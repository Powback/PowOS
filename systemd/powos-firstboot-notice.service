# Narrate bazzite-hardware-setup on the console. See bin/powos-firstboot-notice
# for why: without it, a fresh Deck install shows a minute of blank, repeatedly
# cleared screen and then reboots, which reads exactly like a boot loop.
[Unit]
Description=PowOS: explain the first-boot hardware setup on the console
After=basic.target
# BEFORE, not after. This unit narrates bazzite-hardware-setup while it runs,
# so it has to be started first — ordering it After meant systemd only started
# it once hardware-setup had finished, at which point its polling loop found
# the unit inactive and exited without printing a thing. It could never have
# worked, and the blank minute it exists to explain stayed blank.
#
# Ordering only, never Requires: a missing or already-finished hardware-setup
# must not make this unit fail, and this unit must never delay anything —
# Type=simple means systemd treats it as started immediately, so Before= here
# costs nothing.
Before=bazzite-hardware-setup.service

[Service]
Type=simple
ExecStart=/usr/bin/powos-firstboot-notice
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
# Never hold the boot open: this is commentary, not work.
TimeoutStartSec=150
Restart=no

[Install]
WantedBy=multi-user.target
