[Unit]
Description=PowOS System Hydration
Documentation=https://github.com/user/powos
# Not ordered after network-online.target: that drags
# NetworkManager-wait-online onto the critical path to multi-user.target, and
# with Before=multi-user.target below it would gate the desktop on DHCP.
# Hydration is a background top-up; it waits for the network itself. powos-overlay.service
Wants=network-online.target
ConditionPathExists=/usr/lib/powos/powos-hydrate
# Only run if hydration is needed
ConditionPathExists=!/var/lib/powos/state/hydrated

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/run/powos/environment
ExecStart=/usr/lib/powos/powos-hydrate
StandardOutput=journal
StandardError=journal
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
