[Unit]
Description=PowOS — re-apply boot menu entries into the current ostree slot
Documentation=man:powos(8)
# /boot/loader is a symlink ostree flips to a freshly generated loader.N on any
# deployment change, which silently deletes the Install and Recovery entries.
# Re-apply them every boot; the script is idempotent and writes nothing when
# they are already correct.
ConditionPathIsDirectory=/boot/loader/entries
# Only on a live installer medium. install-to-usb.sh drops this marker into the
# medium's deployment. Without it this unit would also run on an INSTALLED
# system, where it would add an "Install PowOS to disk" entry to that machine's
# own boot menu and strip its boot splash — neither of which belongs there.
ConditionPathExists=/etc/powos/.live-medium
After=local-fs.target
[Service]
Type=oneshot
ExecStart=/usr/bin/powos-boot-entries
RemainAfterExit=yes
StandardOutput=journal
[Install]
WantedBy=multi-user.target
