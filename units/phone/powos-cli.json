{
  "id": "powos-cli",
  "name": "PowOS CLI",
  "kind": "system",
  "owner": "system:powos-deploy",
  "purpose": "the powos command and its libraries (lib/ -> /usr/lib/powos), the AI context, the device's platform file",
  "installedBy": "the PowOS rootfs image + targets/android/rooted/powos-deploy.sh",
  "files": [
    "/usr/bin/powos",
    "/usr/bin/powos-askpass",
    "/usr/bin/powos-boot",
    "/usr/bin/powos-boot-entries",
    "/usr/bin/powos-desktop-entrypoint",
    "/usr/bin/powos-entrypoint",
    "/usr/bin/powos-firstboot-*",
    "/usr/bin/powos-game-shim",
    "/usr/bin/powos-heal",
    "/usr/bin/powos-initramfs-slim",
    "/usr/bin/powos-install-wizard",
    "/usr/bin/powos-mods-mount",
    "/usr/bin/powos-panel-center",
    "/usr/bin/powos-panel-multimon",
    "/usr/bin/powos-panel-responsive",
    "/usr/bin/powos-pty-run",
    "/usr/bin/powos-safemode",
    "/usr/bin/powos-virtual-display*",
    "/usr/bin/powos-welcome",
    "/usr/bin/powos-widget-autoadd",
    "/usr/lib/powos/*.sh",
    "/usr/lib/powos/src",
    "/usr/lib/powos/boot",
    "/usr/lib/powos/cachefs",
    "/usr/lib/powos/dracut",
    "/usr/lib/powos/gkeys",
    "/usr/lib/powos/mods",
    "/usr/lib/powos/ramfs",
    "/etc/powos/platform",
    "/etc/powos/widgets.conf",
    "/etc/powos/zones",
    "/etc/powos/ai/context",
    "/etc/powos/ai/endpoint.conf",
    "/opt/powos"
  ],
  "remove": {
    "commands": []
  }
}
