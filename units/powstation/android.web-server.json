{
  "id": "android.web-server",
  "name": "android-app-dev: web-server",
  "kind": "container",
  "host": "powstation",
  "owner": "user",
  "purpose": "asset-origin; Compose-managed by android-app-dev",
  "installedBy": "pow-compose register",
  "processes": [
    {
      "container": "android-webserver"
    }
  ],
  "autosleep": "never",
  "platform": {
    "schema": "powos.platform/v1",
    "project": "android-app-dev",
    "service": "web-server",
    "lifecycleAuthority": "powstation-autosleep",
    "lifecycle": {
      "policy": "always"
    },
    "access": {
      "authentication": "existing",
      "exposure": "existing"
    }
  },
  "remove": {
    "stop": [
      "docker compose --project-directory /Users/macback/Projects/android-app-dev -f /Users/macback/Projects/android-app-dev/docker-compose.yml --project-name android-app-dev stop web-server"
    ],
    "keep": [
      "/Users/macback/Projects/android-app-dev/webserver",
      "/Users/macback/Projects/android-app-dev/output",
      "/Users/macback/Projects/android-app-dev/webserver/bridge-test"
    ]
  },
  "unbounded": "Existing Compose has no explicit container cap; measure before selecting limits."
}
