{
  "id": "powflix.sabnzbd",
  "name": "powflix: sabnzbd",
  "kind": "container",
  "host": "powstation",
  "owner": "user",
  "purpose": "download-worker; Compose-managed by powflix",
  "installedBy": "pow-compose register",
  "processes": [
    {
      "container": "sabnzbd"
    }
  ],
  "autosleep": "never",
  "platform": {
    "schema": "powos.platform/v1",
    "project": "powflix",
    "service": "sabnzbd",
    "lifecycleAuthority": "powstation-autosleep",
    "lifecycle": {
      "policy": "always"
    },
    "access": {
      "authentication": "existing",
      "exposure": "existing"
    }
  },
  "remove": {
    "stop": [
      "docker compose --project-directory /Users/macback/Projects/Powflix -f /Users/macback/Projects/Powflix/docker-compose.yml --project-name powflix stop sabnzbd"
    ],
    "keep": [
      "/Users/macback/Projects/Powflix/config/sabnzbd",
      "/Users/macback/powflix-downloads"
    ]
  },
  "unbounded": "Existing Compose has no explicit container cap; measure before selecting limits."
}
