{
  "id": "powstation.pihole",
  "name": "powstation: pihole",
  "kind": "container",
  "host": "powstation",
  "owner": "user",
  "purpose": "infrastructure; Compose-managed by powstation",
  "installedBy": "pow-compose register",
  "processes": [
    {
      "container": "pihole"
    }
  ],
  "autosleep": "never",
  "platform": {
    "schema": "powos.platform/v1",
    "project": "powstation",
    "service": "pihole",
    "lifecycleAuthority": "powstation-autosleep",
    "lifecycle": {
      "policy": "always"
    },
    "access": {
      "authentication": "existing",
      "exposure": "existing"
    }
  },
  "remove": {
    "stop": [
      "docker compose --project-directory /Users/macback/Projects/PowStation -f /Users/macback/Projects/PowStation/docker-compose.yaml --project-name powstation stop pihole"
    ],
    "keep": [
      "/Users/macback/Projects/PowStation/data/pihole/etc-pihole",
      "/Users/macback/Projects/PowStation/data/pihole/etc-dnsmasq.d"
    ]
  },
  "unbounded": "Existing Compose has no explicit container cap; measure before selecting limits."
}
