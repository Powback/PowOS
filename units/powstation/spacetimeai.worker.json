{
  "id": "spacetimeai.worker",
  "name": "spacetimeai: worker",
  "kind": "container",
  "host": "powstation",
  "owner": "user",
  "purpose": "agent-platform; Compose-managed by spacetimeai",
  "installedBy": "pow-compose register",
  "processes": [
    {
      "container": "spacetimeai-worker"
    }
  ],
  "autosleep": "never",
  "platform": {
    "schema": "powos.platform/v1",
    "project": "spacetimeai",
    "service": "worker",
    "lifecycleAuthority": "powstation-autosleep",
    "lifecycle": {
      "policy": "always"
    },
    "access": {
      "authentication": "existing",
      "exposure": "existing"
    }
  },
  "remove": {
    "stop": [
      "docker compose --project-directory /Users/macback/Projects/SpaceTimeAI -f /Users/macback/Projects/SpaceTimeAI/docker-compose.yml --project-name spacetimeai stop worker"
    ],
    "keep": [
      "/Users/macback/Projects/SpaceTimeAI/.stdb-state/deploy/SpaceTimeAI/agents",
      "agents_node_modules",
      "/Users/macback/Projects/SpaceTimeAI/.stdb-state/tokens",
      "/Users/macback/Projects/SpaceTimeAI/.stdb-state/deploy/SpaceTimeAI/playbooks",
      "worker_scratch",
      "worker_work",
      "/Users/macback/Projects/SpaceTimeAI/.stdb-state/hub"
    ]
  },
  "limits": {
    "memory": "25769803776",
    "pids": 4096
  }
}
