{
  "id": "minecraft.pack",
  "name": "minecraft-create121: pack",
  "kind": "container",
  "host": "powstation",
  "owner": "user",
  "purpose": "asset-origin; Compose-managed by minecraft-create121",
  "installedBy": "pow-compose register",
  "processes": [
    {
      "container": "mc-create121-pack"
    }
  ],
  "autosleep": "never",
  "platform": {
    "schema": "powos.platform/v1",
    "project": "minecraft-create121",
    "service": "pack",
    "lifecycleAuthority": "powstation-autosleep",
    "lifecycle": {
      "policy": "always"
    },
    "access": {
      "authentication": "existing",
      "exposure": "existing"
    }
  },
  "remove": {
    "stop": [
      "docker compose --project-directory /Users/macback/Projects/minecraft-create121 -f /Users/macback/Projects/minecraft-create121/docker-compose.yaml --project-name minecraft-create121 stop pack"
    ],
    "keep": [
      "/Users/macback/Projects/minecraft-create121/download",
      "/Users/macback/Projects/minecraft-create121/pack",
      "/Users/macback/Projects/minecraft-create121/download/nginx.conf"
    ]
  },
  "unbounded": "Existing Compose has no explicit container cap; measure before selecting limits."
}
