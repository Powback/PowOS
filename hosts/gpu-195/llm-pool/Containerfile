# gpu-195 general LLM pool image: llama-swap in front of vLLM, in one container on GPU1.
# llama-swap starts a model's `vllm serve` as a child process on first request and stops it after its TTL, so the
# pool's models share GPU1 one (plus the small embedder) at a time. Both come from here, not from the host: the vLLM
# image the voice path already runs (pinned by digest, so a pull for voice-llm can't change the pool under us) plus
# the llama-swap release binary (pinned version + sha256).
# Built by hosts/gpu-195/install.sh as localhost/llm-pool:latest. Config: hosts/gpu-195/llm-pool/config.yaml.
FROM docker.io/vllm/vllm-openai@sha256:6ee133356d49ed24cee03dd0cda3d3980279a11c107ce3e752c89e76540f41c9

ARG LLAMA_SWAP_VERSION=265
ARG LLAMA_SWAP_SHA256=cb1f9a94be05afa129d3c17868f1dd2ca710b919333c7b868239dc31575dcfa1
RUN set -eu; \
    curl -fsSL -o /tmp/ls.tgz \
      "https://github.com/mostlygeek/llama-swap/releases/download/v${LLAMA_SWAP_VERSION}/llama-swap_${LLAMA_SWAP_VERSION}_linux_amd64.tar.gz"; \
    echo "${LLAMA_SWAP_SHA256}  /tmp/ls.tgz" | sha256sum -c -; \
    tar -xzf /tmp/ls.tgz -C /usr/local/bin llama-swap; \
    rm /tmp/ls.tgz; \
    llama-swap -version

# Bonsai's ternary GGUF packings need PrismML's matching llama.cpp kernels.
# CUDA 13 matches this vLLM base's runtime; pin both release and archive digest.
ARG PRISM_VERSION=prism-b10826-c9c34bc
ARG PRISM_SHA256=43e203be88b8c2fbebb24d518078c3ff02df742970d89f739e9dc23646c6ff2d
RUN set -eu; \
    curl -fsSL -o /tmp/prism.tgz \
      "https://github.com/PrismML-Eng/llama.cpp/releases/download/${PRISM_VERSION}/llama-${PRISM_VERSION}-bin-linux-cuda-13.3-x64.tar.gz"; \
    echo "${PRISM_SHA256}  /tmp/prism.tgz" | sha256sum -c -; \
    mkdir -p /opt/llama-prism; \
    tar -xzf /tmp/prism.tgz -C /opt/llama-prism --strip-components=1; \
    rm /tmp/prism.tgz; \
    ldd /opt/llama-prism/libggml-cuda.so > /tmp/prism-libs.txt; \
    cat /tmp/prism-libs.txt; \
    # libcuda is injected by CDI at runtime; it is absent during an image build.
    if grep 'not found' /tmp/prism-libs.txt | grep -v 'libcuda.so.1'; then exit 1; fi; \
    /opt/llama-prism/llama-server --version

# Pinned Strata engine and its private Python runtime for the offloaded MoE.
COPY --from=ghcr.io/niko1221/strata@sha256:d39ca9fc583c5085dc66b857fbf3b3e3a9e256f692672d4061322d3bd468433a /opt/strata /opt/strata
COPY strata-voice-aware.py /usr/local/bin/strata-voice-aware
RUN chmod 755 /usr/local/bin/strata-voice-aware

EXPOSE 8080
ENTRYPOINT ["llama-swap", "-config", "/etc/llama-swap/config.yaml", "-listen", ":8080", "-watch-config"]
