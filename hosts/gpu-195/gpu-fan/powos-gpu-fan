#!/usr/bin/env python3
"""powos-gpu-fan - temperature fan curve + power cap for NVIDIA GPUs, through NVML (libnvidia-ml, ctypes only).

The ASUS RTX 3090 blowers on gpu-195 stop their fans when cool (0% at 46-50 C, measured 2026-11-03), but after any
load the vBIOS curve holds 53-77% for minutes at 49-58 C, and runs near 100% under load (docs/GPU-SERVERS-PLAN.md,
"Noise"). NVML cannot set below the cards' 30% minimum, so this daemon never replaces the silent fan-stop: it leaves a
card on its vBIOS curve while that is quiet (never taking over a stopped fan), and takes over with a gentler curve
when the vBIOS spins faster than the curve while warm (>= take_c), or well above it (`slack` points) at any temp. It hands back once the card is cool (<= release_c) for
`release_hold_s`; if the vBIOS then spins up again, it takes over and waits `retry_s` before the next try. A power
cap keeps load quieter too.

Safety: the cards' own automatic curve is the fallback for every failure. On exit, SIGTERM, any NVML error on a card,
or a temperature at/above `panic_c`, that card goes back to the driver default (nvmlDeviceSetDefaultFanSpeed_v2), and
on panic its fans go to 100%. The power cap is restored to the card's default on stop.

  powos-gpu-fan run              the daemon (root; powos-gpu-fan.service)
  powos-gpu-fan status           temps, fans, power, limits (no root needed)
  powos-gpu-fan reset            give every fan back to the vBIOS curve, restore default power limits (root)
  powos-gpu-fan mode [auto|quiet|performance]   show / set the power mode (root to set; the daemon picks it up)

Power profiles (11-09, "gpu-195 runs loud"): a card that sat at <= idle_util % for idle_after_s gets the idle profile
(lower power cap + graphics clocks capped at idle_max_clock_mhz); any util > idle_util puts it back on the busy profile
on the next tick (interval_s). Measured 11-09: GPU0 at 0% util drew 155 W at 86 C, fans 100%, SM clock held at
1740 MHz (P2, voice-llm/STT/TTS contexts resident); a card can't be powered off while contexts are resident, so the
idle profile is the "power-down" for a held card. Modes (/etc/powos/gpu-fan-mode): auto = switch per card,
quiet = idle profile always, performance = busy profile always with the driver's default power limit.

Config: /etc/powos/gpu-fan.json (optional) overrides DEFAULTS below, e.g. {"power_limit_w": 280}.
"""
import ctypes as C
import json
import signal
import sys
import time
from pathlib import Path

CONFIG = Path('/etc/powos/gpu-fan.json')
DEFAULTS = {
    # (temperature C, fan %). Below the first point: the first point's fan; above the last: 100%.
    'curve': [[50, 30], [58, 35], [65, 50], [72, 65], [78, 80], [83, 100]],
    'take_c': 52,           # control the fans at/above this temperature
    'release_c': 47,        # hand back to the vBIOS curve (fan-stop) at/below this ...
    'release_hold_s': 30,   # ... once it has stayed there this long
    'slack': 15,            # below take_c: take over when the vBIOS fan is this many points above the curve
    'retry_s': 120,         # after the vBIOS spun up on a hand-back, wait this long before handing back again
    'panic_c': 87,          # at/above: fans 100% and hand back to the vBIOS curve until it cools below panic-10
    'down_step': 2,         # max % the fan drops per tick (up is immediate)
    'hysteresis_c': 3,      # the fan only drops once the temp is this far below the temp that set the current speed
    'interval_s': 2.0,
    'power_limit_w': 250,   # per card, busy profile; null = leave the driver's limit alone
    'idle_power_limit_w': 150,   # per card, idle profile (range 100-375 W on the 3090s); null = keep power_limit_w
    'idle_max_clock_mhz': 1000,  # idle profile: graphics clock cap (NVML locked clocks); null = no clock cap
    'idle_min_clock_mhz': 210,
    'idle_util': 2,              # GPU util % at/below which a card counts as idle
    'idle_after_s': 60,          # ... for this long before the idle profile goes on
}
MODE_FILE = Path('/etc/powos/gpu-fan-mode')
MODES = ('auto', 'quiet', 'performance')

NVML_TEMPERATURE_GPU = 0
OK = 0
nv = None


def load_config():
    cfg = dict(DEFAULTS)
    if CONFIG.is_file():
        cfg.update(json.loads(CONFIG.read_text()))
    cfg['curve'] = sorted((float(t), float(f)) for t, f in cfg['curve'])
    return cfg


def nvml():
    global nv
    if nv is None:
        nv = C.CDLL('libnvidia-ml.so.1')
        check(nv.nvmlInit_v2(), 'nvmlInit_v2')
    return nv


def check(rc, what):
    if rc != OK:
        nv.nvmlErrorString.restype = C.c_char_p
        raise RuntimeError(f'{what}: {nv.nvmlErrorString(rc).decode()} ({rc})')


def u(fn, *args):
    out = C.c_uint()
    check(getattr(nvml(), fn)(*args, C.byref(out)), fn)
    return out.value


class Gpu:
    def __init__(self, index):
        self.index = index
        self.h = C.c_void_p()
        check(nvml().nvmlDeviceGetHandleByIndex_v2(index, C.byref(self.h)), 'GetHandleByIndex')
        self.fans = u('nvmlDeviceGetNumFans', self.h)
        lo, hi = C.c_uint(), C.c_uint()
        check(nv.nvmlDeviceGetMinMaxFanSpeed(self.h, C.byref(lo), C.byref(hi)), 'GetMinMaxFanSpeed')
        self.fan_min, self.fan_max = lo.value, hi.value
        self.default_pl = u('nvmlDeviceGetPowerManagementDefaultLimit', self.h)
        self.set_fan = None      # last speed we set; None = vBIOS curve
        self.set_at_c = None     # temperature that set it
        self.panicked = False
        self.cool_since = None   # when the temp first sat at/below release_c while we controlled the fans
        self.no_release_until = 0.0
        self.released_at = None  # when we last handed back (to catch the vBIOS spinning straight up)
        self.profile = None      # 'busy' / 'idle' / 'performance' once set
        self.idle_since = None

    def temp(self):
        return u('nvmlDeviceGetTemperature', self.h, NVML_TEMPERATURE_GPU)

    def fan(self, i):
        return u('nvmlDeviceGetFanSpeed_v2', self.h, i)

    def power_w(self):
        return u('nvmlDeviceGetPowerUsage', self.h) / 1000

    def limit_w(self):
        return u('nvmlDeviceGetPowerManagementLimit', self.h) / 1000

    def apply(self, pct):
        pct = int(max(self.fan_min, min(self.fan_max, round(pct))))
        for i in range(self.fans):
            check(nv.nvmlDeviceSetFanSpeed_v2(self.h, i, pct), 'SetFanSpeed_v2')
        self.set_fan = pct

    def to_default(self):
        for i in range(self.fans):
            nvml().nvmlDeviceSetDefaultFanSpeed_v2(self.h, i)   # best effort: this IS the failure path
        self.set_fan = None
        self.set_at_c = None

    def cap(self, watts):
        check(nv.nvmlDeviceSetPowerManagementLimit(self.h, int(watts * 1000)), 'SetPowerManagementLimit')

    def uncap(self):
        nvml().nvmlDeviceSetPowerManagementLimit(self.h, self.default_pl)
        nvml().nvmlDeviceResetGpuLockedClocks(self.h)   # best effort: also the failure path

    def util(self):
        class Util(C.Structure):
            _fields_ = [('gpu', C.c_uint), ('memory', C.c_uint)]
        out = Util()
        check(nvml().nvmlDeviceGetUtilizationRates(self.h, C.byref(out)), 'GetUtilizationRates')
        return out.gpu

    def set_profile(self, name, cfg):
        """busy: power_limit_w, no clock cap. idle: idle_power_limit_w + clocks capped. performance: driver default."""
        if name == 'idle':
            w = cfg['idle_power_limit_w'] or cfg['power_limit_w']
            if w:
                self.cap(w)
            if cfg['idle_max_clock_mhz']:
                check(nv.nvmlDeviceSetGpuLockedClocks(self.h, int(cfg['idle_min_clock_mhz']),
                                                      int(cfg['idle_max_clock_mhz'])), 'SetGpuLockedClocks')
        else:
            nv.nvmlDeviceResetGpuLockedClocks(self.h)
            if name == 'performance':
                check(nv.nvmlDeviceSetPowerManagementLimit(self.h, self.default_pl), 'SetPowerManagementLimit')
            elif cfg['power_limit_w']:
                self.cap(cfg['power_limit_w'])
        self.profile = name


def curve_at(curve, t):
    if t <= curve[0][0]:
        return curve[0][1]
    for (t0, f0), (t1, f1) in zip(curve, curve[1:]):
        if t <= t1:
            return f0 + (f1 - f0) * (t - t0) / (t1 - t0)
    return 100.0


def read_mode():
    try:
        m = MODE_FILE.read_text().strip()
    except OSError:
        return 'auto'
    return m if m in MODES else 'auto'


def power_tick(g, cfg, now):
    """Pick the card's power profile from the mode and its utilization; only touches NVML on a change."""
    mode = read_mode()
    if mode == 'performance':
        want = 'performance'
    elif mode == 'quiet':
        want = 'idle'
    else:
        if g.util() > cfg['idle_util']:
            g.idle_since = None
            want = 'busy'
        else:
            g.idle_since = g.idle_since or now
            want = 'idle' if now - g.idle_since >= cfg['idle_after_s'] else (g.profile or 'busy')
    if want != g.profile:
        g.set_profile(want, cfg)
        log(f'gpu{g.index}: power profile {want} (mode {mode}), limit {g.limit_w():.0f} W')


def gpus():
    return [Gpu(i) for i in range(u('nvmlDeviceGetCount_v2'))]


def log(*a):
    print(*a, flush=True)


def run():
    cfg = load_config()
    cards = gpus()
    stop = []

    def bye(*_):
        stop.append(1)
    signal.signal(signal.SIGTERM, bye)
    signal.signal(signal.SIGINT, bye)

    for g in cards:
        log(f'gpu{g.index}: {g.fans} fans, range {g.fan_min}-{g.fan_max}%, default power {g.default_pl / 1000:.0f} W')
        try:
            g.set_profile('busy', cfg)
            log(f'gpu{g.index}: power limit {g.limit_w():.0f} W (busy profile)')
        except RuntimeError as e:
            log(f'gpu{g.index}: power cap not set: {e}')
    try:
        while not stop:
            for g in cards:
                try:
                    tick(g, cfg)
                except RuntimeError as e:
                    log(f'gpu{g.index}: {e}; back to the vBIOS curve')
                    g.to_default()
                try:
                    power_tick(g, cfg, time.monotonic())
                except RuntimeError as e:   # a power/clock call failed: no clock cap, busy limit, keep going
                    log(f'gpu{g.index}: power profile: {e}; clocks uncapped')
                    nvml().nvmlDeviceResetGpuLockedClocks(g.h)
                    g.profile = 'error'
                    g.idle_since = None
            time.sleep(cfg['interval_s'])
    finally:
        for g in cards:
            g.to_default()
            g.uncap()
        log('stopped: fans on the vBIOS curve, default power limits, clocks uncapped')


def tick(g, cfg):
    t = g.temp()
    if t >= cfg['panic_c']:
        if not g.panicked:
            log(f'gpu{g.index}: {t} C >= {cfg["panic_c"]} C: fans 100%, then the vBIOS curve')
            g.apply(100)
            g.to_default()
            g.panicked = True
        return
    if g.panicked:
        if t > cfg['panic_c'] - 10:
            return
        log(f'gpu{g.index}: cooled to {t} C, curve back on')
        g.panicked = False
    now = time.monotonic()
    want = curve_at(cfg['curve'], t)
    cur = g.set_fan
    if cur is None:
        # vBIOS curve: leave it while quiet. Never wake a fan the vBIOS has stopped (it reads 0% with a 30% target;
        # a blower needs ~50% to start, so taking over a stopped fan only adds noise). Take over when the vBIOS
        # spins faster than the curve: warm (>= take_c), or far above it (the post-load linger).
        vbios = g.fan(0)
        if vbios > want and (t >= cfg['take_c'] or vbios > want + cfg['slack']):
            if g.released_at is not None and now - g.released_at < 30:
                g.no_release_until = now + cfg['retry_s']   # handing back just made it spin up: back off
            log(f'gpu{g.index}: {t} C, vBIOS fan {vbios}%: curve {want:.0f}%')
            g.apply(want)
            g.set_at_c = t
            g.cool_since = None
        return
    if t <= cfg['release_c'] and now >= g.no_release_until:
        g.cool_since = g.cool_since or now
        if now - g.cool_since >= cfg['release_hold_s']:
            log(f'gpu{g.index}: {t} C: back to the vBIOS curve (fan-stop)')
            g.to_default()
            g.released_at = now
            return
    else:
        g.cool_since = None
    if want > cur:
        g.apply(want)
        g.set_at_c = t
    elif want < cur and t <= g.set_at_c - cfg['hysteresis_c']:
        g.apply(max(want, cur - cfg['down_step']))
        if g.set_fan <= want + 0.5:
            g.set_at_c = t

def status():
    for g in gpus():
        fans = []
        for i in range(g.fans):
            try:
                fans.append(f'{g.fan(i)}%')
            except RuntimeError:
                fans.append(f'{u("nvmlDeviceGetFanSpeed", g.h)}%')
        clk = C.c_uint()
        nv.nvmlDeviceGetClockInfo(g.h, 1, C.byref(clk))   # NVML_CLOCK_SM
        print(f'gpu{g.index}: {g.temp()} C, fans {" ".join(fans)}, {g.power_w():.0f} W of {g.limit_w():.0f} W '
              f'(default {g.default_pl / 1000:.0f} W), util {g.util()}%, SM {clk.value} MHz')
    print(f'mode: {read_mode()}')


def reset():
    for g in gpus():
        g.to_default()
        g.uncap()
    print('fans on the vBIOS curve, default power limits, clocks uncapped')


def mode():
    if len(sys.argv) < 3:
        print(read_mode())
        return
    m = sys.argv[2]
    if m not in MODES:
        sys.exit(f'mode must be one of {", ".join(MODES)}')
    MODE_FILE.parent.mkdir(parents=True, exist_ok=True)
    MODE_FILE.write_text(m + '\n')
    print(f'mode {m}: the daemon applies it within {DEFAULTS["interval_s"]:.0f} s')


if __name__ == '__main__':
    cmd = sys.argv[1] if len(sys.argv) > 1 else 'status'
    {'run': run, 'status': status, 'reset': reset, 'mode': mode}.get(cmd, lambda: sys.exit(__doc__))()
