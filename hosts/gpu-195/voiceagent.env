# gpu-195: VoiceAgent backend config (installed to ~/.config/voiceagent/voiceagent.env by install.sh).
# No secrets here: those go in ~/.config/voiceagent/secrets.env (mode 600, only on the box; names: LITELLM_API_KEY).
WHISPER_URL=http://voice-stt:8000
KOKORO_URL=http://voice-tts:8880
VLLM_URL=http://voice-llm:8000
VLLM_MODEL=qwen3-8b
# Qwen3's thinking block delays the first spoken word by the whole think; voice wants it off (the UI can turn it on).
VLLM_ENABLE_THINKING=false
DEFAULT_LLM_PROVIDER=vllm
DEFAULT_STT_PROVIDER=whisper
DEFAULT_VOICE=bf_emma
# The box runs on UTC; the user is in Norway. get_current_time answers in this zone (the image has tzdata).
TZ=Europe/Oslo
# VAD: threshold lowered for the glasses mic (as on the Mac).
VAD_THRESHOLD=0.3
VAD_SPEECH_PAD_MS=300
VAD_MIN_SPEECH_MS=250
# Adaptive end of speech: a turn ends after 250 ms of silence and is transcribed at once; a transcript that looks
# unfinished ("... and", "um", a bare "hey luna") waits out VAD_MIN_SILENCE_MS (the cap), and speech resuming
# before the turn commits merges back into it. Asleep, the cap is always waited.
VAD_BASE_SILENCE_MS=250
VAD_MIN_SILENCE_MS=500
# The final transcript in one plain request (no SSE stream; partials still come while speaking).
WHISPER_STREAMING=false
WAKE_WORDS=hey luna,luna,hey assistant
# LiteLLM (the router, llm.pow) comes in phase 4; until then the litellm provider is unused.
