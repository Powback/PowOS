+// Cross-process arbitration for the shared helper.
+//
+// ClaimPrimary above is per-PROCESS: g_primary is static, so each process picks
+// its own largest swapchain. The helper is ONE service with ONE neural context,
+// so a game spanning several processes has them all submit, and the helper binds
+// its context to whichever arrived first. Seen in GTA V Enhanced: the Rockstar
+// launcher (1024x600) and the game (2977x1440) both claim, the launcher wins the
+// context, and every frame from the game is refused for size mismatch -- 0
+// composed, 22 rejected, while both logs read clean.
+//
+// layerPid in the header is last-writer-wins, which cannot arbitrate. So the
+// claim carries the AREA: a process takes the channel only if its swapchain is
+// larger than the incumbent's, or the incumbent is gone. Kept in a small file
+// rather than a new header field so the protocol version stays put and an older
+// helper keeps working.
+static std::string PrimaryClaimPath() {
+    const char* dir = getenv("DLSSNR_RUNTIME_DIR");
+    if (dir && *dir) return std::string(dir) + "/primary.claim";
+    return "/tmp/dlssnr-" + std::to_string(getuid()) + "/primary.claim";
+}
+
+static bool PidAlive(uint32_t pid) {
+    if (!pid) return false;
+    return ::kill(pid_t(pid), 0) == 0 || errno == EPERM;
+}
+
+// May this process drive the helper with a swapchain of this area?
+static bool ClaimChannel(uint64_t area) {
+    const std::string path = PrimaryClaimPath();
+    const uint32_t self = uint32_t(getpid());
+    uint32_t owner = 0; unsigned long long ownerArea = 0;
+    if (FILE* f = fopen(path.c_str(), "re")) {
+        if (fscanf(f, "%u %llu", &owner, &ownerArea) != 2) { owner = 0; ownerArea = 0; }
+        fclose(f);
+    }
+    const bool take = (owner == self) || !PidAlive(owner) || area > ownerArea;
+    if (!take) return false;
+    if (owner == self && ownerArea == area) return true;
+    // temp + rename, so a reader never sees a half-written claim.
+    const std::string tmp = path + ".tmp";
+    if (FILE* f = fopen(tmp.c_str(), "we")) {
+        fprintf(f, "%u %llu\n", self, (unsigned long long)area);
+        fclose(f);
+        if (rename(tmp.c_str(), path.c_str()) != 0) unlink(tmp.c_str());
+    }
+    return true;
+}
+
+static void ReleaseChannel() {
+    const std::string path = PrimaryClaimPath();
+    uint32_t owner = 0; unsigned long long ownerArea = 0;
+    if (FILE* f = fopen(path.c_str(), "re")) {
+        if (fscanf(f, "%u %llu", &owner, &ownerArea) != 2) owner = 0;
+        fclose(f);
+    }
+    if (owner == uint32_t(getpid())) unlink(path.c_str());
+}
