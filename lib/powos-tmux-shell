#!/usr/bin/env bash
# powos-tmux-shell — the login command for a PowOS terminal.
#
# WHY THIS IS A COMMAND AND NOT A SHELL RC HOOK
# ---------------------------------------------
# The previous implementation lived in /etc/profile.d and had to *guess* whether
# it was inside a terminal we own, by sniffing $KONSOLE_VERSION / $SSH_CONNECTION.
# That fails two ways:
#   1. profile.d is a LOGIN-shell mechanism. Konsole happens to spawn `-bash`
#      (login), but Dolphin's embedded terminal spawns plain `/bin/bash`
#      (non-login), so the hook's delivery depended on a distro-specific
#      /etc/bashrc re-sourcing loop.
#   2. Allow-listing terminals never converges — Dolphin's KPart, Yakuake,
#      VS Code, Zed and every future surface each need a new special case.
#
# Being the terminal's Command inverts both problems. Konsole runs us directly,
# and because /etc/xdg/konsolerc sets DefaultProfile=PowOS.profile, EVERY
# Konsole-KPart surface (Dolphin's F4 panel, Yakuake, ...) inherits us for free.
# There is nothing to detect: if we are running, we are in a terminal.
#
# SSH has no Konsole profile to configure, so 50-powos-tmux-resume.sh execs this
# same script — one implementation, two entry points.
#
# CONTRACT: this script must ALWAYS end in an exec. A terminal whose command
# exits is a terminal that vanishes, so every failure path falls back to a shell.

# --- fallback: hand the user a normal login shell ---------------------------
# Marked DONE so the SSH hook in profile.d cannot re-enter and loop.
exec_shell() {
    export POWOS_TMUX_RESUME_DONE=1
    exec "${SHELL:-/bin/bash}" -l
}

# --switch: show this same picker from INSIDE tmux (a display-popup bound to a
# key) and switch the client instead of attaching. tmux own choose-tree works
# but has no directory sections and no working/finished split, which is the
# whole point of this list.
if [ "${1:-}" = "--switch" ]; then
    export POWOS_TMUX_SWITCH=1
else
    [ -z "$TMUX" ]       || exec_shell   # never nest inside tmux
fi
[ -z "$POWOS_NO_TMUX" ]  || exec_shell   # escape hatch
[ -t 0 ]                 || exec_shell   # no tty (scripted/embedded) -> plain
command -v tmux >/dev/null 2>&1 || exec_shell

export POWOS_TMUX_RESUME_DONE=1
export POWOS_TMUX_NEW='  +  new session'
export POWOS_TMUX_SHELL='  ·  plain shell (no tmux)'
export POWOS_TMUX_CONSOLE='  ▦  console — every session in one grid'

# Row generator for the picker. Exported so fzf's reload() can re-run it after a
# kill. Reads tmux fresh each call, so the list always reflects reality.
#
# Two levels of grouping. First CATEGORY -- terminals running Claude, then plain
# shells -- because most terminals here are Claude and the split is what tells
# them apart at a glance. Then SECTIONS BY WORKING DIRECTORY inside each, with
# the directory on its own heading line. Inside a section the most recently
# active session leads, and sections are ordered by their most recent session.
_powos_tmux_rows() {
    local s wins cmd ttl winlbl grp att name cl wk nw ww tw cols list_w prev="" prevcat=""

    # Which sessions are running Claude, anywhere in the pane process tree?
    #
    # pane_current_command is NOT enough. `powos ai --interactive` is a bash
    # wrapper that spawns Claude as a grandchild, so those panes report "bash"
    # -- every session started through powos ai would be filed as a plain shell.
    # Matching the full cmdline is also wrong: shell snapshots live under
    # ~/.claude, so any shell sourcing one looks like Claude. Match the process
    # NAME (claude, or the versioned binary Claude Code re-execs into), plus the
    # powos ai wrapper, then walk each hit UP to the pane it belongs to.
    cl=$( { ps -e -o pid=,ppid=,comm=,args= 2>/dev/null; echo '---'
            tmux list-panes -a -F '#{session_name} #{pane_pid}' 2>/dev/null; } | awk '
        /^---$/ { m = 1; next }
        !m {
            par[$1] = $2
            if ($3 == "claude" || $3 ~ /^[0-9]+\.[0-9]+\.[0-9]+$/ || $0 ~ /powos ai( |$)/) cand[$1] = 1
            next
        }
        { pane[$2] = $1 }
        END {
            for (p in cand) {
                q = p
                for (i = 0; i < 16; i++) {
                    if (q in pane) hit[pane[q]] = 1
                    if (!(q in par)) break
                    q = par[q]
                }
            }
            out = " "; for (x in hit) out = out x " "; print out
        }')

    # Of those, which are mid-response rather than sitting there finished?
    # Claude Code prints "esc to interrupt" only while it is actually working,
    # in every skin and for any model, so it beats guessing from CPU or from
    # tmux activity (a session that just finished looks identical to a busy one
    # by activity). Only Claude sessions are probed -- a capture-pane each.
    wk=" "
    for s in $cl; do
        tmux capture-pane -p -t "$s" 2>/dev/null | grep -qiE "esc to interrupt" \
            && wk="$wk$s "
    done

    # Column widths come from the data and the real terminal width, not from a
    # guess. Session names here are usually 2-3 digits, so a fixed 14 threw away
    # a third of a phone-width row; the window column disappears entirely when
    # every session has one window, which is most of the time.
    nw=$(tmux list-sessions -F '#{session_name}' 2>/dev/null \
         | awk '{ if (length($0) > m) m = length($0) } END { print m ? m : 4 }')
    ww=$(tmux list-sessions -F '#{session_windows}' 2>/dev/null \
         | awk '{ if ($1 + 0 > 1) { l = length($1) + 1; if (l > m) m = l } } END { print m ? m : 0 }')
    # Reuse the width across fzf reload(): that subprocess has no tty of its own,
    # so measuring there would silently fall back to 80 and reflow the list.
    if [ -n "${POWOS_TMUX_LIST_W:-}" ]; then
        list_w=$POWOS_TMUX_LIST_W
    else
        cols=$( { stty size </dev/tty 2>/dev/null || echo "24 80"; } | awk '{ print $2 }')
        # fzf puts the preview beside the list above 80 columns and above it
        # below, so the list gets about 42% of a wide terminal and all of a
        # narrow one.
        if [ "${cols:-80}" -ge 80 ] 2>/dev/null; then list_w=$(( cols * 42 / 100 ))
        else list_w=${cols:-80}; fi
        export POWOS_TMUX_LIST_W=$list_w
    fi
    # Reserve the "  (attached)" tag even on rows that lack it, so the columns
    # stay aligned and no row overruns the list width and wraps.
    tw=$(( list_w - nw - ww - 6 - 12 ))
    [ "$ww" -gt 0 ] && tw=$(( tw - 1 ))
    [ "$tw" -lt 12 ] && tw=12
    [ "$tw" -gt 60 ] && tw=60

    _row() {  # _row <name> <glyph> <dim?> <tag?>
        local pre="" post="" tag=""
        [ -n "$3" ] && { pre=$'\033[2m'; post=$'\033[0m'; }
        [ -n "$4" ] && tag="  ($4)"
        wins=$(tmux display-message -p -t "$1" '#{session_windows}' 2>/dev/null)
        # Only surface the window count above 1 — every fresh session has 1, so
        # printing "1w" on every row is pure noise.
        winlbl=""; [ "${wins:-1}" -gt 1 ] 2>/dev/null && winlbl="${wins}w"
        cmd=$(tmux display-message -p -t "$1" '#{pane_current_command}' 2>/dev/null)
        # The title a program set (OSC 0/2) identifies a session far better than
        # the bare command; fall back to the command when nothing set one.
        ttl=$(tmux display-message -p -t "$1" '#{pane_title}' 2>/dev/null)
        case "$ttl" in ""|"$cmd"|"$(hostname -s 2>/dev/null)") ttl="$cmd" ;; esac
        if [ "$ww" -gt 0 ]; then
            printf '%s\t%s%s  %-*s %-*s %-*.*s%s%s\n' \
                   "$1" "$pre" "$2" "$nw" "$1" "$ww" "$winlbl" "$tw" "$tw" "$ttl" "$tag" "$post"
        else
            printf '%s\t%s%s  %-*s %-*.*s%s%s\n' \
                   "$1" "$pre" "$2" "$nw" "$1" "$tw" "$tw" "$ttl" "$tag" "$post"
        fi
    }

    # Sort keys: category, then section recency, then section, then row recency.
    # $'' hands tmux real tabs; a literal backslash-t is passed through as-is.
    # The console session is a VIEW of the others, not work to resume — the
    # action row below opens it. Listing it here too would be duplicate noise.
    tmux list-sessions -F $'#{session_activity}\t#{session_attached}\t#{session_name}\t#{pane_current_path}' 2>/dev/null \
    | awk -F'\t' -v me="${POWOS_CONSOLE_SESSION:-console}" -v home="$HOME" -v cl="$cl" -v wk="$wk" '
        $3 == me { next }
        {
            cwd = $4
            sub(/^\/var\/home\//, "/home/", cwd)      # ostree physical -> logical
            if (index(cwd, home) == 1) cwd = "~" substr(cwd, length(home) + 1)
            rank = index(wk, " " $3 " ") ? 0 : (index(cl, " " $3 " ") ? 1 : 2)
            key  = rank "\t" cwd
            a = $1 + 0
            if (a > mx[key]) mx[key] = a
            n++; A[n] = a; T[n] = $2; N[n] = $3; C[n] = cwd; R[n] = rank; K[n] = key
        }
        END {
            for (i = 1; i <= n; i++)
                printf "%d\t%d\t%s\t%d\t%s\t%s\n", R[i], mx[K[i]], C[i], A[i], T[i], N[i]
        }' \
    | sort -t$'\t' -k1,1n -k2,2nr -k3,3 -k4,4nr \
    | while IFS=$'\t' read -r rank _ grp _ att name; do
          [ -n "$name" ] || continue
          if [ "$rank" != "$prevcat" ]; then
              case "$rank" in
                  0) s="claude · working" ;;
                  1) s="claude · finished" ;;
                  *) s="shells" ;;
              esac
              printf '%s\t%s── %s ──%s\n' "$name" $'\033[7m' "$s" $'\033[0m'
              prevcat="$rank"; prev=""
          fi
          if [ "$grp" != "$prev" ]; then
              printf '%s\t%s%s%s\n' "$name" $'\033[1m' "$grp" $'\033[0m'
              prev="$grp"
          fi
          if [ "$att" = "0" ]; then _row "$name" '○' ''
          else                      _row "$name" '●' 'dim' 'attached'; fi
      done
    printf '%s\t%s\n' "$POWOS_TMUX_NEW" "$POWOS_TMUX_NEW"
    # Switching from inside tmux cannot hand you a bare shell or take the
    # terminal over with the grid, so those two rows are hidden there.
    if [ -z "${POWOS_TMUX_SWITCH:-}" ]; then
        # Only worth offering with 2+ sessions — a "grid" of one is just an
        # attach with extra steps.
        if [ "$(tmux list-sessions -F x 2>/dev/null | wc -l)" -ge 2 ]; then
            printf '%s\t%s\n' "$POWOS_TMUX_CONSOLE" "$POWOS_TMUX_CONSOLE"
        fi
        printf '%s\t%s\n' "$POWOS_TMUX_SHELL" "$POWOS_TMUX_SHELL"
    fi
    unset -f _row
}
export -f _powos_tmux_rows

# No sessions yet — but on the first terminal after a REBOOT the sessions worth
# having are the ones tmux-continuum is about to restore. Creating a blank one
# immediately would win the race and leave you in an empty shell while your
# restored work sat detached behind it.
#
# Only wait when there is actually something to restore (resurrect writes a
# `last` symlink after its first save). Otherwise a genuinely fresh machine
# would eat this delay on every terminal for nothing.
_resurrect_last="${XDG_STATE_HOME:-$HOME/.local/state}/tmux/resurrect/last"
if [ -z "$(tmux list-sessions -F x 2>/dev/null | head -n1)" ] && [ -e "$_resurrect_last" ]; then
    tmux start-server 2>/dev/null      # triggers continuum's restore hook
    _n=0
    while [ "$_n" -lt 20 ]; do         # up to ~5s, exits as soon as one appears
        [ -n "$(tmux list-sessions -F x 2>/dev/null | head -n1)" ] && break
        sleep 0.25
        _n=$((_n + 1))
    done
fi

# Still nothing (fresh machine, or restore found nothing) → plain new session.
# No menu when there is no prior work to choose from.
if [ -z "$(tmux list-sessions -F x 2>/dev/null | head -n1)" ]; then
    exec tmux new-session
fi

preview='
    s={1}
    case "$s" in
        *"console"*)
            echo "  Every session at once, in one tiled grid."
            echo
            echo "  Read-only snapshots, so opening it can NOT resize the"
            echo "  sessions it is showing. Alt+Enter takes over the focused"
            echo "  one; prefix+z zooms it fullscreen. Mouse works."
            exit 0;;
        *"new session"*|*"plain shell"*)
            echo "  (starts a fresh session/shell)"; exit 0;;
    esac
    tmux list-windows -t "$s" -F \
      "  #{window_index}: #{window_name}  [#{window_panes}p]#{?window_active,   ← active,}" 2>/dev/null
    echo
    tmux display-message -p -t "$s" "  title: #{pane_title}"
    tmux display-message -p -t "$s" "  dir  : #{pane_current_path}"
    tmux display-message -p -t "$s" "  cmd  : #{pane_current_command}"
    tmux display-message -p -t "$s" "  seen : #{t:session_activity}"
    echo "  ────────────────────────────────────────────"
    tmux capture-pane -ep -t "$s" 2>/dev/null | tail -n 40
'

if command -v fzf >/dev/null 2>&1; then
    choice=$(
        _powos_tmux_rows | fzf --ansi --reverse --height='80%' \
                --delimiter=$'\t' --with-nth=2 \
                --prompt='resume ▶ ' \
                --header="tmux on $(hostname -s)   ·   Enter = attach   ·   Del = kill   ·   Esc = shell" \
                --bind='del:execute-silent(tmux kill-session -t {1} 2>/dev/null)+reload(bash -c _powos_tmux_rows)' \
                --preview="$preview" \
                --preview-window='right,58%,border-left,wrap'
    )
    name=${choice%%$'\t'*}
else
    # No fzf (shouldn't happen on PowOS) → newest DETACHED session, else shell.
    name=$(tmux list-sessions -F '#{session_attached} #{session_name}' 2>/dev/null \
             | awk '$1==0{$1="";sub(/^ /,"");print}' | head -n1)
fi

# In switch mode nothing is exec'd: we retarget the current client and return,
# which closes the popup and leaves you in the chosen session.
if [ -n "${POWOS_TMUX_SWITCH:-}" ]; then
    case "$name" in
        "" | "$POWOS_TMUX_SHELL" | "$POWOS_TMUX_CONSOLE")
            exit 0 ;;                       # Esc / a hidden row: just close
        "$POWOS_TMUX_NEW")
            printf 'name for new session (blank = auto): ' >&2
            read -r sname
            if [ -n "$sname" ]; then tmux new-session -d -s "$sname" 2>/dev/null
            else sname=$(tmux new-session -dP -F '#{session_name}' 2>/dev/null); fi
            [ -n "$sname" ] && tmux switch-client -t "$sname" 2>/dev/null
            exit 0 ;;
        *)
            tmux has-session -t "$name" 2>/dev/null && tmux switch-client -t "$name"
            exit 0 ;;
    esac
fi

case "$name" in
    "" | "$POWOS_TMUX_SHELL")
        exec_shell ;;
    "$POWOS_TMUX_CONSOLE")
        # console attaches its own session; if it bails (e.g. nothing to show)
        # fall back rather than leaving the terminal with no shell.
        exec "${POWOS_BIN:-powos}" console || exec_shell ;;
    "$POWOS_TMUX_NEW")
        printf 'name for new session (blank = auto): ' >&2
        read -r sname
        [ -n "$sname" ] && exec tmux new-session -s "$sname"
        exec tmux new-session ;;
    *)
        # The pick may have just been killed with Del; attach only if it still
        # exists, otherwise fall back rather than dying on a stale name.
        tmux has-session -t "$name" 2>/dev/null && exec tmux attach-session -t "$name"
        exec_shell ;;
esac
