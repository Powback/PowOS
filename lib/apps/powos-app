def cmd_list():
    ok, out = sql(REGISTRY, "SELECT id, name, version, database, tier FROM app")
    if not ok:
        die(f"no registry on {SERVER} ({out.strip()[:200]})")
    print(out)
    ok, out = sql(REGISTRY, "SELECT key, kind, entry, size FROM widget")
    print(out)


def cmd_remove(app_id, data):
    ok, out = sql(REGISTRY, f"SELECT database FROM app WHERE id = '{app_id}'")
    spacetime("call", "-s", SERVER, REGISTRY, "remove", json.dumps(app_id), quiet=True)
    shutil.rmtree(os.path.join(APPS, app_id), ignore_errors=True)
    if data:
        lines = [x.strip() for x in out.splitlines() if x.strip() and not x.startswith(("-", " database"))]
        db = lines[-1].strip('"') if lines else ""
        if db and db != "database":
            spacetime("delete", "-s", SERVER, db, "-y", check=False)
    u = units()
    if u is not None:
        u.unregister(app_id, quiet=True)
    print(f"removed {app_id}")


def runtime(*args):
    os.execvp("powos-runtime", ["powos-runtime", *args])


def take_note(a):
    """--note TEXT (or --note-b64, from scripts through layers of shell quoting) out of the arguments."""
    import base64

    note = None
    for flag in ("--note", "--note-b64"):
        while flag in a:
            i = a.index(flag)
            if i + 1 >= len(a):
                die(f"{flag} needs a value")
            v = a[i + 1]
            note = base64.b64decode(v).decode() if flag == "--note-b64" else v
            a = a[:i] + a[i + 2 :]
    return a, note


def deployed(verb, d, note):
    """The phone's quiet "update applied" notification (shade only, deploys within 2 min batched into one:
    targets/android/tools/deploy-note.sh): the note, else a plain default. Best effort, never fatal."""
    if not note:
        try:
            name = manifest(d)[0].get("name") or os.path.basename(os.path.abspath(d))
        except BaseException:
            name = os.path.basename(os.path.abspath(d))
        note = f"{name} app installed" if verb == "install" else f"{name} app updated"
    try:
        subprocess.run(["powos", "comms", "notify", "--from", "deploy", "--priority", "low", "--batch", "deploy", "--", note],
                       timeout=15, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def cmd_preview(a):
    """powos app preview: shell/dev/preview.sh for one app's widgets, one OWL file, or a widget id."""
    if not a:
        die("usage: powos app preview <dir|file.owl|widget-id> [--live] [--out D]")
    tool = os.environ.get("POWOS_PREVIEW") or os.path.join(LIB, "..", "..", "shell", "dev", "preview.sh")
    if not os.path.isfile(tool):
        die(f"no widget preview here ({tool}): it runs from a PowOS checkout where docker is - POWOS_PREVIEW=<preview.sh>")
    if not shutil.which("docker"):
        die("the widget preview needs docker (a headless Chromium and the OWL engine run in containers)")
    what, rest = a[0], a[1:]
    target = os.path.abspath(os.path.expanduser(what))
    args = []
    if os.path.isdir(target) and os.path.isfile(os.path.join(target, "powos-app.json")):
        m, _ = manifest(target)
        if not os.path.isdir(os.path.join(target, "out", "ui")):
            cmd_build(target, ["--ui"])
        args = ["--no-defaults", "--app", target, "--only", "^" + re.escape(m["id"]) + r"\."]
        if "--out" not in rest:
            args += ["--out", os.path.join(target, "out", "preview")]
    elif target.endswith(".owl") and os.path.isfile(target):
        name = os.path.basename(target)[: -len(".owl")]
        args = ["--no-defaults", "--owl", target, "--only", "^" + re.escape(name) + "$"]
    else:
        args = ["--only", "^" + re.escape(what) + r"(\.|$)"]
    os.execvp("bash", ["bash", tool, *args, *rest])


def main(a):
    a, note = take_note(a)
    dispatch(a)
    if len(a) == 2 and a[0] in ("install", "publish", "ui"):
        deployed(a[0], a[1], note)


def dispatch(a):
    if not a or a[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    c = a[0]
    # A directory argument as an absolute path: the build runs its tools in other directories (bun in ui/), where a
    # relative "." meant something else - `powos app install .` bundled into ui/out/ and installed no page.
    if c in ("build", "install", "dev", "publish", "ui") and len(a) >= 2:
        a = [c, os.path.abspath(os.path.expanduser(a[1])), *a[2:]]
    if c == "list":
        cmd_list()
    elif c == "new":
        cmd_new(a[1:])
    elif c == "build" and len(a) >= 2:
        cmd_build(a[1], a[2:])
    elif c == "install" and len(a) == 2:
        cmd_install(a[1])
    elif c == "dev" and len(a) == 2:
        try:
            cmd_dev(a[1])
        except KeyboardInterrupt:
            pass
    elif c == "builder":
        cmd_builder(a[1:])
    elif c == "publish" and len(a) == 2:
        # Built first, as install does: an unchanged module isn't rebuilt, an edited one is - never the stale wasm.
        cmd_build(a[1], ["--module"])
        m, _ = manifest(a[1])
        publish_module(a[1], m)
    elif c == "ui" and len(a) == 2:
        # Built first (~0.1 s), as install does: it shipped the stale out/ui ("0 files changed") after an edit.
        cmd_build(a[1], ["--ui"])
        m, text = manifest(a[1])
        n = install_ui(a[1], m)
        register(text)
        log(f"{m['id']}: UI {m['version']} in place" + (f" ({n} files changed)" if n >= 0 else ""))
    elif c == "preview":
        cmd_preview(a[1:])
    elif c == "remove" and len(a) >= 2:
        cmd_remove(a[1], "--data" in a)
    elif c == "runtime":
        if len(a) == 1:
            runtime("check")
        elif len(a) == 2:
            runtime("mode", a[1])
        else:
            runtime("config", a[2], "--app", a[1])
    elif c == "services":
        os.execvp("powos-supervisor", ["powos-supervisor", "status", *a[1:]])
    elif c == "check":
        runtime("check")
    else:
        die(f"unknown: {' '.join(a)} (powos app help)")


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except Fail as e:
        print(f"powos app: {e}", file=sys.stderr)
        sys.exit(1)
