SAMPLE = 5  # seconds of CPU/IO measured before freezing
# The desktop shell (plasmashell) while PowOS is off screen (phone): frozen this long after PowOS went off screen
# ("off": never), thawed the moment it's back, and for DESKTOP_DRAIN s every DESKTOP_AWAKE s meanwhile - long enough
