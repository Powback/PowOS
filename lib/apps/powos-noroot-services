#!/usr/bin/env python3
"""powos-noroot-services - PowOS's system services on a phone WITHOUT root: SpacetimeDB (127.0.0.1:3410) and the App
API runtime (127.0.0.1:3411), started inside the PowOS Linux image the engine installed (lotfix, no proot), and the
APK's own apps' modules published to it (docs/research/nonroot-parity.md #2).

On a rooted phone powos-start.sh runs powos-supervisor as root in PowOS's own mount namespace; without root there is
no root, no `powos` user and no namespace, so the launcher (linux/EngineServices.kt) runs this - shipped in the APK,
the same version as it - through EngineGuest each time the PowOS image is ready and SpacetimeDB doesn't answer.
Their "TCP" ports are private Unix sockets here (the launcher's loopback-unix.c preload, docs/research/nonroot-parity.md
"Who can reach SpacetimeDB and the App API"): 127.0.0.1:3410 below works only for PowOS's own uid.
It reads the same service manifests (/usr/lib/powos/apps/services/<id>.json: exec, data, prepare, env) and starts
each one that isn't listening, detached, logging to /var/log/powos/<id>.log. Idempotent: a service already listening
is left alone.
Then the Agents view's reporter (units/phone/agentsd.json), as powos-deploy.sh sets it up on a rooted phone: the claude
hooks in the image's Claude settings (install-hooks.py, once - only when they aren't there) and powos-agentsd, which
writes the spool the launcher's Agents widget reads (XDG_RUNTIME_DIR/agents = the app's files/run/agents,
AgentsSpool.kt). It exits after 10 idle minutes; the hooks start it again with each claude.

HACK: no budgets, restarts or idle unload here (powos-supervisor's job): the supervisor needs root (STATE in /run,
user switches through powos-runtime). Real fix: powos-supervisor gets a no-root mode (its own uid, no user switch,
state under XDG_RUNTIME_DIR) and the launcher runs that instead; then this goes.

  powos-noroot-services [BUNDLED_DIR]   BUNDLED_DIR: <database>.wasm files to publish (the APK's apps' modules)
"""
import hashlib
import json
import os
import shutil
import socket
import subprocess
import sys
import time
import urllib.request

SERVICES = os.environ.get("POWOS_SERVICES", "/usr/lib/powos/apps/services")
STDB = "http://127.0.0.1:3410"
LOGS = os.environ.get("POWOS_LOGS", "/var/log/powos")
# Which services, in order: SpacetimeDB first (the apps' modules publish to it).
WANTED = ("spacetimedb", "app-api")
# The App API's files where the rooted deploy puts them, else the image's baked source tree (lib/self-phone.sh).
FALLBACK = {"/usr/lib/powos/app-api/appcap_serve.py": "/usr/lib/powos/src/tools/app-api/appcap_serve.py"}


def listening(addr, timeout=0.3):
    host, port = addr.rsplit(":", 1)
    try:
        socket.create_connection((host, int(port)), timeout).close()
        return True
    except OSError:
        return False


# HACK: under the no-root engine (fakechroot, FAKECHROOT_BASE set) SpacetimeDB's data lives in the app's run dir, not
# /var/lib/powos/stdb: its atomic writes (config.toml, metadata.toml: tempfile + rename) are raw renameat syscalls from
# Rust's tempfile/rustix, which bypass fakechroot's LD_PRELOAD path rewrite, so the kernel gets the in-image path and
# says ENOENT; the server never came up (razr ISSUES 11-14). XDG_RUNTIME_DIR (the app's files/run) is in
# FAKECHROOT_EXCLUDE_PATH, so there the image's path and the kernel's are the same and raw syscalls work; files/run
# survives app restarts. Real fix: the engine translates raw path syscalls too (a seccomp trap on the *at calls), then
# every service keeps its manifest's data dir.
NOROOT_DATA = {"dev.powos.spacetimedb": "stdb"}
# Where the 11-14 on-device hack put the data (`--data-dir $XDG_RUNTIME_DIR/stdb-data`): moved into the new place once.
NOROOT_LEGACY = {"dev.powos.spacetimedb": {"stdb-data": "data"}}


def noroot():
    return bool(os.environ.get("FAKECHROOT_BASE"))


def data_dir(manifest):
    """The service's data dir: the manifest's, or under a no-root engine the run-dir one (NOROOT_DATA)."""
    b = manifest["backend"]
    data = b.get("data", "")
    run = os.environ.get("XDG_RUNTIME_DIR", "")
    if data and noroot() and manifest["id"] in NOROOT_DATA and run.startswith("/"):
        return os.path.join(run, NOROOT_DATA[manifest["id"]])
    return data


def _empty(path):
    return not os.path.lexists(path) or (os.path.isdir(path) and not os.path.islink(path) and not os.listdir(path))


def migrate(manifest, data):
    """Moves what an earlier start left in the manifest's data dir (keys, data, publish stamps) and in the on-device
    hack's dir (NOROOT_LEGACY) into [data], once: an entry moves only when [data] has none (or an empty one) - never
    over data. Only called when the service isn't listening, so nothing is writing there."""
    old = manifest["backend"].get("data", "")
    if not old or os.path.abspath(old) == os.path.abspath(data):
        return []
    os.makedirs(data, exist_ok=True)
    run = os.environ.get("XDG_RUNTIME_DIR", "")
    moves = [(os.path.join(run, a), os.path.join(data, b)) for a, b in NOROOT_LEGACY.get(manifest["id"], {}).items()]
    if os.path.isdir(old):
        moves += [(os.path.join(old, e), os.path.join(data, e)) for e in sorted(os.listdir(old))]
    out = []
    for src, dst in moves:
        if _empty(src):
            continue
        if not _empty(dst):
            out.append(f"{manifest['id']}: kept {src} ({dst} has data)")
            continue
        if os.path.isdir(dst) and not os.path.islink(dst):
            os.rmdir(dst)
        shutil.move(src, dst)
        out.append(f"{manifest['id']}: moved {src} -> {dst}")
    for src, _ in moves:  # emptied leftovers (an old run's empty data/), then the old dir itself
        if os.path.isdir(src) and _empty(src):
            os.rmdir(src)
    if os.path.isdir(old) and _empty(old):
        os.rmdir(old)
    return out


def command(manifest, data=None):
    """The service's exec with ${data} filled in, its program found (FALLBACK), or None when the image hasn't it."""
    b = manifest["backend"]
    data = b.get("data", "") if data is None else data
    run = os.environ.get("XDG_RUNTIME_DIR", "")
    # An image still carrying the on-device hack (a literal --data-dir in the run dir) gets the migrated place.
    legacy = {os.path.join(run, a): os.path.join(data, b2) for a, b2 in NOROOT_LEGACY.get(manifest["id"], {}).items()} \
        if run.startswith("/") and data != b.get("data", "") else {}
    exe = [legacy.get(x, x.replace("${data}", data)) for x in b["exec"]]
    exe = [FALLBACK.get(x, x) if not os.path.exists(x) else x for x in exe]
    return exe if all(os.path.exists(x) for x in exe if x.startswith("/usr/")) else None


def start(name):
    path = os.path.join(SERVICES, f"{name}.json")
    if not os.path.exists(path):
        return f"{name}: no manifest ({path})"
    m = json.load(open(path))
    listen = m.get("needs", {}).get("listen", [])
    if listen and listening(listen[0]):
        return f"{m['id']}: up"
    data = data_dir(m)
    exe = command(m, data)
    if not exe:
        return f"{m['id']}: not in this image"
    b = m["backend"]
    if data:
        for line in migrate(m, data):
            print(line, flush=True)
        os.makedirs(data, exist_ok=True)
        for step in b.get("prepare", []):
            subprocess.run(["sh", "-c", step], cwd=data, check=False)
    env = dict(os.environ)
    env.update(b.get("env", {}))
    env.update(m.get("budget", {}).get("phone", {}).get("env", {}))
    if not os.path.isdir(env.get("HOME", "/")):
        env["HOME"] = os.environ.get("HOME", "/root")
    os.makedirs(LOGS, exist_ok=True)
    log = open(os.path.join(LOGS, f"{m['id']}.log"), "ab")
    subprocess.Popen(exe, cwd=data or "/", env=env, stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)
    return f"{m['id']}: started"


def exists(db):
    try:
        with urllib.request.urlopen(f"{STDB}/v1/database/{db}", timeout=2) as r:
            return r.status == 200
    except OSError:
        return False


CLI_TOML = os.path.join("~", ".config", "spacetime", "cli.toml")
SERVER_NAME = "powos"


def cli_token():
    try:
        with open(os.path.expanduser(CLI_TOML)) as f:
            for line in f:
                k, _, v = line.partition("=")
                if k.strip() == "spacetimedb_token" and v.strip().strip('"'):
                    return v.strip().strip('"')
    except OSError:
        pass
    return None


def identity():
    """The device owner's CLI identity (~/.config/spacetime/cli.toml), made by THIS server before anything publishes:
    without it the first `spacetime publish` mints an anonymous one, a later `spacetime login` replaces it, and the
    registry's owner is lost for good - every `powos app install` refused (razr ISSUES 11-14). Once: an identity that
    is there is kept. None when there is one, else why not."""
    if cli_token():
        return None
    subprocess.run(["spacetime", "server", "add", "--url", STDB, SERVER_NAME, "--default", "--no-fingerprint"],
                   capture_output=True, text=True)  # fails when it's there already: fine, login names it
    r = subprocess.run(["spacetime", "login", "--server-issued-login", SERVER_NAME], capture_output=True, text=True)
    if cli_token():
        return None
    return f"no CLI identity ({CLI_TOML}): spacetime login: {(r.stdout + r.stderr).strip()[-300:] or f'rc {r.returncode}'}"


def stdb_data():
    """SpacetimeDB's data root here (data_dir: the run dir's under a no-root engine), for the publish stamps."""
    try:
        with open(os.path.join(SERVICES, "spacetimedb.json")) as f:
            return data_dir(json.load(f))
    except (OSError, ValueError, KeyError):
        return "/var/lib/powos/stdb"


def publish(bundled):
    """Each <database>.wasm the APK ships, published when it isn't the one last published from it (its sha), by the
    device owner's identity (identity(): made first, so the owner of the registry is the CLI's)."""
    for _ in range(60):
        if listening("127.0.0.1:3410"):
            break
        time.sleep(0.5)
    else:
        return ["publish: SpacetimeDB didn't come up"]
    why = identity()  # also with nothing to publish: `powos app install` then publishes as this owner
    if why:
        return [f"publish: not publishing, {why}"]
    if not bundled or not os.path.isdir(bundled):
        return []
    stamps = os.path.join(stdb_data(), "bundled")
    os.makedirs(stamps, exist_ok=True)
    out = []
    for f in sorted(os.listdir(bundled)):
        if not f.endswith(".wasm"):
            continue
        db, wasm = f[: -len(".wasm")], os.path.join(bundled, f)
        sha = hashlib.sha256(open(wasm, "rb").read()).hexdigest()
        stamp = os.path.join(stamps, f"{db}.sha")
        same = os.path.exists(stamp) and open(stamp).read().strip() == sha
        if same and exists(db):
            continue
        r = subprocess.run(["spacetime", "publish", "-y", "-s", STDB, "--bin-path", wasm, db], capture_output=True, text=True)
        if r.returncode == 0:
            open(stamp, "w").write(sha)
            out.append(f"{db}: published")
        else:
            out.append(f"{db}: publish failed: {(r.stdout + r.stderr).strip()[-300:]}")
    return out


AGENTS = os.environ.get("POWOS_AGENTS_LIB", "/usr/lib/powos/ai/agents")


def claude_home():
    """The image's Claude home: $HOME, else root's (no root: one uid, claude runs as the image's root)."""
    h = os.environ.get("HOME", "")
    return h if h not in ("", "/") and os.path.isdir(h) else "/root"


def agents():
    """The claude hooks in the image's Claude settings (when missing) and powos-agentsd started (its lock: one runs)."""
    if not os.path.exists(os.path.join(AGENTS, "powos-agentsd")):
        return ["agentsd: not in this image"]
    out = []
    settings = os.path.join(claude_home(), ".claude", "settings.json")
    try:
        have = "powos-agent-hook" in open(settings).read()
    except OSError:
        have = False
    if not have:
        os.makedirs(os.path.dirname(settings), exist_ok=True)
        r = subprocess.run(["python3", os.path.join(AGENTS, "install-hooks.py"), settings,
                            "--command", f"POWOS_AGENTS_HOST=phone {AGENTS}/powos-agent-hook",
                            "--ask", f"POWOS_AGENTS_HOST=phone {AGENTS}/powos-agent-ask",
                            "--backup", settings + ".bak-agents-view"], capture_output=True, text=True)
        out.append("agents hooks: installed" if r.returncode == 0 else f"agents hooks: failed: {(r.stdout + r.stderr).strip()[-300:]}")
    env = dict(os.environ, POWOS_AGENTS_HOST="phone", HOME=claude_home())
    os.makedirs(LOGS, exist_ok=True)
    log = open(os.path.join(LOGS, "agentsd.log"), "ab")
    subprocess.Popen(["python3", os.path.join(AGENTS, "powos-agentsd")], env=env, stdin=subprocess.DEVNULL,
                     stdout=log, stderr=log, start_new_session=True)
    return out + ["agentsd: started"]


def main():
    for line in [start(s) for s in WANTED] + agents() + publish(sys.argv[1] if len(sys.argv) > 1 else ""):
        print(line, flush=True)


if __name__ == "__main__":
    main()
