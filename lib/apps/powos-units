# ── check ───────────────────────────────────────────────────────────────────

def drift(units=None):
    units = load() if units is None else units
    pm = package_manager()
    scope = SCOPE.get(HOST, (HOST,))
    mine = [u for u in units if u.get("host", HOST) in scope]
    out = {"host": HOST, "packages": [], "files": [], "processes": [], "unbounded": [], "missing": [],
           "containers": [], "orphans": [u["id"] for u in mine if u.get("orphan")]}
    claimed_pkgs = {p for u in mine for p in u["packages"]}
    for name, when in sorted(installed_packages(pm).items()):
        if name not in claimed_pkgs:
            out["packages"].append({"name": name, "installed": time.strftime("%Y-%m-%d", time.localtime(when))
                                    if when else "?"})
    owned = package_files(pm) if WATCH.get(HOST) else set()
    for p in watched_paths(HOST):
        if ignored(p) or p in owned or claimed(mine, p):
            continue
        try:
            t = os.lstat(p).st_mtime
        except OSError:
            continue
        out["files"].append({"path": p, "changed": time.strftime("%Y-%m-%d", time.localtime(t))})
    table = proc_table()
    by_id = {u["id"]: u for u in mine}
    taken = {pid: by_id[uid] for pid, uid in owners(mine, table).items()}
    # The check itself and whatever is asking for it (the shell or timer that ran it: root.sh's bash, a publish
    # pass) are never drift - their own units, if any, answer for them elsewhere.
    me = descendants(os.getpid(), table) | ancestors(os.getpid(), table) | {os.getpid()}
    for pid, p in sorted(table.items()):
        if pid in me or not in_scope(p, HOST):
            continue
        u = taken.get(pid)
        if not u:
            out["processes"].append({"pid": pid, "cmd": p["cmd"][:160], "memKB": p["rss"]})
        elif u.get("limits") and not in_group(p, u["id"], u):
            out["unbounded"].append({"unit": u["id"], "pid": pid, "cmd": p["cmd"][:100]})
    for u in mine:
        if u.get("host") == "powstation":
            continue
        # "ondemand": installed only while it's used (the App API's capture units: absent is their resting state)
        if u.get("ondemand"):
            continue
        if u["files"] and not expand_files(u) and not u["packages"] and not u["processes"]:
            out["missing"].append(u["id"])
    if "powstation" in scope:
        for c in docker_containers() or []:
            if not c["project"] and not container_unit(mine, c):
                out["containers"].append({"name": c["name"], "state": c["state"], "image": c["image"][:40],
                                          "created": c["created"][:10]})
    return out


def cmd_check(args):
    d = drift()
    n = sum(len(d[k]) for k in ("packages", "files", "processes", "containers"))
    if "--json" in args:
        print(json.dumps(d, indent=2))
        return 1 if n else 0
    print(f"{HOST}: {'no drift' if not n else f'{n} unregistered'} ({UNITS_DIR})")
    sections = (("packages", "packages no unit lists", lambda x: f"{x['name']}  (installed {x['installed']})"),
                ("files", "files outside every package and unit", lambda x: f"{x['path']}  ({x['changed']})"),
                ("processes", "processes no unit claims", lambda x: f"{x['pid']:<7} {mb(x['memKB']):>6}  {x['cmd']}"),
                ("containers", "containers with no compose project and no unit",
                 lambda x: f"{x['name']}  {x['state']}  {x['image']}  ({x['created']})"),
                ("unbounded", "a unit's processes outside its cgroup (powos units enforce)",
                 lambda x: f"{x['unit']}: pid {x['pid']}  {x['cmd']}"),
                ("missing", "units whose files are all gone (powos units unregister?)", str),
                ("orphans", "orphans: registered, no clear owner - yours to decide", str))
    for key, title, fmt in sections:
        if d[key]:
            print(f"\n{title} ({len(d[key])}):")
            for x in d[key][:200]:
                print(f"  {fmt(x)}")
    if n:
        print("\nEach one: register it (powos units register), or remove it; dependencies belong inside an app or a "
              "container (capabilities.md, Units).")
    return 1 if n else 0


# ── remove ──────────────────────────────────────────────────────────────────

def plan_remove(u, units):
    others = [x for x in units if x["id"] != u["id"]]
    shared_pkgs = {p for x in others for p in x["packages"]}
    pm = package_manager()
    owned = package_files(pm) if u["files"] else set()
    keep = [os.path.expanduser(k) for k in u["remove"].get("keep", [])]
    table = proc_table()
    # Never ourselves or the shell that runs us: a `match` regex can match the command line that invoked remove
    # (it did: `powos units remove ...; pgrep -f '<the pattern>'` in one shell got that shell SIGTERMed mid-remove).
    pids = sorted(unit_pids(u, table, owners(units, table)) - ancestors(os.getpid(), table)
                  - descendants(os.getpid(), table))
    steps = []
    for c in u["remove"].get("stop", []):
        steps.append(("stop", c))
    if pids and not u["remove"].get("stop"):
        steps.append(("kill", pids))
    pkgs = [p for p in u["packages"] if p not in shared_pkgs]
    kept_pkgs = [p for p in u["packages"] if p in shared_pkgs]
    if pkgs:
        steps.append(("packages", remove_package_cmd(pm, pkgs)))
    files, kept = [], []
    magisk = {f"/data/adb/modules/{p}" for p in pkgs} if pm == "magisk" else set()
    for f in sorted(set(expand_files(u))):
        if any(claims(m, f) for m in magisk):
            kept.append(f"{f} (Magisk removes the module at the next boot)")
        elif any(claims(k, f) for k in keep) or f in owned or any(any(claims(g, f) for g in x["files"]) for x in others):
            kept.append(f)
        elif os.path.isdir(f) and not os.path.islink(f) and any(o.startswith(f + "/") for o in owned):
            kept.append(f"{f} (holds package files)")
        else:
            files.append(f)
    if files:
        steps.append(("files", files))
    for c in u["remove"].get("commands", []):
        steps.append(("command", c))
    steps.append(("manifest", u["_src"]))
    return steps, kept + [f"package {p} (another unit lists it)" for p in kept_pkgs] + keep


def cmd_remove(args):
    ids = [a for a in args if not a.startswith("--")]
    if not ids:
        die("usage: powos units remove <id> [--dry-run] [--yes]")
    units = load()
    u = find(units, ids[0])
    if not u:
        die(f"no unit {ids[0]} on {HOST}")
    steps, kept = plan_remove(u, units)
    print(f"Removing {u['id']} ({u['purpose']}) - the plan:")
    for i, (kind, what) in enumerate(steps, 1):
        if kind == "kill":
            print(f"  {i}. stop its processes: SIGTERM {' '.join(map(str, what))} (then SIGKILL after 5 s)")
        elif kind in ("stop", "command"):
            print(f"  {i}. run: {what}")
        elif kind == "packages":
            print(f"  {i}. uninstall: {' '.join(what)}")
        elif kind == "files":
            print(f"  {i}. delete {len(what)} file(s):")
            for f in what:
                print(f"       {f}")
        elif kind == "manifest":
            print(f"  {i}. forget the unit: {what}")
    for k in kept:
        print(f"  kept: {k}")
    if "--dry-run" in args:
        print("(dry run: nothing changed)")
        return 0
    if "--yes" not in args:
        if not sys.stdin.isatty():
            die("not removing without --yes (non-interactive)")
        if input(f"Type {u['id']} to remove it: ").strip() != u["id"]:
            die("not removed")
    for kind, what in steps:
        if kind == "kill":
            table = proc_table()
            cmds = {p: (table.get(p) or {}).get("cmd") for p in what}
            for p in what:
                try:
                    os.kill(p, signal.SIGTERM)
                except OSError:
                    pass
            time.sleep(5)
            now = proc_table()
            for p in what:  # only what is still there and still the same process (not a reused pid)
                if p in now and now[p]["cmd"] == cmds[p]:
                    try:
                        os.kill(p, signal.SIGKILL)
                    except OSError:
                        pass
        elif kind in ("stop", "command"):
            subprocess.run(["/bin/sh", "-c", what], check=False)
        elif kind == "packages":
            subprocess.run(what, check=False)
        elif kind == "files":
            for f in what:
                if os.path.isdir(f) and not os.path.islink(f):
                    shutil.rmtree(f, ignore_errors=True)
                else:
                    try:
                        os.remove(f)
                    except OSError as e:
                        print(f"  {f}: {e}", file=sys.stderr)
        elif kind == "manifest" and os.path.exists(what):
            os.remove(what)
    print(f"removed {u['id']}")
    return 0


# ── limits: a cgroup per long-running unit ──────────────────────────────────

_PC = None


def container_module():
    """powos-container: its hybrid cgroups (Android's v1 memcg/cpuctl/cpuset + v2 pids) are the phone's limits."""
    global _PC
    if _PC is None:
        p = os.path.join(HERE, "powos-container")
        loader = SourceFileLoader("powos_container", p)
        m = module_from_spec(spec_from_loader("powos_container", loader))
        loader.exec_module(m)
        _PC = m
    return _PC


def limits_of(lim):
    pc = container_module()
    out = {}
    if lim.get("memory"):
        out["mem"] = pc.size(lim["memory"])
        out["memsw"] = pc.size(lim["memory_swap"]) if lim.get("memory_swap") else -1
    if lim.get("cpus"):
        out["cpus"] = str(lim["cpus"])
    if lim.get("cpuset"):
        out["cpuset"] = str(lim["cpuset"])
    if lim.get("pids"):
        out["pids"] = int(lim["pids"])
    return out


def place(uid, pids, lim):
    """Put pids into the unit's own cgroup with its limits. Returns what was enforced (or why nothing was).
    The API powos-runtime and the supervisor use; fails closed only on a write to a controller that exists."""
    if not lim:
        return []
    if sys.platform == "darwin":
        return ["none: macOS has no cgroups"]
    if HOST in ("phone", "phone-android") or os.path.isdir("/dev/memcg"):
        pc = container_module()
        done = pc.apply(group_name(uid), limits_of(lim), pid=pids[0]) if pids else []
        for pid in pids[1:]:
            pc.apply(group_name(uid), limits_of(lim), pid=pid)
        return done
    return place_v2(uid, pids, lim)


def place_v2(uid, pids, lim):
    base = "/sys/fs/cgroup/powos-units"
    g = f"{base}/{uid}"
    try:
        os.makedirs(g, exist_ok=True)
        ctl = rd(f"{base}/cgroup.controllers").split()
        want = [c for c in ("memory", "cpu", "pids") if c in ctl]
        with open(f"{base}/../cgroup.subtree_control", "w") as f:
            f.write(" ".join(f"+{c}" for c in want))
    except OSError as e:
        return [f"none: no writable cgroup v2 ({e})"]
    done = []
    pc = container_module()
    wr = [("memory.max", pc.size(lim["memory"])) if lim.get("memory") else None,
          ("cpu.max", f"{int(float(lim['cpus']) * 100000)} 100000") if lim.get("cpus") else None,
          ("pids.max", lim["pids"]) if lim.get("pids") else None]
    for w in filter(None, wr):
        try:
            with open(f"{g}/{w[0]}", "w") as f:
                f.write(str(w[1]))
            done.append(f"{w[0]}={w[1]}")
        except OSError:
            pass
    for pid in pids:
        try:
            with open(f"{g}/cgroup.procs", "w") as f:
                f.write(str(pid))
        except OSError:
            pass
    return done


def cmd_enforce(args):
    units = load()
    table = proc_table()
    todo = [find(units, a) for a in args] if args else units
    if None in todo:
        die(f"no such unit: {args}")
    own = owners([u for u in units if u.get("host", HOST) in SCOPE.get(HOST, (HOST,))], table)
    n = 0
    for u in todo:
        if not u.get("limits"):
            continue
        if u.get("cgroups"):  # it manages its own cgroups (powos-sleepd): reported by check, never moved here
            continue
        pids = sorted(p for p in unit_pids(u, table, own) if not in_group(table[p], u["id"], u))
        if not pids:
            continue
        # Only the top of each tree: its children follow it on the next fork, the running ones are moved too.
        try:
            done = place(u["id"], pids, u["limits"])
        except OSError as e:
            print(f"  {u['id']}: {e}", file=sys.stderr)
            continue
        n += 1
        print(f"  {u['id']}: {len(pids)} process(es) -> {group_name(u['id'])}: {', '.join(done) or 'nothing enforceable'}")
    print(f"{n} unit(s) placed" if n else "every running unit with limits is in its cgroup")
    delegate(todo)
    return 0


def unit_groups(uid):
    """Every cgroup directory the unit's group has on this host (the phone's hybrid ones, else cgroup v2's)."""
    if sys.platform == "darwin":
        return []
    if HOST in ("phone", "phone-android") or os.path.isdir("/dev/memcg"):
        return list(container_module().groups(group_name(uid)).values())
    return [f"/sys/fs/cgroup/powos-units/{uid}"]


def delegate(units):
    """A unit with "enter": "<user>" is started by that user, not by root (the manager's claude starts the sandbox's
    MCP server as powos): its groups are made now, with its limits, and their cgroup.procs given to that user, so
    `powos units enter <id>` puts the process there itself at start (cgroup v1 lets the owner of cgroup.procs move its
    own processes in; where v2 refuses that, the v1 groups that carry the limits still take it)."""
    if os.getuid() != 0:
        return
    for u in units:
        who = u.get("enter")
        if not who or not u.get("limits") or u.get("host", HOST) != HOST:
            continue
        try:
            if HOST in ("phone", "phone-android") or os.path.isdir("/dev/memcg"):
                container_module().apply(group_name(u["id"]), limits_of(u["limits"]))
            else:
                place_v2(u["id"], [], u["limits"])
        except OSError as e:
            print(f"  {u['id']}: delegate: {e}", file=sys.stderr)
        uid = user_id(who)
        for g in unit_groups(u["id"]):
            try:
                os.chown(f"{g}/cgroup.procs", uid, -1)
            except OSError:
                pass


def cmd_enter(args):
    """powos units enter <id> [-- cmd...]: this process into the unit's cgroup (root: made with its limits; another
    user: the groups enforce delegated to it), then exec cmd. Never fatal: a launch must not fail on its cgroup."""
    if not args:
        die("usage: powos units enter <id> [-- cmd ...]")
    uid, cmd = args[0], args[args.index("--") + 1:] if "--" in args else args[1:]
    if os.getuid() == 0:
        u = next((x for x in load() if x["id"] == uid), None)
        if u and u.get("limits"):
            try:
                place(uid, [os.getpid()], u["limits"])
            except OSError as e:
                print(f"powos units enter {uid}: {e}", file=sys.stderr)
    else:
        for g in unit_groups(uid):
            try:
                with open(f"{g}/cgroup.procs", "w") as f:
                    f.write(str(os.getpid()))
            except OSError:
                pass
    if cmd:
        os.execvp(cmd[0], cmd)
    return 0


# ── baseline ────────────────────────────────────────────────────────────────

def cmd_baseline(args):
    ids = [a for a in args if not a.startswith("--")]
    opts = {a: b for a, b in zip(args, args[1:]) if a.startswith("--")}
    before = opts.get("--before")
    if not ids or not before:
        die("usage: powos units baseline <id> --before YYYY-MM-DD [--owner O] [--purpose P]")
    for v in opts.values():
        ids = [i for i in ids if i != v]
    cut = time.mktime(time.strptime(before, "%Y-%m-%d"))
    units = load()
    pkgs = installed_packages(package_manager())
    keep = sorted(n for n, t in pkgs.items() if not t or t < cut)
    files = []
    for p in watched_paths(HOST):
        try:
            old = os.lstat(p).st_mtime < cut
        except OSError:
            continue
        if old and not ignored(p) and not claimed(units, p):
            files.append(p)
    procs = []
    if shutil.which("systemctl") and HOST not in ("phone", "phone-android"):
        out = run("systemctl", "list-units", "--type=service", "--state=running", "--no-legend", "--plain")
        procs = [{"systemd": l.split()[0]} for l in out.splitlines() if l.strip()]
        procs += [{"systemd": "init.scope"}, {"systemd": "user.slice"}]
    u = {"id": ids[0], "name": opts.get("--name", ids[0]), "kind": "system", "host": HOST,
         "owner": opts.get("--owner", "system:image"),
         "purpose": opts.get("--purpose", f"what this host had before {before} (adopted by powos units baseline)"),
         "packages": keep, "files": sorted(files), "processes": procs, "baseline": before,
         "unbounded": "the host's own base system"}
    register(u)
    print(f"{len(keep)} package(s), {len(files)} file(s), {len(procs)} service(s) adopted; "
          f"{len(pkgs) - len(keep)} later package(s) stay for check to show")
    return 0


# ── publish (the PowOS AI page) ─────────────────────────────────────────────

ROW_KEYS = ("id", "name", "kind", "owner", "purpose", "status", "memKB", "cpuPct", "limits", "autosleep", "orphan",
            "decide", "host")


def check_counts(d):
    return {k: len(d[k]) for k in ("packages", "files", "processes", "containers", "unbounded", "missing")}


def overview(with_check=True):
    """This host's units and its drift counts: what list --json --check prints and publish sends."""
    rows = snapshot()
    out = {"host": HOST, "at": int(time.time()), "units": rows}
    if with_check:
        out["check"] = check_counts(drift())
    return out


def cmd_publish(args):
    """The rows for the PowOS AI page, one sync per host (the Mac's view carries PowStation's containers as host
    "powstation"). --stdin: another host's `powos units list --json --check` (the Colima VM's), published from here."""
    ov = json.load(sys.stdin) if "--stdin" in args else overview()
    # --failed REASON (with --stdin: the host's last good snapshot, or {"host": H, "units": []}): its publisher ran but
    # couldn't read the host - the rows stay as last seen and its _check row says "stale" with why, never a silent age.
    failed = args[args.index("--failed") + 1] if "--failed" in args and args.index("--failed") + 1 < len(args) else ""
    n = ov.get("check") or {}
    by_host = {}
    for r in ov["units"]:
        row = {k: (r.get(k) or ("" if k not in ("memKB", "cpuPct", "orphan") else 0)) for k in ROW_KEYS}
        row["purpose"], row["orphan"] = row["purpose"][:200], bool(row["orphan"])
        by_host.setdefault(row["host"] or ov["host"], []).append(row)
    by_host.setdefault(ov["host"], [])
    code = 0
    for host, rows in sorted(by_host.items()):
        keys = ("containers",) if host == "powstation" else ("packages", "files", "processes", "unbounded")
        counts = {k: n.get(k, 0) for k in keys}
        drifted = any(counts.get(k) for k in ("packages", "files", "processes", "containers"))
        purpose = ", ".join(f"{v} {k}" for k, v in counts.items() if v) or "no drift"
        status = "drift" if drifted else "clean"
        if failed:
            seen = time.strftime("%Y-%m-%d %H:%M", time.localtime(ov["at"])) if ov.get("at") else "never"
            purpose, status = f"publish failed: {failed[:180]} (rows as of {seen})", "stale"
        rows.append({"id": "_check", "name": "check", "kind": "system", "owner": "", "host": host,
                     "purpose": purpose, "status": status, "memKB": 0, "cpuPct": 0, "limits": "",
                     "autosleep": "", "orphan": False, "decide": ""})
        code = sync_rows(host, rows) or code
    return code


def sync_rows(host, rows):
    """One host's rows to the powos-agents module's `unit` table, through the work board's CLI."""
    import base64
    payload = json.dumps({"host": host, "units": rows}, separators=(",", ":"))
    b64 = base64.b64encode(payload.encode()).decode()
    if HOST in ("phone", "phone-android") and os.getuid() == 0:
        # The snapshot needs root (every process's /proc); the board's writer is the PowOS user's CLI identity.
        run_as = ["/usr/bin/setpriv", "--reuid=powos", "--regid=powos", "--init-groups", "/usr/bin/env", "-i",
                  "PATH=/usr/bin:/usr/sbin", "HOME=/home/powos", "python3",
                  "/usr/lib/powos/ai/agents/powos-agents-cli", "units", "sync", b64]
        cmd = (["chroot", "/data/powos/root"] + run_as) if HOST == "phone-android" else run_as
    else:
        cli = os.environ.get("POWOS_AGENTS_CLI") or next(
            (p for p in (os.path.join(HERE, "..", "ai", "agents", "powos-agents-cli"),
                         "/usr/lib/powos/ai/agents/powos-agents-cli") if os.path.exists(p)), None)
        if not cli:
            die("no powos-agents-cli here")
        cmd = [sys.executable, cli, "units", "sync", b64]
    r = subprocess.run(cmd)
    if r.returncode == 0:
        print(f"published {len(rows) - 1} unit(s) of {host}")
    return r.returncode


# ── main ────────────────────────────────────────────────────────────────────

def cmd_register(args):
    if not args:
        die("usage: powos units register <manifest.json|->")
    src = sys.stdin.read() if args[0] == "-" else open(args[0]).read()
    try:
        u = json.loads(src)
    except ValueError as e:
        die(f"not JSON: {e}")
    try:
        register(u)
    except (ValueError, OSError) as e:
        die(str(e))
    return 0


def main(argv):
    verb, rest = (argv[0], argv[1:]) if argv else ("list", [])
    if verb.startswith("--") and verb not in ("--help", "-h"):
        verb, rest = "list", argv
    if verb in ("help", "--help", "-h"):
        print(__doc__.strip())
        return 0
    if verb not in COMMANDS:
        die(f"unknown: {verb} (powos units --help)")
    return COMMANDS[verb](rest) or 0


COMMANDS = {"list": cmd_list, "ls": cmd_list, "show": cmd_show, "check": cmd_check, "remove": cmd_remove,
            "rm": cmd_remove, "register": cmd_register, "enforce": cmd_enforce, "baseline": cmd_baseline,
            "publish": cmd_publish, "enter": cmd_enter,
            "unregister": lambda a: 0 if a and unregister(a[0]) else die(f"no unit {a[0] if a else '?'}")}


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except BrokenPipeError:
        sys.exit(0)
