def check_cmd(argv):
    verb = argv[0] if argv else "list"
    argv = argv[1:]
    if verb == "set":
        o, rest = opts(argv, ["name", "line", "need", "shipped", "at"])
        if len(rest) != 3:
            die("usage: powos agents check set <task> <job> <queued|running|PASS|FAIL|SKIP|INVALID|none> [--name N] [--line L] [--need SHA] [--shipped 0|1]")
        task_, job, state = rest
        c = {"job": job, "task": task_, "state": state, "name": o.get("name", ""), "line": o.get("line", ""),
             "need": o.get("need", ""), "shipped": o.get("shipped", "1") != "0", "at": int(o.get("at") or 0)}
        call("check_set", json.dumps(c))
    elif verb == "sync":
        if len(argv) != 2 or argv[0] != "--json-text":
            die("usage: powos agents check sync <file.json|->  (a JSON array: `check scan` makes it)")
        data = argv[1]
        cs = json.loads(data)
        call("check_sync", data)
        print(f"{len(cs)} check(s) synced; {close_passed(cs)} task(s) closed by their --close check")
    elif verb == "scan":
        o, _ = opts(argv, ["queue", "repo", "days"])
        print(json.dumps(scan_queue(o.get("queue"), o.get("repo"), int(o.get("days") or 7))))
    elif verb in ("list", "ls"):
        o, rest = opts(argv, ["json!"])
        cs = table("work_check")
        if rest:
            cs = [c for c in cs if c["task"] == rest[0]]
        cs.sort(key=lambda c: int(c.get("at") or 0))
        if o.get("json"):
            print(json.dumps(cs, indent=1))
            return
        for c in cs:
            print(f"{c['state']:<8} {c['task']}  {_check_name(c)}  {ago(int(c['at']))}  {c.get('line', '')[:100]}")
    else:
        die(f"unknown: check {verb} (powos agents help)")


def close_passed(cs):
    """Tasks whose LATEST result is a PASS of a shipped build from a `queue.sh add --close` job, still open and untouched
    since: closed now (the runner's own close is refused when its check row wasn't written first - an older runner
    copy - or failed)."""
    latest = {}
    for c in cs:
        if c.get("state") in ("PASS", "FAIL", "none") and int(c.get("at") or 0) >= int(latest.get(c["task"], {}).get("at") or 0):
            latest[c["task"]] = c
    # Only while nothing happened to the task since that result (the runner's step write follows it within seconds): a
    # task its owner reopened or moved after the pass is theirs.
    ws = rows()
    open_ = {w["id"]: int(w.get("updated") or 0) for w in ws if w["status"] != "done"}
    # ... and only a task with nothing else open on it (its sub-tasks, its planned steps): a PASS closes the task it was
    # queued for, never a parent that still has work.
    blocked = {w["id"] for w in ws if w["status"] != "done" and any(open_items(w, ws))}
    n = 0
    for t, c in latest.items():
        if (t in open_ and t not in blocked and c.get("close") and c["state"] == "PASS" and c.get("shipped", True)
                and open_[t] - int(c.get("at") or 0) <= 300_000):
            call("work_set", t, "", "", "done", "", "")
            n += 1
    return n


def _git_ok(repo, *a):
    try:
        return subprocess.run(["git", "-C", repo, *a], capture_output=True, text=True, timeout=20).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def _git_out(repo, *a):
    try:
        r = subprocess.run(["git", "-C", repo, *a], capture_output=True, text=True, timeout=20)
        return r.stdout if r.returncode == 0 else ""
    except (OSError, subprocess.TimeoutExpired):
        return ""


def shipped(repo, need, live, inst):
    """The commit [need] is on the phone: in the live shell ([live], the ship service's tip) - or what it changed is
    none of the shell - and in the installed APK ([inst]) when it changed the APK's inputs. Unknown (no commit, not in
    [repo]): True, as queue.sh's shipped() runs it anyway."""
    if not need or not repo or not _git_ok(repo, "cat-file", "-e", f"{need}^{{commit}}"):
        return True

    def changed(a, b, path):
        return [p for p in _git_out(repo, "diff", "--name-only", a, b, "--", path).split() if not p.endswith("version.properties")]

    if inst and not _git_ok(repo, "merge-base", "--is-ancestor", need, inst) and (
            changed(inst, need, "targets/android/app") or changed(inst, need, "targets/android/build-app.sh")):
        return False
    if not live or _git_ok(repo, "merge-base", "--is-ancestor", need, live):
        return True
    base = _git_out(repo, "merge-base", live, need).strip()
    return not changed(base, need, "shell") if base else False


def _sh_vars(text):
    """A queue job file's task=/name=/need=/qt= lines (printf %q values, unquoted the simple way)."""
    import shlex

    out = {}
    for line in text.splitlines():
        k, eq, v = line.partition("=")
        if eq and re.fullmatch(r"[a-z]+", k) and not v.startswith("("):
            try:
                out[k] = shlex.split(v)[0] if v.strip() else ""
            except ValueError:
                out[k] = v
    return out


def _script_of(job_text):
    """A job file's cmd=(...) script, as queue.sh names it: past `env A=1`, its basename without .sh."""
    import shlex

    m = re.search(r"^cmd=\((.*)\)\s*$", job_text, re.M)
    try:
        toks = shlex.split(m.group(1)) if m else []
    except ValueError:
        toks = []
    for t in toks:
        if os.path.basename(t) in ("env", "bash", "sh", "python3", "python", "perl", "nice") or t.startswith("-") \
                or re.match(r"[A-Za-z_][A-Za-z0-9_]*=", t):
            continue
        return re.sub(r"\.sh$", "", os.path.basename(t))
    return ""


def _result_of(log):
    """(state, line, at) of a finished job's log: the runner appends "PASS|FAIL ...|SKIP ...: <last line>"."""
    try:
        with open(log, errors="replace") as f:
            lines = [x.rstrip("\n") for x in f.readlines()[-400:]]
        at = int(os.path.getmtime(log) * 1000)
    except OSError:
        return None
    if not lines:
        return None
    tail = lines[-1]
    m = re.match(r"(PASS|FAIL|SKIP|INVALID)\b", tail)
    if not m:
        return None
    state = m.group(1)
    if state == "FAIL" and any(x.startswith("INVALID") for x in lines):
        state = "INVALID"
    first_fail = next((x for x in lines if x.startswith(("FAIL", "INVALID"))), "")
    line = first_fail if state in ("FAIL", "INVALID") and first_fail else tail
    return state, line, at


def scan_queue(qdir=None, repo=None, days=7):
    """The verify queue as check rows (check_sync's input): every queued job (running: the one the runner's status
    names), and every finished one of the last [days] days with its result. Run on the Mac (the queue's host)."""
    q = qdir or os.path.expanduser("~/.cache/powos-verify-queue")
    repo = repo or os.environ.get("POWOS_VERIFY_REPO") or os.path.expanduser(
        "~/Projects/PowOS/.claude/worktrees/verify-runner")
    ship = os.environ.get("SHIP_DIR") or os.path.expanduser("~/.cache/powos-ship-queue")

    def read(p):
        try:
            with open(p) as f:
                return f.read().strip()
        except OSError:
            return ""

    live, inst = read(os.path.join(ship, "live")), read(os.path.expanduser("~/.cache/powos-installed-commit"))
    out, cutoff = [], (time.time() - days * 86400) * 1000
    for d, done in ((q, False), (os.path.join(q, "done"), True)):
        try:
            names = sorted(f for f in os.listdir(d) if f.endswith(".job"))
        except OSError:
            continue
        for f in names:
            text = read(os.path.join(d, f))
            v = _sh_vars(text)
            job = f[:-4]
            if not v.get("name"):   # jobs from before --name: the script's name, as queue.sh's default
                v["name"] = _script_of(text)
            if not v.get("task"):
                continue
            row = {"job": job, "task": v["task"], "name": v.get("name", ""), "need": v.get("need", ""),
                   "close": v.get("close") == "1",
                   "at": int(v.get("qt") or 0) * 1000 or int(os.path.getmtime(os.path.join(d, f)) * 1000)}
            if done:
                r = _result_of(os.path.join(d, job + ".log"))
                if not r or r[2] < cutoff:
                    continue
                row.update(state=r[0], line=r[1], at=r[2], shipped=shipped(repo, row["need"], live, inst))
            else:
                row.update(state="queued", line="", shipped=shipped(repo, row["need"], live, inst))
            out.append(row)
    return out


