def project_opt(o):
    """--project as one of the AREAS ("" when not given); refused when it names none of them."""
    if not o.get("project"):
        return ""
    a = area_of(o["project"])
    if not a:
        die(f"--project {o['project']!r} isn't an area of the board - one of: {', '.join(AREAS)}")
    return a


def infer_project(owner, wid, title):
    """The title's own words first (its lead word: "Launcher: ... chat typing" is the launcher), then the id's."""
    for text in (title.lower().strip(), f"{wid} {title}".lower()):
        for rx, proj in PROJECT_WORDS:
            if re.search(rx, text):
                return proj
    return PROJECT_OWNERS.get(owner, "Other")


TRY_MAX = 90


def try_line(o):
    """--try: what the user is to try, one plain sentence (the Ready-to-try line on the page), checked; None when not
    given, "" to clear (--try -)."""
    if "try" not in o:
        return None
    t = " ".join(str(o["try"]).split())
    if t == "-":
        return ""
    why = ("is empty" if not t else
           f"is {len(t)} characters (at most {TRY_MAX})" if len(t) > TRY_MAX else
           "has a commit hash in it" if re.search(r"\b[0-9a-f]{7,}\b", t, re.I) and re.search(r"[0-9]", t) else
           "has a path in it" if "/" in t else "")
    if why:
        die(f"--try {why}: say in one plain sentence what the user can try now, no hashes, file names or jargon "
            f"(e.g. --try \"Floating windows are back, try moving and resizing one\")")
    return t


def _words(t):
    return set(re.findall(r"[a-z0-9]+", t.lower())) - {"the", "a", "an", "on", "in", "of", "to", "for", "and"}


def similar(a, b):
    """Two titles for one task: nearly the same text, or the same words."""
    import difflib

    x, y = " ".join(sorted(_words(a))), " ".join(sorted(_words(b)))
    if not x or not y:
        return False
    wa, wb = _words(a), _words(b)
    jac = len(wa & wb) / len(wa | wb)
    return jac >= 0.75 or difflib.SequenceMatcher(None, a.lower().strip(), b.lower().strip()).ratio() >= 0.85


def likely_dupes(ws):
    """Open tasks whose titles are [similar] enough to be the same task twice, as (a, b) merge-suggestion pairs - a
    is the older one (the natural merge target), b the newer."""
    open_ = sorted((w for w in ws if w["status"] != "done"), key=lambda w: int(w.get("created") or w.get("updated") or 0))
    return [(a, b) for i, a in enumerate(open_) for b in open_[i + 1:] if similar(a["title"], b["title"])]


def slug(title):
    s = re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")
    return s[:48].rstrip("-") or f"task-{int(time.time())}"


def status_of(s):
    if s is None:
        return ""
    s = s.strip().lower().replace(" ", "-")
    s = ALIASES.get(s, s)
    if s.startswith("waiting"):
        s = "waiting"
    if s not in STATES:
        die(f"status is one of {' | '.join(STATES)} (got {s!r})")
    return s


def find(key):
    """The ONE task <key> names: its exact id, a unique PREFIX of an id, or whole words of its title matching one
    open task (else one task at all). Refused, never guessed (2026-10-23: a games agent scraped the status column,
    ran `task set working --step ...` and the old substring match put its Broforce step on "Board shows real agent
    state (working only ...)"): an id-shaped key (one token with a '-') that isn't an id or a unique prefix of one
    (several ids share the prefix: listed, not guessed), a key of only status words, more than one title match."""
    all_ = rows()
    key = key.strip()
    for w in all_:
        if w["id"] == key:
            return w
    if not key:
        die("no task given (powos agents task list)")
    if " " not in key and "-" in key:
        pre = [w for w in all_ if w["id"].startswith(key)]
        if pre:
            open_pre = [w for w in pre if w["status"] != "done"] or pre
            if len(open_pre) == 1:
                return open_pre[0]
            die(f"{key!r} matches {len(open_pre)} task ids, name one: " + ", ".join(w["id"] for w in open_pre))
        near = [w["id"] for w in all_ if key.startswith(w["id"])][:3]
        die(f"no task has the id {key!r}" + (f" (did you mean {', '.join(near)}?)" if near else "")
            + " - use the exact id (or a unique prefix of it) from `powos agents task list --json`")
    words = re.findall(r"[a-z0-9]+", key.lower())
    if not words or all(x in STATES or x in ALIASES for x in words):
        die(f"{key!r} is a status, not a task: name the task by its id (powos agents task list --json)")
    hits = [w for w in all_ if set(words) <= set(re.findall(r"[a-z0-9]+", w["title"].lower()))]
    open_hits = [w for w in hits if w["status"] != "done"]
    pick = open_hits if open_hits else hits
    if len(pick) == 1:
        return pick[0]
    if not hits:
        die(f"no task matches {key!r} (powos agents task list --all)")
    die(f"{key!r} matches {len(pick)} tasks, name one by its id: " + ", ".join(w["id"] for w in pick))


def ago(ms):
    s = max(0, int(time.time() - int(ms) / 1000))
    for n, u in ((86400, "d"), (3600, "h"), (60, "m")):
        if s >= n:
            return f"{s // n}{u}"
    return f"{s}s"


def opts(argv, spec):
    """--flag VALUE pairs (spec: allowed names; bool flags end in '!', repeatable ones in '*': a list), the rest
    positional."""
    got, rest, i = {}, [], 0
    bools = {s[:-1] for s in spec if s.endswith("!")}
    lists = {s[:-1] for s in spec if s.endswith("*")}
    vals = {s for s in spec if not s.endswith("!") and not s.endswith("*")} | lists
    while i < len(argv):
        a = argv[i]
        if a.startswith("--"):
            k, eq, v = a[2:].partition("=")
            if k in bools:
                got[k] = True
            elif k in vals:
                if not eq:
                    i += 1
                    if i >= len(argv):
                        die(f"--{k} needs a value")
                    v = argv[i]
                if k in lists:
                    got.setdefault(k, []).append(v)
                else:
                    got[k] = v
            else:
                die(f"unknown option --{k} (powos agents help)")
        else:
            rest.append(a)
        i += 1
    return got, rest


