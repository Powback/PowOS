# only 4 agents run"; the status column is what someone once typed, not what is happening) ---------------------------

# The states, in the order the board lists them.
TRUTH = ("working", "awaiting-check", "no-check", "stalled", "queued", "blocked", "done")
LIVE_MS = 30 * 60_000          # agentsd's own staleness: an agent heard from in the last 30 min is live
CHECK_RESULTS = ("PASS", "FAIL", "SKIP", "INVALID", "none")
QUEUED_STEP = "phone check queued"   # tools/phone/verify/queue.sh's marker (the board's fallback before a sync)


def spool_files():
    """The agents' spool snapshots this host sees: its own state.json and every mirrored host's (the Mac's agents on
    the phone: mirror/mac.json). POWOS_AGENTS_SPOOLS (':'-separated files) overrides (tests)."""
    if os.environ.get("POWOS_AGENTS_SPOOLS") is not None:
        return [f for f in os.environ["POWOS_AGENTS_SPOOLS"].split(":") if f]
    d = os.environ.get("POWOS_AGENTS_DIR")
    if not d:
        run = os.environ.get("XDG_RUNTIME_DIR")
        user = os.environ.get("USER") or os.environ.get("LOGNAME") or "u"
        d = os.path.join(run, "agents") if run else os.path.join(os.environ.get("TMPDIR") or "/tmp", f"powos-agents-{user}")
    out = [os.path.join(d, "state.json")]
    try:
        out += sorted(os.path.join(d, "mirror", f) for f in os.listdir(os.path.join(d, "mirror")) if f.endswith(".json"))
    except OSError:
        pass
    return out


def live_agents(now_ms=None):
    """Every live agent (working or needs you, heard from within LIVE_MS), from the spool files."""
    now_ms = now_ms or int(time.time() * 1000)
    out = []
    for f in spool_files():
        try:
            with open(f) as fh:
                snap = json.load(fh)
        except (OSError, ValueError):
            continue
        for a in snap.get("agents") or []:
            if a.get("state") in ("working", "needs_you") and now_ms - int(a.get("last") or 0) < LIVE_MS:
                out.append(a)
    return out


def holders(agents):
    """task id -> who holds it: an agent whose `work` is the task (its own `task set <id> --step/--progress/--plan/
    --commit`, powos-agentsd's work_of()), else a live agent of the owner's role holding nothing ("@role")."""
    held, idle_roles = {}, {}
    for a in agents:
        who = a.get("title") or a.get("role") or a.get("id", "?")
        if a.get("work"):
            held.setdefault(a["work"], f"{a.get('role') or 'agent'}: {who}"[:80])
        else:
            idle_roles.setdefault(a.get("role") or "", f"{a.get('role')}: {who}"[:80])
    return held, idle_roles


def checks_by_task(checks):
    out = {}
    for c in checks:
        out.setdefault(c.get("task", ""), []).append(c)
    for v in out.values():
        v.sort(key=lambda c: int(c.get("at") or 0))
    return out


def _check_name(c):
    return c.get("name") or c.get("job", "?")


def truth(w, held, idle_roles, checks, now_ms=None, ws=()):
    """(state, why) of one board row, from facts only: a live agent holding it, its phone checks (queued, results),
    its commits, its status (blocked/waiting/done are the owner's word and stay). One of TRUTH."""
    now_ms = now_ms or int(time.time() * 1000)
    status, owner = w.get("status") or "working", (w.get("owner") or "")
    if status == "done":
        return "done", w.get("note") or ""
    if status == "queued":
        # Accepted, not started: it waits for an agent slot, so it's nobody's orphan (an owner's idle agent doesn't
        # hold it either - the agent that takes it moves it, which sets it working; `task set` below).
        pos = queue_pos(w, ws)
        return "queued", f"up next{f' (#{pos} in the queue)' if pos else ''}"
    h = held.get(w["id"]) or (idle_roles.get(owner) if owner and owner not in GENERIC_OWNERS else None)
    if h:
        return "working", f"{h} has it"
    if status in ("blocked", "waiting"):
        why = w.get("note") or "no reason given"
        return "blocked", ("waiting on the user: " if status == "waiting" else "") + why
    queued = [c for c in checks if c.get("state") in ("queued", "running")]
    if queued:
        c = queued[-1]
        ship = "" if c.get("shipped", True) else f", waits for its ship ({(c.get('need') or '')[:9]})"
        return "awaiting-check", f"check {_check_name(c)} {c['state']}{ship}"
    if not checks and w.get("step") == QUEUED_STEP:
        return "awaiting-check", "check queued (the queue not synced yet)"
    results = sorted((c for c in checks if c.get("state") in CHECK_RESULTS), key=lambda c: int(c.get("at") or 0))
    last = results[-1] if results else None
    if last and last["state"] in ("FAIL", "INVALID", "SKIP"):
        word = {"FAIL": "FAILED", "INVALID": "was INVALID", "SKIP": "was SKIPPED"}[last["state"]]
        return "no-check", f"last check {_check_name(last)} {word}: {last.get('line', '')[:120]} - nobody on it"
    if last and last["state"] == "PASS":
        # A PASS speaks only for the task it was queued for, and only when nothing else is open on it ([ws]: the
        # board, for its sub-tasks; its planned steps): a parent with open children or steps stays open.
        kids, steps = open_items(w, list(ws))
        if kids or steps:
            return "no-check", (f"check {_check_name(last)} PASSED {ago(int(last.get('at') or now_ms))} ago, but "
                                f"{open_why(kids, steps)} - not done")
        # A newer PASS of a shipped build supersedes every older FAIL (results[-1] is the latest by time); with the fix
        # landed (commits recorded) that is the done rule's evidence - the board no longer waits for someone to close it.
        if last.get("shipped", True) and _jl(w.get("commits", "")):
            return "done", f"fix landed, check {_check_name(last)} PASSED {ago(int(last.get('at') or now_ms))} ago"
        return "no-check", f"check {_check_name(last)} PASSED {ago(int(last.get('at') or now_ms))} ago - close it or queue the next check"
    if last and last["state"] == "none":
        return "no-check", f"no device check possible ({last.get('line', '')[:80]}) - close it"
    commits = _jl(w.get("commits", ""))
    if commits:
        return "no-check", f"fix pushed ({len(commits)} commit{'s' if len(commits) != 1 else ''}), no phone check queued"
    gone = f"; owner {owner} isn't running" if owner and owner not in GENERIC_OWNERS else ""
    return "stalled", f"nobody on it and no check{gone}"


def queue_of(ws):
    """The queue (status queued) in order: severity, user evidence above infra-only at a level, score, then oldest
    accepted first (the AI page's Up next, same order: upnext.tsx upNext)."""
    return sorted((w for w in ws if w.get("status") == "queued"), key=queue_key)


def queue_pos(w, ws):
    """[w]'s place in the queue, 1-based (0: [ws] not given or [w] not in it)."""
    ids = [x["id"] for x in queue_of(ws)]
    return ids.index(w["id"]) + 1 if w["id"] in ids else 0


def board_truth(ws=None, checks=None, agents=None, now_ms=None):
    """Every row with its `truth` and `why` (added to a copy of the row)."""
    ws = rows() if ws is None else ws
    if checks is None:
        try:
            checks = table("work_check")
        except (Down, SystemExit):
            checks = []
    held, idle_roles = holders(live_agents(now_ms) if agents is None else agents)
    by = checks_by_task(checks)
    out = []
    for w in ws:
        st, why = truth(w, held, idle_roles, by.get(w["id"], []), now_ms, ws)
        out.append(dict(w, truth=st, why=why))
    return out


def counts(ws):
    c = {s: 0 for s in TRUTH}
    for w in ws:
        c[w["truth"]] = c.get(w["truth"], 0) + 1
    return c


