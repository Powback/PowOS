    """The ship gate on ready-to-try: a UI task's --try needs an after image (stored or in this call) or --no-after."""
    if not tl or project not in VISUAL_PROJECTS:
        return
    if "no-after" in o:
        if not _line(o["no-after"]):
            die('--no-after needs the reason no picture can show the fix (--no-after "timing only")')
        return
    have = [p for p in _jl(w_images or "") if isinstance(p, str)] + image_entries(o)
    if not any(p.startswith(AFTER) for p in have):
        die(f"--try on a {project} task needs an after image: the fixed build in the same scene, taken on the emulator "
            "(POWOS_DEVICE=emu tools/phone/shot.sh OUT.png) or a gate scene render (shell/dev/shot.sh OUTDIR 'scene'), "
            "copied to the phone (tools/phone/review-image.sh OUT.png) and attached: --image "
            "/home/powos/design-qa/OUT.png --image-kind after. Nothing a picture can show: --no-after \"<why>\"")
# Owners that say nobody in particular has it: `task list --unowned` lists these as free.
GENERIC_OWNERS = ("", "coder")


def _jl(s):
    """A JSON-array column ("" = none) as a list."""
    try:
        v = json.loads(s) if s else []
        return v if isinstance(v, list) else []
    except ValueError:
        return []


def _line(s):
    return " ".join(str(s).split())


def progress_of(s):
    m = re.fullmatch(r"\s*(\d+)\s*/\s*(\d+)\s*", s or "")
    if not m or int(m.group(1)) > int(m.group(2)) or int(m.group(2)) > 100000:
        die(f"--progress is N/M with N <= M (got {s!r})")
    return int(m.group(1)), int(m.group(2))


def track(w, progress=None, step=None, plan=None, commits=(), images=(), done=False, images_rm=(), slice_done=False):
    """The work row [w]'s progress columns after this change: the step history kept (the current step done when the
    next one starts), the count following the steps unless --progress set it. None when nothing changes. [slice_done]:
    the current step is finished (the user tried it: `task works`) - the planned ones stay to do."""
    steps = [{"text": _line(x.get("text", "")), "state": x.get("state", "next")} for x in _jl(w.get("steps", ""))
             if isinstance(x, dict) and _line(x.get("text", ""))]
    pd, pt = int(w.get("progress_done") or 0), int(w.get("progress_total") or 0)
    # The count was the steps' (or there was none): it keeps following them.
    auto = pt == 0 or (pt == len(steps) and pd == sum(1 for x in steps if x["state"] == "done"))
    cur = _line(w.get("step", ""))
    if plan is not None:
        texts = [_line(t) for t in re.split(r"[;\n]", plan) if _line(t)]
        keep = [x for x in steps if x["state"] != "next"]
        have = {x["text"] for x in keep}
        steps = keep + [{"text": t, "state": "next"} for t in texts if t not in have]
    if step is not None and _line(step) and _line(step) != cur:
        step = _line(step)
        steps = [dict(x, state="done") if x["state"] == "current" else x for x in steps]
        nxt = [x for x in steps if x["state"] == "next" and x["text"] == step]
        if nxt:
            nxt[0]["state"] = "current"
        else:
            at = next((i for i, x in enumerate(steps) if x["state"] == "next"), len(steps))
            steps.insert(at, {"text": step, "state": "current"})
        cur = step
    if done:
        steps = [dict(x, state="done") if x["state"] == "current" else x for x in steps]
        cur = ""
    elif slice_done:
        # Only the slice the card showed (its current step, the row's `step`): any other step stays as it is.
        at = next((i for i, x in enumerate(steps) if x["state"] == "current" and x["text"] == cur),
                  next((i for i, x in enumerate(steps) if x["state"] == "current"), None))
        if at is not None:
            steps[at] = dict(steps[at], state="done")
        cur = ""
    if progress is not None:
        pd, pt = progress
    elif auto and steps:
        pd, pt = sum(1 for x in steps if x["state"] == "done"), len(steps)
    if done and pt:
        pd = pt
    cs = [c for c in _jl(w.get("commits", "")) if isinstance(c, dict) and c.get("sha")]
    for c in commits:
        sha = c["sha"].lower()
        if not any(sha.startswith(x["sha"]) or x["sha"].startswith(sha) for x in cs):
            cs.append({"sha": sha, "subject": _line(c.get("subject", ""))})
    ims = [p for p in _jl(w.get("images", "")) if isinstance(p, str)]
    # The same file added again as another kind: it moves to that kind (one entry per file).
    ims = [p for p in ims if not any(image_path(p) == image_path(q) and p != q for q in images)]
    ims += [p for p in images if p not in ims]
    ims = [p for p in ims if image_path(p) not in images_rm and p not in images_rm]
    new = {"progress_done": pd, "progress_total": pt, "step": cur,
           "steps": json.dumps(steps, ensure_ascii=False, separators=(",", ":")) if steps else "",
           "commits": json.dumps(cs, ensure_ascii=False, separators=(",", ":")) if cs else "",
           "images": json.dumps(ims, ensure_ascii=False, separators=(",", ":")) if ims else ""}
    old = {k: w.get(k) or ("" if k not in ("progress_done", "progress_total") else 0) for k in new}
    old["progress_done"], old["progress_total"] = int(old["progress_done"]), int(old["progress_total"])
    return None if new == old else new


def git_commits(shas, mention=None, days=30):
    """[{sha, subject}] of [shas] (subjects from the git repo the caller is in, "" outside one) plus, with [mention],
    the commits of the last [days] days whose message contains it."""
    out = []

    def git(*a):
        try:
            r = subprocess.run(["git", *a], capture_output=True, text=True, timeout=10)
            return r.stdout if r.returncode == 0 else None
        except (OSError, subprocess.TimeoutExpired):
            return None

    for sha in shas:
        if not re.fullmatch(r"[0-9a-fA-F]{4,40}", sha):
            die(f"--commit takes a commit sha (got {sha!r})")
        got = git("log", "-1", "--format=%H%x1f%s", sha)
        full, _, subject = (got or "").strip().partition("\x1f")
        out.append({"sha": (full or sha)[:12].lower(), "subject": subject})
    if mention and len(mention) >= 4 and git("rev-parse", "--git-dir") is not None:
        log = git("log", f"--since={days}.days", "--fixed-strings", "-i", f"--grep={mention}", "--format=%H%x1f%s") or ""
        for line in log.splitlines()[::-1]:
            full, _, subject = line.partition("\x1f")
            if full and not any(full.startswith(c["sha"]) for c in out):
                out.append({"sha": full[:12], "subject": subject})
    return out


def resolve_commits(argv):
    """Before anything else (the command may run on another host, the phone, where the caller's repo isn't): the
    --commit SHAs resolved here, in the caller's git repo, plus the commits there that mention the task's id (when the
    command names it by id, or add makes it), into one --commits-json. argv: after "task"."""
    if not argv or argv[0] not in ("add", "new", "set", "done"):
        return argv
    verb = "add" if argv[0] == "new" else argv[0]
    o, rest = opts(argv[1:], ["owner", "status", "note", "title", "project", "id", "ask", "no-check", "parent", "try",
                              "friction", "no-after"] + TRACK)
    wid = o.get("id") or (slug(" ".join(rest)) if verb == "add" else " ".join(rest))
    mention = wid if re.fullmatch(r"[a-z0-9][a-z0-9._-]{3,63}", wid or "") else None
    commits = (json.loads(o["commits-json"]) if o.get("commits-json") else []) + git_commits(o.get("commit") or [], mention)
    if not commits:
        return argv
    out, i = [], 1
    while i < len(argv):
        if argv[i] in ("--commit", "--commits-json"):
            i += 2
            continue
        if argv[i].startswith(("--commit=", "--commits-json=")):
            i += 1
            continue
        out.append(argv[i])
        i += 1
    return [verb] + out + ["--commits-json", json.dumps(commits)]


def apply_track(w, o, done=False):
    """The row's progress after the options [o] (and, on add/set/done, the commits that mention its id)."""
    commits = json.loads(o["commits-json"]) if o.get("commits-json") else []
    # Run where the repo is (a phone-side run has none; the caller's side resolved them already): its id's mentions.
    commits += git_commits([], mention=w["id"])
    new = track(w, progress_of(o["progress"]) if o.get("progress") else None, o.get("step"), o.get("plan"),
                commits, image_entries(o), done=done, images_rm=o.get("image-rm") or [])
    if new:
        call("work_track", w["id"], new["progress_done"], new["progress_total"], new["step"], new["steps"],
             new["commits"], new["images"])


def open_items(w, ws=None):
    """What is still open on [w], besides the check: (its open sub-tasks' ids, its planned steps' texts). A task with
    either can't be done - not by `task done`, not by a check's PASS (queue.sh --close, close_passed), not by the
    board's truth (the module's may_close holds the same rule). The current step isn't open work: a close finishes it.
    The user, 2026-10-30: a chat-overflow PASS queued against the AI-page board task closed it while its W1-W4 steps
    were still to do, and the work it tracked was never built."""
    ws = rows() if ws is None else ws
    kids = [c["id"] for c in ws if (c.get("parent") or "") == w["id"] and c.get("status") != "done"]
    steps = [_line(x.get("text", "")) for x in _jl(w.get("steps", "")) if isinstance(x, dict) and x.get("state") == "next"]
    return kids, [t for t in steps if t]


def open_why(kids, steps):
    bits = []
    if kids:
        bits.append(f"{len(kids)} open sub-task{'s' if len(kids) != 1 else ''} ({', '.join(kids)[:120]})")
    if steps:
        bits.append(f"{len(steps)} planned step{'s' if len(steps) != 1 else ''} to do ({'; '.join(steps)[:120]})")
    return " and ".join(bits)


def refuse_open(w):
    kids, steps = open_items(w)
    if kids or steps:
        die(f"'{w['id']}' can't be done: {open_why(kids, steps)} - each sub-task closes on its own check first; "
            f"do the steps or drop them from the plan (task set {w['id']} --plan \"\")")


def merge_into(target, dups, note):
    """Fold [dups] into [target]: each dup's title/note and still-open steps, plus its commits and images, land on
    [target]; each dup is then marked done, its note "merged into <target>" (no device check needed - its scope
    moved to the target, the same reason --no-check gives for Mac-only work)."""
    bits, commits, images = [], [], []
    plan = [s["text"] for s in _jl(target.get("steps", "")) if isinstance(s, dict) and s.get("state") == "next"]
    for w in dups:
        bits.append(f"{w['title']} [{w['id']}]" + (f": {w['note']}" if w.get("note") else ""))
        for s in _jl(w.get("steps", "")):
            if isinstance(s, dict) and s.get("state") in ("current", "next"):
                t = _line(s.get("text", ""))
                if t and t not in plan:
                    plan.append(t)
        commits += [c for c in _jl(w.get("commits", "")) if isinstance(c, dict) and c.get("sha")]
        images += [p for p in _jl(w.get("images", "")) if isinstance(p, str)]
    merged = "merged in: " + "; ".join(bits)
    full_note = f"{note.strip()} ({merged})" if note.strip() else merged
    if target.get("note"):
        full_note = f"{target['note']} | {full_note}"
    call("work_set", target["id"], "", "", "", full_note, "")
    tgt = next((w for w in rows() if w["id"] == target["id"]), target)
    new = track(tgt, plan="; ".join(plan) if plan else None, commits=commits, images=images)
    if new:
        call("work_track", tgt["id"], new["progress_done"], new["progress_total"], new["step"], new["steps"],
             new["commits"], new["images"])
    for w in dups:
        # Its scope moved to the target: its sub-tasks follow it, its planned steps are on the target now (else the
        # done rule - nothing open on it - refuses the dup's close), and its "no check" mark goes first.
        for kid in open_items(w)[0]:
            call("work_parent", kid, target["id"])
        cur = next((x for x in rows() if x["id"] == w["id"]), w)
        moved = track(cur, plan="")
        if moved:
            call("work_track", w["id"], moved["progress_done"], moved["progress_total"], moved["step"], moved["steps"],
                 moved["commits"], moved["images"])
        call("check_set", json.dumps({"job": f"nocheck:{w['id']}", "task": w["id"],
                                      "name": "no device check possible", "state": "none",
                                      "line": f"merged into {target['id']}"}))
        # Its evidence moves too (a merge is not a fix: closing the dup must not mark its friction fixed).
        try:
            for f in table("friction"):
                if f.get("task") == w["id"]:
                    call("friction_link", f["id"], target["id"])
        except (Down, SystemExit):
            pass
        call("work_set", w["id"], "", "", "done", f"merged into {target['id']}", "")


def no_check(wid, o):
    """--no-check REASON: no device check is possible for it - recorded as its check (state none), which lets the
    module's done rule close it."""
    reason = (o.get("no-check") or "").strip()
    if o.get("no-check") is not None and not reason:
        die('--no-check needs the reason ("docs only", "Mac-side tooling, tested by test/tier1/...")')
    if reason:
        call("check_set", json.dumps({"job": f"nocheck:{wid}", "task": wid, "name": "no device check possible",
                                      "state": "none", "line": reason}))


def link_ask(o, wid):
    if o.get("ask"):
        call("user_ask_link", o["ask"], wid, "")


def link_friction(o, wid):
    """--friction f30,f31: those friction items are evidence for [wid] (their counts feed its severity)."""
    for fid in [x.strip() for x in (o.get("friction") or "").split(",") if x.strip()]:
        call("friction_link", fid, wid)


# ---- severity from evidence (apps/agents' board_score holds the same constants; change both) ----------------------
# Per occurrence: an automated friction report 1, the user's "still broken" verdict (a FAIL check named "you") 50, a
# repeated ask (each linked user ask past the first) 25 - the user's own evidence outweighs infra noise. P1 at 50, P0 at
# 500 of that score; a task's severity only ever rises (never lowered automatically).
SCORE_FRICTION, SCORE_BROKEN, SCORE_ASK = 1, 50, 25
P1_AT, P0_AT = 50, 500
SEV_NAMES = {2: "P0", 1: "P1", 0: ""}


def severity_of(score):
    return 2 if score >= P0_AT else 1 if score >= P1_AT else 0


def evidence(wid, frictions, checks, asks):
    """[wid]'s evidence: {friction, broken, asks, user, score} (the module's board_score, same math)."""
    fr = sum(int(f.get("count") or 0) for f in frictions if f.get("task") == wid)
    broken = sum(1 for c in checks if c.get("task") == wid and c.get("name") == "you" and c.get("state") == "FAIL")
    n_asks = sum(1 for a in asks if a.get("task") == wid)
    user = broken * SCORE_BROKEN + max(0, n_asks - 1) * SCORE_ASK
    return {"friction": fr, "broken": broken, "asks": n_asks, "user": user, "score": fr * SCORE_FRICTION + user}


def severity(w, ev=None):
    """The row's severity: the stored one, raised to what [ev] says (never lowered)."""
    sev = int(w.get("severity") or 0)
    return max(sev, severity_of(ev["score"])) if ev else sev


def rank_key(w):
    """The sweep's and queue's order: severity, then the score (report count), then age (oldest first)."""
    return (-int(w.get("severity") or 0), -int(w.get("score") or 0), int(w.get("created") or w.get("updated") or 0), w["id"])


def queue_key(w):
    """Up next's order: severity; at a level the user's own evidence above infra-only; then score, then age."""
    return (-int(w.get("severity") or 0), -(int(w.get("user_score") or 0) > 0), -int(w.get("score") or 0),
            int(w.get("created") or 0), w["id"])


LIST_MAX, BODY_MAX = 100, 600


def cut_body(s, full=False):
    s = s or ""
    return s if full or len(s) <= BODY_MAX else s[:BODY_MAX] + f"... (+{len(s) - BODY_MAX} chars, --full)"


def task(argv):
    verb = argv[0] if argv else "list"
    argv = argv[1:]
    if verb == "new":
        verb = "add"
    if verb == "add":
        o, rest = opts(argv, ["owner", "status", "note", "id", "project", "ask", "no-check", "parent", "try",
                              "friction", "no-after"] + TRACK)
        title = " ".join(rest).strip()
        if not title:
            die("usage: powos agents task add <title...> [--owner ROLE] [--status S] [--note TEXT]")
        wid = o.get("id") or slug(title)
        have = rows()
        dup = next((w for w in have if w["id"] == wid), None) or next(
            (w for w in have if w["status"] != "done" and similar(w["title"], title)), None)
        if dup:
            print(f"powos agents: already on the board: {dup['title']!r} [{dup['id']}] (task set to change it)",
                  file=sys.stderr)
            link_ask(o, dup["id"])
            print(dup["id"])
            return
        owner = o.get("owner", "")
        project = project_opt(o) or infer_project(owner, wid, title)
        tl = try_line(o)
        need_after("", project, o, tl)
        st = status_of(o.get("status")) or "working"
        if st == "done":
            die("a new task isn't done: add it, then `task done` once its check passed")
        parent = find(o["parent"])["id"] if o.get("parent") else ""
        call("work_set", wid, title, owner, st, o.get("note", ""), project)
        if parent:
            call("work_parent", wid, parent)
        if tl:
            call("work_try", wid, tl)
        w = next((w for w in rows() if w["id"] == wid), None)
        if w:
            apply_track(w, o)
        link_ask(o, wid)
        link_friction(o, wid)
        print(wid)
    elif verb == "set":
        o, rest = opts(argv, ["owner", "status", "note", "title", "project", "ask", "no-check", "parent", "try",
                              "friction", "no-after"] + TRACK)
        if not rest:
            die("usage: powos agents task set <task> [--status S] [--owner ROLE] [--title T] [--note TEXT]")
        w = find(" ".join(rest))
        st = status_of(o.get("status"))
        # Taking a queued task (an agent moves it): it leaves the queue and is working.
        if not st and w["status"] == "queued" and any(o.get(k) for k in ("step", "progress", "plan")):
            st = "working"
        project, tl = project_opt(o), try_line(o)
        need_after(w.get("images", ""), project or w.get("project", ""), o, tl)
        if o.get("parent"):
            call("work_parent", w["id"], "" if o["parent"] == "-" else find(o["parent"])["id"])
        if st == "done":
            refuse_open(w)
            no_check(w["id"], o)
        call("work_set", w["id"], o.get("title", ""), o.get("owner", ""), st, o.get("note", ""), project)
        if tl is not None:
            call("work_try", w["id"], tl)
        apply_track(w, o, done=st == "done")
        link_ask(o, w["id"])
        link_friction(o, w["id"])
        print(w["id"])
    elif verb == "done":
        o, rest = opts(argv, ["note", "commit*", "image*", "image-rm*", "image-kind", "commits-json", "no-check"])
        if not rest:
            die('usage: powos agents task done <task> [--note TEXT] [--no-check "<why no device check is possible>"]')
        w = find(" ".join(rest))
        refuse_open(w)
        no_check(w["id"], o)
        call("work_set", w["id"], "", "", "done", o.get("note", ""), "")
        apply_track(w, o, done=True)
        print(w["id"])
    elif verb == "works":
        # The user tried what was ready (the page's "works", after its `check set ... PASS --name you`): the slice
        # shipped for them to try - the current step - is done; the task closes only when nothing else is open on it
        # (refuse_open's rule, unweakened: an epic with planned steps or open sub-tasks stays open). Never an error for
        # an open epic - the user's pass is recorded either way (the page, 2026-10-30: "I try to press like works, but
        # it just shows me like this error message").
        o, rest = opts(argv, ["note"])
        if not rest:
            die('usage: powos agents task works <task> [--note TEXT]')
        w = find(" ".join(rest))
        if w["status"] == "done":
            print(w["id"])
            return
        slice_ = _line(w.get("step", ""))
        if w.get("try_line"):
            call("work_try", w["id"], "")  # what was to try is tried: the next slice gets its own line
        new = track(w, slice_done=True)
        if new:
            call("work_track", w["id"], new["progress_done"], new["progress_total"], new["step"], new["steps"],
                 new["commits"], new["images"])
            w = dict(w, **new)
        kids, steps = open_items(w)
        # The close needs EVERY step done (and every sub-task): open_items leaves out a current step (a `task done`
        # finishes it), but a works tap only speaks for the slice it tried - one still current here is a later slice
        # that didn't ship, never something this tap may finish (2026-10-30: the web-windows epic closed with W1 open).
        steps += [_line(x.get("text", "")) for x in _jl(w.get("steps", "")) if isinstance(x, dict)
                  and x.get("state") == "current" and _line(x.get("text", ""))]
        if kids or steps:
            print(f"powos agents: {w['id']}: works{(' - ' + slice_) if slice_ else ''}; still open: "
                  f"{open_why(kids, steps)}", file=sys.stderr)
        else:
            call("work_set", w["id"], "", "", "done", o.get("note") or "works: you tried it", "")
            apply_track(w, {}, done=True)
        print(w["id"])
    elif verb == "merge":
        o, rest = opts(argv, ["into", "note"])
        if not rest or not o.get("into"):
            die('usage: powos agents task merge <dup...> --into <task> [--note TEXT]')
        target = find(o["into"])
        if target["status"] == "done":
            die(f"{target['id']!r} is already done - merge into an open task")
        dups = []
        for key in rest:
            w = find(key)
            if w["id"] == target["id"]:
                die(f"can't merge {w['id']!r} into itself")
            dups.append(w)
        merge_into(target, dups, o.get("note", ""))
        print(target["id"])
    elif verb in ("dupes", "dup", "duplicates"):
        o, _ = opts(argv, ["json!"])
        pairs = likely_dupes(rows())
        if o.get("json"):
            print(json.dumps([{"a": a["id"], "b": b["id"], "a_title": a["title"], "b_title": b["title"]}
                              for a, b in pairs], indent=1))
            return
        if not pairs:
            print("no likely duplicates (powos agents task list)")
        for a, b in pairs:
            print(f"{a['id']}  ~  {b['id']}")
            print(f"    {a['title']!r}  /  {b['title']!r}")
            print(f"    powos agents task merge {b['id']} --into {a['id']}")
    elif verb in ("rm", "remove", "drop"):
        if not argv:
            die("usage: powos agents task rm <task>")
        w = find(" ".join(argv))
        call("work_drop", w["id"])
        print(w["id"])
    elif verb == "infer":
        # Every task with no project gets one. --all: every open task is written with its area (its project if that is
        # one, its old project's area, else inferred) - all of them, oldest activity first, so the board's newest-first
        # order stays as it was (a write moves a task's activity to now).
        o, _ = opts(argv, ["all!"])
        n = 0
        ws = sorted(rows(), key=lambda w: int(w.get("activity") or 0) or int(w["updated"]))
        for w in ws:
            p = w.get("project") or ""
            if p and (not o.get("all") or w["status"] == "done"):
                continue
