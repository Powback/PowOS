def sync_asks():
    """The manager's own log of the user's asks (asks.jsonl, written before each turn) into the board - a turn whose
    recording failed (the module was down) is not lost."""
    try:
        with open(asks_file()) as f:
            mine = [json.loads(x) for x in f if x.strip()]
    except (OSError, ValueError):
        return 0
    have = {a["id"] for a in table("user_ask")}
    n = 0
    for a in mine[-200:]:
        if a.get("id") and a["id"] not in have and a.get("text"):
            call("user_ask_add", json.dumps({"id": a["id"], "text": a["text"], "by": a.get("by", "manager"), "at": a.get("at", 0)}))
            n += 1
    return n


def untracked_asks(older_s=0):
    now = time.time() * 1000
    return sorted((a for a in table("user_ask") if not a["task"] and not a["none"] and now - int(a["at"]) >= older_s * 1000),
                  key=lambda a: int(a["at"]))


