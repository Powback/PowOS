class Stdb:
    """The device's SpacetimeDB (docs/POWOS-APPS-FEASIBILITY.md §8) as a second target: each batch also goes to the
    powos-agents module's `sync` (apps/agents) over the server's HTTP call endpoint, as the PowOS user's CLI identity
    (the module's owner). Best effort: the spool stays the source of truth; while the server is unreachable nothing is
    sent, and the next batch that gets through is a full one. POWOS_AGENTS_STDB=0 turns it off."""

    def __init__(self, host):
        self.host = host
        self.url = os.environ.get("POWOS_STDB", "http://127.0.0.1:3410") + "/v1/database/powos-agents/call/sync"
        self.full = True
        self.token = None
        self.retry_at = 0.0
        self.warned = False

    def _token(self):
        p = os.path.expanduser("~/.config/spacetime/cli.toml")
        try:
            with open(p) as f:
                for line in f:
                    k, _, v = line.partition("=")
                    if k.strip() == "spacetimedb_token":
                        return v.strip().strip('"')
        except OSError:
            pass
        return None

    def send(self, batch):
        import urllib.request

        if time.monotonic() < self.retry_at:
            self.full = True
            return
        self.token = self.token or self._token()
        if not self.token:
            self.retry_at = time.monotonic() + 60
            return
        body = json.dumps([self.host, json.dumps(batch, separators=(",", ":"))]).encode()
        req = urllib.request.Request(self.url, data=body, method="POST", headers={
            "Content-Type": "application/json", "Authorization": f"Bearer {self.token}"})
        try:
            with urllib.request.urlopen(req, timeout=2) as r:
                r.read()
            self.full = False
            self.warned = False
        except Exception as e:  # down, not published, or refused: the spool has it all
            self.full = True
            self.retry_at = time.monotonic() + 30
            if not self.warned:
                print(f"powos-agentsd: SpacetimeDB sync off until it answers ({e})", file=sys.stderr)
                self.warned = True


def main():
    import argparse

    ap = argparse.ArgumentParser(description="Folds agent hook events into the Agents view's spool.")
    ap.add_argument("--mirror", default=os.environ.get("POWOS_AGENTS_MIRROR", ""), help="also push the state to this host (phone)")
    ap.add_argument("--foreground", action="store_true", help="don't detach (tests)")
    ap.add_argument("--once", action="store_true", help="fold what's queued, write, exit (tests)")
    args = ap.parse_args()

    spool, q = spool_dir(), queue_dir()
    os.makedirs(spool, exist_ok=True)
    os.makedirs(q, mode=0o700, exist_ok=True)
    if not args.foreground and not args.once:
        try:
            os.setsid()
        except OSError:
            pass
    lock = open(os.path.join(q, "lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return 0  # one is running
    pid_file = os.path.join(q, "pid")
    with open(pid_file, "w") as f:
        f.write(f"{os.getpid()}\n")
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))

    s = Spool(spool, host_name())
    mirror = Mirror(args.mirror, s.host) if args.mirror else None
    stdb = None if os.environ.get("POWOS_AGENTS_STDB", "1") == "0" else Stdb(s.host)
    watch = None if args.once else Watch(q)
    last_event = time.monotonic()
    next_sweep = time.monotonic()
    try:
        while True:
            got, waiting = read_queue(q, spool, now_ms())
            for ts, header, rec in got:
                if header is None:
                    if rec.get("powos_agents") == "message":
                        s.message(rec, ts)
                else:
                    try:
                        s.fold(header, rec, ts)
                    except Exception as e:  # one odd event mustn't take the reporter down
                        print(f"powos-agentsd: skipped an event: {e!r}", file=sys.stderr)
            if got:
                last_event = time.monotonic()
            if time.monotonic() >= next_sweep:
                s.sweep(now_ms())
                next_sweep = time.monotonic() + SWEEP_S
            changed = s.flush(stdb)
            if mirror and changed:
                mirror.wanted = True
            if mirror and mirror.due():
                mirror.push(s)
            if args.once:
                if mirror:
                    mirror.finish(s)
                return 0
            quiet = time.monotonic() - last_event
            if quiet >= IDLE_EXIT_S and not s.working():
                if mirror:
                    mirror.finish(s)
                return 0
            timeout = min(max(1.0, next_sweep - time.monotonic()), max(1.0, IDLE_EXIT_S - quiet))
            if waiting:
                timeout = BATCH_S
            if mirror and mirror.wanted:
                timeout = min(timeout, max(0.05, MIRROR_EVERY_S - (time.monotonic() - mirror.last)))
            if watch.wait(timeout):
                # The batch: whatever else arrives in the next 250 ms is folded and written with it.
                time.sleep(BATCH_S)
    finally:
        try:
            with open(pid_file) as f:
                if f.read().strip() == str(os.getpid()):
                    os.remove(pid_file)
        except OSError:
            pass


if __name__ == "__main__":
    sys.exit(main())
