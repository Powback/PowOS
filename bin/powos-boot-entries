#!/usr/bin/env bash
# powos-boot-entries — re-apply PowOS's boot-menu entries into the CURRENT
# ostree loader slot.
#
# WHY THIS EXISTS
# /boot/loader is a SYMLINK to loader.0 or loader.1. ostree writes a fresh slot
# whenever a deployment is created and flips the symlink atomically. Entries
# written by install-to-usb.sh land in whichever slot was current at write
# time, so the first deployment change — an update, a rollback, anything —
# silently removes "Install PowOS to disk" and both Recovery entries. That is
# exactly what happened on a Steam Deck: the menu came back with nothing but
# the two ostree entries.
#
# Run on every boot (powos-boot-entries.service). Idempotent and cheap: if the
# entries are already correct it rewrites nothing.
#
# Also applies the console fix — the last console= on the line becomes
# /dev/console, and an image built for VMs ends with console=ttyS0, which is a
# port physical hardware usually does not have. Left alone, every entry boots
# to a blank screen with a cursor.
set -uo pipefail

ENTRIES="${POWOS_ENTRIES_DIR:-/boot/loader/entries}"
[[ -d "$ENTRIES" ]] || { echo "powos-boot-entries: no $ENTRIES — nothing to do"; exit 0; }

# /boot is mounted READ-ONLY on an ostree system. Without this every write
# below fails with "Read-only file system" and the entries stay missing — which
# is exactly what happened on a Steam Deck: bazzite-hardware-setup applied its
# kargs, rpm-ostree created a new deployment, ostree regenerated the loader
# slot, and this service then could not put the entries back.
POWOS_REMOUNTED_BOOT=0
_powos_boot_rw() {
    [[ "${POWOS_ENTRIES_DIR:-}" ]] && return 0   # tests point at a normal dir
    mountpoint -q /boot || return 0
    findmnt -no OPTIONS /boot 2>/dev/null | grep -qw ro || return 0
    if mount -o remount,rw /boot 2>/dev/null; then
        POWOS_REMOUNTED_BOOT=1
    else
        echo "powos-boot-entries: /boot is read-only and could not be remounted rw"
        return 1
    fi
}
_powos_boot_ro() {
    (( POWOS_REMOUNTED_BOOT )) || return 0
    mount -o remount,ro /boot 2>/dev/null || true
    POWOS_REMOUNTED_BOOT=0
}
# Always hand /boot back the way we found it, even on error.
trap _powos_boot_ro EXIT
_powos_boot_rw || exit 0

# The template is the image's own entry: never one of ours.
template=$(find "$ENTRIES" -maxdepth 1 -name '*.conf' ! -name 'powos-*' | sort | head -1)
[[ -n "$template" ]] || { echo "powos-boot-entries: no ostree entry to template from"; exit 0; }
grep -q '^options ' "$template" || { echo "powos-boot-entries: template has no options line"; exit 0; }

# Move console=tty0 last so /dev/console is the DISPLAY, on every entry here.
console_to_display() {
    local f="$1"
    grep -q '^options .*console=' "$f" 2>/dev/null || return 0
    awk '
        /^options / {
            n = 0
            for (i = 2; i <= NF; i++) {
                # Drop EVERY serial console. Keeping one and merely putting
                # console=tty0 last is theoretically equivalent — the last
                # console= becomes /dev/console — but on a Steam Deck that
                # still produced a blank screen, while deleting console=ttyS0
                # outright produced a working one. Ship the configuration that
                # was observed to work, not the one that should have.
                if ($i ~ /^console=ttyS/ || $i ~ /^console=ttyUSB/ || $i ~ /^console=ttyAMA/) continue
                if ($i == "console=tty0" || $i ~ /^plymouth.enable=/) continue
                out[n++] = $i
            }
            line = "options"
            for (i = 0; i < n; i++) line = line " " out[i]
            print line " console=tty0 plymouth.enable=0"
            next
        }
        { print }
    ' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
}

write_entry() {
    # Separate declarations: bash creates every name in a single `local` before
    # assigning, so "dest=$ENTRIES/$name" on the same line reads an unset $name
    # and dies under set -u.
    local name="$1" title="$2" extra="$3"
    local dest="$ENTRIES/$name"
    awk -v t="$title" -v x="$extra" '
        /^title /   { print "title " t; next }
        /^options / { print $0 " " x; next }
        { print }
    ' "$template" > "$dest.new" || return 1
    grep -q '^title '   "$dest.new" || echo "title $title" >> "$dest.new"
    # Refuse to leave an entry that lost its kernel args — unbootable is worse
    # than absent.
    if ! grep -q '^options .*root=' "$dest.new"; then
        rm -f "$dest.new"; echo "powos-boot-entries: refusing to write $name (no root=)"; return 1
    fi
    console_to_display "$dest.new"
    if [[ -f "$dest" ]] && cmp -s "$dest" "$dest.new"; then rm -f "$dest.new"; return 0; fi
    mv "$dest.new" "$dest"
    echo "powos-boot-entries: wrote $name"
}

write_entry powos-install.conf "Install PowOS to disk" \
    "powos.install=1 systemd.unit=multi-user.target plymouth.enable=0"
write_entry powos-safe.conf    "Recovery — Safe mode (RAM boot off)" \
    "rd.powos.ramboot=0 powos.mode=safe systemd.unit=multi-user.target plymouth.enable=0"
write_entry powos-aidebug.conf "Recovery — AI Debug (diagnose boot)" \
    "rd.powos.ramboot=0 powos.mode=aidebug systemd.unit=multi-user.target plymouth.enable=0"

# The ostree entries are regenerated too, so re-apply the console fix to them.
for f in "$ENTRIES"/*.conf; do [[ -f "$f" ]] && console_to_display "$f"; done

# Keep the menu default pointing at the NEWEST deployment.
#
# install-to-usb.sh writes an explicit `set default=` when the stick is made,
# but a deployment created later (bazzite-hardware-setup applying Deck kargs,
# an update, a rollback) adds a higher-numbered ostree entry and leaves that
# default naming the OLD one — which is what a Steam Deck did: it auto-selected
# ostree:1, the deployment from before its own hardware kargs were applied.
GRUB_CFG="${POWOS_GRUB_CFG:-/boot/grub2/grub.cfg}"
if [[ -f "$GRUB_CFG" ]]; then
    newest=$(find "$ENTRIES" -maxdepth 1 -name '*.conf' ! -name 'powos-*' \
               -printf '%f\n' 2>/dev/null | sort -V | tail -1)
    newest="${newest%.conf}"
    if [[ -n "$newest" ]] && ! grep -q "set default=\"$newest\"" "$GRUB_CFG"; then
        if grep -q 'BEGIN powos-default' "$GRUB_CFG"; then
            sed -i "/BEGIN powos-default/,/END powos-default/s|^set default=.*|set default=\"$newest\"|" "$GRUB_CFG"
        else
            awk -v id="$newest" '
                /### END 10_blscfg.cfg ###/ {
                    print; print "### BEGIN powos-default ###"
                    print "set default=\"" id "\""
                    print "### END powos-default ###"; next
                } { print }' "$GRUB_CFG" > "$GRUB_CFG.tmp" && mv "$GRUB_CFG.tmp" "$GRUB_CFG"
        fi
        echo "powos-boot-entries: menu default -> $newest"
    fi
fi
exit 0
