#!/usr/bin/env bash
# PowOS Compose entry point: policy preflight, inventory and the existing engine CLI.
# Implementation lives once in lib/apps/powos-platform; no background daemon.
set -euo pipefail
for config in "$HOME/.config/pow-compose.conf" /etc/pow-compose.conf; do
    if [ -r "$config" ]; then
        set -a
        . "$config"
        set +a
    fi
done
here="$(cd "$(dirname "$0")" && pwd)"
platform="$here/../lib/apps/powos-platform"
if [ ! -f "$platform" ]; then platform=/usr/lib/powos/apps/powos-platform; fi
if [ ! -f "$platform" ]; then
    echo "pow-compose: missing PowOS platform adapter; install the matching PowOS CLI" >&2
    exit 2
fi
exec python3 "$platform" "$@"
