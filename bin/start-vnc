#!/bin/bash
# start-vnc - Start VNC server with KDE desktop
set -e

export HOME=/home/powos
export USER=powos
export DISPLAY=:1

# dbus/Plasma need a machine-id; the container image ships an empty one.
if [[ ! -s /etc/machine-id ]]; then
    sudo bash -c 'dbus-uuidgen > /etc/machine-id' 2>/dev/null || true
fi

# Create VNC directory
mkdir -p $HOME/.vnc

# Set VNC password (password: powos)
echo "powos" | vncpasswd -f > $HOME/.vnc/passwd
chmod 600 $HOME/.vnc/passwd

# VNC xstartup - starts XFCE
cat > $HOME/.vnc/xstartup << 'EOF'
#!/bin/bash
export XDG_SESSION_TYPE=x11
export XDG_RUNTIME_DIR=/tmp/runtime-powos
mkdir -p $XDG_RUNTIME_DIR
chmod 700 $XDG_RUNTIME_DIR
# PowOS ships KDE Plasma, not XFCE. Prefer the X11 Plasma session; fall back to
# whatever desktop session is actually present so the container is never blank.
if command -v startplasma-x11 >/dev/null 2>&1; then
    exec dbus-launch --exit-with-session startplasma-x11
elif command -v startxfce4 >/dev/null 2>&1; then
    exec dbus-launch --exit-with-session startxfce4
else
    exec dbus-launch --exit-with-session xterm
fi
EOF
chmod +x $HOME/.vnc/xstartup

# Kill any existing VNC
vncserver -kill :1 2>/dev/null || true

# Start VNC server
vncserver :1 -geometry 1920x1080 -depth 24 -localhost no

# Start noVNC (websocket proxy for browser access). Listen on 8443 to match the
# compose port map (6091:8443) and powos-boot — 6080 left the browser unable to
# reach it through the published port.
/usr/bin/novnc_proxy --vnc localhost:5901 --listen 8443 &

echo "VNC started on :1 (port 5901)"
echo "noVNC available at http://localhost:6091/vnc.html  (via compose 6091:8443)"

# Keep running
wait
