#!/bin/bash
# Restarts plasmalogin when the greeter is in the known broken-QML state.
# Never touches a live user session. Ships with powos; see powos repo.
STAMP=/run/greeter-watchdog.last
systemctl is-active --quiet plasmalogin.service || exit 0
# A failed/incomplete query is not evidence that it is safe to restart.
SESSIONS=$(loginctl list-sessions --no-legend 2>/dev/null) || exit 0
while read -r sid _; do
  [ -n "$sid" ] || continue
  INFO=$(loginctl show-session "$sid" -p Class -p State -p Type 2>/dev/null) || exit 0
  CLASS= STATE= TYPE=
  while IFS='=' read -r key value; do
    case "$key" in
      Class) [ -z "$CLASS" ] || exit 0; CLASS=$value ;;
      State) [ -z "$STATE" ] || exit 0; STATE=$value ;;
      Type) [ -z "$TYPE" ] || exit 0; TYPE=$value ;;
      *) exit 0 ;;
    esac
  done <<< "$INFO"
  # Unknown/new logind values fail closed too; never guess about a session.
  case "$CLASS" in user|greeter|background|lock-screen|manager|manager-early) ;; *) exit 0 ;; esac
  case "$STATE" in active|online|closing) ;; *) exit 0 ;; esac
  case "$TYPE" in unspecified|tty|x11|wayland|mir|web) ;; *) exit 0 ;; esac
  if [ "$CLASS" = user ] && [ "$STATE" = active ]; then
    case "$TYPE" in x11|wayland) exit 0 ;; esac
  fi
done <<< "$SESSIONS"
START=$(systemctl show plasmalogin.service -p ActiveEnterTimestamp --value)
[ -n "$START" ] || exit 0
ERRS=$(journalctl --since "$START" --no-pager -t plasma-login-greeter 2>/dev/null | grep -c "not a function")
[ "$ERRS" -ge 3 ] || exit 0
NOW=$(date +%s); LAST=$(cat "$STAMP" 2>/dev/null || echo 0)
[ $((NOW - LAST)) -ge 300 ] || exit 0
echo "$NOW" > "$STAMP"
logger -t greeter-watchdog "broken greeter detected ($ERRS QML errors) — restarting plasmalogin"
systemctl restart plasmalogin.service
