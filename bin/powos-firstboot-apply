#!/bin/bash
# powos-firstboot-apply - apply /etc/powos/install.conf on an installed
# system's FIRST boot, then delete it.
#
# The guided installer (powos-install-wizard) records everything the raw
# installer's flags can't express into /etc/powos/install.conf. install-system
# lays down the OS + partitions; THIS script, run once on first boot by
# powos-firstboot.service, applies the rest:
#
#   hostname, primary user + password (from a HASH), SSH key + sshd state,
#   RAM boot, AI provider/key, and an optional restore-from-backup pull.
#
# DESIGN RULES:
#   - Every step is BEST-EFFORT and independently logged. A single failure
#     must NEVER brick the boot — we always reach the cleanup at the end.
#   - The config holds a password HASH; we DELETE it when done so the hash
#     doesn't linger. The systemd unit's ConditionPathExists makes this a
#     one-shot: once the file is gone the service won't run again.
#   - External commands are called by bare name so tests can shadow them with
#     shell functions (source this file, define mocks, call fb_main).
#
# Usage:  powos-firstboot-apply        (normally launched by systemd)

set -uo pipefail

# Overridable so tests can point at a temp file instead of /etc.
POWOS_INSTALL_CONF="${POWOS_INSTALL_CONF:-/etc/powos/install.conf}"
POWOS_AI_CONF_DIR="${POWOS_AI_CONF_DIR:-/etc/powos/ai}"
# Survives install.conf being deleted, so a variant switch that failed for
# want of network can be retried on a later boot.
POWOS_PENDING_VARIANT="${POWOS_PENDING_VARIANT:-/etc/powos/pending-variant}"

GREEN=$'\033[0;32m'; YELLOW=$'\033[0;33m'; RED=$'\033[0;31m'; CYAN=$'\033[0;36m'; NC=$'\033[0m'

fb_log()  { echo -e "${CYAN}[firstboot]${NC} $*"; }
fb_ok()   { echo -e "${GREEN}[firstboot]${NC} $*"; }
fb_warn() { echo -e "${YELLOW}[firstboot]${NC} $*" >&2; }
fb_err()  { echo -e "${RED}[firstboot]${NC} $*" >&2; }

# ── Individual best-effort steps ──────────────────────────────────
# Each reads the sourced POWOS_* config values. Wrapped so a nonzero return
# is logged, never propagated.

fb_apply_hostname() {
    local host="${POWOS_HOSTNAME:-}"
    [[ -n "$host" ]] || { fb_log "no hostname configured — skipping"; return 0; }
    if hostnamectl set-hostname "$host" 2>/dev/null; then
        fb_ok "hostname set to '$host'"
    else
        # Fallback for environments without hostnamectl.
        echo "$host" > /etc/hostname 2>/dev/null && fb_ok "hostname written to /etc/hostname" \
            || fb_warn "could not set hostname"
    fi
}

fb_apply_user() {
    local user="${POWOS_USERNAME:-}" hash="${POWOS_PASSWORD_HASH:-}"
    [[ -n "$user" ]] || { fb_log "no username configured — skipping user setup"; return 0; }

    # Create the account if it doesn't exist yet (wheel for sudo).
    if ! id "$user" >/dev/null 2>&1; then
        if useradd -m -G wheel -s /bin/bash "$user" 2>/dev/null; then
            fb_ok "created user '$user'"
        else
            fb_warn "could not create user '$user' (may already exist)"
        fi
    fi

    # Deliberately no password: clear the field so the account can log in
    # without one. This is NOT the same as an empty hash — useradd leaves a '!'
    # in /etc/shadow, which LOCKS the account. `passwd -d` empties it.
    #
    # Chosen in the installer by leaving the password box blank, which is the
    # only workable answer on a device with no keyboard: a Steam Deck's
    # controller falls back to arrows/Enter/Escape with no letters, so a
    # mandatory password is an unescapable prompt.
    if [[ "${POWOS_PASSWORD_NONE:-0}" == "1" ]]; then
        if passwd -d "$user" >/dev/null 2>&1; then
            fb_ok "no password set for '$user' (login without one; set later with passwd)"
        else
            fb_warn "could not clear the password for '$user'"
        fi
    # Set the password from the pre-computed hash (-e = value is encrypted).
    elif [[ -n "$hash" ]]; then
        if printf '%s:%s\n' "$user" "$hash" | chpasswd -e 2>/dev/null; then
            fb_ok "password set for '$user'"
        else
            fb_warn "could not set password for '$user'"
        fi
    else
        fb_warn "no password hash present for '$user'"
    fi
}

fb_apply_ssh() {
    local user="${POWOS_USERNAME:-}" enable="${POWOS_SSH_ENABLE:-0}" key="${POWOS_SSH_KEY:-}"

    # Install an authorized key regardless of the daemon state (harmless).
    if [[ -n "$key" && -n "$user" ]]; then
        local home; home=$(getent passwd "$user" 2>/dev/null | cut -d: -f6)
        [[ -z "$home" ]] && home="/home/$user"
        if mkdir -p "$home/.ssh" 2>/dev/null; then
            if printf '%s\n' "$key" >> "$home/.ssh/authorized_keys" 2>/dev/null; then
                chmod 700 "$home/.ssh" 2>/dev/null || true
                chmod 600 "$home/.ssh/authorized_keys" 2>/dev/null || true
                chown -R "$user":"$user" "$home/.ssh" 2>/dev/null || true
                fb_ok "installed SSH authorized key for '$user'"
            else
                fb_warn "could not write authorized_keys"
            fi
        fi
    fi

    # Enable/disable + start/stop the daemon (sshd is the common unit name).
    if [[ "$enable" == "1" ]]; then
        systemctl enable --now sshd 2>/dev/null && fb_ok "sshd enabled" \
            || fb_warn "could not enable sshd"
    else
        systemctl disable --now sshd 2>/dev/null || true
        fb_log "sshd left disabled"
    fi
}

fb_apply_ramboot() {
    local mode="${POWOS_RAMBOOT:-off}"
    [[ "$mode" == "installed" ]] || { fb_log "RAM boot off — skipping"; return 0; }
    # The 'powos ramboot' CLI is being built in parallel; guard on it.
    if command -v powos >/dev/null 2>&1; then
        if powos ramboot enable 2>/dev/null; then
            fb_ok "installed-disk RAM boot enabled"
        else
            fb_warn "'powos ramboot enable' failed or is unavailable on this image"
        fi
    else
        fb_warn "powos CLI not found — cannot enable RAM boot"
    fi
}

# ── GPU variant ───────────────────────────────────────────────────
# The install media is ONE image that boots anywhere (the generic build), so
# an installed machine can easily be running the wrong variant for its GPU.
# The wizard already detects and records POWOS_GPU_FLAVOR — until 2026-08-21
# nothing ever read it, so every install simply kept whatever variant the USB
# happened to carry. This re-points the install at the matching published tag.

# Steam Deck DMI product names: Jupiter = LCD, Galileo = OLED.
fb_is_steam_deck() {
    local p=""
    [[ -r /sys/class/dmi/id/product_name ]] && p=$(cat /sys/class/dmi/id/product_name 2>/dev/null)
    case "$p" in Jupiter|Galileo) return 0 ;; *) return 1 ;; esac
}

# Published image tag for a wizard GPU flavor. Deck hardware OVERRIDES the GPU
# answer: a Deck is AMD, but it needs upstream's Deck enablement (jupiter
# kernel, Deck audio/controller firmware, gamescope session defaults) that the
# generic AMD image does not carry.
fb_variant_for_flavor() {
    local flavor="${1:-}"
    if fb_is_steam_deck; then echo "deck"; return 0; fi
    case "$flavor" in
        nvidia-open|nvidia) echo "nvidia-open" ;;
        deck)               echo "deck" ;;
        amd|intel|main)     echo "main" ;;
        # Unknown or undetectable → the generic build. AMD and Intel drivers
        # are in-kernel so it comes up everywhere; guessing NVIDIA instead
        # would put proprietary kmods on a machine that has no NVIDIA GPU.
        *)                  echo "main" ;;
    esac
}

# The registry ref of the currently booted deployment, prefixes stripped.
fb_current_image_ref() {
    rpm-ostree status --json 2>/dev/null | python3 -c '
import json, sys
try: d = json.load(sys.stdin)
except Exception: sys.exit(0)
ref = ""
for dep in d.get("deployments", []):
    if dep.get("booted"):
        ref = dep.get("container-image-reference") or ""
        break
for pre in ("ostree-unverified-registry:", "ostree-image-signed:",
            "ostree-unverified-image:", "ostree-remote-image:"):
    if ref.startswith(pre):
        ref = ref[len(pre):]; break
if "://" in ref:
    ref = ref.split("://", 1)[1]
print(ref)' 2>/dev/null
}

fb_apply_gpu_flavor() {
    local flavor="${POWOS_GPU_FLAVOR:-}" want ref repo target
    [[ -n "$flavor" ]] || { fb_log "no GPU flavor recorded — leaving the image alone"; return 0; }
    want="$(fb_variant_for_flavor "$flavor")"
    ref="$(fb_current_image_ref)"
    if [[ -z "$ref" || "$ref" != *"/"*":"* ]]; then
        fb_warn "cannot read the booted image reference — not switching GPU variant"
        return 0
    fi
    repo="${ref%:*}"; repo="${repo%@*}"
    target="$repo:$want"
    if [[ "$ref" == "$target" ]]; then
        fb_ok "already on the '$want' image variant"
        return 0
    fi
    fb_log "GPU flavor '$flavor' → image variant '$want'"
    fb_log "  from: $ref"
    fb_log "    to: $target"
    fb_switch_variant "$target" "$ref"
}

# Stage $1, recording it for a later retry if it fails. install.conf is deleted
# at the end of firstboot (it holds a password hash), so without this marker a
# switch that fails — most likely because the machine was offline, since the
# other variant's bytes have to come from the registry — would lose the
# recorded flavor permanently and leave the machine silently generic.
fb_switch_variant() {
    local target="$1" ref="${2:-}"
    # Bounded: this pulls from a registry, and the unit it runs in is now
    # ordered before the greeter. With no network yet — the normal state on a
    # first boot — an unbounded pull would spend the whole unit timeout here
    # and the retry path below would never be reached.
    if ${FB_TIMEOUT-timeout 60} bootc switch "$target" >/dev/null 2>&1; then
        rm -f "$POWOS_PENDING_VARIANT" 2>/dev/null || true
        fb_ok "staged $target — applies on the next reboot (old deployment stays as rollback)"
        return 0
    fi
    # Never fatal: a machine on the wrong variant is a working machine with
    # generic drivers. A machine that fails firstboot is not.
    fb_warn "bootc switch to $target failed${ref:+ — staying on $ref}"
    if mkdir -p "$(dirname "$POWOS_PENDING_VARIANT")" 2>/dev/null &&
       printf '%s\n' "$target" > "$POWOS_PENDING_VARIANT" 2>/dev/null; then
        fb_warn "recorded $target for retry — powos-variant-retry.service will try again"
        fb_warn "(usually this just means no network yet; it needs the registry)"
    else
        fb_warn "could not record the pending variant — fix manually with 'powos driver'"
    fi
    return 0
}

# --retry-variant: re-attempt a switch recorded by a previous boot. Driven by
# powos-variant-retry.service, which is gated on the marker existing.
fb_retry_variant() {
    local target
    [[ -r "$POWOS_PENDING_VARIANT" ]] || { fb_log "no pending variant — nothing to retry"; return 0; }
    target=$(head -1 "$POWOS_PENDING_VARIANT" 2>/dev/null)
    if [[ -z "$target" || "$target" != *"/"*":"* ]]; then
        fb_warn "pending variant file is malformed — removing it"
        rm -f "$POWOS_PENDING_VARIANT" 2>/dev/null || true
        return 0
    fi
    fb_log "retrying variant switch → $target"
    fb_switch_variant "$target"
}

fb_apply_ai() {
    local provider="${POWOS_AI_PROVIDER:-none}" key="${POWOS_AI_KEY:-}"
    [[ -n "$provider" && "$provider" != "none" ]] || { fb_log "no AI provider — skipping"; return 0; }

    if mkdir -p "$POWOS_AI_CONF_DIR" 2>/dev/null; then
        # Set the default client; keep the API key in a 600 file next to it.
        {
            echo "# Written by powos-firstboot-apply"
            echo "AI_DEFAULT_CLIENT=\"$provider\""
        } > "$POWOS_AI_CONF_DIR/provider.conf" 2>/dev/null \
            && fb_ok "AI default provider set to '$provider'" \
            || fb_warn "could not write AI provider config"

        if [[ -n "$key" ]]; then
            {
                echo "# Written by powos-firstboot-apply — keep private."
                case "$provider" in
                    claude) echo "ANTHROPIC_API_KEY=\"$key\"" ;;
                    gemini) echo "GEMINI_API_KEY=\"$key\"" ;;
                    *)      echo "AI_API_KEY=\"$key\"" ;;
                esac
            } > "$POWOS_AI_CONF_DIR/credentials.conf" 2>/dev/null
            chmod 600 "$POWOS_AI_CONF_DIR/credentials.conf" 2>/dev/null || true
            fb_ok "AI API key stored (0600)"
        fi
    else
        fb_warn "could not create $POWOS_AI_CONF_DIR"
    fi
}

# Wait for the network, briefly, and ONLY here.
#
# The unit no longer pulls in network-online.target: doing so made every
# first boot without wifi (i.e. every fresh Steam Deck) sit through
# NetworkManager-wait-online before the user account was created, with the
# greeter already up. The restore pull is the one step that genuinely needs a
# network, so it does its own bounded wait instead of taxing the whole boot.
FB_NET_WAIT_SECS="${FB_NET_WAIT_SECS:-45}"
fb_wait_for_network() {
    local i
    for ((i = 0; i < FB_NET_WAIT_SECS; i++)); do
        if [[ "$(systemctl is-active NetworkManager.service 2>/dev/null)" == active ]] &&
           nm-online -q -t 1 2>/dev/null; then
            return 0
        fi
        # No NetworkManager (or no nm-online): fall back to asking the kernel
        # whether any route to the outside world exists at all.
        if ip route get 1.1.1.1 >/dev/null 2>&1; then
            return 0
        fi
        sleep 1
    done
    return 1
}

fb_apply_restore() {
    local url="${POWOS_RESTORE_URL:-}"
    [[ -n "$url" ]] || { fb_log "no restore URL — skipping"; return 0; }
    if ! fb_wait_for_network; then
        fb_warn "no network after ${FB_NET_WAIT_SECS}s — skipping restore"
        fb_warn "run 'powos backup pull' once you are online"
        return 0
    fi
    if ! command -v powos >/dev/null 2>&1; then
        fb_warn "powos CLI not found — cannot restore from backup"
        return 0
    fi
    if powos backup setup "$url" 2>/dev/null; then
        if powos backup pull 2>/dev/null; then
            fb_ok "restored from backup: $url"
        else
            fb_warn "'powos backup pull' failed — restore later with 'powos backup pull'"
        fi
    else
        fb_warn "'powos backup setup' failed for $url"
    fi
}

# ── Main ──────────────────────────────────────────────────────────
fb_main() {
    if [[ ! -f "$POWOS_INSTALL_CONF" ]]; then
        fb_log "no $POWOS_INSTALL_CONF — nothing to apply."
        return 0
    fi

    fb_log "applying first-boot configuration from $POWOS_INSTALL_CONF"
    # shellcheck disable=SC1090
    source "$POWOS_INSTALL_CONF" 2>/dev/null || fb_warn "could not fully parse config"

    # Best-effort: never let one failure stop the others (|| true belt-and-braces
    # on top of each step's own guards).
    fb_apply_hostname || true
    fb_apply_user     || true
    fb_apply_ssh      || true
    fb_apply_ramboot  || true
    fb_apply_gpu_flavor || true
    fb_apply_ai       || true
    fb_apply_restore  || true

    # Always remove the config LAST — it carries the password hash, and its
    # absence is what stops powos-firstboot.service running again.
    if rm -f "$POWOS_INSTALL_CONF" 2>/dev/null; then
        fb_ok "applied and removed $POWOS_INSTALL_CONF"
    else
        fb_warn "could not remove $POWOS_INSTALL_CONF — remove it manually (holds a hash)"
    fi

    # Belt-and-braces: disable the unit too (ConditionPathExists already makes
    # it one-shot). Ignored if systemctl/the unit is absent.
    systemctl disable powos-firstboot.service 2>/dev/null || true

    return 0
}

# Run only when executed directly, not when sourced by the test harness.
if [[ "${BASH_SOURCE[0]:-$0}" == "${0}" ]]; then
    if [[ "${1:-}" == "--retry-variant" ]]; then
        fb_retry_variant
    else
        fb_main "$@"
    fi
fi
