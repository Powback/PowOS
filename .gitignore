# PowOS .gitignore

# Built extensions (regenerated from sources)
extensions/*/

# But keep the directory
!extensions/.gitkeep

# Secrets (encrypted versions are committed)
secrets/*.yaml
secrets/*.json
secrets/age-key.txt
!secrets/*.age
!secrets/.sops.yaml

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Build output (ISOs are large, regenerated)
build/output/

# Python bytecode
__pycache__/
*.pyc

# Windows / WSL cruft
nul
%USERPROFILE%*

# Test artifacts
test/tier2/*.qcow2
test/tier2/*.iso
/tmp/

# IDE
.idea/
.vscode/
*.code-workspace

# OS files
.DS_Store
Thumbs.db

# Docker
.docker/

# Logs
*.log
logs/
bazzite/
containers/system_files/

# Overlay upstream clones (regenerated by build.sh)
sources/*/upstream/

# Source-tree snapshot baked into the image at build time (regenerated;
# 3.7MB copy of the repo — must never be committed into the repo itself).
.snapshot/

# Local agent/session config, not part of the OS.
.claude/

# Marker a runner checkout (ship/verify services) drops at its own root - land.sh/worktree.sh refuse to run
# from a directory that has one (friction f57). Never committed; each service writes its own on creation.
/.powos-runner-checkout

# Build-tier bookkeeping (raw cache key, gate record, timings)
build/.cache/
