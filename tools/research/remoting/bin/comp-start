#!/bin/bash
# comp-start MODE: (as u) a fresh headless sway logging every Wayland message it sends/receives (WAYLAND_DEBUG=server,
# libwayland's own timestamps) to /tmp/run/sway.log, plus a waypipe client exposed on TCP :5000.
. /opt/rm/common.sh
pkill -x sway; pkill -x waypipe; pkill -f waypipe-argbvideo; pkill -x socat; pkill -x firefox; pkill -x kate; pkill -x dolphin; sleep 1
rm -rf /tmp/run/* "$XDG_RUNTIME_DIR"/*
opts=$(wp_opts "$1")
export WLR_BACKENDS=headless WLR_LIBINPUT_NO_DEVICES=1 WLR_RENDERER=${WLR_RENDERER:-gles2} WLR_RENDER_DRM_DEVICE=/dev/dri/renderD128
WAYLAND_DEBUG=server setsid sway -c /opt/rm/sway.conf >/tmp/run/sway.out 2>/tmp/run/sway.log &
for i in $(seq 50); do [ -S "$XDG_RUNTIME_DIR/wayland-1" ] && break; sleep 0.1; done
[ -S "$XDG_RUNTIME_DIR/wayland-1" ] || { echo "sway did not start"; tail -20 /tmp/run/sway.log; exit 1; }
if [ "$1" != local ]; then
  WAYLAND_DISPLAY=wayland-1 setsid $(wp_bin "$1") $opts -s /tmp/run/wp.sock client >/tmp/run/wp-client.log 2>&1 &
  sleep 0.5
  setsid socat TCP-LISTEN:5000,fork,reuseaddr,nodelay UNIX-CONNECT:/tmp/run/wp.sock >/tmp/run/socat.log 2>&1 &
fi
echo "comp up mode=$1 renderer=$WLR_RENDERER"
