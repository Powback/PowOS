#!/bin/bash
# Refuses a push whose shell/apps TypeScript fails the complexity lint (shell/dev/lint-complexity.sh) or tsc --noEmit
# (~2 s; d30be04), or whose Kotlin fails targets/android/lint-complexity.sh --only (~4 s; WindowFrame.barView), so a
# broken tip can't block every agent's ship-apk again (e9af512, 2026-10-22). Only the files changed in the pushed range; the lint
# reads them from the working tree (push a clean tree). Wired for every worktree by `git config core.hooksPath
# tools/git-hooks`. Skip once: GATE_LINT=0 git push.
set -uo pipefail
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
changed=()
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$zero" ] && continue
  base=$rsha
  [ "$rsha" = "$zero" ] && base=$(git merge-base "$lsha" origin/main 2>/dev/null || echo "$lsha")
  while IFS= read -r f; do changed+=("$f"); done < <(git diff --name-only --diff-filter=AM "$base" "$lsha" 2>/dev/null)
done
# The lints themselves (complexity: shell TS + apps UIs + Kotlin; tsc; the shellcheck ratchet; the hack registry) live in
# tools/lint/changed-lints.sh, which the agent's scoped gate (shell/dev/gate.sh) also runs - same verdict, one gate round
# earlier.
s=0
bash "$root/tools/lint/changed-lints.sh" ${changed[@]+"${changed[@]}"} || s=1
[ $s = 1 ] && echo "pre-push: refused - the lint / tsc fails on what you push (above)." >&2
[ $s = 1 ] && exit 1
exit 0
