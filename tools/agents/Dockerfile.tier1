# tools/agents/Dockerfile.tier1 — the container tools/agents/tier1.sh runs test/tier1/run-all.sh in.
#
# ubuntu:24.04 + bash 5 + python3 + jq + shellcheck + git + tmux + zip (ship-order-test fake APKs) + rsync (test-offload) + node >=22.18 — enough for every
# test/tier1/test-*.{sh,py} that doesn't need the full Bazzite OS image (those are quarantined/NEEDS_IMAGE
# in run-all.sh already). Built once, cached as `powos-tier1:<this file's git hash>` by tier1.sh, so an
# edit here gets its own image on the next run (--rebuild forces one, e.g. for a newer base).
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      bash python3 python3-pip jq shellcheck git tmux docker.io ca-certificates curl gnupg zip unzip rsync g++ \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && node --version && npm --version \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

SHELL ["/bin/bash", "-c"]
