<?xml version="1.0" encoding="utf-8"?>
<!-- tools/emu/testwin: the emulator's test window client - an ordinary resizable app under the package name of the
     phone's Calculator, so the window checks (window-max calc, float-windows, resize-probe ...) run unchanged on the
     emulator, which has no OnePlus Calculator. Installed on the emulator only (tools/emu/emu.sh), never on the phone.
     HACK: a stand-in under another app's package name. Real fix: one test-app setting the checks read (E2E_APP in
     e2e-lib.sh), this client under its own package. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.oneplus.calculator"
    android:versionCode="1" android:versionName="emu-testwin-1">
    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="36" />
    <application android:label="Calculator" android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <activity android:name=".Calculator" android:exported="true" android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
