<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The LAN door for `powos self push --ship` (tools/phone/ship-gate.py; unit units/mac/ship-gate-mac.json).
     Installed by tools/phone/ship-deploy.sh gate-install, which fills in @HOME@ and @VR@ (the ship-runner checkout).
     Needs ~/.config/powos/ship-gate.secret (0600) or it exits at once. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.powos.ship-gate</string>
  <key>ProgramArguments</key><array>
    <string>/usr/bin/python3</string><string>@VR@/tools/phone/ship-gate.py</string>
  </array>
  <key>WorkingDirectory</key><string>@VR@</string>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>LimitLoadToSessionType</key><string>Background</string>
  <key>ProcessType</key><string>Background</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>@HOME@/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key><string>@HOME@/.cache/powos-ship-queue/gate.log</string>
  <key>StandardErrorPath</key><string>@HOME@/.cache/powos-ship-queue/gate.log</string>
</dict>
</plist>
