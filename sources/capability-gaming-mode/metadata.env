# Gaming Mode Overlay Metadata
# This overlay provides the console-like gaming experience (Steam Big Picture mode)
OVERLAY_VERSION="1.0.0"
OS_VERSION="43"
OVERLAY_TYPE="mode"
MODE_NAME="Gaming Mode"

# Repositories these packages live in. ublue/Bazzite COPRs ship enabled=0, so
# the build must enable them explicitly or every package silently "does not
# exist". gamescope-session-plus / gamescope-session-steam / steamos-manager
# come from ublue-os:bazzite; hhd + hhd-ui from ublue-os:staging.
REPOS="copr:copr.fedorainfracloud.org:ublue-os:bazzite copr:copr.fedorainfracloud.org:ublue-os:staging copr:copr.fedorainfracloud.org:ublue-os:packages"
