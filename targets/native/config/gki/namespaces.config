# Namespaces for Steam (pressure-vessel/bubblewrap: its runtime containers need user + PID namespaces) and for
# Flatpak/podman. Android's GKI leaves both off. Kept only if tools/kmi-check.py still passes against the phone's
# own vendor modules (see powos.config's KMI rule).
CONFIG_USER_NS=y
CONFIG_PID_NS=y
