# PowOS on the OnePlus Open's vendor kernel: what a normal Linux system (systemd) needs on top of gki_defconfig.
#
# KMI rule: OnePlus's vendor modules (vendor_dlkm) are built against Google's GKI and checked by symbol CRCs
# (MODVERSIONS). An option may only ADD code; anything that changes a kernel structure (task_struct, struct device,
# ...) changes the CRCs of every symbol that reaches it, and the vendor modules - display, GPU, touch, Wi-Fi - then
# refuse to load. tools/kmi-check.py verifies the result against the phone's own modules. So, deliberately NOT here:
# SYSVIPC (adds task_struct fields), PID_NS/USER_NS beyond GKI's, VT (changes tty structures).

# name_to_handle_at()/open_by_handle_at(): systemd requires them (mount tracking).
CONFIG_FHANDLE=y
# devtmpfs: systemd and udev expect the kernel to create /dev nodes.
CONFIG_DEVTMPFS=y
# autofs: systemd's automount units (and /proc/sys/fs/binfmt_misc).
CONFIG_AUTOFS_FS=y
