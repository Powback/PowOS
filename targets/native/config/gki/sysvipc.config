# System V IPC (semget/shmget/msgget) and POSIX message queues: the Steam client's thread synchronization uses SysV
# semaphores ("Function not implemented" - ENOSYS - without them). Android's GKI leaves them off. Experimental: it
# adds task_struct fields (see powos.config's KMI rule) - kept only if tools/kmi-check.py passes against the phone's
# own vendor modules.
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
