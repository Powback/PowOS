# Built in (not modules): the bring-up initramfs carries no modules, so everything the first boot needs to reach a
# USB network shell must be in the kernel image. Merged over arm64 defconfig by build-kernel.sh.
CONFIG_ARCH_QCOM=y
CONFIG_PINCTRL_SM8550=y
CONFIG_SM_GCC_8550=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SM8550=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
# USB peripheral (gadget) path: DWC3 on Qualcomm, SNPS eUSB2 PHY + PMIC repeater, configfs gadget (NCM/RNDIS/ACM). USB 2 only.
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_SNPS_EUSB2=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_F_NCM=y
CONFIG_USB_F_RNDIS=y
CONFIG_USB_F_ACM=y
# Storage: UFS driver built in for later steps; the bring-up DTS keeps UFS disabled, so the first boots never touch the disk.
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFS_QCOM=y
# Framebuffer the bootloader left lit (simple-framebuffer node in the DTS), so text can show before DSI works.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# Bring-up comfort.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
