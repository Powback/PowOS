+/* PowOS web: file:chunked:<index> - the snapshot state streamed on demand (chunked-state.c). */
+static void chunked_state_incoming(void *opaque)
+{
+    migration_channel_process_incoming(QIO_CHANNEL(opaque));
+    object_unref(OBJECT(opaque));
+}
+
 void file_start_incoming_migration(FileMigrationArgs *file_args, Error **errp)
 {
+    if (g_str_has_prefix(file_args->filename, "chunked:")) {
+        QIOChannel *cioc = chunked_state_open(file_args->filename + strlen("chunked:"), errp);
+        if (cioc) {
+            /* Started from the main loop, as the file: case does through its watch. */
+            aio_bh_schedule_oneshot(qemu_get_aio_context(), chunked_state_incoming, cioc);
+        }
+        return;
+    }
+
     g_autofree char *filename = g_strdup(file_args->filename);
     QIOChannelFile *fioc = NULL;
     uint64_t offset = file_args->offset;
