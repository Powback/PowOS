+/*
+ * PowOS web: the i32 forms of add2/sub2. TCG leaves the upper 32 bits of an i32 value undefined (this backend
+ * computes i32 ops with 64-bit arithmetic), so the carry/borrow must come from bit 32 of the zero-extended low
+ * halves. The 64-bit forms above never see a 32-bit carry (0xfffffffc + 5 is no 64-bit overflow): every AArch64
+ * ADDS/CMN on W registers (gen_add32_CC: add2_i32) set C wrongly, and branches on it went the wrong way (systemd's
+ * hashmap code then handed memcpy a garbage pointer).
+ */
+static void tcg_wasm_out_add2_i32(TCGContext *s, TCGReg retl, TCGReg reth,
+                                  TCGReg al, TCGReg ah, TCGReg bl, TCGReg bh)
+{
+    /* sum = zext32(al) + zext32(bl): the carry is bit 32 */
+    tcg_wasm_out_op_global_get_r(s, al);
+    tcg_wasm_out_op_i32_wrap_i64(s);
+    tcg_wasm_out_op_i64_extend_i32_u(s);
+    tcg_wasm_out_op_global_get_r(s, bl);
+    tcg_wasm_out_op_i32_wrap_i64(s);
+    tcg_wasm_out_op_i64_extend_i32_u(s);
+    tcg_wasm_out_op_i64_add(s);
+    tcg_wasm_out_op_local_set(s, TMP64_0_IDX);
+
+    /* high = (ah + bh + carry) mod 2^32, computed before any output is written (outputs may alias inputs) */
+    tcg_wasm_out_op_global_get_r(s, ah);
+    tcg_wasm_out_op_global_get_r(s, bh);
+    tcg_wasm_out_op_i64_add(s);
+    tcg_wasm_out_op_local_get(s, TMP64_0_IDX);
+    tcg_wasm_out_op_i64_const(s, 32);
+    tcg_wasm_out_op_i64_shr_u(s);
+    tcg_wasm_out_op_i64_add(s);
+    tcg_wasm_out_op_i64_const(s, 0xffffffff);
+    tcg_wasm_out_op_i64_and(s);
+
+    /* low = sum mod 2^32 */
+    tcg_wasm_out_op_local_get(s, TMP64_0_IDX);
+    tcg_wasm_out_op_i64_const(s, 0xffffffff);
+    tcg_wasm_out_op_i64_and(s);
+    tcg_wasm_out_op_global_set_r(s, retl);
+    tcg_wasm_out_op_global_set_r(s, reth);
+}
+
+static void tcg_wasm_out_sub2_i32(TCGContext *s, TCGReg retl, TCGReg reth,
+                                  TCGReg al, TCGReg ah, TCGReg bl, TCGReg bh)
+{
+    /* diff = zext32(al) - zext32(bl): negative (bit 63 set) exactly when there is a borrow */
+    tcg_wasm_out_op_global_get_r(s, al);
+    tcg_wasm_out_op_i32_wrap_i64(s);
+    tcg_wasm_out_op_i64_extend_i32_u(s);
+    tcg_wasm_out_op_global_get_r(s, bl);
+    tcg_wasm_out_op_i32_wrap_i64(s);
+    tcg_wasm_out_op_i64_extend_i32_u(s);
+    tcg_wasm_out_op_i64_sub(s);
+    tcg_wasm_out_op_local_set(s, TMP64_0_IDX);
+
+    /* high = (ah - bh - borrow) mod 2^32 */
+    tcg_wasm_out_op_global_get_r(s, ah);
+    tcg_wasm_out_op_global_get_r(s, bh);
+    tcg_wasm_out_op_i64_sub(s);
+    tcg_wasm_out_op_local_get(s, TMP64_0_IDX);
+    tcg_wasm_out_op_i64_const(s, 63);
+    tcg_wasm_out_op_i64_shr_u(s);
+    tcg_wasm_out_op_i64_sub(s);
+    tcg_wasm_out_op_i64_const(s, 0xffffffff);
+    tcg_wasm_out_op_i64_and(s);
+
+    /* low = diff mod 2^32 */
+    tcg_wasm_out_op_local_get(s, TMP64_0_IDX);
+    tcg_wasm_out_op_i64_const(s, 0xffffffff);
+    tcg_wasm_out_op_i64_and(s);
+    tcg_wasm_out_op_global_set_r(s, retl);
+    tcg_wasm_out_op_global_set_r(s, reth);
+}
