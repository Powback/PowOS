#!/bin/sh
# PowOS on Linux/Wasm: init (replaces upstream's, appended over its initramfs by build.sh powos-initramfs).
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev
mkdir -p /tmp /run /var/tmp
mount -t tmpfs none /tmp
mount -t tmpfs none /run
# The disk the page streams on demand (kernel wasm_blk, read-only EROFS), at /powos.
if [ -b /dev/wasmblk0 ]; then
  mkdir -p /powos && mount -t erofs -o ro /dev/wasmblk0 /powos && echo "PowOS: /powos streamed on demand"
fi
echo "PowOS on Linux/Wasm - the kernel and every program here are WebAssembly, no CPU emulation."
# A shell on the canvas too (etc/powos-canvas-shell). Without it the canvas only shows a cursor.
# Only a plain command may go to the background here: "a && b &" is a subshell, which on NOMMU (CLONE_VFORK) blocks
# init until it exits - and this one never does.
if [ -c /dev/tty1 ]; then
  /etc/powos-canvas-shell &
fi
exec /sbin/init -s
