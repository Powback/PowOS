<?xml version="1.0" encoding="utf-8"?>
<!-- The device admin PowOS asks for (devices/LockAccess.kt): only force-lock - DevicePolicyManager.lockNow(). No password,
     wipe, camera or keyguard policy: the no-root device agent's lock/screen_off and nothing more. -->
<device-admin>
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>
