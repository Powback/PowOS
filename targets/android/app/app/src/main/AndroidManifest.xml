<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Remote input (shell/RemoteInput.kt): the phone as a Bluetooth keyboard and mouse (the HID device profile).
         Targeting SDK 28, these two; Android grants BLUETOOTH_CONNECT/ADVERTISE with them. -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- PowOS AI's live mode: the screen, with the user's consent each session (assist/LiveCapture.kt). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Speech input for the agent prompt bar; only recognized text reaches Linux. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Home's swipe down pulls the notification shade down. -->
    <!-- The control center's state and sliders (shell/QuickSettings.kt). WRITE_SETTINGS is an app op, granted there. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- PowOS as the recents provider (docs/NATIVE-SYSTEM-UI.md; the system module's recents overlay): granted by the
         recents role, not asked for - STATUS_BAR and START_TASKS_FROM_RECENTS are also privileged, so they're on the
         system module's allowlist (privapp-permissions.txt). The switcher: tasks' last frames, removing tasks, switching
         to them (system/Tasks.kt); the shade: its system windows and SystemUI's shade switched off (system/ShadeHost.kt). -->
    <uses-permission android:name="android.permission.READ_FRAME_BUFFER" />
    <uses-permission android:name="android.permission.REMOVE_TASKS" />
    <uses-permission android:name="android.permission.START_TASKS_FROM_RECENTS" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission android:name="android.permission.STATUS_BAR_SERVICE" />
    <uses-permission android:name="android.permission.STATUS_BAR" />
    <uses-permission android:name="android.permission.INTERNAL_SYSTEM_WINDOW" />
    <!-- Gesture navigation (system/gesture/): the input monitor on the display, and WM Shell's recents transition (its
         IRecentTasks checks MANAGE_ACTIVITY_TASKS). Both signature|recents on the phone, not privileged: no allowlist. -->
    <uses-permission android:name="android.permission.MONITOR_INPUT" />
    <uses-permission android:name="android.permission.MANAGE_ACTIVITY_TASKS" />
    <!-- The control center's third-party tiles, hosted as SystemUI hosts them (shell/TileHost.kt): every TileService
         requires it of its binder. signature|recents on the phone, as the two above. -->
    <uses-permission android:name="android.permission.BIND_QUICK_SETTINGS_TILE" />

    <!-- Uninstall from the app drawer's long-press menu (ACTION_DELETE). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Android widgets on home bound silently (shell/AppWidgets.kt: bindAppWidgetIdIfAllowed) needs
         android.permission.BIND_APPWIDGET (signature|privileged). NOT requested yet: the phone enforces the privapp
         allowlist (ro.control_privapp_permissions=enforce), and an installed APK asking for it before the system module
         that allowlists it is installed AND booted once stops the phone at the boot screen. Add the uses-permission back
         only after `dumpsys package com.powos.app` / the mounted module xml show it allowlisted; install-app.sh refuses
         an APK that asks for a privileged permission the phone's module doesn't list. -->
    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Lets SpeechRecognizer find the phone's recognition service. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="PowOS"
        android:theme="@style/Theme.Omalauncher"
        android:usesCleartextTraffic="true">

        <!-- The launcher: a web UI (shell/, see shell/DESIGN.md), the home screen (through .HomeShell) and its own app
             entry. Its own task (taskAffinity): sharing the desktop's, each singleTask switch to the desktop finished
             it. The page lays itself out around the keyboard (adjustNothing). -->
        <activity
            android:name=".shell.ShellActivity"
            android:label="PowOS Launcher"
            android:taskAffinity="com.powos.app.shell"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Android's home screen when it should be the launcher (andro.marchy.HomeScreen switches this and the
             engine's .HomeDesktop alias; one is enabled). -->
        <activity-alias
            android:name="andro.marchy.HomeShell"
            android:label="PowOS Launcher"
            android:targetActivity=".shell.ShellActivity"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".LinuxWindowActivity"
            android:label="Linux"
            android:theme="@style/Theme.Omalauncher.Window"
            android:autoRemoveFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:documentLaunchMode="always"
            android:exported="false"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden" />

        <!-- PowOS (rooted mode): opens a PowOS app from Android - its shortcut on the PowOS icon, in Android's
             search, or pinned to the phone's home screen (PowosShortcuts). Exported: launchers start shortcuts. -->
        <activity
            android:name=".OpenPowosApp"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- PowOS AI: the chat with PowOS's manager (docs/powos-ai-android.md) - from the launcher, the share sheet, the
             assistant gesture (the app as the phone's digital assistant), Quick Settings and the agents' notifications. -->
        <!-- PowOS AI as the digital assistant (assist/, docs/POWAI-ASSISTANT.md): holding the power button opens it over
             the screen. Chosen under Settings > Default apps > Digital assistant app. -->
        <service
            android:name="dev.omalauncher.assist.PowosVoiceInteractionService"
            android:label="PowOS AI"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data android:name="android.voice_interaction" android:resource="@xml/powos_voice_interaction" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>
        <service
            android:name="dev.omalauncher.assist.PowosAssistSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <activity
            android:name="dev.omalauncher.assist.LiveConsentActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:exported="false" />
        <service
            android:name="dev.omalauncher.assist.LiveCaptureService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />
        <service
            android:name="dev.omalauncher.assist.PowosRecognitionService"
            android:label="PowOS AI"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- The screen-off display: the shell's aod screen as the doze component (the system module's overlay names it),
             and a screensaver. -->
        <service
            android:name=".shell.PowosDozeService"
            android:label="PowOS"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- PowOS as the recents provider (the system module's recents overlay names this package): SystemUI binds the
             service (only it holds STATUS_BAR_SERVICE) and hands it the overview button; the activity is the switcher,
             the system's recents screen (config_recentsComponentName). -->
        <service
            android:name="dev.omalauncher.system.PowosRecentsService"
            android:exported="true"
            android:permission="android.permission.STATUS_BAR_SERVICE">
            <intent-filter>
                <action android:name="android.intent.action.QUICKSTEP_SERVICE" />
            </intent-filter>
        </service>
        <activity
            android:name=".shell.SwitcherActivity"
            android:label="Recents"
            android:taskAffinity="com.powos.app.switcher"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustNothing" />

        <!-- The lock screen's face (shell/LockFace.kt): over Android's lock screen, which keeps the lock. -->
        <activity
            android:name=".shell.PowosLockActivity"
            android:theme="@style/Theme.Omalauncher.Window"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=".lock"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode" />


        <activity
            android:name=".PowosAiActivity"
            android:label="PowOS AI"
            android:theme="@style/Theme.Omalauncher.Window"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=".powosai"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter android:label="PowOS AI">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <service
            android:name=".PowosAiTile"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="PowOS AI"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <receiver
            android:name=".AgentMail$Reply"
            android:exported="false" />

        <!-- PowOS (rooted mode): a terminal the launcher draws, one task each (PowosTerminalActivity). -->
        <activity
            android:name=".PowosTerminalActivity"
            android:label="Terminal"
            android:theme="@style/Theme.Omalauncher.Window"
            android:autoRemoveFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:documentLaunchMode="always"
            android:exported="false"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden" />

        <!-- Recents names a task after its activity's manifest label, so the common windows get their own. -->
        <activity-alias
            android:name=".TerminalWindow"
            android:exported="false"
            android:label="Terminal"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".BtopWindow"
            android:exported="false"
            android:label="btop"
            android:targetActivity=".LinuxWindowActivity" />

        <!-- And each coding agent (Agent.windowAlias), with its logo: Recents shows the activity's icon too. -->
        <activity-alias
            android:name=".ClaudeWindow"
            android:exported="false"
            android:icon="@drawable/agent_claude"
            android:label="Claude Code"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".OpencodeWindow"
            android:exported="false"
            android:icon="@drawable/agent_opencode"
            android:label="OpenCode"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".CodexWindow"
            android:exported="false"
            android:icon="@drawable/agent_codex"
            android:label="Codex"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".GrokWindow"
            android:exported="false"
            android:icon="@drawable/agent_grok"
            android:label="Grok"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".CopilotWindow"
            android:exported="false"
            android:icon="@drawable/agent_copilot"
            android:label="GitHub Copilot"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".CrushWindow"
            android:exported="false"
            android:icon="@drawable/agent_crush"
            android:label="Crush"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".CursorAgentWindow"
            android:exported="false"
            android:icon="@drawable/agent_cursor_agent"
            android:label="Cursor CLI"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".AgyWindow"
            android:exported="false"
            android:icon="@drawable/agent_agy"
            android:label="Antigravity"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".PiWindow"
            android:exported="false"
            android:icon="@drawable/agent_pi"
            android:label="Pi"
            android:targetActivity=".LinuxWindowActivity" />

        <activity
            android:name=".FilesActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:exported="false"
            android:label="Files"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.files"
            android:theme="@style/Theme.Omalauncher.Window"
            android:windowSoftInputMode="adjustResize" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".theme.OmarchyWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_label"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

        <!-- Notification access lets widgets show and control what's playing (android.media) and list notifications (android.notifications). -->
        <service
            android:name=".widgets.runtime.MediaListener"
            android:exported="true"
            android:label="Omalauncher widgets"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Widget recon (widgets/recon/WidgetRecon.kt): Android's "allow PowOS to create widgets" dialog and a widget's
             own setup, shown for a recon an agent asked for. -->
        <activity
            android:name=".widgets.recon.ReconActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity="com.powos.app.recon"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Adding another app's widget to home (shell/AppWidgets.kt): Android's "allow PowOS to create widgets"
             dialog, then the widget's own setup. Invisible itself. -->
        <activity
            android:name=".shell.AppWidgets$BindActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity="com.powos.app.appwidgets"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- The same recon from adb (am broadcast): DUMP is held by adb's shell and the system, never by apps. -->
        <receiver
            android:name=".widgets.recon.ReconReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <service
            android:name=".LinuxService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs a user-started Linux environment and its display server" />
        </service>
    </application>
</manifest>
