widget "disk" {
  page: 1
  order: 3
  size: 3x2
  minSize: 2x2

  requires { pacman: ["dua-cli"] }

  source df = cmd('df -B1 --output=avail,pcent / | tail -1') every 120s
  let use = num(words(df)[1])
  let hist = history(use, 40) persist

  onTap: terminal("dua i /")

  // Sized from the tile, never fixed (monospace: 0.6 em a character, a line 1.4 em budgeted): the label, the
  // value as big as the width and a share of the height allow, a bar, the detail, and the history graph taking the
  // height that's left.
  let iw = tileWidth == null ? 154 : tileWidth - 24
  let ih = tileHeight == null ? 200 : tileHeight - 24
  let detail = "${fmtBytes(num(words(df)[0]))} free"
  let ls = clamp(floor(min(ih * 0.08, iw / (8 * 0.6))), 10, 20)
  let tz = clamp(floor(min(iw / (4 * 0.6), ih * 0.3 / 1.4)), 18, 120)
  let ds = clamp(floor(min(iw / (max(len(detail), 6) * 0.6), max(tz * 0.35, ih * 0.06))), 9, 28)
  let bar = clamp(round(ih * 0.035), 3, 10)

  Column {
    gap: 4; fill: height
    Text { text: "disk"; fontSize: ls; color: muted; maxLines: 1 }
    Text { text: "${use}%"; fontSize: tz; color: use > 90 ? red : foreground; maxLines: 1 }
    Progress { value: use; color: use > 90 ? red : yellow; height: bar; fill: width; animate value: spring() }
    Text { text: detail; fontSize: ds; maxLines: 1 }
    Sparkline { values: hist; min: 0; max: 100; color: use > 90 ? red : yellow; area: true; fill: width; weight: 1 }
  }
}
