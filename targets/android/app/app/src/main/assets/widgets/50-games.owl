widget "games" {
  meta { owl: 7; description: "Your Steam games in PowOS, last played first: tap one to play it on the PowOS desktop"; version: "1.0"; license: "MIT"; category: "fun" }
  page: 1
  order: 6
  size: 6x3
  minSize: 3x2

  // Installed games from Steam's app manifests: appid, last played (Unix s), size, name. Proton, the Steam
  // Linux Runtime and Steamworks redistributables are tools, not games.
  source acf = cmd('for f in ~/.local/share/Steam/steamapps/appmanifest_*.acf; do awk -F"\"" "/\"appid\"/{a=\$4} /\"name\"/{n=\$4} /\"LastPlayed\"/{l=\$4} /\"SizeOnDisk\"/{s=\$4} END{if (n !~ /^Proton|Steam Linux Runtime|Steamworks|^FEX$/) printf \"%s\\t%s\\t%s\\t%s\\n\", a, l+0, s+0, n}" "$f"; done 2>/dev/null | sort -t "$(printf "\t")" -k2,2nr') every 2m
  source steam = cmd("pgrep -x steam >/dev/null && echo on || echo off") every 15s
  source now = clock every 1m

  let games = lines(acf ?? "").filter(l => len(l) > 0).map(l => split(l, "\t"))
    .map(g => {id: g[0], last: num(g[1], 0), size: num(g[2], 0), name: g[3]})
  let hero = first(games)
  let tints = [accent, magenta, cyan, green, orange, blue, yellow, red]

  // Launching: app() starts `steam steam://rungameid/...` - rooted, through powos-open-task (Runtime.launch): a game
  // that already runs (maybe frozen with Steam) is resumed and its window shown as its own task at once; otherwise
  // it hands the game to the running Steam (or starts Steam) and shows the game's window when it comes.

  component Ago(stamp, size = 11) {
    let d = now - stamp
    Text {
      text: stamp == 0 ? "never played" : d < 3600 ? "${max(floor(d / 60), 1)}m ago" : d < 86400 ? "${floor(d / 3600)}h ago" : d < 86400 * 60 ? "${floor(d / 86400)}d ago" : fmtTime(stamp, "MMM yyyy")
      fontSize: size; color: muted; maxLines: 1
    }
  }

  // A game's tile when there's no art: its initials in a tint picked from the theme by its appid, on the tile's soft
  // fill - no coloured plate, no outline.
  component Badge(game, side = 34) {
    let tint = tints[num(game.id, 0) % len(tints)]
    Box {
      width: side; height: side; radius: 6 * corners; align: center
      background: alpha(foreground, 0.07)
      Text { text: upper(join(words(replace(replace(game.name, ":", " "), "-", " ")).take(2).map(w => sub(w, 0, 1)), "")); bold: true; color: tint; fontSize: side * 0.36; align: center }
    }
  }

  // What fits: the hero's badge by the tile's width, the list's rows (26 dp and 6 between) by the height left under the
  // header (16 + 8) and the hero (its badge + 8 + 8).
  let iw = tileWidth == null ? 340 : tileWidth - 24
  let ih = tileHeight == null ? 180 : tileHeight - 24
  let heroSide = clamp(round(min(iw * 0.16, ih * 0.32)), 34, 88)
  let listCols = iw < 360 ? 1 : 2
  let avail = ih - 24 - (heroSide + 8) - 8
  // Rows no smaller than the tile warrants (a big tile: fewer, bigger rows rather than many small ones).
  let minSide = clamp(round(min(iw / listCols, ih) * 0.16), 26, 48)
  let listRows = max(floor((avail + 6) / (minSide + 6)), 0)
  // Fewer games than rows: each row taller (its badge up to 54), so the list still reaches the tile's foot.
  let need = max(ceil((len(games) - 1) / listCols), 1)
  let rowSide = clamp(floor((avail + 6) / max(min(need, listRows), 1)) - 6, minSide, 60)
  // Text in step with its badge (its two lines about the badge's height), and a name of ~18 characters fitting its column.
  let rowFs = clamp(min(round(rowSide * 0.38), floor((iw / listCols - rowSide - 14) / (18 * 0.62))), 10, 20)
  let heroFs = clamp(round(heroSide * 0.36), 13, 24)

  let rest = drop(games, 1).take(listRows * listCols)

  Column {
    gap: 8
    Row {
      align: center
      Text { text: "steam"; style: label; weight: 1 }
      Box { width: 7; height: 7; radius: 4; background: steam == "on" ? green : alpha(muted, 0.6) }
      Text { text: steam == "on" ? "running" : "${len(games)} installed"; style: small; color: muted; width: 84; align: end }
    }

    if acf == null {
      Text { text: "…"; style: muted }
    } else if hero == null {
      Text { text: "no games installed in PowOS's Steam yet"; style: small; color: muted }
    } else {
      // The last played, big: tap anywhere on it to carry on. On the tile itself - no plate, no outline.
      Row {
        fill: width; gap: 12; align: center
        onTap: app("steam steam://rungameid/${hero.id}")
        Badge { game: hero; side: heroSide }
        Column {
          gap: 2; weight: 1
          Text { text: hero.name; fontSize: heroFs; bold: true; maxLines: 1 }
          Ago { stamp: hero.last; size: round(heroFs * 0.8) }
        }
        Text { text: "▶"; color: accent; fontSize: round(heroFs * 1.1); width: round(heroFs * 1.3); align: center }
      }
      Grid {
        columns: listCols; gap: 6
        for g in rest key g.id {
          Row {
            gap: 8; align: center
            onTap: app("steam steam://rungameid/${g.id}")
            Badge { game: g; side: rowSide }
            Column {
              gap: 0; weight: 1
              Text { text: g.name; fontSize: rowFs; maxLines: 1 }
              Ago { stamp: g.last; size: round(rowFs * 0.85) }
            }
          }
        }
      }
    }
  }
}
