widget "what's new" {
  page: 2
  order: 9
  size: 3x2
  minSize: 2x2
  meta { description: "What's new in the launcher, from its changelog on GitHub. Tap it for every release"; version: "1.0"; license: "MIT"; category: "news"; owl: 5 }

  source log = http("https://raw.githubusercontent.com/SimonSchubert/omalauncher/main/CHANGELOG.md") every 6h timeout 10s status
  source sys = android.system every 1h

  // Each "## 0.5.0 (versionCode 10) – 2026-10-11" section, with its "- " items.
  // An item's wrapped lines are indented by two spaces, so they're joined first.
  let releases = split(log.ok ? log.out : "", "\n## ").drop(1).map(s => {
    version: lower(words(first(lines(s)))[0]),
    date: match(first(lines(s)), "\\d{4}-\\d{2}-\\d{2}"),
    items: lines(replace(s, "\n  ", " ")).filter(l => startsWith(l, "- ")).map(l => replace(sub(l, 2), "`", ""))
  }).filter(r => len(r.items) > 0)
  // "Unreleased" is what's coming; the tile shows the newest release.
  let latest = releases.find(r => r.date != null)
  let behind = latest != null && sys.launcher != null && latest.version != sys.launcher

  onTap: screen()

  // Sized from the tile, never fixed (monospace: 0.6 em a character, a line 1.4 em budgeted): the label, the version
  // big with its date, then the changes - whole ones only, each one's wrapped lines counted, as many as fit spread over
  // the height, the rest counted.
  let iw = tileWidth == null ? 154 : tileWidth - 24
  let ih = tileHeight == null ? 106 : tileHeight - 24
  let ls = clamp(floor(min(ih * 0.08, iw / (10 * 0.6))), 10, 18)
  let vs = clamp(floor(min(iw * 0.55 / (max(len(latest.version ?? "0.0.0"), 5) * 0.6), ih * 0.2 / 1.4)), 14, 64)
  let items = latest == null ? [] : latest.items
  let budget0 = ih - (ls + vs) * 1.4 - 6 - 14
  // Small enough that the first change fits whole: ceil(chars / per line) lines of 1.4 em in the height left.
  let first = len(items) == 0 ? 20 : len(items[0]) + 2
  let is = clamp(floor(min(iw / 20, ih * 0.075, sqrt(max(budget0, 1) * iw / (first * 0.6 * 1.4)) * 0.85)), 8, 22)
  let cpl = max(1, floor((iw - is) / (is * 0.6)))
  // The date beside the version where the width leaves it room.
  let dateFits = iw - len(latest.version ?? "") * 0.6 * vs - 6 >= 10 * 0.6 * ls
  let heights = items.map(i => ceil((len(i) + 2) / cpl) * is * 1.4)
  let budget = ih - (ls + vs) * 1.4 - 6 - is * 1.4
  let fits = count(range(len(items)), k => sum(take(heights, k + 1)) + k * 4 <= budget)

  Column {
    gap: 2; fill: height
    Text { text: "what's new"; fontSize: ls; color: muted; maxLines: 1 }
    if latest != null {
      Row {
        gap: 6
        align: bottom
        Text { text: latest.version; fontSize: vs; color: accent; maxLines: 1 }
        if dateFits {
          Text { text: behind ? "update" : latest.date; fontSize: ls; color: behind ? yellow : muted; align: end; weight: 1; maxLines: 1 }
        }
      }
      Column {
        gap: 4; weight: 1; justify: fits + (fits < len(items) ? 1 : 0) > 1 ? "spaceBetween" : "start"
        for i in take(items, fits) {
          Text { text: "• ${i}"; fontSize: is; maxLines: 6 }
        }
        if fits < len(items) {
          Text { text: "+${len(items) - fits} more"; fontSize: is; color: muted; maxLines: 1 }
        }
      }
    } else {
      Text { text: log == null ? "…" : "offline"; fontSize: vs; color: muted }
    }
  }

  screen {
    title: "what's new"
    if len(releases) == 0 {
      Text { text: log == null ? "loading…" : "couldn't reach github"; style: body; color: muted }
    } else {
      Column {
        scroll: true
        gap: 18
        for r in releases key r.version {
          let installed = r.version == sys.launcher
          Column {
            gap: 6
            Row {
              gap: 8
              align: bottom
              Text { text: r.date == null ? "coming next" : r.version; style: title; color: r.date == null ? muted : accent; weight: 1; maxLines: 1 }
              if installed {
                Text { text: "installed"; style: label; color: green; width: 72; align: end }
              }
              Text { text: r.date ?? ""; style: small; color: muted; width: 88; align: end }
            }
            for item in r.items {
              Row {
                gap: 8
                align: top
                Text { text: "•"; style: body; color: r.date == null ? muted : accent; width: 10 }
                Text { text: item; style: body; color: r.date == null ? muted : foreground; weight: 1 }
              }
            }
          }
        }
        Row {
          justify: end
          Button { text: "open on github ↗"; color: muted; onTap: url("https://github.com/SimonSchubert/omalauncher/blob/main/CHANGELOG.md") }
        }
      }
    }
  }
}
