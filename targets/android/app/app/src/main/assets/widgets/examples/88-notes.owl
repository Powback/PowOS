widget "notes" {
  page: 3
  order: 3
  size: 3x4
  minSize: 2x2

  meta { owl: 6; description: "Quick notes typed on the home screen; tap a note to remove it."; version: "1.0"; license: "MIT"; category: "productivity" }

  // Kept by the launcher across restarts; no file, no shell.
  state notes = [] persist

  // Sized from the tile, never fixed (monospace: 0.6 em a character, a line 1.4 em budgeted): the label, the field,
  // then the notes as soft cards - whole ones only, each one's wrapped lines counted, as many as fit spread over the
  // height, the rest counted. No scroll (a tile can't take one), no lines.
  let iw = tileWidth == null ? 154 : tileWidth - 24
  let ih = tileHeight == null ? 250 : tileHeight - 24
  // A short tile has no room for the label: the field's "add a note" says what it is.
  let labelled = ih >= 120
  let ls = labelled ? clamp(floor(min(ih * 0.06, iw / (8 * 0.6))), 10, 18) : 0
  let fieldH = clamp(floor(min(ih * 0.18, 56)), 28, 56)
  // Small enough that the first note fits whole in what the label and the field leave.
  let room0 = ih - ls * 1.4 - fieldH - (labelled ? 12 : 6) - 26
  let first = len(notes) == 0 ? 10 : len(notes[0])
  let ns = clamp(floor(min(iw / 16, ih * 0.075, sqrt(max(room0, 1) * (iw - 20) / (first * 0.6 * 1.4)) * 0.85, (room0 - 12) / 1.4)), 8, 24)
  let cpl = max(1, floor((iw - 20) / (ns * 0.6)))
  let heights = notes.map(n => ceil(max(len(n), 1) / cpl) * ns * 1.4 + 12)
  let budget = ih - ls * 1.4 - fieldH - (labelled ? 18 : 12) - ns * 1.5
  let fits = count(range(len(notes)), k => sum(take(heights, k + 1)) + k * 6 <= budget)

  Column {
    gap: 6
    fill: true
    if labelled {
      Text { text: "notes"; fontSize: ls; color: muted; maxLines: 1 }
    }
    Input { placeholder: "add a note"; clear: true; fontSize: ns; height: fieldH; fill: width; onSubmit: notes = value == "" ? notes : ([value] + notes).take(50) }
    Column {
      gap: 6
      weight: 1
      justify: fits + (fits < len(notes) ? 1 : 0) > 1 ? "spaceBetween" : "start"
      for note, i in take(notes, fits) {
        Box {
          fill: width; padding: [10, 6]; background: alpha(foreground, 0.07); radius: 6 * corners
          onTap: notes = notes.take(i) + notes.drop(i + 1)
          Text { text: note; fontSize: ns; maxLines: 8 }
        }
      }
      if fits < len(notes) {
        Text { text: "+${len(notes) - fits} more"; fontSize: ns; color: muted; maxLines: 1 }
      }
    }
  }
}
