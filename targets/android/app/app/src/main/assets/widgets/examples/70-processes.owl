widget "processes" {
  page: 2
  order: 3
  size: 3x5
  minSize: 3x2

  requires { pacman: ["procps-ng", "btop"] }

  source top = cmd('ps -eo rss=,comm= --sort=-rss | head -6') every 10s
  // "  81234 firefox" -> {mem: bytes, name: "firefox"}
  let procs = lines(top).map(l => { mem: num(words(l)[0]) * 1024, name: words(l)[1] })
  let biggest = max(procs.map(p => p.mem))

  onTap: terminal("btop")

  // As many processes as fit at ~34 dp a row (whole rows), sharing the tile's height; each row's name, size and bar
  // as big as its share allows. Sized from the tile, never fixed.
  let iw = tileWidth == null ? 154 : tileWidth - 24
  let ih = tileHeight == null ? 200 : tileHeight - 24
  let hs = clamp(floor(min(ih * 0.08, iw / (10 * 0.6))), 10, 22)
  let n = clamp(floor((ih - hs * 1.4 - 6) / 40), 1, max(1, len(procs)))
  let rowH = (ih - hs * 1.4 - 6 - (n - 1) * 6) / n
  // A name of ~14 characters and its size (~5) across the width (monospace: 0.6 em a character).
  let fs = clamp(floor(min(rowH * 0.55, iw / (19 * 0.6))), 11, 32)
  let bar = clamp(round(rowH * 0.14), 3, 10)

  Column {
    gap: 6; fill: height
    Text { text: "top memory"; fontSize: hs; color: muted; maxLines: 1 }
    for p in take(procs, n) key p.name {
      Column {
        gap: 2; weight: 1; justify: center
        Row {
          Text { text: p.name; fontSize: fs; maxLines: 1; weight: 1 }
          Text { text: fmtBytes(p.mem); fontSize: fs; color: muted; width: round(fs * 3.4); align: end; maxLines: 1 }
        }
        Progress { value: p.mem; max: biggest; height: bar; fill: width; animate value: spring() }
      }
    }
  }
}
