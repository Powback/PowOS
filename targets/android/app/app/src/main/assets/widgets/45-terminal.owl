widget "terminal" {
  page: 1
  order: 5
  size: 6x4
  minSize: 2x2
  padding: 0

  meta { owl: 8 }

  // A real shell. The tile shows it in widget-sized text; tap it to open it full size (its screen), where you
  // type - the same shell, as the info widget's tile and screen. Back closes the screen; the shell keeps running.
  onTap: screen()

  Terminal { session: "shell"; interactive: false; textSize: 10 }

  screen {
    Terminal { session: "shell" }
  }
}
