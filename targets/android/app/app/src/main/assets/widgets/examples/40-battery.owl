widget "battery" {
  page: 1
  order: 4
  size: 3x2
  minSize: 3x2

  source bat = android.battery every 60s
  let low = bat.level < 20

  // Sized from the tile, never fixed (monospace: 0.6 em a character, a line 1.4 em budgeted): the ring as big as
  // the tile allows with the level in it; beside it on a wide tile, over it on a tall one, the label and the status.
  let iw = tileWidth == null ? 154 : tileWidth - 24
  let ih = tileHeight == null ? 106 : tileHeight - 24
  let wide = iw >= ih * 1.25
  let status = bat.status ?? ""
  // Stacked: the status line first (the tile's width, a tenth of its height), the ring in the height it leaves.
  let lsS = clamp(floor(min(iw / (max(len(status), 7) * 0.6), ih * 0.1)), 9, 30)
  let d = wide ? floor(min(ih, iw * 0.6)) : floor(min(iw * 0.95, ih - lsS * 1.5 - 24))
  let tw = wide ? iw - d - 12 : iw
  let ls = wide ? clamp(floor(min(tw / (max(len(status), 7) * 0.6), ih * 0.22)), 9, 48) : lsS
  let ps = clamp(floor(d * 0.26), 10, 120)

  if wide {
    Row {
      gap: 12; align: center; fill: true
      Spacer { weight: 1 }
      Box {
        size: d; align: center
        Ring { value: bat.level; max: 100; size: d; thickness: clamp(round(d * 0.09), 4, 16); color: low ? red : green; animate value: spring() }
        Text { text: "${bat.level}%"; fontSize: ps; color: low ? red : green; align: center; maxLines: 1 }
      }
      Column {
        gap: 2
        Text { text: "battery"; fontSize: ls; color: muted; maxLines: 1 }
        Text { text: status; fontSize: ls; maxLines: 1 }
      }
      Spacer { weight: 1 }
    }
  } else {
    Column {
      gap: 4; align: center; fill: height
      Spacer { weight: 1 }
      Box {
        size: d; align: center
        Ring { value: bat.level; max: 100; size: d; thickness: clamp(round(d * 0.09), 4, 16); color: low ? red : green; animate value: spring() }
        Text { text: "${bat.level}%"; fontSize: ps; color: low ? red : green; align: center; maxLines: 1 }
      }
      Text { text: status; fontSize: ls; color: muted; align: center; maxLines: 1 }
      Spacer { weight: 1 }
    }
  }
}
