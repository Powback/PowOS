widget "ai usage" {
  page: 4
  order: 3
  size: 6x3
  minSize: 3x2
  meta { owl: 6 }

  requires { pacman: ["jq", "procps-ng", "findutils"] }

  // Today's tokens (UTC day) from the agents' own session logs, so no API keys are needed.
  // Claude Code: input + output + cache writes per message, messages counted once.
  // Codex: each of today's sessions reports a running total; its last one counts.
  source ai = cmd("""
    d=$(date -u +%F)
    claude=$(find ~/.claude/projects -name '*.jsonl' -newermt "$d" 2>/dev/null | xargs grep -h "\"timestamp\":\"$d" 2>/dev/null | jq -sc '
      [.[] | select(.type == "assistant" and .message.usage != null)] | unique_by((.message.id // "") + (.requestId // "")) |
      {tokens: (map(.message.usage | (.input_tokens // 0) + (.output_tokens // 0) + (.cache_creation_input_tokens // 0)) | add // 0),
       sessions: (map(.sessionId) | unique | length),
       hours: [range(24) as $h | map(select((.timestamp[11:13] | tonumber) == $h) | .message.usage.output_tokens // 0) | add // 0]}')
    codex=$(ls ~/.codex/sessions/$(date +%Y/%m/%d)/*.jsonl 2>/dev/null | while read -r f; do grep '"token_count"' "$f" | tail -1; done | jq -sc '
      {tokens: (map(.payload.info.total_token_usage.total_tokens // 0) | add // 0), sessions: length}')
    printf '{"claude":%s,"codex":%s,"running":{"claude":%s,"codex":%s}}\n' "$claude" "$codex" "$(pgrep -x claude | wc -l)" "$(pgrep -x codex | wc -l)"
  """) every 2m json timeout 30s

  // Sized from the tile, never fixed (monospace: 0.6 em a character, a line 1.4 em budgeted): the label, the two
  // agents as soft cards (their name, today's tokens big, their sessions), and the hours' graph in the height left.
  let iw = tileWidth == null ? 340 : tileWidth - 24
  let ih = tileHeight == null ? 180 : tileHeight - 24
  let ls = clamp(floor(min(ih * 0.07, iw / (16 * 0.6))), 10, 18)
  let cardW = (iw - 8) / 2
  let ts = clamp(floor(min((cardW - 20) / (5 * 0.6), ih * 0.2 / 1.4)), 14, 72)
  let ss = clamp(floor(min((cardW - 20) / (11 * 0.6), ts * 0.4)), 9, 22)

  component Agent(name, tokens, sessions, running) {
    Column {
      gap: 0; padding: [10, 8]; background: alpha(foreground, 0.07); radius: 8 * corners
      Row {
        gap: 6
        align: center
        Text { text: name; fontSize: ss; color: muted; weight: 1; maxLines: 1 }
        if running > 0 { Text { text: "● ${running}"; fontSize: ss; color: green; maxLines: 1 } }
      }
      Text {
        text: tokens == null ? "…" : tokens >= 1000000 ? "${round(tokens / 1000000, 1)}M" : tokens >= 1000 ? "${round(tokens / 1000)}k" : "${tokens}"
        fontSize: ts; maxLines: 1
        color: tokens > 0 ? foreground : muted
      }
      Text { text: sessions == 1 ? "1 session" : "${sessions ?? 0} sessions"; fontSize: ss; color: muted; maxLines: 1 }
    }
  }

  onTap: launcher("agents")

  Column {
    gap: 8; fill: height
    Text { text: "ai tokens today"; fontSize: ls; color: muted; maxLines: 1 }
    Row {
      gap: 8
      Agent { name: "claude"; tokens: ai.claude.tokens; sessions: ai.claude.sessions; running: ai.running.claude; weight: 1 }
      Agent { name: "codex"; tokens: ai.codex.tokens; sessions: ai.codex.sessions; running: ai.running.codex; weight: 1 }
    }
    // Claude's output tokens per hour of the day.
    Sparkline { values: ai.claude.hours; color: accent; area: true; fill: width; weight: 1 }
  }
}
