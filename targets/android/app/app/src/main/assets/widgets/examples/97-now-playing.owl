widget "now playing" {
  page: 1
  order: 20
  size: 6x2
  minSize: 3x2
  meta { description: "What's playing on your phone, from any music or podcast app: album art, track, progress and play, pause and skip. Tap the tile to open the app"; version: "1.1"; license: "MIT"; category: "fun"; owl: 9 }

  // {available, playing, title, artist, album, app, package, position, duration, art}.
  // Android only shares other apps' sessions with notification access; without it, available is false.
  source m = android.media

  let has = m != null && m.title != null
  let allowed = m == null || m.available != false
  let dur = num(m.duration, 0)
  let pos = dur > 0 ? clamp(num(m.position, 0), 0, dur) : num(m.position, 0)
  // Size each line from both its measured advances and the shell's conservative mono glyph budget.
  // Reserve metadata and transport space first: wide cards put art beside it, cards with enough height stack it.
  // Compact cards keep the full-width text/transport layout; no control is shrunk to make room for art.
  let iw = tileWidth == null ? 340 : tileWidth - 24
  let ih = tileHeight == null ? 106 : tileHeight - 24
  // Stack whenever height can hold art plus the complete transport and metadata, not only at a portrait ratio.
  let tall = ih >= 160 && ih > iw * 0.65
  let title = m.title ?? ""
  let both = [m.artist, m.album].filter(x => x != null && x != "").join(" · ")
  // Tall cards reserve room for words and transport before spending it on artwork.
  let artD = tall ? clamp(floor(min(iw * 0.6, ih * 0.3, ih - 150)), 40, 360) : max(40, floor(min(ih, iw * 0.32, iw - 172)))
  let side = !tall && iw - artD - 12 >= 160
  let tw = tall ? iw : side ? iw - artD - 12 : iw
  // Keep the existing transport hit sizes when changing the art breakpoint.
  let transportWidth = iw - floor(min(ih, iw * 0.42)) - 12
  let ctl = clamp(floor(min(ih > iw * 1.15 ? ih * 0.12 : ih * 0.3, (ih <= iw * 1.15 && transportWidth >= 110 ? transportWidth : iw) / 4.5)), 28, 84)
  let ls = clamp(floor(min(ih * 0.07, tw / 22)), 9, 18)
  let words = (tall ? ih - artD - 8 : ih) - ctl - (dur > 0 ? ls * 1.4 + 8 : 0) - ls * 1.4 - 8
  let fs = clamp(floor(min(tw / max(measure(title, 1, true), len(title) * 0.62, 2.4), words * 0.55 / 1.4)), 11, 44)
  // Keep artist and album; use two lines when the narrow card cannot hold both at readable size.
  let who = both
  let whoWidth = max(measure(who), len(who) * 0.62, 2.4)
  let whoLines = tw / whoWidth < 9 ? 2 : 1
  let ws = clamp(floor(min(tw * whoLines / whoWidth, fs * 0.75, words * 0.4 / (1.4 * whoLines))), 9, 32)
  // Clocks must not compete with three controls. Reserve both clock widths and all five row gaps.
  let clockWidth = ceil(max(measure("${floor(pos / 60)}:88", ls), len("${floor(pos / 60)}:88") * ls * 0.62)) + ceil(max(measure("${floor(dur / 60)}:88", ls), len("${floor(dur / 60)}:88") * ls * 0.62)) + ls + 6
  let separateTime = dur > 0 && tw < ctl * 2.68 + clockWidth + 20

  onTap: media("open")

  component Clock(s) {
    // As wide as "m:88" (the seconds' widest digits), so the line doesn't shift as they tick.
    Text { text: s == null ? "" : "${floor(s / 60)}:${pad(floor(s % 60), 2, "0")}"; fontSize: ls; color: muted; maxLines: 1; width: s == null ? 0 : ceil(max(measure("${floor(s / 60)}:88", ls), len("${floor(s / 60)}:88") * ls * 0.62)) + 2 }
  }

  // Drawn, not glyphs: the launcher's icon font only carries weather symbols. Paths need an
  // explicit fill: to be filled. Play/pause is a solid disc with the glyph in the background color.
  component Control(kind, big = false) {
    Box {
      size: big ? ctl : round(ctl * 0.84)
      onTap: media(kind)
      Canvas {
        let cx = width / 2
        let cy = height / 2
        let d = min(width, height)
        if kind == "toggle" {
          circle(cx, cy, d / 2, fill: foreground)
          if m.playing == true {
            rect(cx - d * 0.15, cy - d * 0.18, d * 0.11, d * 0.36, radius: d * 0.03, fill: background)
            rect(cx + d * 0.04, cy - d * 0.18, d * 0.11, d * 0.36, radius: d * 0.03, fill: background)
          } else {
            // The triangle's centroid sits right of its box: nudge it so it looks centered.
            path([[cx - d * 0.12, cy - d * 0.2], [cx + d * 0.21, cy], [cx - d * 0.12, cy + d * 0.2]], closed: true, fill: background)
          }
        } else {
          let dir = kind == "next" ? 1 : -1
          path([[cx - d * 0.19 * dir, cy - d * 0.2], [cx + d * 0.1 * dir, cy], [cx - d * 0.19 * dir, cy + d * 0.2]], closed: true, fill: foreground)
          rect(dir > 0 ? cx + d * 0.1 : cx - d * 0.18, cy - d * 0.2, d * 0.08, d * 0.4, radius: d * 0.03, fill: foreground)
        }
      }
    }
  }

  // A small equalizer that only exists (and only animates) while something plays.
  component Bars() {
    Canvas {
      width: 14
      height: 12
      for i in range(3) {
        let h = 3 + (sin(time * (5 + i * 1.7) + i * 2) * 0.5 + 0.5) * (height - 3)
        rect(i * 5, height - h, 3, h, radius: 1, color: accent)
      }
    }
  }

  component Art(src, d) {
    Box {
      size: d
      radius: 8
      clip: true
      align: center
      if src != null {
        Image { src: src; fit: cover; fill: true }
      } else {
        // Gradients only fill inside a Canvas, not as a background.
        Canvas {
          rect(0, 0, width, height, fill: linear(0, 0, width, height, [alpha(accent, 0.55), alpha(magenta, 0.35)]))
          text("♪", width / 2, height / 2, size: d * 0.45, align: center, color: alpha(foreground, 0.85))
        }
      }
    }
  }

  // The source app, with a live equalizer while it plays.
  component AppLine() {
    Row {
      align: center
      gap: 6
      if m.playing == true {
        Bars { }
      }
      Text { text: lower(m.app ?? ""); fontSize: ls; color: m.playing == true ? accent : muted; maxLines: 1; weight: 1 }
    }
  }

  if !allowed {
    Column {
      justify: center
      gap: 6
      fill: height
      Text { text: "now playing"; fontSize: ls; color: muted }
      Text { text: "Allow notification access so the launcher can see what's playing. Tap to open the setting."; fontSize: clamp(floor(min(tw / 16, ih / 6)), 11, 22); maxLines: 4 }
    }
  } else {
    if !has {
      // Nothing playing: the art's note and two lines, at the same sizes.
      if tall {
        Column {
          gap: 8; fill: height; align: center
          Art { src: null; d: artD }
          Spacer { weight: 1 }
          Text { text: "nothing playing"; fontSize: clamp(floor(iw / measure("nothing playing")), 11, 40); color: muted; align: center; maxLines: 1 }
          Text { text: "start music in any app"; fontSize: clamp(floor(iw / measure("start music in any app")), 9, 28); color: muted; align: center; maxLines: 1 }
          Spacer { weight: 1 }
        }
      } else {
        Row {
          align: center; gap: 12; fill: height
          if side { Art { src: null; d: artD } }
          Column {
            weight: 1; gap: 2
            Text { text: "nothing playing"; fontSize: clamp(floor(min(tw / measure("nothing playing"), ih * 0.3)), 11, 40); color: muted; maxLines: 1 }
            Text { text: "start music in any app"; fontSize: clamp(floor(min(tw / measure("start music in any app"), ih * 0.2)), 9, 28); color: muted; maxLines: 1 }
          }
        }
      }
    } else {
      if tall {
        Column {
          gap: 8; fill: height
          Art { src: m.art; d: artD }
          Column {
            gap: 2; weight: 1; justify: center
            AppLine { }
            Text { text: title; fontSize: fs; bold: true; maxLines: 1 }
            if who != "" { Text { text: who; fontSize: ws; color: muted; maxLines: whoLines } }
          }
          if dur > 0 {
            Progress { value: pos; max: dur; color: accent; track: alpha(muted, 0.2); height: clamp(round(ctl * 0.1), 3, 8); animate value: tween(900ms, "linear") }
            Row {
              align: center
              gap: 4
              Clock { s: pos }
              Spacer { weight: 1 }
              Clock { s: dur }
            }
          }
          Row {
            align: center
            gap: round(ctl * 0.3)
            Spacer { weight: 1 }
            Control { kind: "previous" }
            Control { kind: "toggle"; big: true }
            Control { kind: "next" }
            Spacer { weight: 1 }
          }
        }
      } else {
        Row {
          align: center
          gap: 12
          fill: height
          if side {
            Art { src: m.art; d: artD }
          }
          Column {
            weight: 1
            gap: 2
            fill: height
            AppLine { }
            Spacer { weight: 1 }
            Text { text: title; fontSize: fs; bold: true; maxLines: 1 }
            if who != "" { Text { text: who; fontSize: ws; color: muted; maxLines: whoLines } }
            Spacer { weight: 1 }
            if dur > 0 {
              Progress { value: pos; max: dur; color: accent; track: alpha(muted, 0.2); height: clamp(round(ctl * 0.1), 3, 8); animate value: tween(900ms, "linear") }
            }
            if separateTime {
              Row {
                gap: 4; fill: width
                Clock { s: pos }
                Spacer { weight: 1 }
                Clock { s: dur }
              }
            }
            Row {
              align: center
              gap: 4
              if dur > 0 && !separateTime {
                Clock { s: pos }
                Text { text: "/"; fontSize: ls; color: alpha(muted, 0.5); width: ceil(measure("/", ls)) + 2 }
                Clock { s: dur }
              }
              Spacer { weight: 1 }
              Control { kind: "previous" }
              Control { kind: "toggle"; big: true }
              Control { kind: "next" }
            }
          }
        }
      }
    }
  }
}
