widget "now playing" {
  page: 1
  order: 20
  size: 6x2
  minSize: 3x2
  meta { description: "What's playing on your phone, from any music or podcast app: album art, track, progress and play, pause and skip. Tap the tile to open the app"; version: "1.1"; license: "MIT"; category: "fun"; owl: 5 }

  // {available, playing, title, artist, album, app, package, position, duration, art}.
  // Android only shares other apps' sessions with notification access; without it, available is false.
  source m = android.media

  let has = m != null && m.title != null
  let allowed = m == null || m.available != false
  let dur = num(m.duration, 0)
  let pos = dur > 0 ? clamp(num(m.position, 0), 0, dur) : num(m.position, 0)
  // Sized from the tile, never fixed (monospace: 0.6 em a character, a line 1.4 em budgeted). Side by side - the
  // art square, as tall as the tile (at most 0.42 of its width), where the width leaves the words ~110 dp - or, a
  // tile taller than wide, stacked: art, words, progress and controls. The words as big as their width and the
  // height allow, the controls a share of the height.
  let iw = tileWidth == null ? 340 : tileWidth - 24
  let ih = tileHeight == null ? 106 : tileHeight - 24
  let tall = ih > iw * 1.15
  let title = m.title ?? ""
  let both = [m.artist, m.album].filter(x => x != null && x != "").join(" · ")
  let artD = tall ? clamp(floor(min(iw, ih * 0.42)), 40, 360) : floor(min(ih, iw * 0.42))
  let side = !tall && iw - artD - 12 >= 110
  let tw = tall ? iw : side ? iw - artD - 12 : iw
  let ctl = clamp(floor(min(tall ? ih * 0.12 : ih * 0.3, tw / 4.5)), 28, 84)
  let ls = clamp(floor(min(ih * 0.07, tw / 22)), 9, 18)
  let words = (tall ? ih - artD - 8 : ih) - ctl - (dur > 0 ? ls * 1.4 + 8 : 0) - ls * 1.4 - 8
  let fs = clamp(floor(min(tw / (max(len(title), 4) * 0.6), words * 0.55 / 1.4)), 11, 44)
  // Artist and album where they fit at 9 dp or more, else the artist alone.
  let who = tw / (max(len(both), 4) * 0.6) >= 9 ? both : (m.artist ?? both)
  let ws = clamp(floor(min(tw / (max(len(who), 4) * 0.6), fs * 0.75, words * 0.4 / 1.4)), 9, 32)

  onTap: media("open")

  component Clock(s) {
    Text { text: s == null ? "" : "${floor(s / 60)}:${pad(floor(s % 60), 2, "0")}"; fontSize: ls; color: muted; font: mono; maxLines: 1; width: (len("${floor(s / 60)}") + 3) * ls * 0.62 + 4 }
  }

  // Drawn, not glyphs: the launcher's icon font only carries weather symbols. Paths need an
  // explicit fill: to be filled. Play/pause is a solid disc with the glyph in the background color.
  component Control(kind, big = false) {
    Box {
      size: big ? ctl : round(ctl * 0.84)
      onTap: media(kind)
      Canvas {
        let cx = width / 2
        let cy = height / 2
        let d = min(width, height)
        if kind == "toggle" {
          circle(cx, cy, d / 2, fill: foreground)
          if m.playing == true {
            rect(cx - d * 0.15, cy - d * 0.18, d * 0.11, d * 0.36, radius: d * 0.03, fill: background)
            rect(cx + d * 0.04, cy - d * 0.18, d * 0.11, d * 0.36, radius: d * 0.03, fill: background)
          } else {
            // The triangle's centroid sits right of its box: nudge it so it looks centered.
            path([[cx - d * 0.12, cy - d * 0.2], [cx + d * 0.21, cy], [cx - d * 0.12, cy + d * 0.2]], closed: true, fill: background)
          }
        } else {
          let dir = kind == "next" ? 1 : -1
          path([[cx - d * 0.19 * dir, cy - d * 0.2], [cx + d * 0.1 * dir, cy], [cx - d * 0.19 * dir, cy + d * 0.2]], closed: true, fill: foreground)
          rect(dir > 0 ? cx + d * 0.1 : cx - d * 0.18, cy - d * 0.2, d * 0.08, d * 0.4, radius: d * 0.03, fill: foreground)
        }
      }
    }
  }

  // A small equalizer that only exists (and only animates) while something plays.
  component Bars() {
    Canvas {
      width: 14
      height: 12
      for i in range(3) {
        let h = 3 + (sin(time * (5 + i * 1.7) + i * 2) * 0.5 + 0.5) * (height - 3)
        rect(i * 5, height - h, 3, h, radius: 1, color: accent)
      }
    }
  }

  component Art(src, d) {
    Box {
      size: d
      radius: 8
      clip: true
      align: center
      if src != null {
        Image { src: src; fit: cover; fill: true }
      } else {
        // Gradients only fill inside a Canvas, not as a background.
        Canvas {
          rect(0, 0, width, height, fill: linear(0, 0, width, height, [alpha(accent, 0.55), alpha(magenta, 0.35)]))
          text("♪", width / 2, height / 2, size: d * 0.45, align: center, color: alpha(foreground, 0.85))
        }
      }
    }
  }

  // The source app, with a live equalizer while it plays.
  component AppLine() {
    Row {
      align: center
      gap: 6
      if m.playing == true {
        Bars { }
      }
      Text { text: lower(m.app ?? ""); fontSize: ls; color: m.playing == true ? accent : muted; maxLines: 1; weight: 1 }
    }
  }

  if !allowed {
    Column {
      justify: center
      gap: 6
      fill: height
      Text { text: "now playing"; fontSize: ls; color: muted }
      Text { text: "Allow notification access so the launcher can see what's playing. Tap to open the setting."; fontSize: clamp(floor(min(tw / 16, ih / 6)), 11, 22); maxLines: 4 }
    }
  } else {
    if !has {
      // Nothing playing: the art's note and two lines, at the same sizes.
      if tall {
        Column {
          gap: 8; fill: height; align: center
          Art { src: null; d: artD }
          Spacer { weight: 1 }
          Text { text: "nothing playing"; fontSize: clamp(floor(iw / (15 * 0.6)), 11, 40); color: muted; align: center; maxLines: 1 }
          Text { text: "start music in any app"; fontSize: clamp(floor(iw / (22 * 0.6)), 9, 28); color: muted; align: center; maxLines: 1 }
          Spacer { weight: 1 }
        }
      } else {
        Row {
          align: center; gap: 12; fill: height
          if side { Art { src: null; d: artD } }
          Column {
            weight: 1; gap: 2
            Text { text: "nothing playing"; fontSize: clamp(floor(min(tw / (15 * 0.6), ih * 0.3)), 11, 40); color: muted; maxLines: 1 }
            Text { text: "start music in any app"; fontSize: clamp(floor(min(tw / (22 * 0.6), ih * 0.2)), 9, 28); color: muted; maxLines: 1 }
          }
        }
      }
    } else {
      if tall {
        Column {
          gap: 8; fill: height
          Art { src: m.art; d: artD }
          Column {
            gap: 2; weight: 1; justify: center
            AppLine { }
            Text { text: title; fontSize: fs; bold: true; maxLines: 1 }
            if who != "" { Text { text: who; fontSize: ws; color: muted; maxLines: 1 } }
          }
          if dur > 0 {
            Progress { value: pos; max: dur; color: accent; track: alpha(muted, 0.2); height: clamp(round(ctl * 0.1), 3, 8); animate value: tween(900ms, "linear") }
            Row {
              align: center
              gap: 4
              Clock { s: pos }
              Spacer { weight: 1 }
              Clock { s: dur }
            }
          }
          Row {
            align: center
            gap: round(ctl * 0.3)
            Spacer { weight: 1 }
            Control { kind: "previous" }
            Control { kind: "toggle"; big: true }
            Control { kind: "next" }
            Spacer { weight: 1 }
          }
        }
      } else {
        Row {
          align: center
          gap: 12
          fill: height
          if side {
            Art { src: m.art; d: artD }
          }
          Column {
            weight: 1
            gap: 2
            fill: height
            AppLine { }
            Spacer { weight: 1 }
            Text { text: title; fontSize: fs; bold: true; maxLines: 1 }
            if who != "" { Text { text: who; fontSize: ws; color: muted; maxLines: 1 } }
            Spacer { weight: 1 }
            if dur > 0 {
              Progress { value: pos; max: dur; color: accent; track: alpha(muted, 0.2); height: clamp(round(ctl * 0.1), 3, 8); animate value: tween(900ms, "linear") }
            }
            Row {
              align: center
              gap: 4
              if dur > 0 {
                Clock { s: pos }
                Text { text: "/"; fontSize: ls; color: alpha(muted, 0.5); width: round(ls * 0.8) }
                Clock { s: dur }
              }
              Spacer { weight: 1 }
              Control { kind: "previous" }
              Control { kind: "toggle"; big: true }
              Control { kind: "next" }
            }
          }
        }
      }
    }
  }
}
