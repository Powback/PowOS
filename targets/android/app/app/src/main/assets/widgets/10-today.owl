widget "today" {
  page: 1
  order: 1
  size: 3x3
  minSize: 3x2
  meta { description: "The date and the weather where you are, by IP or a city you type. Tap it for the next 24 hours, three days, wind, UV, sun and moon"; version: "1.4"; license: "MIT"; category: "world"; owl: 5 }

  source now = clock every 1m
  state city = "" persist
  // The city, percent-encoded so "/", "?", "&" or "#" in it can't break the URL. Empty means located by IP.
  let q = city.replace("%", "%25").replace("+", "%2B").replace("/", "%2F").replace("?", "%3F").replace("#", "%23").replace("&", "%26").replace("'", "%27").replace(" ", "+")
  // One request. Icons and °F countries match omarchy's weather panel.
  source wx = http("https://wttr.in/${q}?format=j1") every 30m timeout 10s json
  let cur = wx.current_condition[0]
  let day = wx.weather[0]
  let area = wx.nearest_area[0]
  let imperial = contains(["united states", "united states of america", "liberia", "myanmar", "burma"], lower(trim(area.country[0].value)))
  let unit = imperial ? "F" : "C"
  let night = contains(cur.weatherIconUrl[0].value, "_night")
  // Clear or partly cloudy gets a warm sun or a cool moon; everything else stays neutral.
  let sky = contains(["113", "116"], cur.weatherCode) ? (night ? blue : yellow) : foreground
  // wttr gives "07:16 AM"; show 24-hour time.
  let sun = [day.astronomy[0].sunrise, day.astronomy[0].sunset]
    .map(s => match(s ?? "", "(\\d+):(\\d+) (AM|PM)"))
    .map(m => m == null ? "" : pad(int(num(m[0]) % 12 + (m[2] == "PM" ? 12 : 0)), 2, "0") + ":" + m[1])
  let sunHours = sun.map(s => num(sub(s, 0, 2)))
  let hourNow = num(fmtTime(now, "H"))
  // The next 24 hours in wttr's 3-hour steps, from today's and tomorrow's forecasts.
  let steps = flatten(range(2).map(i => (wx.weather[i].hourly ?? []).map(h => {
    hr: i * 24 + num(h.time) / 100,
    t: num(get(h, "temp" + unit)),
    rain: num(h.chanceofrain),
    code: h.weatherCode
  }))).filter(s => s.hr > hourNow - 3).take(8)
  // The three days' range, so their bars share one scale.
  let lowest = min((wx.weather ?? []).map(d => num(get(d, "mintemp" + unit))))
  let highest = max((wx.weather ?? []).map(d => num(get(d, "maxtemp" + unit))))
  let moonIcons = {
    "New Moon": "", "Waxing Crescent": "", "First Quarter": "", "Waxing Gibbous": "",
    "Full Moon": "", "Waning Gibbous": "", "Last Quarter": "", "Waning Crescent": ""
  }
  let uv = num(cur.uvIndex)

  onTap: screen()

  component Rule() {
    Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
  }

  component Stat(glyph, label, value, tint = foreground) {
    Row {
      gap: 10
      align: center
      padding: [10, 8]
      Text { text: glyph; font: icon; fontSize: 22; color: tint; width: 28; align: center }
      Column {
        gap: 0
        weight: 1
        Text { text: label; style: label; color: muted; maxLines: 1 }
        Text { text: value; style: body; maxLines: 1 }
      }
    }
  }

  // The tile: the day and place on one line, now large, then the wind and rain, then the next hours as a light strip.
  // Everything scales to the tile instead of floating in it: the temperature's size follows the tile's height, the
  // hours strip takes as many 3-hour steps as fit across, and each line shows only when there's room for it, the
  // spacers between them sharing what's left. The rest (UV, the days ahead, sun and moon) is a tap away, in the screen.
  // Narrow (a 3-column tile is about 170dp): now stacked - the temperature, then one line of sky, range and place.
  // Wider: the sky and the range beside the temperature, the place in the top line.
  let iw = tileWidth == null ? 154 : tileWidth - 24
  let ih = tileHeight == null ? 160 : tileHeight - 24
  let narrow = iw < 236
  // Every size follows the tile: the temperature about 30% of its height, the small lines and the hours strip in step
  // with it (a big tile is a big forecast, not a small one in a lot of glass).
  // Without the hours strip (under 3 rows, unless wide) the temperature takes more of the height; on a wide tile its width
  // bounds it too.
  let hoursRoom = rows == null || rows >= 3 || iw >= 440
  // A wide tile (the inner screen's 4 columns) has the next three days beside now - the width used for more forecast,
  // not more glass; their text sized to their column (~11.5 of it across).
  let days3 = !narrow && iw >= 440 && ih < 420
  // The temperature never truncates: its size leaves room for the widest it shows ("-13°", 4 characters at ~0.62 em on
  // the phone's font) beside its icon (~0.95 big) and, narrow, the high and low (4 characters at 1.2 fs); wide, ~90 dp
  // left beside it for the sky and "-8° / -13°" (140 for the days) - "13°" was cut to "1…" on a 3x3 when the width
  // it got was only what the icon and the range left.
  let fs0 = clamp(round(ih * 0.055), 11, 24)
  // Without the days beside it, now is stacked on any tile: the icon, the temperature and the high and low on a line,
  // the sky under it - a sky beside the temperature left it, or the sky, too little room for "-13°".
  let stacked = narrow || !days3
  let tempRoom = stacked ? (iw - 16 - 4 * 0.62 * round(fs0 * 1.2)) / (0.95 + 4 * 0.62) : (iw - 20 - 140) / (1 + 4.4 * 0.62)
  let big = clamp(floor(min(ih * (hoursRoom ? 0.3 : 0.46), iw * (stacked ? 0.3 : 0.2), tempRoom)), 18, 150)
  // The days take what the temperature leaves (the sky's words go to the line under it), their text as big as both
  // that width (~11.5 of it across) and three lines beside the temperature allow.
  // The temperature as wide as what it shows (its size already leaves room for "-13°"), the side or the days the rest.
  let tempText = "${get(cur, "temp_" + unit)}°"
  let tempW = ceil((len(tempText) + 0.4) * 0.62 * big)
  // What the row leaves the days: the icon (big), the temperature (tempW), a 10 dp spacer and two 10 dp gaps.
  let daysW = days3 ? iw - big - tempW - 40 : 0
  let fs = clamp(round(ih * 0.055), 11, 24)
  // A day's row: its name, an icon and two temperatures as wide as "-13°" (~17 characters across).
  // A day's row ~12.5 em: its name, the icon (1.7), two temperatures as wide as "-13°" (2.8 each) and the gaps.
  let dfs = clamp(min(floor(daysW / 12.5), floor(big * 0.36)), 8, 30)
  let hw = round(fs * 3.3)
  // Beside the temperature on a wide tile: what its icon (~big) and its digits (~1.9 big) leave.
  // The row's two 10 dp gaps counted (a side reckoned 40 wide was 14).
  let sideW = max(iw - big - tempW - 20, 30)
  let hours = clamp(floor(iw / (hw + 10)), 3, 8)
  // Lines are added by priority only while they fit the tile's real height (never half-clipped): the top line and now
  // (the top line + the temperature's line + one small line) always, then the place/wind-and-rain line, then the hours.
  let base = fs * 1.5 + big * 1.25 + fs * 1.5
  let detailed = ih >= base + fs * 1.6
  let hourly = hoursRoom && ih >= base + (detailed ? fs * 1.6 : 0) + fs * 4.6
  // A tall tile not wide enough for the days beside now: the days under the hours, when there's room for three lines.
  let daysBelow = !days3 && hourly && ih >= base + fs * 1.6 + fs * 4.6 + fs * 6.5
  let rainToday = max((day.hourly ?? []).map(h => num(h.chanceofrain)))
  let wind = imperial ? "${cur.windspeedMiles} mph" : "${cur.windspeedKmph} km/h"
  Column {
    gap: 0
    weight: 1
    Row {
      gap: 6
      align: center
      Text { text: lower(fmtTime(now, "EEEE")); fontSize: fs; color: accent; maxLines: 1 }
      Text { text: lower(fmtTime(now, "d MMM")); fontSize: fs; color: muted; maxLines: 1; weight: 1 }
      if area != null && !narrow {
        Text { text: lower(area.areaName[0].value); fontSize: fs; color: muted; maxLines: 1; align: end }
      }
    }
    Spacer { weight: 1 }
    if cur != null {
      if stacked {
        // Now, and today's high and low at its right; the sky in words under it.
        Row {
          gap: 8
          align: center
          Text { text: weatherIcon(cur.weatherCode, night); font: icon; fontSize: round(big * 0.85); color: sky; width: round(big * 0.95); align: center }
          Text { text: tempText; fontSize: big; maxLines: 1; weight: 1 }
          Column {
            gap: 0
            Text { text: "${get(day, "maxtemp" + unit)}°"; fontSize: round(fs * 1.2); align: end; maxLines: 1 }
            Text { text: "${get(day, "mintemp" + unit)}°"; fontSize: round(fs * 1.2); color: muted; align: end; maxLines: 1 }
          }
        }
        Text {
          text: lower(trim(cur.weatherDesc[0].value))
          // As big as the line allows: never an ellipsis.
          fontSize: clamp(min(fs, floor(iw / (len(trim(cur.weatherDesc[0].value)) * 0.62))), 9, 24)
          color: muted
          maxLines: 1
        }
      } else {
        Row {
          gap: 10
          align: center
          Text { text: weatherIcon(cur.weatherCode, night); font: icon; fontSize: round(big * 0.9); color: sky; width: round(big); align: center }
          Text { text: tempText; fontSize: big; maxLines: 1; width: tempW }
          if days3 {
            Spacer { width: 10 }
          } else {
          Column {
            gap: 2
            weight: 1
            // The room beside the temperature: the sky on up to two lines, the range under it.
            // In its two lines whatever its length (~1.8 lines' worth of characters, words wrap).
            Text { text: lower(trim(cur.weatherDesc[0].value)); fontSize: clamp(min(round(fs * 1.15), floor(sideW / 7), floor(sideW / (max(ceil(len(trim(cur.weatherDesc[0].value)) / 2) + 5, max(words(cur.weatherDesc[0].value).map(x => len(x)))) * 0.62))), 7, 28); align: end; maxLines: 2 }
            Text { text: "${get(day, "maxtemp" + unit)}° / ${get(day, "mintemp" + unit)}°"; fontSize: clamp(min(round(fs * 1.15), floor(sideW / 7), floor(sideW / (len("${get(day, "maxtemp" + unit)}° / ${get(day, "mintemp" + unit)}°") * 0.62))), 7, 28); color: muted; align: end; maxLines: 1 }
          }
          }
          if days3 {
            Column {
              gap: round(dfs * 0.35)
              weight: 1
              for d, i in wx.weather key d.date {
                Row {
                  gap: round(dfs * 0.4)
                  align: center
                  Text { text: i == 0 ? "today" : lower(fmtTime(now + 86400 * i, "EEE")); fontSize: dfs; maxLines: 1; weight: 1 }
                  Text { text: weatherIcon(d.hourly[4].weatherCode, false); font: icon; fontSize: round(dfs * 1.3); width: round(dfs * 1.7); align: center; color: muted }
                  Text { text: "${get(d, "mintemp" + unit)}°"; fontSize: dfs; color: muted; width: round(dfs * 2.8); align: end; maxLines: 1 }
                  Text { text: "${get(d, "maxtemp" + unit)}°"; fontSize: dfs; width: round(dfs * 2.8); align: end; maxLines: 1 }
                }
              }
            }
          }
        }
      }
      if detailed {
        Spacer { weight: 1 }
        // Today's rain chance (what decides an umbrella) on one line with the place when narrow (it has no room in the
        // top line there), with the wind when wide (the place is in the top line).
        Row {
          gap: 6
          align: center
          if narrow {
            Text { text: area != null ? lower(area.areaName[0].value) : ""; fontSize: fs; color: muted; maxLines: 1; weight: 1 }
          } else if days3 {
            // As big as the line beside "rain 100%" allows: never an ellipsis.
            Text { text: "${lower(trim(cur.weatherDesc[0].value))} · wind ${wind}"; fontSize: clamp(min(fs, floor((iw - 10 * 0.62 * fs - 12) / (len("${trim(cur.weatherDesc[0].value)} · wind ${wind}") * 0.62))), 8, 24); color: cyan; maxLines: 1; weight: 1 }
          } else {
            Text { text: "wind ${wind}"; fontSize: fs; color: cyan; maxLines: 1; weight: 1 }
          }
          Text { text: "rain ${rainToday}%"; fontSize: fs; color: rainToday >= 30 ? blue : muted; maxLines: 1 }
        }
      }
      if hourly {
        Spacer { weight: 1 }
        // Fixed-width hours spread over the row (fill: across the whole tile, not only as wide as the hours): shared by
        // weight, the first one came out squeezed ("n…").
        Row {
          gap: 0
          fill: width
          justify: spaceBetween
          for s in steps.take(hours) key s.hr {
            Column {
              gap: round(fs * 0.2)
              width: hw
              align: center
              Text { text: s.hr == hourNow - hourNow % 3 ? "now" : pad(s.hr % 24, 2, "0"); fontSize: fs; color: muted; align: center }
              Text { text: weatherIcon(s.code, s.hr % 24 < sunHours[0] || s.hr % 24 >= sunHours[1]); font: icon; fontSize: round(fs * 1.5); align: center; color: muted }
              Text { text: "${s.t}°"; fontSize: round(fs * 1.15); align: center; maxLines: 1 }
            }
          }
        }
      }
      if daysBelow {
        Spacer { weight: 1 }
        Column {
          gap: round(fs * 0.45)
          for d, i in wx.weather key d.date {
            Row {
              gap: round(fs * 0.6)
              align: center
              Text { text: i == 0 ? "today" : lower(fmtTime(now + 86400 * i, "EEE")); fontSize: round(fs * 1.1); maxLines: 1; weight: 1 }
              Text { text: weatherIcon(d.hourly[4].weatherCode, false); font: icon; fontSize: round(fs * 1.4); width: round(fs * 1.9); align: center; color: muted }
              Text { text: "${max(d.hourly.map(h => num(h.chanceofrain)))}%"; fontSize: fs; color: blue; width: round(fs * 3); align: end; maxLines: 1 }
              Text { text: "${get(d, "mintemp" + unit)}°"; fontSize: round(fs * 1.1); color: muted; width: round(fs * 2.6); align: end; maxLines: 1 }
              Text { text: "${get(d, "maxtemp" + unit)}°"; fontSize: round(fs * 1.1); width: round(fs * 2.6); align: end; maxLines: 1 }
            }
          }
        }
      }
    } else {
      Text { text: wx == null ? "weather…" : "weather offline"; style: small; color: muted }
      Spacer { weight: 1 }
    }
  }

  screen {
    title: "weather"
    if cur == null {
      Text { text: wx == null ? "weather…" : "weather offline"; style: body; color: muted }
    } else {
      Column {
        scroll: true
        gap: 14
        // Now.
        Row {
          gap: 16
          align: center
          Text { text: weatherIcon(cur.weatherCode, night); font: icon; fontSize: 64; color: sky; width: 80; align: center }
          Column {
            gap: 0
            weight: 1
            Text { text: "${get(cur, "temp_" + unit)}°${unit}"; fontSize: 44; color: cyan; maxLines: 1 }
            Text { text: lower(trim(cur.weatherDesc[0].value)); style: body; maxLines: 2 }
          }
        }
        Text {
          text: "feels ${get(cur, "FeelsLike" + unit)}° · ↑${get(day, "maxtemp" + unit)}° ↓${get(day, "mintemp" + unit)}° · ${lower(area.areaName[0].value)}, ${lower(area.country[0].value)}"
          style: small
          color: muted
        }
        Rule { }
        Grid {
          columns: 2
          gap: 8
          Stat { glyph: ""; label: "wind ${lower(cur.winddir16Point)}"; value: imperial ? "${cur.windspeedMiles} mph" : "${cur.windspeedKmph} km/h"; tint: cyan }
          Stat { glyph: ""; label: "humidity"; value: "${cur.humidity}%"; tint: blue }
          Stat { glyph: ""; label: "rain today"; value: "${max(day.hourly.map(h => num(h.chanceofrain)))}% · ${imperial ? cur.precipInches + " in" : cur.precipMM + " mm"}"; tint: blue }
          Stat { glyph: ""; label: "uv index"; value: "${uv} ${uv >= 8 ? "very high" : uv >= 6 ? "high" : uv >= 3 ? "moderate" : "low"}"; tint: uv >= 6 ? red : uv >= 3 ? yellow : green }
          Stat { glyph: ""; label: "pressure"; value: imperial ? "${cur.pressureInches} inHg" : "${cur.pressure} hPa" }
          Stat { glyph: ""; label: "visibility"; value: imperial ? "${cur.visibilityMiles} mi" : "${cur.visibility} km" }
        }
        Rule { }
        // The next 24 hours: time, icon and rain chance per step, with the temperature curve under them.
        Text { text: "next 24 hours"; style: label; color: accent }
        Column {
          gap: 4
          Row {
            gap: 0
            for s in steps key s.hr {
              Column {
                gap: 2
                weight: 1
                align: center
                Text { text: s.hr == hourNow - hourNow % 3 ? "now" : pad(s.hr % 24, 2, "0"); style: label; color: muted; align: center }
                Text { text: weatherIcon(s.code, s.hr % 24 < sunHours[0] || s.hr % 24 >= sunHours[1]); font: icon; fontSize: 20; align: center }
              }
            }
          }
          Canvas {
            height: 84
            fill: width
            let n = max(len(steps), 1)
            let temps = steps.map(s => s.t)
            let lo = min(temps)
            let hi = max(temps)
            let ys = temps.map(t => 22 + (hi - t) / max(hi - lo, 1) * 26)
            let xs = range(n).map(i => (i + 0.5) * width / n)
            path(range(n).map(i => [xs[i], ys[i]]), stroke: accent, width: 2)
            for s, i in steps {
              circle(xs[i], ys[i], 3, fill: accent)
              text("${s.t}°", xs[i], ys[i] - 13, size: 12, align: center, color: foreground)
              rect(xs[i] - 10, height - 12, 20, 4, radius: 2, fill: alpha(muted, 0.2))
              rect(xs[i] - 10, height - 12, 20 * s.rain / 100, 4, radius: 2, fill: blue)
              text("${s.rain}%", xs[i], height - 24, size: 10, align: center, color: s.rain >= 30 ? blue : muted)
            }
          }
        }
        Rule { }
        // Three days: icon, rain chance and the day's low to high on a shared scale.
        Text { text: "3 days"; style: label; color: accent }
        for d, i in wx.weather key d.date {
          let lo = num(get(d, "mintemp" + unit))
          let hi = num(get(d, "maxtemp" + unit))
          Row {
            gap: 8
            align: center
            Text { text: i == 0 ? "today" : lower(fmtTime(now + 86400 * i, "EEE")); style: body; width: 52; maxLines: 1 }
            Text { text: weatherIcon(d.hourly[4].weatherCode, false); font: icon; fontSize: 20; width: 26; align: center }
            Text { text: "${max(d.hourly.map(h => num(h.chanceofrain)))}%"; style: small; color: blue; width: 40; align: end; maxLines: 1 }
            Text { text: "${lo}°"; style: small; color: muted; width: 36; align: end; maxLines: 1 }
            Canvas {
              height: 6
              weight: 1
              let span = max(highest - lowest, 1)
              let x0 = (lo - lowest) / span * width
              let x1 = (hi - lowest) / span * width
              rect(0, 0, width, height, radius: 3, fill: alpha(muted, 0.2))
              rect(x0, 0, max(x1 - x0, 6), height, radius: 3, fill: linear(0, 0, width, 0, [cyan, orange]))
            }
            Text { text: "${hi}°"; style: small; width: 36; maxLines: 1 }
          }
        }
        Rule { }
        // Sun and moon.
        Row {
          gap: 8
          Stat { glyph: ""; label: "sunrise"; value: sun[0]; tint: yellow; weight: 1 }
          Stat { glyph: ""; label: "sunset"; value: sun[1]; tint: orange; weight: 1 }
        }
        Stat {
          glyph: get(moonIcons, day.astronomy[0].moon_phase, "")
          label: "moon"
          value: "${lower(day.astronomy[0].moon_phase)} · ${day.astronomy[0].moon_illumination}% lit"
          tint: foreground
        }
        // yr.no (Norwegian Meteorological Institute): ad-free and worldwide, opened at wttr's coordinates.
        Row {
          justify: end
          Button { text: "open yr.no ↗"; color: muted; onTap: url("https://www.yr.no/en/forecast/daily-table/${area.latitude},${area.longitude}") }
        }
      }
    }
    // The place: where you are (by IP) unless a city is typed here - last, out of the forecast's way, and there
    // offline too (a wrong city is how it goes offline).
    Input {
      text: city
      placeholder: "city"
      onSubmit: { city = trim(value); refresh() }
    }
  }
}
