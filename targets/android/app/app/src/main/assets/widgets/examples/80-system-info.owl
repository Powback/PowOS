widget "system" {
  page: 2
  order: 4
  size: 6x3
  minSize: 3x2
  meta { owl: 6 }

  requires { pacman: ["procps-ng", "fastfetch"] }

  source info = cmd("printf '{\"kernel\":\"%s\",\"packages\":%s,\"up\":\"%s\"}' \"$(uname -r | cut -d- -f1)\" \"$(pacman -Q | wc -l)\" \"$(uptime -p | sed 's/up //')\"") every 10m json

  onTap: terminal("fastfetch")

  // Four lines sized from the tile, never fixed (monospace: 0.6 em a character, a line 1.4 em budgeted), centred:
  // one column, or on a wide tile a 2 x 2 of soft chips, each line as big as the longest one's width and the height allow, spread over
  // the height. "16 hours, 36 minutes" says "16h 36m".
  let iw = tileWidth == null ? 154 : tileWidth - 24
  let ih = tileHeight == null ? 106 : tileHeight - 24
  let up = replace(replace(replace(replace(replace(replace(replace(info.up ?? "", " minutes", "m"), " minute", "m"), " hours", "h"), " hour", "h"), " days", "d"), " day", "d"), ",", "")
  let rows = ["arch linux arm", "kernel ${info.kernel}", "${info.packages} packages", "up ${up}"]
  let longest = max(rows.map(r => len(r)))
  let wide = iw > ih * 1.5
  let fs = clamp(floor(wide ? min((iw - 8) / 2 / (longest * 0.6) - 3, (ih - 8) / 2 / 1.4 - 4) : min(iw / (longest * 0.6), ih / (4 * 1.4))), 9, 96)

  if wide {
    Row {
      gap: 8; fill: true
      for col in [[0, 1], [2, 3]] {
        Column {
          weight: 1; gap: 8; fill: height
          for i in col {
            Box {
              weight: 1; fill: width; align: center; background: alpha(foreground, 0.07); radius: 8 * corners
              Text { text: rows[i]; fontSize: fs; color: i == 0 ? muted : foreground; align: center; maxLines: 1 }
            }
          }
        }
      }
    }
  } else {
    Column {
      gap: 0; fill: height; justify: spaceBetween; align: center
      for r, i in rows {
        Text { text: r; fontSize: fs; color: i == 0 ? muted : foreground; align: center; maxLines: 1 }
      }
    }
  }
}
