+ btop                         btop
+ duf                          duf
+ fastfetch                    fastfetch
+ fish                         fish
+ glow                         glow
+ gum                          gum
+ jq                           jq
+ kdeconnectd                  kdeconnect
+ kdeplasma-addons             kdeplasma-addons
+ kio-extras                   kio-extras
+ krdp                         krdp
+ lsb_release                  lsb-release
+ lzip                         lzip
+ p7zip                        7zip
+ p7zip-plugins                7zip
+ rar                          unrar
+ sqlite                       sqlite
- topgrade                     not in Arch Linux ARM (AUR); `pacman -Syu` covers the phone
+ unzip                        unzip
+ uv                           uv
+ vim                          vim
+ vulkan-tools                 vulkan-tools
+ wmctrl                       wmctrl
+ xdg-user-dirs                xdg-user-dirs
+ xdotool                      xdotool
+ xrandr                       xorg-xrandr
+ xwininfo                     xorg-xwininfo
+ yad                          yad
+ python3-pip                  python-pip
+ libadwaita                   libadwaita
+ gobject-introspection        gobject-introspection
+ dbus-x11                     dbus
+ libxcrypt-compat             libxcrypt-compat
+ pulseaudio-utils             libpulse
+ libnice-gstreamer1           libnice
+ ladspa-noise-suppression-for-voice noise-suppression-for-voice
- ladspa-caps-plugins          LADSPA effects bundle, not packaged for aarch64
- pipewire-module-filter-chain-sofa spatial-audio filter; Android routes audio
- ptyxis                       Konsole is PowOS's terminal
- bazaar                       Flathub front-end (GTK); Discover + Flathub on the phone instead
- krunner-bazaar               same
- webapp-manager               Linux Mint tool, not in Arch ARM
- rom-properties-kf6           not in Arch ARM
- python3-icoextract           Windows icon extraction for game launchers; not packaged
- Sunshine                     game-stream host; the phone is the client side (AUR only)
- maliit-keyboard              Android's own keyboard types into KWin
- fcitx5-chinese-addons        input methods: Android's keyboard handles languages
- fcitx5-hangul                same
- fcitx5-mozc                  same
- kcm-fcitx5                   same

# Fonts
+ google-noto-sans-cjk-fonts   noto-fonts-cjk
+ fira-code-fonts              ttf-fira-code
+ lato-fonts                   ttf-lato
+ nerd-fonts                   ttf-nerd-fonts-symbols
- twitter-twemoji-fonts        noto-fonts-emoji already covers emoji

# PC hardware and system administration: not reachable from an Android app
- openrgb                      RGB over SMBus/USB HID
- piper                        gaming mouse config over USB HID
- logiops                      Logitech HID++ daemon
- i2c-tools                    I2C buses
- lm_sensors                   hardware sensors
- ddcutil                      monitor DDC/CI
- libcec                       HDMI-CEC
- xwiimote-ng                  Wii remote kernel driver
- libinput-utils               libinput debugging (input comes from Android)
- iwd                          Android owns Wi-Fi
- tailscale                    one VPN per phone: use the Android Tailscale app
- libfreeaptx                  Bluetooth codecs: Android owns Bluetooth
- ydotool                      needs /dev/uinput
- wlr-randr                    wlroots-only tool
- lshw                         hardware listing needs /sys and root
- f3                           flash-drive testing
- stress-ng                    stress testing
- gnome-disk-utility           no block devices for apps
- btrfs-assistant              no btrfs
- compsize                     same
- duperemove                   same
- snapper                      same
- edk2-ovmf                    VMs need KVM
- qemu                         same
- libvirt                      same
- waydroid                     Android inside Android
- podman-compose               containers need namespaces, denied to apps
- podman-docker                same
- cockpit-files                web admin over systemd
- cockpit-networkmanager       same
- cockpit-podman               same
- cockpit-selinux              same
- cockpit-storaged             same
- cockpit-system               same
- udica                        SELinux policy generator
- uupd                         bootc/rpm update service
- dnf5-plugins                 Fedora package manager
- cpulimit                     not in Arch ARM; Android schedules the app
- libaacs                      Blu-ray decryption
- libbdplus                    same
- libbluray                    Blu-ray
- libbluray-utils              same
