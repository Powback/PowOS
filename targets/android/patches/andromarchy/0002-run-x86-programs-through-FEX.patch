+    path = self_exe_target(path);
+    // x86 programs (Steam's bootstrapper, x86 Linux games): what binfmt_misc does for FEX on a Linux PC, which
+    // Android does not let an app register. Exec FEXInterpreter with the program as its first argument.
+    if (path && x86_program(path) && access("/usr/bin/FEXInterpreter", X_OK) == 0) {
+        size_t argc = 0;
+        while (argv && argv[argc])
+            argc++;
+        // FEXInterpreter <program> <argv[1..]>: the program's own argv[0] is replaced by its path, as binfmt does.
+        char *fex_argv[argc + 3];
+        size_t k = 0;
+        fex_argv[k++] = "FEXInterpreter";
+        fex_argv[k++] = (char *)path;
+        for (size_t i = 1; i < argc; i++)
+            fex_argv[k++] = argv[i];
+        fex_argv[k] = NULL;
+        return next("/usr/bin/FEXInterpreter", fex_argv, env);
+    }
+    return next(path, argv, env);
