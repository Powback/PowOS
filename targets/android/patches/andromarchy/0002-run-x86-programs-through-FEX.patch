+// ELF e_machine of an x86 (EM_386, 3) or x86-64 (EM_X86_64, 62) program. open() goes through fakechroot, so the
+// guest path works as given.
+static int x86_program(const char *path)
+{
+    unsigned char h[20];
+    int fd = open(path, O_RDONLY | O_CLOEXEC);
+    if (fd < 0)
+        return 0;
+    ssize_t r = read(fd, h, sizeof h);
+    close(fd);
+    if (r < (ssize_t)sizeof h || h[0] != 0x7f || h[1] != 'E' || h[2] != 'L' || h[3] != 'F' || h[5] != 1)
+        return 0;
+    unsigned machine = h[18] | (h[19] << 8);
+    return machine == 3 || machine == 62;
+}
