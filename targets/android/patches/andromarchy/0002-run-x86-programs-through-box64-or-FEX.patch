+    // box64 first: it runs x86 code against the NATIVE glibc for library calls, so file access goes through
+    // fakechroot like any program here. FEX performs the guest's syscalls raw: they reach Android's real
+    // filesystem, not the rootfs (PowOS's steam failed "cd /usr/bin" under FEX on the S25). FEX stays the
+    // fallback (its interpreter is /usr/bin/FEX since FEX-2604, FEXInterpreter before).
+    const char *fex = access("/usr/bin/box64", X_OK) == 0  ? "/usr/bin/box64"
+                      : access("/usr/bin/FEX", X_OK) == 0 ? "/usr/bin/FEX"
+                                                          : "/usr/bin/FEXInterpreter";
+    if (path && x86_program(path) && access(fex, X_OK) == 0) {
+        size_t argc = 0;
+        while (argv && argv[argc])
+            argc++;
+        // FEXInterpreter <program> <argv[1..]>: the program's own argv[0] is replaced by its path, as binfmt does.
+        char *fex_argv[argc + 3];
+        size_t k = 0;
+        fex_argv[k++] = (char *)fex;
+        fex_argv[k++] = (char *)path;
+        for (size_t i = 1; i < argc; i++)
+            fex_argv[k++] = argv[i];
+        fex_argv[k] = NULL;
+        return next(fex, fex_argv, env);
+    }
+    return next(path, argv, env);
 }
 
