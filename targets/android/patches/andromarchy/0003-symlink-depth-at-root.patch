diff --git a/native/android-compat.c b/native/android-compat.c
--- a/native/android-compat.c	2026-10-13 08:07:03
+++ b/native/android-compat.c	2026-10-13 08:07:03
@@ -1822,7 +1822,10 @@
                 return -1;
             base[n] = 0;
         }
-        snprintf(tmp, sizeof tmp, "%s/%s", base, d);
+        // A base of "/" (tar -C / extracting "usr/bin/steam") must not give "//usr/bin": the ".." count below
