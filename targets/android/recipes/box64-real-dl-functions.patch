+// PowOS (Android, no root): how the real dlopen/dlclose/dlsym are found. These hooks are exported from the box64
+// executable, so they interpose every library's calls, fakechroot's included (the LD_PRELOAD that makes an
+// app-private rootfs look like /). Upstream resolves them with GetNativeSymbolUnversioned, which walks the loaded
+// objects with dl_iterate_phdr; fakechroot wraps dl_iterate_phdr and resolves its own next functions through
+// dlsym - which lands back here: unbounded recursion, a segfault before main (even "box64 --version").
+// libc's dlsym comes from dlvsym (neither exported by box64 nor wrapped by fakechroot); every other function is
+// looked up with it, called from here, so RTLD_NEXT means "after the box64 executable": fakechroot's dlopen when
+// it is preloaded (its path rewriting is what lets native libraries, e.g. the Vulkan loader, dlopen inside the
+// rootfs), libc's otherwise.
+static void* real_dl(const char* name)
+{
+    static void* (*libc_dlsym)(void*, const char*) = NULL;
+    if(!libc_dlsym) libc_dlsym = dlvsym(RTLD_NEXT, "dlsym", "GLIBC_2.34");
+    if(!libc_dlsym) libc_dlsym = dlvsym(RTLD_NEXT, "dlsym", "GLIBC_2.17");
+    if(!strcmp(name, "dlsym") && libc_dlsym) return (void*)libc_dlsym;
+    void* p = libc_dlsym ? libc_dlsym(RTLD_NEXT, name) : NULL;  // not a tail call: RTLD_NEXT is relative to here
+    if(!p) p = GetNativeSymbolUnversioned(RTLD_NEXT, name);
+    return p;
+}
