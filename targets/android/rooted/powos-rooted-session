#!/bin/bash
# /usr/bin/powos-rooted-session in /data/powos/root: the session's services, then the PowOS desktop (KDE Plasma on
# KWin's Anland backend) - what the no-root app engine starts one by one through lotfix-run (SessionService), here as
# plain root processes in PowOS's own system. Started by /data/powos/powos-session.sh with the environment set.
set -u
R=$XDG_RUNTIME_DIR
cd /root
# Android's root, left at /.oldroot by powos-session.sh's pivot_root: detached, PowOS sees only its own system.
mountpoint -q /.oldroot && umount -l /.oldroot

# The whole session runs in a process group of its own, so a restarted app (new display daemon) can end the
# previous session completely. Killing by name missed processes: comm is cut at 15 characters
# (kwin_wayland_wrapper, startplasma-wayland never matched), and the surviving wrapper respawned its KWin, two KWins
# then fought over the screen (flickering).
[ -z "${POWOS_SESSION_GROUP:-}" ] && POWOS_SESSION_GROUP=1 exec setsid -w "$0" "$@"
PGFILE=/run/powos-rooted-session.pgid
if [ -s "$PGFILE" ]; then
  old=$(cat "$PGFILE")
  if [ "$old" != "$$" ]; then
    kill -TERM -- "-$old" 2>/dev/null
    for _ in $(seq 30); do kill -0 -- "-$old" 2>/dev/null || break; sleep 0.1; done
    kill -KILL -- "-$old" 2>/dev/null
  fi
fi
echo $$ > "$PGFILE"
# Sessions started before the process group existed: by full command line.
pkill -KILL -f '^(/usr/bin/)?(startplasma-wayland|plasma_session|kwin_wayland_wrapper|kwin_wayland|plasmashell|pipewire|wireplumber|pipewire-pulse)( |$)' 2>/dev/null
pkill -KILL -f "dbus-daemon.*$R/" 2>/dev/null
sleep 0.3
# What a previous session left in the app's run dir: its sockets and locks (root-owned ones from sessions that ran
# as root would lock the user out: pipewire "failed to create context: Permission denied").
rm -f "$R"/bus "$R"/system_bus "$R"/pipewire-0* "$R"/wayland-* "$R"/kwin-xwayland-*
# Podman's per-boot runtime state (XDG_RUNTIME_DIR is this dir, which outlives a reboot, unlike a real /run): left
# over, every podman call failed ("current system boot ID differs from cached boot ID") and the Containers widget
# showed nothing. No container survives the previous session anyway.
rm -rf "$R"/containers "$R"/libpod/tmp "$R"/crun "$R"/netns
chown -R powos:powos "$R"   # the app's own dir: powos is the app's uid

# GPU: Mesa on KGSL (Adreno; Android has no /dev/dri). In the no-root engine lotfix-run sets these.
export TURNIP_KMD=kgsl FD_FORCE_KGSL=1
# HACK: freedreno's UBWC (compressed textures) on KGSL left Plasma's SVG textures (panel, widgets, theme previews)
# as noise blocks on the OnePlus Open (Adreno 740, Mesa 26.3). Real fix: find and report the UBWC bug in Mesa's
# KGSL path. Same switch in session/Hyprland for the no-root app.
export FD_MESA_DEBUG=noubwc
# OpenGL driver: freedreno's own GL, or zink (GL on Turnip's Vulkan) - Andromarchy's ARCH_GPU switch.
# /etc/powos/gl picks one; default freedreno.
case $(cat /etc/powos/gl 2>/dev/null) in
  zink) export MESA_LOADER_DRIVER_OVERRIDE=zink GALLIUM_DRIVER=zink ;;
  *)    export MESA_LOADER_DRIVER_OVERRIDE=kgsl GALLIUM_DRIVER=freedreno ;;
esac
# Per-phone overrides for the whole session (KEY=value lines, e.g. Mesa debug switches).
[ -f /etc/powos/session.env ] && { set -a; . /etc/powos/session.env; set +a; }
export XWAYLAND_FORCE_KGSL_SURFACELESS=1 ANDROMARCHY_NO_DRM_DEVICE=1
# Hardware video decode/encode (VA-API): Mesa's termuxva driver talks to the PowOS app's termux-va daemon, which
# uses Android's MediaCodec - the same as the no-root engine (SessionService.archEnv). Android apps in PowOS windows
# (scrcpy) decode their stream with it instead of the CPU.
if [ -e /usr/lib/dri/termuxva_drv_video.so ]; then
  export LIBVA_DRIVER_NAME=termuxva TERMUX_VA_BRIDGE=1 TERMUX_VA_GPU_BACKEND=kgsl TERMUX_VA_SOCKET="$R/termux-va.sock"
fi
export POWOS_SESSION_MODE=rooted
# Open files: what systemd gives a desktop (DefaultLimitNOFILE=1024:524288) and more - Proton enables esync only with
# a hard limit of at least 524288. Android's 32768 left Wine on wineserver round trips for every lock and event
# (no fsync/ntsync on this 5.15 kernel): Besiege ran at ~6 fps with the GPU 40% idle. Raised as root, inherited by all.
ulimit -n 1048576
# No journald on a phone: Qt sends its messages (KWin, Plasma) there whenever stderr is not a terminal, so they
# vanished. Into the session's logs instead.
export QT_FORCE_STDERR_LOGGING=1

bg() { local name=$1; shift; ( "$@" ) > "$R/$name.log" 2>&1 & }
# The desktop is the user's, as on every PowOS: powos (uid = the PowOS app's Android uid, so it owns the app's run
# dir and display socket; rooted/powos-deploy.sh). Root keeps only the system bus and the phone's stand-in services.
AS_USER=(setpriv --reuid=powos --regid=powos --init-groups -- env HOME=/home/powos USER=powos LOGNAME=powos)
as_user() { "${AS_USER[@]}" "$@"; }
wait_sock() { for _ in $(seq 100); do [ -S "$1" ] && return 0; sleep 0.1; done; return 1; }

# D-Bus: the session bus, and a system bus of PowOS's own for the stand-in hardware services (same config and
# services as the app's: android-nm/upower read the phone's state files the app writes into $R).
rm -f "$R/bus" "$R/system_bus"
# The previous session's PipeWire sockets too: wait_sock below would pass on the stale pipewire-0 and start KWin before
# the new PipeWire listens; KWin's audio engine then stays on the dead connection (no anland-speaker sink: no sound).
rm -f "$R/pipewire-0" "$R/pipewire-0.lock" "$R/pipewire-0-manager" "$R/pipewire-0-manager.lock"
bg dbus as_user dbus-daemon --session --nofork --nopidfile --address="unix:path=$R/bus"
bg system-dbus dbus-daemon --config-file=/opt/lotfix/system-bus.conf --nofork --nopidfile --address="unix:path=$R/system_bus"
wait_sock "$R/system_bus"
for s in android-nm android-upower android-system-services; do bg "$s" "$s"; done
# The app's on-screen controls as a real gamepad (uinput is root-only on Android; see the file).
bg powos-padd powos-padd
# Which game has focus, for the controls' per-game layouts (see the file).
bg powos-focus-watch as_user powos-focus-watch
wait_sock "$R/bus"
bg android-session-services as_user android-session-services
as_user sh -c 'K=$HOME/.local/share/keyrings; mkdir -p "$K" && chmod 700 "$K"
  [ -f "$K/login.keyring" ] || printf "[keyring]\ndisplay-name=Login\nctime=0\nmtime=0\nlock-on-idle=false\nlock-after=false\n" > "$K/login.keyring"
  [ -f "$K/default" ] || printf login > "$K/default"'
bg gnome-keyring as_user gnome-keyring-daemon --foreground --components=secrets

# Sound: KWin's Anland backend makes PipeWire nodes for the phone's speaker and microphone.
bg pipewire as_user pipewire
wait_sock "$R/pipewire-0"
bg wireplumber as_user wireplumber
bg pipewire-pulse as_user pipewire-pulse

# The desktop: the same PowOS session as the app's (ANLAND_SOCKET, scale, services, startplasma-wayland).
export EGL_PLATFORM=surfaceless
cd /home/powos
exec "${AS_USER[@]}" /usr/bin/Hyprland >> "$R/hyprland.log" 2>&1
