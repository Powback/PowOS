 		}
 	}
 
 	dma_resv_unlock(resv);
 	return events;
 }
 
 static long _dma_buf_set_name(struct dma_buf *dmabuf, const char *name)
 {
 	spin_lock(&dmabuf->name_lock);
 	kfree(dmabuf->name);
 	dmabuf->name = name;
 	spin_unlock(&dmabuf->name_lock);
 
 	return 0;
 }
 
 /**
  * dma_buf_set_name - Set a name to a specific dma_buf to track the usage.
  * It could support changing the name of the dma-buf if the same piece of
  * memory is used for multiple purpose between different devices.
  *
  * @dmabuf: [in]     dmabuf buffer that will be renamed.
  * @buf:    [in]     A piece of userspace memory that contains the name of
  *                   the dma-buf.
  *
  * Returns 0 on success. If the dma-buf buffer is already attached to
  * devices, return -EBUSY.
  *
  */
 long dma_buf_set_name(struct dma_buf *dmabuf, const char *name)
 {
 	long ret = 0;
 	char *buf = kstrndup(name, DMA_BUF_NAME_LEN, GFP_KERNEL);
 
 	if (!buf)
 		return -ENOMEM;
 
 	ret = _dma_buf_set_name(dmabuf, buf);
 	if (ret)
 		kfree(buf);
 
 	return ret;
 }
 EXPORT_SYMBOL_GPL(dma_buf_set_name);
 
 static long dma_buf_set_name_user(struct dma_buf *dmabuf, const char __user *buf)
 {
 	char *name = strndup_user(buf, DMA_BUF_NAME_LEN);
 	long ret = 0;
 
 	if (IS_ERR(name))
 		return PTR_ERR(name);
 
 	ret = _dma_buf_set_name(dmabuf, name);
 	if (ret)
 		kfree(name);
 
 	return ret;
 }
 
 /*
  * PowOS: DMA_BUF_IOCTL_EXPORT_SYNC_FILE / DMA_BUF_IOCTL_IMPORT_SYNC_FILE, backported from Linux 6.0 (upstream
  * 20e10881a043, 594740497e99) to android13-5.15's dma_resv (exclusive + shared fences instead of dma_resv_usage).
  * Mesa's Vulkan WSI attaches its rendering fence to a swapchain image with these, and a compositor (Xwayland) waits
  * on it before reading the image. Without them a driver with no implicit sync of its own (Turnip on KGSL) hands
  * over images the GPU is still drawing: Proton games on the phone showed half-drawn and older frames.
  */
 
-/* All fences a waiter of this kind has to wait for, as one fence (a stub if there are none). */
+/*
+ * All fences a waiter of this kind has to wait for, as one FLAT fence: upstream's dma_fence_unwrap_merge (in this
+ * tree, also what sync_file_merge uses) unwraps arrays and chains, drops signaled fences, keeps only the latest fence
+ * per context, and returns the single remaining fence itself, an array of the rest, or a signaled stub.
+ *
+ * The first version wrapped every fence on the buffer in a NEW dma_fence_array, including the exclusive fence the
+ * last import had set - itself such an array. Mesa's WSI imports a write fence for every frame it presents, so a
+ * game's swapchain buffer carried an array nested one level deeper per frame, its signaled fences included. Freeing
+ * the buffer (the game or Steam closing) put that chain: dma_fence_array_release -> dma_fence_put -> release, once
+ * per frame shown, on the kernel stack - the phone rebooted at every game close (2026-10-23, 4x).
+ */
 static int dma_buf_resv_fence(struct dma_resv *resv, bool write, struct dma_fence *extra,
 			      struct dma_fence **out)
 {
-	struct dma_fence *excl = NULL, **shared = NULL, **fences;
-	struct dma_fence_array *array;
+	struct dma_fence *excl = NULL, **shared = NULL, **fences, **work;
+	struct dma_fence_unwrap *iter;
 	unsigned int shared_count = 0, count, i;
 	int ret;
 
 	ret = dma_resv_get_fences(resv, &excl, &shared_count, &shared);
 	if (ret)
 		return ret;
 
 	if (!write) {	/* a reader waits for the writer only */
 		for (i = 0; i < shared_count; i++)
 			dma_fence_put(shared[i]);
 		shared_count = 0;
 	}
 
 	count = shared_count + (excl ? 1 : 0) + (extra ? 1 : 0);
 	if (count == 0) {
 		kfree(shared);
 		*out = dma_fence_get_stub();
 		return 0;
 	}
-	if (count == 1) {
-		*out = excl ? excl : extra ? dma_fence_get(extra) : shared[0];
-		kfree(shared);
-		return 0;
-	}
 
 	fences = krealloc(shared, count * sizeof(*fences), GFP_KERNEL);
 	if (!fences) {
 		for (i = 0; i < shared_count; i++)
 			dma_fence_put(shared[i]);
 		kfree(shared);
 		dma_fence_put(excl);
 		return -ENOMEM;
 	}
 	i = shared_count;
 	if (excl)
 		fences[i++] = excl;
 	if (extra)
 		fences[i++] = dma_fence_get(extra);
 
-	array = dma_fence_array_create(count, fences, dma_fence_context_alloc(1), 1, false);
-	if (!array) {
-		for (i = 0; i < count; i++)
-			dma_fence_put(fences[i]);
-		kfree(fences);
-		return -ENOMEM;
-	}
-	*out = &array->base;
-	return 0;
+	/*
+	 * __dma_fence_unwrap_merge uses its fences[] as cursor positions (trashes it) and takes its own references:
+	 * it gets a copy, our references in fences[] are put after.
+	 */
+	work = kmemdup(fences, count * sizeof(*fences), GFP_KERNEL);
+	iter = kmalloc_array(count, sizeof(*iter), GFP_KERNEL);
+	*out = work && iter ? __dma_fence_unwrap_merge(count, work, iter) : NULL;
+	kfree(iter);
+	kfree(work);
+
+	for (i = 0; i < count; i++)
+		dma_fence_put(fences[i]);
+	kfree(fences);
+
+	return *out ? 0 : -ENOMEM;
 }
 
 static long dma_buf_export_sync_file(struct dma_buf *dmabuf, void __user *user_data)
 {
 	struct dma_buf_export_sync_file arg;
 	struct dma_fence *fence = NULL;
 	struct sync_file *sync_file;
 	int fd, ret;
 
 	if (copy_from_user(&arg, user_data, sizeof(arg)))
 		return -EFAULT;
 
 	if (arg.flags & ~DMA_BUF_SYNC_RW)
 		return -EINVAL;
 
 	if ((arg.flags & DMA_BUF_SYNC_RW) == 0)
 		return -EINVAL;
 
 	fd = get_unused_fd_flags(O_CLOEXEC);
 	if (fd < 0)
 		return fd;
 
 	ret = dma_buf_resv_fence(dmabuf->resv, arg.flags & DMA_BUF_SYNC_WRITE, NULL, &fence);
 	if (ret)
 		goto err_put_fd;
 
 	sync_file = sync_file_create(fence);
 	dma_fence_put(fence);
 	if (!sync_file) {
 		ret = -ENOMEM;
 		goto err_put_fd;
 	}
 
 	arg.fd = fd;
 	if (copy_to_user(user_data, &arg, sizeof(arg))) {
 		ret = -EFAULT;
 		goto err_put_file;
 	}
 
 	fd_install(fd, sync_file->file);
 
 	return 0;
 
 err_put_file:
 	fput(sync_file->file);
 err_put_fd:
 	put_unused_fd(fd);
 	return ret;
 }
 
 static long dma_buf_import_sync_file(struct dma_buf *dmabuf, const void __user *user_data)
 {
 	struct dma_buf_import_sync_file arg;
 	struct dma_fence *fence, *excl;
 	int ret = 0;
 
 	if (copy_from_user(&arg, user_data, sizeof(arg)))
 		return -EFAULT;
 
 	if (arg.flags & ~DMA_BUF_SYNC_RW)
 		return -EINVAL;
 
 	if ((arg.flags & DMA_BUF_SYNC_RW) == 0)
 		return -EINVAL;
 
 	fence = sync_file_get_fence(arg.fd);
 	if (!fence)
 		return -EINVAL;
 
 	dma_resv_lock(dmabuf->resv, NULL);
 	if (arg.flags & DMA_BUF_SYNC_WRITE) {
 		/*
 		 * A write fence. 5.15's dma_resv keeps one exclusive fence and drops the shared ones when it is set,
 		 * so the new exclusive fence also covers everything that was there (upstream keeps them as separate
 		 * write and read fences instead).
 		 */
 		ret = dma_buf_resv_fence(dmabuf->resv, true, fence, &excl);
 		if (!ret) {
 			dma_resv_add_excl_fence(dmabuf->resv, excl);
 			dma_fence_put(excl);
 		}
 	} else {
 		ret = dma_resv_reserve_shared(dmabuf->resv, 1);
 		if (!ret)
 			dma_resv_add_shared_fence(dmabuf->resv, fence);
 	}
 	dma_resv_unlock(dmabuf->resv);
 
 	dma_fence_put(fence);
 
 	return ret;
 }
 
 static long dma_buf_ioctl(struct file *file,
 			  unsigned int cmd, unsigned long arg)
 {
 	struct dma_buf *dmabuf;
 	struct dma_buf_sync sync;
 	enum dma_data_direction direction;
 	int ret;
