From: PowOS
Subject: dma-buf: DMA_BUF_IOCTL_EXPORT_SYNC_FILE / IMPORT_SYNC_FILE (backport from Linux 6.0)

Upstream 20e10881a043 ("dma-buf: Add an API for exporting sync files (v14)") and 594740497e99 ("dma-buf: Add an
API for importing sync files (v10)"), rewritten for android13-5.15's dma_resv (one exclusive + shared fences; the
dma_resv_usage API they use came in 5.19). Same uapi numbers and semantics:
  EXPORT: READ -> the writer's fence, WRITE -> every fence on the buffer, as one sync_file (a stub if none).
  IMPORT: READ -> a shared fence, WRITE -> the exclusive fence (merged with the fences already there, since
          setting 5.15's exclusive fence drops the shared ones).

Why: Mesa's Vulkan WSI attaches the image's rendering fence to the dma-buf with IMPORT before presenting to an X
server, and a compositor (Xwayland) waits on EXPORT before reading the buffer. Without these ioctls Turnip on KGSL
(no implicit sync of its own) hands Xwayland images the GPU is still drawing: Proton games showed half-drawn and
older frames (Broforce, 2026-10-22). KMI: only dma-buf.c's static ioctl handler and the uapi header change; no
exported symbol or struct layout changes.
diff --git a/drivers/dma-buf/dma-buf.c b/drivers/dma-buf/dma-buf.c
--- a/drivers/dma-buf/dma-buf.c
+++ b/drivers/dma-buf/dma-buf.c
@@ -15,6 +15,8 @@
 #include <linux/slab.h>
 #include <linux/dma-buf.h>
 #include <linux/dma-fence.h>
+#include <linux/dma-fence-array.h>
+#include <linux/sync_file.h>
 #include <linux/anon_inodes.h>
 #include <linux/export.h>
 #include <linux/debugfs.h>
@@ -401,6 +403,161 @@
 	return ret;
 }
 
+/*
+ * PowOS: DMA_BUF_IOCTL_EXPORT_SYNC_FILE / DMA_BUF_IOCTL_IMPORT_SYNC_FILE, backported from Linux 6.0 (upstream
+ * 20e10881a043, 594740497e99) to android13-5.15's dma_resv (exclusive + shared fences instead of dma_resv_usage).
+ * Mesa's Vulkan WSI attaches its rendering fence to a swapchain image with these, and a compositor (Xwayland) waits
+ * on it before reading the image. Without them a driver with no implicit sync of its own (Turnip on KGSL) hands
+ * over images the GPU is still drawing: Proton games on the phone showed half-drawn and older frames.
+ */
+
+/* All fences a waiter of this kind has to wait for, as one fence (a stub if there are none). */
+static int dma_buf_resv_fence(struct dma_resv *resv, bool write, struct dma_fence *extra,
+			      struct dma_fence **out)
+{
+	struct dma_fence *excl = NULL, **shared = NULL, **fences;
+	struct dma_fence_array *array;
+	unsigned int shared_count = 0, count, i;
+	int ret;
+
+	ret = dma_resv_get_fences(resv, &excl, &shared_count, &shared);
+	if (ret)
+		return ret;
+
+	if (!write) {	/* a reader waits for the writer only */
+		for (i = 0; i < shared_count; i++)
+			dma_fence_put(shared[i]);
+		shared_count = 0;
+	}
+
+	count = shared_count + (excl ? 1 : 0) + (extra ? 1 : 0);
+	if (count == 0) {
+		kfree(shared);
+		*out = dma_fence_get_stub();
+		return 0;
+	}
+	if (count == 1) {
+		*out = excl ? excl : extra ? dma_fence_get(extra) : shared[0];
+		kfree(shared);
+		return 0;
+	}
+
+	fences = krealloc(shared, count * sizeof(*fences), GFP_KERNEL);
+	if (!fences) {
+		for (i = 0; i < shared_count; i++)
+			dma_fence_put(shared[i]);
+		kfree(shared);
+		dma_fence_put(excl);
+		return -ENOMEM;
+	}
+	i = shared_count;
+	if (excl)
+		fences[i++] = excl;
+	if (extra)
+		fences[i++] = dma_fence_get(extra);
+
+	array = dma_fence_array_create(count, fences, dma_fence_context_alloc(1), 1, false);
+	if (!array) {
+		for (i = 0; i < count; i++)
+			dma_fence_put(fences[i]);
+		kfree(fences);
+		return -ENOMEM;
+	}
+	*out = &array->base;
+	return 0;
+}
+
+static long dma_buf_export_sync_file(struct dma_buf *dmabuf, void __user *user_data)
+{
+	struct dma_buf_export_sync_file arg;
+	struct dma_fence *fence = NULL;
+	struct sync_file *sync_file;
+	int fd, ret;
+
+	if (copy_from_user(&arg, user_data, sizeof(arg)))
+		return -EFAULT;
+
+	if (arg.flags & ~DMA_BUF_SYNC_RW)
+		return -EINVAL;
+
+	if ((arg.flags & DMA_BUF_SYNC_RW) == 0)
+		return -EINVAL;
+
+	fd = get_unused_fd_flags(O_CLOEXEC);
+	if (fd < 0)
+		return fd;
+
+	ret = dma_buf_resv_fence(dmabuf->resv, arg.flags & DMA_BUF_SYNC_WRITE, NULL, &fence);
+	if (ret)
+		goto err_put_fd;
+
+	sync_file = sync_file_create(fence);
+	dma_fence_put(fence);
+	if (!sync_file) {
+		ret = -ENOMEM;
+		goto err_put_fd;
+	}
+
+	arg.fd = fd;
+	if (copy_to_user(user_data, &arg, sizeof(arg))) {
+		ret = -EFAULT;
+		goto err_put_file;
+	}
+
+	fd_install(fd, sync_file->file);
+
+	return 0;
+
+err_put_file:
+	fput(sync_file->file);
+err_put_fd:
+	put_unused_fd(fd);
+	return ret;
+}
+
+static long dma_buf_import_sync_file(struct dma_buf *dmabuf, const void __user *user_data)
+{
+	struct dma_buf_import_sync_file arg;
+	struct dma_fence *fence, *excl;
+	int ret = 0;
+
+	if (copy_from_user(&arg, user_data, sizeof(arg)))
+		return -EFAULT;
+
+	if (arg.flags & ~DMA_BUF_SYNC_RW)
+		return -EINVAL;
+
+	if ((arg.flags & DMA_BUF_SYNC_RW) == 0)
+		return -EINVAL;
+
+	fence = sync_file_get_fence(arg.fd);
+	if (!fence)
+		return -EINVAL;
+
+	dma_resv_lock(dmabuf->resv, NULL);
+	if (arg.flags & DMA_BUF_SYNC_WRITE) {
+		/*
+		 * A write fence. 5.15's dma_resv keeps one exclusive fence and drops the shared ones when it is set,
+		 * so the new exclusive fence also covers everything that was there (upstream keeps them as separate
+		 * write and read fences instead).
+		 */
+		ret = dma_buf_resv_fence(dmabuf->resv, true, fence, &excl);
+		if (!ret) {
+			dma_resv_add_excl_fence(dmabuf->resv, excl);
+			dma_fence_put(excl);
+		}
+	} else {
+		ret = dma_resv_reserve_shared(dmabuf->resv, 1);
+		if (!ret)
+			dma_resv_add_shared_fence(dmabuf->resv, fence);
+	}
+	dma_resv_unlock(dmabuf->resv);
+
+	dma_fence_put(fence);
+
+	return ret;
+}
+
 static long dma_buf_ioctl(struct file *file,
 			  unsigned int cmd, unsigned long arg)
 {
@@ -443,6 +600,11 @@
 	case DMA_BUF_SET_NAME_A:
 	case DMA_BUF_SET_NAME_B:
 		return dma_buf_set_name_user(dmabuf, (const char __user *)arg);
+
+	case DMA_BUF_IOCTL_EXPORT_SYNC_FILE:
+		return dma_buf_export_sync_file(dmabuf, (void __user *)arg);
+	case DMA_BUF_IOCTL_IMPORT_SYNC_FILE:
+		return dma_buf_import_sync_file(dmabuf, (const void __user *)arg);
 
 	default:
 		return -ENOTTY;
diff --git a/include/uapi/linux/dma-buf.h b/include/uapi/linux/dma-buf.h
--- a/include/uapi/linux/dma-buf.h
+++ b/include/uapi/linux/dma-buf.h
@@ -95,4 +95,73 @@
 #define DMA_BUF_SET_NAME_A	_IOW(DMA_BUF_BASE, 1, __u32)
 #define DMA_BUF_SET_NAME_B	_IOW(DMA_BUF_BASE, 1, __u64)
 
+/**
+ * struct dma_buf_export_sync_file - Get a sync_file from a dma-buf
+ *
+ * Userspace can perform a DMA_BUF_IOCTL_EXPORT_SYNC_FILE to retrieve the
+ * current set of fences on a dma-buf file descriptor as a sync_file. CPU
+ * waits via poll() or other driver-specific mechanisms typically wait on
+ * whatever fences are on the dma-buf at the time the wait begins. This
+ * is similar except that it takes a snapshot of the current fences on the
+ * dma-buf for waiting later instead of waiting immediately. This is
+ * useful for modern graphics APIs such as Vulkan which assume an explicit
+ * synchronization model but still need to inter-operate with dma-buf.
+ *
+ * PowOS backport of upstream 20e10881a043 (Linux 6.0) to android13-5.15.
+ */
+struct dma_buf_export_sync_file {
+	/**
+	 * @flags: Read/write flags
+	 *
+	 * Must be DMA_BUF_SYNC_READ, DMA_BUF_SYNC_WRITE, or both.
+	 *
+	 * If DMA_BUF_SYNC_READ is set and DMA_BUF_SYNC_WRITE is not set,
+	 * the returned sync file waits on any writers of the dma-buf to
+	 * complete. Waiting on the returned sync file is equivalent to
+	 * poll() with POLLIN.
+	 *
+	 * If DMA_BUF_SYNC_WRITE is set, the returned sync file waits on
+	 * any users of the dma-buf (read or write) to complete. Waiting
+	 * on the returned sync file is equivalent to poll() with POLLOUT.
+	 */
+	__u32 flags;
+	/** @fd: Returned sync file descriptor */
+	__s32 fd;
+};
+
+/**
+ * struct dma_buf_import_sync_file - Insert a sync_file into a dma-buf
+ *
+ * Userspace can perform a DMA_BUF_IOCTL_IMPORT_SYNC_FILE to insert a
+ * sync_file into a dma-buf for the purposes of implicit synchronization
+ * with other dma-buf consumers. This allows clients using explicitly
+ * synchronized APIs such as Vulkan to inter-op with dma-buf consumers
+ * which expect implicit synchronization such as OpenGL or most media
+ * drivers/video.
+ *
+ * PowOS backport of upstream 594740497e99 (Linux 6.0) to android13-5.15.
+ */
+struct dma_buf_import_sync_file {
+	/**
+	 * @flags: Read/write flags
+	 *
+	 * Must be DMA_BUF_SYNC_READ, DMA_BUF_SYNC_WRITE, or both.
+	 *
+	 * If DMA_BUF_SYNC_READ is set and DMA_BUF_SYNC_WRITE is not set,
+	 * this inserts the sync_file as a read-only fence. Any subsequent
+	 * implicitly synchronized writes to this dma-buf will wait on this
+	 * fence but reads will not.
+	 *
+	 * Otherwise, this inserts the sync_file as a write fence. Any
+	 * subsequent implicitly synchronized access to this dma-buf will
+	 * wait on this fence.
+	 */
+	__u32 flags;
+	/** @fd: Sync file descriptor */
+	__s32 fd;
+};
+
+#define DMA_BUF_IOCTL_EXPORT_SYNC_FILE	_IOWR(DMA_BUF_BASE, 2, struct dma_buf_export_sync_file)
+#define DMA_BUF_IOCTL_IMPORT_SYNC_FILE	_IOW(DMA_BUF_BASE, 3, struct dma_buf_import_sync_file)
+
 #endif
