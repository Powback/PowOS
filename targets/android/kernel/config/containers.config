# Container resource control for PowOS on the OnePlus Open (GKI android13-5.15), on top of
# targets/native/config/gki/*.config. Every option here is KMI-preserving only together with
# targets/android/kernel/patches/: build-containers-kernel.sh checks the result with
# targets/native/tools/kmi-check.py (symbol CRCs) and a pahole layout diff (struct offsets) against the
# phone's own vendor modules. See docs/PHONE-KERNEL-CONTAINERS.md.

# pids.max (podman --pids-limit): the pids controller in net_prio's subsystem slot (patch 0001).
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_PIDS_REPLACES_NET_PRIO=y

# cpu.max / cpu.cfs_quota_us (podman --cpus): bandwidth state beside cfs_rq/task_group (patch 0002).
CONFIG_CFS_BANDWIDTH=y

# nftables (netavark's firewall driver, nft, iptables-nft) as loadable modules; struct net unchanged
# (patch 0003).
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_NUMGEN=m
CONFIG_NFT_CT=m
CONFIG_NFT_COUNTER=m
CONFIG_NFT_CONNLIMIT=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_NAT=m
CONFIG_NFT_OBJREF=m
CONFIG_NFT_QUOTA=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_REJECT_INET=m
CONFIG_NFT_COMPAT=m
CONFIG_NFT_HASH=m
CONFIG_NFT_FIB_INET=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
