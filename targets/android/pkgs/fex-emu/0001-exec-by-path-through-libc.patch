+
+// Android (PowOS on Andromarchy): programs in the Linux rootfs can only be started through the userspace
+// launcher that LD_PRELOADs into every process (fakechroot's execve: the rootfs loader + #! handling, and
+// android-compat's /proc/self/exe redirection): the kernel cannot start them itself, their PT_INTERP does not
+// exist on Android's filesystem. A raw execveat syscall bypasses that launcher, so exec by path goes through
+// libc's execve. FD-based execs (AT_EMPTY_PATH) keep the raw syscall: no path for the launcher to translate.
+static long HostExecveat(int dirfd, const char* pathname, char* const* argv, char* const* envp, int flags) {
+  if (dirfd == AT_FDCWD && flags == 0 && pathname && pathname[0]) {
+    return ::execve(pathname, argv, envp);
+  }
+  return ::syscall(SYS_execveat, dirfd, pathname, argv, envp, flags);
 }
 
