# PowOS: Arch's plasma-desktop 6.7.5-1 recipe for aarch64 plus our patch (the Application Dashboard - the phone's
# start button - answers taps on its categories).
# HACK: same pkgname as Arch's with pkgrel 1.1 (".1" = ours, as kwin) so it replaces the distro package. Real fix:
# upstream the patch (KDE bug: kicker's dashboard category click uses the hover-set index), then drop this package.
# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Maintainer: Antonio Rojas <arojas@archlinux.org>
# Contributor: Andrea Scarpino <andrea@archlinux.org>

pkgname=plasma-desktop
pkgver=6.7.5
_dirver=$(echo $pkgver | cut -d. -f1-3)
pkgrel=1.9
pkgdesc='KDE Plasma Desktop'
arch=(aarch64)
url='https://kde.org/plasma-desktop/'
license=(LGPL-2.0-or-later)
depends=(attica
         baloo
         emoji-font # for clock and language KCMs
         glibc
         kbookmarks
         kcmutils
         kcodecs
         kcompletion
         kconfig
         kconfigwidgets
         kcoreaddons
         kcrash
         kdbusaddons
         kdeclarative
         kglobalaccel
         kguiaddons
         ki18n
         kiconthemes
         kio
         kirigami
         kirigami-addons
         kitemmodels
         kitemviews
         kjobwidgets
         kmenuedit
         knewstuff
         knotifications
         knotifyconfig
         kpackage
         kpipewire
         krunner
         kservice
         ksvg
         kwidgetsaddons
         kwindowsystem
         kxmlgui
         libcanberra
         libksysguard
         libstdc++
         libwacom
         libx11
         libxcb
         libxcursor
         libxi
         libxkbcommon
         libxkbfile
         libplasma
         plasma-activities
         plasma-activities-stats
         plasma-workspace
         plasma5support
         polkit-kde-agent
         powerdevil
         qt6-5compat
         qt6-base
         qt6-declarative
         sdl2
         solid
         sonnet
         systemd-libs
         systemsettings
         wayland
         xcb-util-keysyms
         xdg-user-dirs)
optdepends=('bluedevil: Bluetooth applet'
            'glib2: kimpanel IBUS support'
            'ibus: kimpanel IBUS support'
            'kaccounts-integration: OpenDesktop integration plugin'
            'kscreen: screen management'
            'libaccounts-qt: OpenDesktop integration plugin'
            'packagekit-qt6: to install new krunner plugins'
            'plasma-nm: Network manager applet'
            'plasma-pa: Audio volume applet'
            'scim: kimpanel SCIM support')
makedepends=(extra-cmake-modules
             intltool
             kaccounts-integration
             kdoctools
             libibus
             packagekit-qt6
             scim
             wayland-protocols
             xf86-input-libinput
             xorg-server-devel)
groups=(plasma)
source=(https://download.kde.org/stable/plasma/$_dirver/$pkgname-$pkgver.tar.xz
        0001-kicker-dashboard-categories-respond-to-a-tap.patch
        0002-kicker-an-A-Z-bar-on-the-Application-Dashboard.patch
        0003-kicker-favorites-as-a-row-above-the-apps.patch
        0004-desktop-widgets-keep-their-size-while-narrower.patch
        0005-folder-view-swipe-up-on-the-desktop-opens-the-launcher.patch
        0006-kicker-dashboard-no-search-focus-while-closing.patch)
sha256sums=('079fcf6b87d7bf65e3f2a4670d605fac9469344c279a285a98ad549332d7b53e'
            SKIP SKIP SKIP SKIP SKIP SKIP)

prepare() {
  cd $pkgname-$pkgver
  patch -p1 -N --forward --no-backup-if-mismatch < "$srcdir/0001-kicker-dashboard-categories-respond-to-a-tap.patch" || { echo "patch 0001-kicker-dashboard-categories-respond-to-a-tap.patch FAILED"; exit 1; }
  patch -p1 -N --forward --no-backup-if-mismatch < "$srcdir/0002-kicker-an-A-Z-bar-on-the-Application-Dashboard.patch" || { echo "patch 0002-kicker-an-A-Z-bar-on-the-Application-Dashboard.patch FAILED"; exit 1; }
  patch -p1 -N --forward --no-backup-if-mismatch < "$srcdir/0003-kicker-favorites-as-a-row-above-the-apps.patch" || { echo "patch 0003-kicker-favorites-as-a-row-above-the-apps.patch FAILED"; exit 1; }
  patch -p1 -N --forward --no-backup-if-mismatch < "$srcdir/0004-desktop-widgets-keep-their-size-while-narrower.patch" || { echo "patch 0004-desktop-widgets-keep-their-size-while-narrower.patch FAILED"; exit 1; }
  patch -p1 -N --forward --no-backup-if-mismatch < "$srcdir/0005-folder-view-swipe-up-on-the-desktop-opens-the-launcher.patch" || { echo "patch 0005-folder-view-swipe-up-on-the-desktop-opens-the-launcher.patch FAILED"; exit 1; }
  patch -p1 -N --forward --no-backup-if-mismatch < "$srcdir/0006-kicker-dashboard-no-search-focus-while-closing.patch" || { echo "patch 0006-kicker-dashboard-no-search-focus-while-closing.patch FAILED"; exit 1; }
  [ -z "$(find . -name '*.rej' -print -quit)" ] || { echo "patch left .rej files (a hunk was rejected)"; exit 1; }
}

build() {
  cmake -B build  -S $pkgname-$pkgver \
    -DCMAKE_INSTALL_LIBEXECDIR=lib \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
