+        xwl_kgsl_commit_note(&xwl_kgsl_commits, XWL_COMMIT_POST_DAMAGE, xwl_window->surface, GetTimeInMicros());  /* PowOS 0014 */
         wl_surface_commit(xwl_window->surface);
         xorg_list_del(&xwl_window->link_damage);
     }
@@ -817,6 +830,7 @@ void xwl_surface_damage(struct xwl_screen *xwl_screen,
