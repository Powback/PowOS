From: PowOS
Subject: xwayland/kgsl: a failed DRI3 dma-buf import says its width, height, stride, offset and fd size

Broforce (DXVK via Proton) went full screen at 1116x2484 on the cover screen and
its frames never reached KWin: Xwayland logged "failed to import KGSL DRI3 dma-buf
(XR24, modifier INVALID, EGL_BAD_ALLOC)" ~90 times a second (13,775 lines in
2.5 min) without the buffer's shape, so the cause could not be told from the log.

The importer (KGSL Mesa's freedreno, fd_resource_from_handle -> fd6 layout) refuses
a linear pitch that is not a multiple of 64 bytes (1116*4 = 4464 is not), a pitch
under width*cpp, and a bo smaller than offset+pitch*height; anything else that
fails is the KGSL bo import itself. Each failure (import and refresh paths) now
logs the shape, the dma-buf's size (lseek SEEK_END), stride % 64 and the rule it
breaks (xwayland-kgsl-import-check.h, shared with test/import-check-test.c), once
per distinct shape and then every 1000th with a count.

diff --git a/hw/xwayland/xwayland-glamor-gbm.c b/hw/xwayland/xwayland-glamor-gbm.c
index c70da5b..db76a0e 100644
--- a/hw/xwayland/xwayland-glamor-gbm.c
+++ b/hw/xwayland/xwayland-glamor-gbm.c
@@ -64,6 +64,7 @@
 #include "xwayland-pixmap.h"
 #include "xwayland-screen.h"
 #include "xwayland-window-buffers.h"
+#include "xwayland-kgsl-import-check.h"
 
 #include "linux-dmabuf-unstable-v1-client-protocol.h"
 #include "linux-drm-syncobj-v1-client-protocol.h"
@@ -690,6 +691,44 @@ xwl_glamor_kgsl_bind_image_to_texture(EGLImage image, unsigned int *texture)
     return TRUE;
 }
 
+/* PowOS: a failed import says which buffer shape failed and which import rule it breaks (stride alignment, size),
+ * once per distinct shape and then every 1000th, instead of a bare egl_error ~90 times a second (Broforce at
+ * 1116x2484: 13,775 identical lines in 2.5 min that never said the width, stride or size). */
+static struct xwl_kgsl_import_log xwl_kgsl_import_failures;
+
+static void
+xwl_glamor_kgsl_log_import_failure(const char *what, CARD16 width, CARD16 height, CARD8 depth,
+                                   uint32_t format, uint64_t modifier, int num_fds, const int *fds,
+                                   const CARD32 *strides, const CARD32 *offsets, EGLint egl_error)
+{
+    uint32_t cpp = depth == 16 ? 2 : 4;
+    int64_t fd_size = -1;
+    const char *rule;
+    uint64_t count;
+
+    if (num_fds > 0 && fds[0] >= 0) {
+        off_t end = lseek(fds[0], 0, SEEK_END);
+
+        if (end >= 0)
+            fd_size = end;
+        lseek(fds[0], 0, SEEK_SET);
+    }
+
+    count = xwl_kgsl_import_log_note(&xwl_kgsl_import_failures, width, height, strides[0], offsets[0], fd_size);
+    if (!xwl_kgsl_import_log_should_print(count))
+        return;
+
+    rule = xwl_kgsl_import_check(width, height, cpp, strides[0], offsets[0], fd_size);
+    ErrorF("Xwayland glamor: failed to %s KGSL DRI3 dma-buf "
+           "(format=0x%" PRIx32 ", modifier=0x%" PRIx64 ", planes=%d, egl_error=0x%x, "
+           "%ux%u depth %u stride %" PRIu32 " offset %" PRIu32 " fd-size %" PRId64 " (needs %" PRIu64 "), "
+           "stride %% 64 = %" PRIu32 ", failures of this shape %" PRIu64 "): %s\n",
+           what, format, modifier, num_fds, egl_error, width, height, depth, (uint32_t) strides[0],
+           (uint32_t) offsets[0], fd_size, (uint64_t) offsets[0] + (uint64_t) strides[0] * height,
+           (uint32_t) strides[0] % XWL_KGSL_LINEAR_PITCH_ALIGN, count,
+           rule ? rule : "parameters fit the import rules, so the KGSL bo import was refused");
+}
+
 static PixmapPtr
 xwl_glamor_kgsl_create_pixmap_from_fds(ScreenPtr screen, CARD8 num_fds,
                                        const int *fds, CARD16 width,
@@ -746,10 +785,8 @@ xwl_glamor_kgsl_create_pixmap_from_fds(ScreenPtr screen, CARD8 num_fds,
                                                              modifier);
     if (xwl_pixmap->image == EGL_NO_IMAGE_KHR) {
         egl_error = eglGetError();
-        ErrorF("Xwayland glamor: failed to import KGSL DRI3 dma-buf "
-               "(format=0x%" PRIx32 ", modifier=0x%" PRIx64
-               ", planes=%d, egl_error=0x%x)\n",
-               format, modifier, num_fds, egl_error);
+        xwl_glamor_kgsl_log_import_failure("import", width, height, depth, format, modifier, num_fds, fds,
+                                           strides, offsets, egl_error);
         goto error;
     }
 
@@ -858,9 +895,11 @@ xwl_glamor_kgsl_refresh_dri3_pixmap(PixmapPtr pixmap)
                                                  xwl_pixmap->kgsl_modifier);
     if (image == EGL_NO_IMAGE_KHR) {
         egl_error = eglGetError();
-        ErrorF("Xwayland glamor: failed to refresh KGSL DRI3 dma-buf "
-               "(pixmap=0x%x, planes=%d, egl_error=0x%x)\n",
-               pixmap->drawable.id, xwl_pixmap->kgsl_num_fds, egl_error);
+        xwl_glamor_kgsl_log_import_failure("refresh", pixmap->drawable.width, pixmap->drawable.height,
+                                           pixmap->drawable.depth, xwl_pixmap->kgsl_format,
+                                           xwl_pixmap->kgsl_modifier, xwl_pixmap->kgsl_num_fds,
+                                           xwl_pixmap->kgsl_fds, xwl_pixmap->kgsl_strides,
+                                           xwl_pixmap->kgsl_offsets, egl_error);
         return FALSE;
     }
 
