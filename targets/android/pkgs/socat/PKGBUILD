# socat for the phone's chroot (unit units/phone/waypipe.json): the TCP <-> unix-socket relay a waypipe client uses
# to reach a remote waypipe server without ssh (docs/research/native-window-remoting.md §8.7). Arch's own recipe
# (gitlab.archlinux.org/archlinux/packaging/packages/socat, 1.8.1.3-2) for aarch64, built on the rootfs (see
# BUILD_ON_ROOTFS) and WITHOUT Arch's socat-1.8.1.3-openssl4_fixes-1.patch: that one ports to openssl 4, the rootfs
# has openssl 3.6, which 1.8.1.3 supports as released.
pkgname=socat
pkgver=1.8.1.3
pkgrel=2
pkgdesc='Multipurpose relay'
url='http://www.dest-unreach.org/socat/'
license=('GPL-2.0-only')
arch=(aarch64)
depends=('glibc' 'openssl' 'readline')
source=("http://www.dest-unreach.org/socat/download/${pkgname}-${pkgver}.tar.gz")
sha256sums=('06602ffd591e98c75b3dc1d66f0f19136cc666b0b2d95caad987d6ab2cb28097')

build() {
  cd "${pkgname}-${pkgver}"
  ./configure --prefix=/usr --mandir=/usr/share/man
  make
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
