diff -ru a/src/utils/fullscreenleave.h b/src/utils/fullscreenleave.h
--- a/src/utils/fullscreenleave.h	2026-11-10 10:17:55
+++ b/src/utils/fullscreenleave.h	2026-11-10 10:18:15
@@ -19,11 +19,19 @@
 {
 
 // keptByTask: the window's size is its task's (powosKeepFullScreenGeometry). win*/out*: the window's frame and its
-// output now, logical. True = refuse the client's leave: it differs from its screen by more than one device px.
-inline bool staleSize(bool keptByTask, double winW, double winH, double outW, double outH, double scale)
+// output now, logical. sinceTaskResizeMs: how long ago the task last resized the window to a new screen (kwin 0072;
+// < 0 = never). True = refuse the client's leave: it differs from its screen by more than one device px, or the task
+// resized it within LeaveGraceMs - since 0070 the task resizes the window at once, so Wine's leave (asked when it saw
+// the root change before the window's configure) arrives with the frame already the screen's: game-resize 11-10 09:43
+// Besiege rotated, 09:49 Bananas cover portrait left full screen, their tasks closed, 1221x1262 / 393x2484 floats.
+inline constexpr long long LeaveGraceMs = 3000;
+inline bool staleSize(bool keptByTask, double winW, double winH, double outW, double outH, double scale, long long sinceTaskResizeMs = -1)
 {
     if (!keptByTask || outW <= 0 || outH <= 0) {
         return false;
+    }
+    if (sinceTaskResizeMs >= 0 && sinceTaskResizeMs < LeaveGraceMs) {
+        return true;
     }
     const double tol = scale > 0 ? 1.0 / scale : 1.0;
     return std::abs(winW - outW) > tol || std::abs(winH - outH) > tol;
