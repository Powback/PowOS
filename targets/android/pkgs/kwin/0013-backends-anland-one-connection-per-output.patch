-bool AnlandBackend::notifyFramePresented()
+AnlandOutput *AnlandBackend::addOutput(display_ctx *display, const QString &name, bool primary)
 {
-    if (m_consumerReady) {
-        trigger_refresh(m_display);
-        m_consumerReady = false;
+    uint32_t w = 0, h = 0, fmt = 0, refresh = 0;
+    get_screen_info(display, &w, &h, &fmt, &refresh);
+    auto *output = new AnlandOutput(this, name);
+    output->link().display = display; // before outputAdded: the EGL layer takes it
+    output->setPrimary(primary);
+    // Android pointer ids are small: 64 per output keeps two tasks' fingers apart.
+    output->setTouchIdBase(m_outputs.size() * 64);
+    output->init(QSize(w, h), static_cast<int>(refresh), 1.0);
+    // No position here: KWin's output configuration store lays out a new set of outputs itself (anland-2 right of
+    // the desktop) and keeps it (kwinoutputconfig.json).
+    set_fallback_callback(display, &AnlandBackend::fallbackTrampoline, output);
+    output->link().reconnectTimer = new QTimer(this);
+    output->link().reconnectTimer->setInterval(s_reconnectIntervalMs);
+    connect(output->link().reconnectTimer, &QTimer::timeout, this, [this, output]() {
+        onReconnectTimer(output);
+    });
+    m_outputs.append(output);
+    Q_EMIT outputAdded(output);
+    output->updateEnabled(true);
+    Q_EMIT outputsQueried();
+    qCInfo(KWIN_ANLAND) << "output" << name << w << "x" << h << (primary ? "(primary)" : "");
+    return output;
+}
+
+void AnlandBackend::connectSecondOutput()
+{
+    // The daemon sends its screen info only once its consumer (the Android task's surface) is there, maybe much
+    // later or never: wait for it on the event loop, then add the output.
+    display_ctx *display = nullptr;
+    if (connect_to_deamon_begin(&display, m_secondSocketPath.toLocal8Bit().constData()) < 0) {
+        qCWarning(KWIN_ANLAND) << "no second display daemon at" << m_secondSocketPath;
+        return;
+    }
+    auto *notifier = new QSocketNotifier(get_ctrl_fd(display), QSocketNotifier::Read, this);
+    connect(notifier, &QSocketNotifier::activated, this, [this, notifier, display]() {
+        notifier->setEnabled(false);
+        notifier->deleteLater();
+        if (connect_to_deamon_finish(display) < 0) {
+            qCWarning(KWIN_ANLAND) << "second display daemon handshake failed";
+            ::disconnect(display);
+            return;
+        }
+        enterFallback(addOutput(display, QStringLiteral("anland-2"), false));
+    });
+}
+
+bool AnlandBackend::primaryDown() const
+{
+    return m_outputs.isEmpty() || m_outputs.first()->link().inFallback;
+}
+
+bool AnlandBackend::notifyFramePresented(AnlandOutput *output)
+{
+    AnlandOutput::Link &link = output->link();
+    if (link.consumerReady) {
+        trigger_refresh(link.display);
+        link.consumerReady = false;
         return true;
     }
     return false;
 }
 
