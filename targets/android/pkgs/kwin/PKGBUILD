        "${_patches[@]}")
sha256sums=('6baa910b732d93c48c90f9c1cc685cc93d0b8de0cdf138c24192c045bc3a48e2'
            SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP)

prepare() {
  cd $pkgname-$pkgver
  for p in "${_patches[@]}"; do
    echo "Applying $p"
    patch -p1 -N --forward --no-backup-if-mismatch < "$srcdir/$p" || { echo "patch $p FAILED"; exit 1; }
    [ -z "$(find . -name '*.rej' -print -quit)" ] || { echo "patch left .rej files (a hunk was rejected)"; exit 1; }
  done
}

build() {
  cmake -B build  -S $pkgname-$pkgver \
    -DCMAKE_INSTALL_LIBEXECDIR=lib \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  # HACK: '|| true' because setcap needs xattr support the build container's filesystem may lack.
  # It only matters on desktops (CAP_SYS_NICE for realtime scheduling); on Android the app's
  # processes can't hold capabilities anyway.
  setcap CAP_SYS_NICE=+ep "$pkgdir"/usr/bin/kwin_wayland || true
}
