+// PowOS (kwin 0059): try_exit_fallback() asks the daemon for a consumer once and never waits for the answer (its
+// poll of up to 100 ms per 200 ms tick ran on this thread for as long as the desktop had no consumer - behind every
+// full-screen game task: KWin stopped half the time, the game's frame callbacks came ~100 ms late 4-5 times a second).
+// The answer arrives on ctrl_fd: watched here while in fallback, so a returning consumer is picked up at once, not on
+// the next tick. Level-triggered, so it is disabled around the call and dropped once live (or its fd went: redial).
+void AnlandBackend::watchCtrl()
+{
+    const int fd = (m_inFallback && m_display) ? get_ctrl_fd(m_display) : -1;
+    if (m_ctrlNotifier && (fd < 0 || fd != m_ctrlNotifierFd)) {
+        m_ctrlNotifier->setEnabled(false);
+        m_ctrlNotifier->deleteLater(); // may be the notifier whose activation got us here
+        m_ctrlNotifier = nullptr;
+        m_ctrlNotifierFd = -1;
+    }
+    if (fd < 0) {
+        return;
+    }
+    if (!m_ctrlNotifier) {
+        auto *notifier = new QSocketNotifier(fd, QSocketNotifier::Read, this);
+        m_ctrlNotifier = notifier;
+        m_ctrlNotifierFd = fd;
+        connect(notifier, &QSocketNotifier::activated, this, [this, notifier]() {
+            notifier->setEnabled(false);
+            onReconnectTimer(); // calls watchCtrl() again: re-enabled, replaced or gone
+        });
+    }
+    m_ctrlNotifier->setEnabled(true);
+}
+
 void AnlandBackend::onReconnectTimer()
 {
     if (!m_inFallback) {
         m_reconnectTimer->stop();
+        watchCtrl();
         return;
     }
 
     if (try_exit_fallback(m_display) != 0) {
+        watchCtrl(); // PowOS (0059): the daemon's answer (a consumer came) wakes us before the next tick
         return; // still down, keep retrying
     }
 
