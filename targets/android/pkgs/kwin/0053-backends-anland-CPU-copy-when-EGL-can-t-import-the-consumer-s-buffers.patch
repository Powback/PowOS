+        std::shared_ptr<AnlandCpuMapping> cpu; // PowOS: set only when the buffer could not be imported (CPU copy)
     };
     ImportedBuffer importConsumerBuffer(display_ctx *display, int index, OutputTransform contentTransform);
+    /** PowOS: reads [deviceDamage] of [fbo] (the frame's rendered region, in device coordinates; infinite = all) back
