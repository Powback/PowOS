+namespace
+{
+/** PowOS: the CPU copy's render target, stored as RGBA bytes like the consumer's ABGR8888 buffer (GLTexture::allocate
+ *  makes a BGRA one on GLES), so glReadPixels is a straight copy with no swizzle. */
+class AnlandCpuTexture : public GLTexture
+{
+public:
+    AnlandCpuTexture(GLuint texture, const QSize &size)
+        : GLTexture(GL_TEXTURE_2D, texture, GL_RGBA8, size, 1, true, OutputTransform())
+    {
+    }
+};
+
+std::shared_ptr<GLTexture> allocateRgba(const QSize &size)
+{
+    GLuint texture = 0;
+    glGenTextures(1, &texture);
+    if (!texture) {
+        return nullptr;
+    }
+    glBindTexture(GL_TEXTURE_2D, texture);
+    const bool gles = EglContext::currentContext()->isOpenGLES();
+    glTexImage2D(GL_TEXTURE_2D, 0, gles ? GL_RGBA : GL_RGBA8, size.width(), size.height(), 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+    glBindTexture(GL_TEXTURE_2D, 0);
+    return std::make_shared<AnlandCpuTexture>(texture, size);
+}
+}
+
+AnlandCpuMapping::~AnlandCpuMapping()
+{
+    if (base) {
+        munmap(base, length);
+    }
+}
+
+AnlandEglBackend::ImportedBuffer AnlandEglBackend::importForCpuCopy(int fd, int index, const buf_info &info, OutputTransform contentTransform)
+{
+    const QSize size(info.width, info.height);
+    // The emulator's gralloc (ranchu) reports no stride (ANativeWindowBuffer.stride 0): its CPU buffers are tightly
+    // packed rows.
+    const uint32_t stride = info.stride ? info.stride : uint32_t(size.width()) * 4;
+    if (size.isEmpty() || stride < uint64_t(size.width()) * 4 || stride % 4 != 0) {
+        qCWarning(KWIN_ANLAND) << "buffer" << index << "can't be copied to: size" << size << "stride" << info.stride;
+        return {};
+    }
+    auto cpu = std::make_shared<AnlandCpuMapping>();
+    cpu->length = size_t(info.offset) + size_t(stride) * size_t(size.height());
+    // A buffer smaller than its rows (a wrong stride guess) would fault on the copy: refuse it.
+    const off_t fdSize = lseek(fd, 0, SEEK_END);
+    if (fdSize > 0 && size_t(fdSize) < cpu->length) {
+        qCWarning(KWIN_ANLAND) << "buffer" << index << "is" << fdSize << "bytes, its rows need" << cpu->length;
+        return {};
+    }
+    void *mapped = mmap(nullptr, cpu->length, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    if (mapped == MAP_FAILED) {
+        // The next fallback (docs/research/nonroot-parity.md): memfd buffers the consumer copies in.
+        qCWarning(KWIN_ANLAND) << "buffer" << index << "can't be mapped for a CPU copy either:" << strerror(errno);
+        return {};
+    }
+    cpu->base = static_cast<uint8_t *>(mapped);
+    cpu->fd = FileDescriptor(dup(fd));
+    cpu->offset = info.offset;
+    cpu->stride = stride;
+    cpu->drmFormat = protocol_format_to_drm(info.format);
+    cpu->size = size;
+
+    std::shared_ptr<GLTexture> texture = allocateRgba(size);
+    if (!texture) {
+        qCWarning(KWIN_ANLAND) << "no offscreen texture" << size << "for buffer" << index;
+        return {};
+    }
+    // The same transform as an imported buffer: glReadPixels' row 0 is the texture's row 0, which the consumer reads
+    // as its top row, exactly as it reads an imported buffer's.
+    texture->setContentTransform(contentTransform);
+    auto fbo = std::make_unique<GLFramebuffer>(texture.get());
+    if (!fbo->valid()) {
+        qCWarning(KWIN_ANLAND) << "offscreen framebuffer for buffer" << index << "is not complete";
+        return {};
+    }
+    static bool logged = false;
+    if (!logged) {
+        logged = true;
+        qCInfo(KWIN_ANLAND) << "consumer buffers: CPU copy (no EGL dma-buf import)";
+    }
+    qCInfo(KWIN_ANLAND) << "mapped buffer" << index << "fd" << fd << size << "stride" << stride << "offset"
+                        << info.offset << "fmt" << Qt::hex << cpu->drmFormat << "for a CPU copy";
+    return ImportedBuffer{.texture = std::move(texture), .fbo = std::move(fbo), .size = size, .cpu = std::move(cpu)};
+}
+
+void AnlandEglBackend::copyToConsumer(const AnlandCpuMapping &cpu, GLFramebuffer *fbo, OutputTransform contentTransform, const Region &deviceDamage)
+{
+    // Device damage to buffer rows, as the DRM backend's copy maps it (EglGbmLayerSurface::importWithCopy).
+    const QSize orientedSize = contentTransform.map(cpu.size);
+    const Region damage = contentTransform.map(deviceDamage.intersected(Rect(QPoint(), orientedSize)), orientedSize)
+                              .intersected(Rect(QPoint(), cpu.size));
+    if (damage.isEmpty()) {
+        return;
+    }
+    // Whole rows of the damage's bounding band: one read, straight into the mapping.
+    const Rect band = damage.boundingRect();
+    GLenum format = GL_RGBA; // ABGR8888 = R,G,B,A bytes
+    if (cpu.drmFormat != DRM_FORMAT_ABGR8888) {
+        static const bool bgra = !openglContext()->isOpenGLES() || openglContext()->hasOpenglExtension(QByteArrayLiteral("GL_EXT_read_format_bgra"));
+        format = bgra ? GL_BGRA_EXT : GL_RGBA; // XRGB8888 = B,G,R,X bytes
+    }
+    GLFramebuffer::pushFramebuffer(fbo);
+    glPixelStorei(GL_PACK_ALIGNMENT, 4);
+    glPixelStorei(GL_PACK_ROW_LENGTH, int(cpu.stride / 4));
+    // A dma-buf wants its CPU access bracketed (cache maintenance); any other fd just refuses the ioctl.
+    struct dma_buf_sync sync = {.flags = DMA_BUF_SYNC_START | DMA_BUF_SYNC_WRITE};
+    const bool synced = ioctl(cpu.fd.get(), DMA_BUF_IOCTL_SYNC, &sync) == 0;
+    glReadPixels(0, band.y(), cpu.size.width(), band.height(), format, GL_UNSIGNED_BYTE,
+                 cpu.base + cpu.offset + size_t(band.y()) * cpu.stride);
+    if (synced) {
+        sync.flags = DMA_BUF_SYNC_END | DMA_BUF_SYNC_WRITE;
+        (void)ioctl(cpu.fd.get(), DMA_BUF_IOCTL_SYNC, &sync);
+    }
+    glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+    GLFramebuffer::popFramebuffer();
+}
+
 DrmDevice *AnlandEglBackend::drmDevice() const
 {
     return m_backend->drmDevice();
