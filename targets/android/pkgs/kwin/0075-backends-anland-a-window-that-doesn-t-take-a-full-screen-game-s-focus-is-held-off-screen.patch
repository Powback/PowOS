 #include <QProcess>
 #include <QSocketNotifier>
 #include <cerrno>
@@ -710,6 +712,7 @@ void AnlandWindowTask::goLive()
         return;
     }
     m_state = State::Live;
+    m_backgroundSince = -1;
     m_tasks->backend()->updateAudio(); // PowOS (0067): with no desktop consumer, the sound goes out on this task's
     qCInfo(KWIN_ANLAND) << "window task" << m_id << "live," << m_bufferSize << "pre-rotated" << get_buffer_transform(m_display)
                         << "for" << (m_window ? m_window->caption() : QString());
@@ -909,6 +912,15 @@ void AnlandWindowTask::enterFallback()
     // where it is (on the tasks desktop) until the task comes back or is closed.
     qCInfo(KWIN_ANLAND) << "window task" << m_id << "in the background";
     m_state = State::Fallback;
+    m_backgroundSince = QDateTime::currentMSecsSinceEpoch();
+    // PowOS (0075): a full-screen task out of sight for longer than a fold's surface swap no longer holds windows back.
+    if (fullScreen() || appFullScreen()) {
+        QTimer::singleShot(AnlandTaskPolicy::screenSwapGraceMs + 100, m_tasks, [tasks = QPointer<AnlandWindowTasks>(m_tasks)]() {
+            if (tasks) {
+                tasks->retryHeld();
+            }
+        });
+    }
     m_tasks->backend()->updateAudio(this); // PowOS (0067): the library closes its audio socket right after this
     cancelTouches();
     if (m_inputNotifier) {
@@ -2312,6 +2324,9 @@ void AnlandWindowTasks::onFullScreenChanged(Window *window)
     } else if (task && task->setAppFullScreen(false)) {
         send({QStringLiteral("fullscreen"), QString::number(task->id()), QStringLiteral("0")});
     }
+    if (!window->isFullScreen()) {
+        QMetaObject::invokeMethod(this, &AnlandWindowTasks::retryHeld, Qt::QueuedConnection); // PowOS (0075)
+    }
 }
 
 void AnlandWindowTasks::setExportNew(bool on)
@@ -2434,6 +2449,17 @@ void AnlandWindowTasks::exportNew(Window *window)
         return;
     }
     m_activationWaited.remove(window);
+    // PowOS (0075): still not active after that wait, over a full-screen task that stands (live, or swapping its surface
+    // for a fold/rotate - the unfold's "export-new 1" re-exports every window right then): held off screen, never in
+    // front of the game. It opens once it takes the focus (its app brought forward) or no full-screen task stands.
+    if (AnlandWindowTask *cover = standingFullScreenTask(window);
+        AnlandTaskPolicy::heldBehindFullScreen(cover != nullptr, window->isActive(), relatedTask(window) != nullptr, window->isFullScreen())) {
+        holdBehindFullScreen(window, cover);
+        return;
+    }
+    if (const auto held = m_heldBehindFull.take(window)) {
+        disconnect(held);
+    }
     if (show(window)) {
         qCInfo(KWIN_ANLAND) << "new window" << window->caption() << "(" << window->desktopFileName() << ") opened as a task";
     }
@@ -2598,6 +2624,58 @@ bool AnlandWindowTasks::show(Window *window, bool fullScreen)
     return true;
 }
 
+int64_t AnlandWindowTask::msInBackground() const
+{
+    return m_state == State::Live || m_backgroundSince < 0 ? -1 : QDateTime::currentMSecsSinceEpoch() - m_backgroundSince;
+}
+
+AnlandWindowTask *AnlandWindowTasks::standingFullScreenTask(const Window *window) const
+{
+    for (AnlandWindowTask *task : m_tasks) {
+        const Window *w = task->window();
+        if (w && w != window && !w->isDeleted() && !w->isMinimized() && !task->isPopupSurface()
+            && (task->fullScreen() || task->appFullScreen() || w->isFullScreen())
+            && AnlandTaskPolicy::fullScreenTaskStands(task->live(), task->msInBackground())) {
+            return task;
+        }
+    }
+    return nullptr;
+}
+
+void AnlandWindowTasks::holdBehindFullScreen(Window *window, AnlandWindowTask *cover)
+{
+    if (m_heldBehindFull.contains(window)) {
+        return;
+    }
+    qCInfo(KWIN_ANLAND) << "new window" << window->caption() << "(" << window->desktopFileName() << ") didn't take the focus from full-screen window task"
+                        << cover->id() << ": held off screen until it does or no full-screen task stands";
+    m_heldBehindFull.insert(window, connect(window, &Window::activeChanged, this, [this, w = QPointer<Window>(window)]() {
+        if (w && w->isActive() && m_heldBehindFull.contains(w.data())) {
+            qCInfo(KWIN_ANLAND) << "held window" << w->caption() << "took the focus: it opens";
+            exportNew(w);
+        }
+    }));
+    connect(window, &Window::closed, this, [this, raw = window]() {
+        if (const auto held = m_heldBehindFull.take(raw)) {
+            disconnect(held);
+        }
+    }, Qt::SingleShotConnection);
+}
+
+void AnlandWindowTasks::retryHeld()
+{
+    if (m_heldBehindFull.isEmpty()) {
+        return;
+    }
+    const auto held = m_heldBehindFull.keys();
+    for (Window *window : held) {
+        if (m_heldBehindFull.contains(window) && !window->isDeleted() && !standingFullScreenTask(window)) {
+            qCInfo(KWIN_ANLAND) << "held window" << window->caption() << ": no full-screen task stands now, it opens";
+            exportNew(window);
+        }
+    }
+}
+
 AnlandWindowTask *AnlandWindowTasks::fullScreenTask(const Window *window) const
 {
     for (AnlandWindowTask *task : m_tasks) {
@@ -2732,6 +2810,7 @@ void AnlandWindowTasks::remove(AnlandWindowTask *task)
     task->deleteLater();
     // After the window went back (the task's destructor).
     QMetaObject::invokeMethod(this, &AnlandWindowTasks::dropTasksDesktopIfUnused, Qt::QueuedConnection);
+    QMetaObject::invokeMethod(this, &AnlandWindowTasks::retryHeld, Qt::QueuedConnection); // PowOS (0075)
 }
 
 VirtualDesktop *AnlandWindowTasks::tasksDesktop()
