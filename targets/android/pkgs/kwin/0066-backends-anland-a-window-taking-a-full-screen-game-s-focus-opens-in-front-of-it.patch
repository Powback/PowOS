+void AnlandWindowTask::watchRestore()
+{
+    // PowOS (0066): a full-screen game restored after it minimized itself sometimes never draws again - 11-08 02:03,
+    // Broforce after KWin's Remote Control prompt took its focus: restored, made active, then 0 commits for good while
+    // its engine ran (01:39 and 02:30, the same sequence, kept drawing). The restore came right after the client's own
+    // iconify, before Wine had acted on it; its window state and ours can then disagree (Win32 still minimized on a
+    // mapped, active X window), and a minimized Unity game renders nothing. Watched for a while: one that has the
+    // focus and draws nothing is minimized and restored again (checkRestore).
+    // HACK: the recovery, not the cause. Real fix: find in Wine's (Proton's) X11 window-state handling why an Iconic
+    // -> Normal right after its own WM_CHANGE_STATE can leave the Win32 window minimized, and fix it there or never
+    // restore before the client's iconify is seen (docs/REMOTE-POWOS.md section 4).
+    m_restoreWatchFrom = std::chrono::steady_clock::now();
+    m_restoreKicks = 0;
+    if (!m_restoreActive && m_window) {
+        // The focus coming back (the user answered a prompt in front of it) starts the watch again.
+        m_restoreActive = connect(m_window, &Window::activeChanged, this, [this]() {
+            if (m_window && m_window->isActive() && m_restoreWatch.isActive()) {
+                m_restoreWatchFrom = std::chrono::steady_clock::now();
+            }
+        });
+    }
+    m_restoreWatch.start();
+}
+
+void AnlandWindowTask::checkRestore()
+{
+    using namespace AnlandTaskPolicy;
+    const auto now = std::chrono::steady_clock::now();
+    const auto ms = [now](std::chrono::steady_clock::time_point t) {
+        return int64_t(std::chrono::duration_cast<std::chrono::milliseconds>(now - t).count());
+    };
+    const bool gone = !m_window || m_window->isDeleted() || m_state != State::Live
+        || !(m_fullScreen || m_appFullScreen || m_window->isFullScreen());
+    const int64_t since = ms(m_restoreWatchFrom);
+    const int64_t sinceCommit = std::min(since, ms(m_lastCommitAt));
+    const RestoreWatch what = gone ? RestoreWatch::Done
+                                   : restoreWatch(since, sinceCommit, m_window->isActive(), m_window->isMinimized(), m_restoreKicks);
+    if (what == RestoreWatch::Done) {
+        m_restoreWatch.stop();
+        disconnect(m_restoreActive);
+        m_restoreActive = {};
+        return;
+    }
+    if (what == RestoreWatch::Wait || m_kicking) {
+        return;
+    }
+    m_restoreKicks++;
+    qCWarning(KWIN_ANLAND) << "window task" << m_id << "full-screen window restored" << since << "ms ago has the focus and drew nothing for"
+                           << sinceCommit << "ms: minimized and restored again (" << m_restoreKicks << "of" << restoreKicksMax << ")";
+    m_kicking = true;
+    m_window->setMinimized(true);
+    QTimer::singleShot(500, this, [this]() {
+        m_kicking = false;
+        if (!m_window || m_window->isDeleted()) {
+            return;
+        }
+        m_window->setMinimized(false);
+        if (m_state == State::Live) {
+            focus();
+        }
+        m_restoreWatchFrom = std::chrono::steady_clock::now();
+    });
+}
