+        qCInfo(KWIN_ANLAND) << "window task" << id << "(" << window->caption() << ") took the focus from full-screen window task"
+                            << cover->id() << ": opens in front of it";
+        send({QStringLiteral("parent"), QString::number(id), QString::number(cover->id())});
+        m_overFull.insert(id, cover->id());
     }
     QStringList open{QStringLiteral("open"), QString::number(id), offeredAppId(window), window->caption()};
@@ -2416,4 +2535,22 @@ bool AnlandWindowTasks::show(Window *window, bool fullScreen)
 }
 
+AnlandWindowTask *AnlandWindowTasks::fullScreenTask(const Window *window) const
+{
+    for (AnlandWindowTask *task : m_tasks) {
+        const Window *w = task->window();
+        if (w && w != window && !w->isDeleted() && !w->isMinimized() && task->live() && !task->isPopupSurface()
+            && (task->fullScreen() || task->appFullScreen() || w->isFullScreen())) {
+            return task;
+        }
+    }
+    return nullptr;
+}
+
+bool AnlandWindowTasks::activeIsOver(const AnlandWindowTask *cover) const
+{
+    const AnlandWindowTask *active = workspace() ? taskFor(workspace()->activeWindow()) : nullptr;
+    return cover && active && m_overFull.value(active->id()) == cover->id();
+}
+
 AnlandWindowTask *AnlandWindowTasks::relatedTask(const Window *window) const
 {
