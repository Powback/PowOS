+/*
+    PowOS (0066): pure decisions of the window tasks around a full-screen task (a game), kept free of Qt and KWin so
+    test/task-policy-test.cpp checks them without a KWin build.
+*/
+#pragma once
+
+#include <cstdint>
+
+namespace KWin::AnlandTaskPolicy
+{
+
+/**
+ * A new window opens IN FRONT of a full-screen task ("parent <new> <full-screen task>": the app makes it a task over
+ * the full-screen web window) when it took KWin's activation away from it - a system prompt (KWin's Remote Control
+ * prompt, polkit, a portal dialog) or another app's dialog. Shown as a web window it lay under the game's full-screen
+ * layer, unseen, while it held the focus: the game minimized itself (11-08 02:03, kwin_eis_prompter "shown 99601 ms
+ * after open"). A window that didn't take the focus leaves the game alone and opens as before; a full-screen one is a
+ * game of its own (its own full-screen task).
+ */
+inline bool opensOverFullScreen(bool fullScreenTaskShown, bool newWindowActive, bool newWindowFullScreen)
+{
+    return fullScreenTaskShown && newWindowActive && !newWindowFullScreen;
+}
+
+/** How long a new window may take to get the activation it was started with (an xdg-activation token, an X11 map). */
+constexpr int64_t activationWaitMs = 400;
+
+enum class RestoreWatch {
+    Wait, // nothing to do yet
+    Kick, // the restored window has the focus and draws nothing: minimize and restore it again, the way the app sees
+    Done, // watched long enough, or kicked enough
+};
+
+constexpr int64_t restoreWatchMs = 20000; // after a restore (or the window's activation again)
+constexpr int64_t restoreStallMs = 3000; // no commit for this long while it has the focus = stalled
+constexpr int restoreKicksMax = 2;
+
+/**
+ * A full-screen task's window restored after it minimized itself (handOverMinimize): [sinceMs] since the restore or
+ * since the window got the focus again, [sinceCommitMs] since its last commit (or since the watch began, if none).
+ * Only a window that has the focus and isn't minimized counts as stalled: another window in front (a prompt the user
+ * answers) may hold a game's frames, and that is the game's own pause.
+ */
+inline RestoreWatch restoreWatch(int64_t sinceMs, int64_t sinceCommitMs, bool active, bool minimized, int kicks)
+{
+    if (kicks >= restoreKicksMax || sinceMs > restoreWatchMs) {
+        return RestoreWatch::Done;
+    }
+    if (minimized || !active) {
+        return RestoreWatch::Wait;
+    }
+    return sinceCommitMs >= restoreStallMs ? RestoreWatch::Kick : RestoreWatch::Wait;
+}
+
+} // namespace KWin::AnlandTaskPolicy
