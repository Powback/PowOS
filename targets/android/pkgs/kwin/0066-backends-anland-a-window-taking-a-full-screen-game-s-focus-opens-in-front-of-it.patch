+        connect(window, &Window::activeChanged, this, again, Qt::SingleShotConnection);
+        QTimer::singleShot(AnlandTaskPolicy::activationWaitMs, this, again);
+        return;
+    }
+    m_activationWaited.remove(window);
     if (show(window)) {
         qCInfo(KWIN_ANLAND) << "new window" << window->caption() << "(" << window->desktopFileName() << ") opened as a task";
@@ -2398,4 +2496,15 @@ bool AnlandWindowTasks::show(Window *window, bool fullScreen)
     connect(window, &Window::closed, task, [this, task]() {
         send({QStringLiteral("close"), QString::number(task->id())});
+        // PowOS (0066): a window that opened in front of a full-screen task (a prompt) closed: the game behind it
+        // gets the focus back, restored if it minimized itself meanwhile, and is watched until it draws again.
+        if (const auto cover = m_overFull.take(task->id()); cover && m_tasks.contains(cover)) {
+            QMetaObject::invokeMethod(this, [this, cover]() {
+                if (AnlandWindowTask *t = m_tasks.value(cover); t && t->live() && t->window() && !t->window()->isDeleted()) {
+                    qCInfo(KWIN_ANLAND) << "window task" << cover << ": the window in front of it closed - the focus back";
+                    t->focus();
+                    t->watchRestore();
+                }
+            }, Qt::QueuedConnection);
+        }
         remove(task);
     });
@@ -2407,4 +2516,14 @@ bool AnlandWindowTasks::show(Window *window, bool fullScreen)
                             << "of" << (parent->window() ? parent->window()->caption() : QString()) << ")";
         send({QStringLiteral("parent"), QString::number(id), QString::number(parent->id())});
+    } else if (AnlandWindowTask *cover = fullScreenTask(window);
