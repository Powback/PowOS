From 61125e9222e65191d3bcfe1ea57c067f403e2072 Mon Sep 17 00:00:00 2001
From: PowOS <mats@powback.com>
Date: Fri, 23 Oct 2026 15:01:17 +0200
Subject: [PATCH] backends/anland: a floating window task's own full screen
 covers the screen

A window already shown as a floating task (the unfolded home) that went
full screen by itself - a game, a video, F11 - stayed in its floating
task, scaled down into it, with PowOS's frame and the dock around it:
onFullScreenChanged only acted on windows without a task. Now KWin tells
the app ("fullscreen <id> 1", cap "fullscreen") and the same task covers
the whole screen, immersive; leaving full screen says "fullscreen <id> 0"
and the task floats again at its bounds before. While full screen the
window is scaled to fit the task's size (not its screen-sized buffers),
drawn again when that size changes. A window that OPENED full screen (its
own immersive task) becomes a floating task when it leaves full screen,
instead of going back to the hidden desktop.
---
 src/backends/anland/anland_window_task.cpp | 45 +++++++++++++++++++---
 src/backends/anland/anland_window_task.h   | 11 ++++++
 2 files changed, 50 insertions(+), 6 deletions(-)

diff --git a/src/backends/anland/anland_window_task.cpp b/src/backends/anland/anland_window_task.cpp
index e288b3a..098ddc9 100644
--- a/src/backends/anland/anland_window_task.cpp
+++ b/src/backends/anland/anland_window_task.cpp
@@ -386,15 +386,17 @@ void AnlandWindowTask::releaseBuffers()
 
 bool AnlandWindowTask::fitsWindow() const
 {
-    return m_window && m_window->isFullScreen() && !m_window->clientGeometry().isEmpty() && !m_bufferSize.isEmpty();
+    return m_window && m_window->isFullScreen() && !m_window->clientGeometry().isEmpty() && !taskSize().isEmpty();
 }
 
 qreal AnlandWindowTask::scale() const
 {
     if (fitsWindow()) {
-        // Full screen keeps its size (powosKeepFullScreenGeometry): scaled to fit the task, aspect kept.
+        // Full screen keeps its size (powosKeepFullScreenGeometry): scaled to fit the task, aspect kept. The task's
+        // size, not the buffers': a floating task shows only its part of them (the crop, "size").
         const QSizeF client = m_window->clientGeometry().size();
-        return std::min(m_bufferSize.width() / client.width(), m_bufferSize.height() / client.height());
+        const QSize task = taskSize();
+        return std::min(task.width() / client.width(), task.height() / client.height());
     }
     return m_window ? m_window->targetScale() : 1.0;
 }
@@ -405,8 +407,9 @@ RectF AnlandWindowTask::viewport() const
     const RectF client = m_window ? m_window->clientGeometry() : RectF();
     const QSizeF size = QSizeF(m_bufferSize) / scale();
     if (fitsWindow()) {
-        // Centred: black bars where the task's shape differs from the window's (the cover screen after a fold).
-        return RectF(client.center() - QPointF(size.width(), size.height()) / 2, size);
+        // Centred in the task: black bars where its shape differs from the window's (the cover screen after a fold).
+        const QSizeF task = QSizeF(taskSize()) / scale();
+        return RectF(client.center() - QPointF(task.width(), task.height()) / 2, size);
     }
     return RectF(client.topLeft(), size);
 }
@@ -469,6 +472,23 @@ void AnlandWindowTask::refit()
     }
     qCInfo(KWIN_ANLAND) << "window task" << m_id << "the window took" << has << "itself, the task is" << wanted << ": sized back";
     fitWindow();
+    if (fitsWindow()) {
+        scheduleRender(); // full screen keeps its size: drawn again at the task's new scale
+    }
+}
+
+bool AnlandWindowTask::setAppFullScreen(bool on)
+{
+    if (on == m_appFullScreen || !m_window) {
+        return false;
+    }
+    m_appFullScreen = on;
+    // Kept through output changes while the task shows it full screen (as a game's own full-screen task, goLive).
+    m_window->setProperty("powosKeepFullScreenGeometry", on);
+    qCInfo(KWIN_ANLAND) << "window task" << m_id << (on ? "full screen (the app's own)" : "floating again") << m_window->clientGeometry();
+    fitWindow();
+    scheduleRender();
+    return true;
 }
 
 void AnlandWindowTask::fitWindow()
@@ -740,7 +760,7 @@ void AnlandWindowTasks::connectControl()
     connect(m_controlNotifier, &QSocketNotifier::activated, this, &AnlandWindowTasks::onControlReadable);
     // What this KWin understands beyond "closed"/"focus": the app only sends it then (an older KWin, buffers of the
     // task's size as before).
-    send({QStringLiteral("caps"), QStringLiteral("size export-new")});
+    send({QStringLiteral("caps"), QStringLiteral("size export-new fullscreen")});
 }
 
 void AnlandWindowTasks::onControlReadable()
@@ -946,10 +966,23 @@ void AnlandWindowTasks::onFullScreenChanged(Window *window)
     if (window->isFullScreen()) {
         if (!task && !handBackAndroidApp(window) && exportable(window)) {
             show(window, true);
+        } else if (task && !task->fullScreen() && task->setAppFullScreen(true)) {
+            // Already a floating task (the unfolded home): the same task covers the whole screen, immersive - no
+            // frame, no dock - and floats again where it was when the window leaves full screen.
+            send({QStringLiteral("fullscreen"), QString::number(task->id()), QStringLiteral("1")});
         }
     } else if (task && task->fullScreen()) {
         send({QStringLiteral("close"), QString::number(task->id())});
         remove(task);
+        // Opened full screen (a game), now a normal window: on the unfolded home a floating task, never left on the
+        // hidden desktop.
+        QMetaObject::invokeMethod(this, [this, w = QPointer<Window>(window)]() {
+            if (w) {
+                exportNew(w);
+            }
+        }, Qt::QueuedConnection);
+    } else if (task && task->setAppFullScreen(false)) {
+        send({QStringLiteral("fullscreen"), QString::number(task->id()), QStringLiteral("0")});
     }
 }
 
diff --git a/src/backends/anland/anland_window_task.h b/src/backends/anland/anland_window_task.h
index 02cccaa..1abed70 100644
--- a/src/backends/anland/anland_window_task.h
+++ b/src/backends/anland/anland_window_task.h
@@ -77,6 +77,16 @@ public:
      * commits - with no new buffers per step. Before the app says one: the buffers' size.
      */
     void resizeTo(const QSize &taskSize);
+    /**
+     * The window of this (floating) task went full screen by itself (a game, a video, F11) - [on] - or left it: true
+     * when that changed. The app makes the same task cover the whole screen ("fullscreen <id> 1"), and float again at
+     * its bounds before ("fullscreen <id> 0"); meanwhile the window is scaled to fit the task (fitsWindow).
+     */
+    bool setAppFullScreen(bool on);
+    bool appFullScreen() const
+    {
+        return m_appFullScreen;
+    }
 
 private:
     enum class State {
@@ -120,6 +130,7 @@ private:
     QPointer<Window> m_window;
     const uint32_t m_id;
     const bool m_fullScreen;
+    bool m_appFullScreen = false;
     display_ctx *m_display = nullptr;
     State m_state = State::Handshake;
     QSocketNotifier *m_ctrlNotifier = nullptr;
