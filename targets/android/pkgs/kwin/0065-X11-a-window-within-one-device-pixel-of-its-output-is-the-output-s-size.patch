diff --git a/src/x11window.cpp b/src/x11window.cpp
index a3d8f90..02eeee3 100644
--- a/src/x11window.cpp
+++ b/src/x11window.cpp
@@ -32,6 +32,7 @@
 #include "wayland/xwaylandshell_v1.h"
 #include "wayland_server.h"
 #include "workspace.h"
+#include "utils/xnativesnap.h"
 #include <KDecoration3/DecoratedWindow>
 #include <KDecoration3/Decoration>
 // KDE
@@ -3576,6 +3577,7 @@ void X11Window::configure(const Rect &nativeGeometry)
     // - we need to configure the window to match the emulated size
     // - Xwayland will set up the viewport to present the window properly on the Wayland side
     Rect effectiveGeometry = nativeGeometry;
+    bool emulated = false; // PowOS (kwin 0065): an emulated mode's size stays as Xwayland asked
     if (m_fullscreenMode == X11Window::FullScreenMode::FullScreenNormal) {
         Xcb::Property property(0, m_client, atoms->xwayland_xrandr_emulation, XCB_ATOM_CARDINAL, 0, workspace()->outputs().size() * 4);
         const auto values = property.array<uint32_t>();
@@ -3588,11 +3590,28 @@ void X11Window::configure(const Rect &nativeGeometry)
                 if (xwaylandOutputPos == QPoint(x, y)) {
                     effectiveGeometry.setWidth((*values)[i * 4 + 2]);
                     effectiveGeometry.setHeight((*values)[i * 4 + 3]);
+                    emulated = true;
                     break;
                 }
             }
         }
     }
+    if (!emulated) {
+        // PowOS (kwin 0065): within one device px of an output -> exactly the output, in X pixels from its
+        // unrounded logical geometry (xnativesnap.h: a 2268x2439 game in a 2268x2440 screen never flips).
+        const qreal scale = kwinApp()->xwaylandScale();
+        const XNativeSnap::Box g{effectiveGeometry.x(), effectiveGeometry.y(), effectiveGeometry.width(), effectiveGeometry.height()};
+        for (const LogicalOutput *output : workspace()->outputs()) {
+            const RectF o = output->geometryF();
+            XNativeSnap::Box snapped;
+            if (XNativeSnap::snap(g, XNativeSnap::outputBox(o.x(), o.y(), o.width(), o.height(), scale), &snapped)) {
+                qCDebug(KWIN_CORE) << "X window" << window() << "snapped to its output:" << effectiveGeometry.size()
+                                   << "->" << QSize(snapped.w, snapped.h);
+                effectiveGeometry = Rect(snapped.x, snapped.y, snapped.w, snapped.h);
+                break;
+            }
+        }
+    }
     if (m_client.size() != effectiveGeometry.size()) {
         m_client.setGeometry(effectiveGeometry);
     } else if (m_client.position() != effectiveGeometry.topLeft()) {
