                               << "on a" << screen.size() << "screen (a rotate/fold mid-way," << since << "ms after its task resized it)";
             mask &= ~NET::FullScreen;
         } else {
+            // PowOS (kwin 0076): a leave let through says why, as a refused one does: game-resize 11-18 22:42 (My Friend
+            // Pedro unfolded again) left full screen with no line at all, so which path did it was guesswork.
+            if (m_client->property("powosKeepFullScreenGeometry").toBool()) {
+                qCInfo(KWIN_CORE) << "PowOS: full screen left on the client's request:" << m_client->caption() << "at" << frame.size()
+                                  << "on a" << screen.size() << "screen," << since << "ms after its last screen change";
+            }
             m_client->setFullScreen(false);
         }
     }
