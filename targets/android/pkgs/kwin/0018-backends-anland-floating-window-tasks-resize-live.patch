+void AnlandWindowTasks::setExportNew(bool on)
+{
+    if (on == m_exportNew) {
+        return;
+    }
+    m_exportNew = on;
+    qCInfo(KWIN_ANLAND) << "new windows as tasks:" << on;
+    if (!on || !workspace()) {
+        return;
+    }
+    // Turned on: the application windows already open on the desktop too - nothing shows the desktop now, so a
+    // window left there could never be reached (six Gwenview windows opened that way, 2026-10-23).
+    for (Window *window : workspace()->windows()) {
+        exportNew(window);
+    }
+}
+
+void AnlandWindowTasks::exportNew(Window *window)
+{
+    if (!m_exportNew || !window || window->isDeleted() || window->transientFor() || window->isFullScreen() || taskFor(window)) {
+        return;
+    }
+    if (window->isMinimized() || !exportable(window)) {
+        return;
+    }
+    show(window);
+}
