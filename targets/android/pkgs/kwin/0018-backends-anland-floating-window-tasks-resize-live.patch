+QSize AnlandWindowTask::taskSize() const
+{
+    // Never past the buffers: what doesn't fit them can't be shown.
+    return m_taskSize.isEmpty() || m_bufferSize.isEmpty() ? m_bufferSize : m_taskSize.boundedTo(m_bufferSize);
+}
+
+void AnlandWindowTask::resizeTo(const QSize &taskSize)
+{
+    if (taskSize.isEmpty() || taskSize == m_taskSize) {
+        return;
+    }
+    m_taskSize = taskSize;
+    fitWindow();
+}
+
 void AnlandWindowTask::fitWindow()
 {
     // A full-screen window keeps KWin's full-screen geometry (the screen's - what the immersive task shows).
     if (!m_window || m_bufferSize.isEmpty() || m_window->isFullScreen()) {
         return;
     }
-    // The window takes the task's size (split screen, floating window, fold): its client area fills the buffers.
-    const QSizeF client = QSizeF(m_bufferSize) / scale();
+    // The window takes the task's size (split screen, floating window, fold): its client area fills the task. The
+    // latest size wins - KWin configures the client, which commits when it has laid itself out (render() draws
+    // whatever it has meanwhile, at its real size from the top left: never stretched).
+    const QSizeF client = QSizeF(taskSize()) / scale();
     if (m_window->clientGeometry().size() != client) {
+        m_resizeAsked = std::chrono::steady_clock::now();
+        m_resizeWanted = client;
         m_window->moveResize(RectF(m_window->frameGeometry().topLeft(), m_window->clientSizeToFrameSize(client)));
     }
 }
 
+void AnlandWindowTask::noteResized()
+{
+    // The client committed the size resizeTo asked for: how long it took (the log line after the resize).
+    if (!m_window || m_resizeWanted.isEmpty() || m_window->clientGeometry().size() != m_resizeWanted) {
+        return;
+    }
+    m_resizeWanted = QSizeF();
+    const auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - m_resizeAsked);
+    m_resizeLatencies.append(int(ms.count()));
+    m_resizeReport.start();
+}
