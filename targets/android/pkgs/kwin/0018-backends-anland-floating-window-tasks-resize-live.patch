+bool AnlandWindowTask::watching(const Window *window) const
+{
+    for (const Watched &w : m_watched) {
+        if (w.window == window) {
+            return true;
+        }
+    }
+    return false;
+}
+
+void AnlandWindowTask::attach(Window *window)
+{
+    // [window]'s transients (popups, menus, dialogs, theirs in turn), already open: drawn into the task with it.
+    for (Window *child : window->transients()) {
+        if (!child->isDeleted() && !watching(child)) {
+            watchWindow(child);
+            attach(child);
+        }
+    }
+}
