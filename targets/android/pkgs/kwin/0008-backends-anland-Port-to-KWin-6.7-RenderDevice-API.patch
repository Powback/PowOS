diff -ruN s3/src/core/renderdevice.cpp s4/src/core/renderdevice.cpp
--- a/src/core/renderdevice.cpp	2026-10-13 01:01:37
+++ b/src/core/renderdevice.cpp	2026-10-13 01:04:02
@@ -135,6 +135,13 @@
 
 static std::unique_ptr<VulkanDevice> openVulkanDevice(const vk::raii::Instance &instance, DrmDevice *drm)
 {
+    // A render device without a DRM node (the anland backend on Android: EGL is
+    // surfaceless on KGSL, no /dev/dri) can't be matched to a Vulkan physical device
+    // by its render node: run EGL-only rather than dereference the missing device.
+    if (!drm) {
+        qCDebug(KWIN_VULKAN, "No DRM device for this render device; Vulkan disabled");
+        return nullptr;
+    }
     const auto [enumerateResult, physicalDevices] = instance.enumeratePhysicalDevices();
     if (enumerateResult != vk::Result::eSuccess) {
         qCWarning(KWIN_VULKAN) << "querying vulkan devices failed:" << vk::to_string(enumerateResult);
