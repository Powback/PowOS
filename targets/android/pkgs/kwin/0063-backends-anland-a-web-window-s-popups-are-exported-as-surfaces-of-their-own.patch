     connect(m_ctrlNotifier, &QSocketNotifier::activated, this, &AnlandWindowTask::onCtrlReadable);
+    // PowOS (0063): the window moved or resized (a floating task, its own move): its exported popups' places with it.
+    connect(window, &Window::frameGeometryChanged, this, [this]() {
+        for (AnlandWindowTask *surface : std::as_const(m_popupSurfaces)) {
+            tellPopup(surface);
+        }
+    });
+}
+
+AnlandWindowTask::AnlandWindowTask(AnlandWindowTasks *tasks, Window *popup, uint32_t id, AnlandWindowTask *parent)
+    : QObject(parent)
+    , m_tasks(tasks)
+    , m_window(popup)
+    , m_id(id)
+    , m_fullScreen(false)
+    , m_isPopup(true)
+    , m_popupOf(parent)
+{
+    m_retry.setSingleShot(true);
+    m_retry.setInterval(500);
+    connect(&m_retry, &QTimer::timeout, this, &AnlandWindowTask::requestConsumer);
+    m_statsReport.setInterval(5000);
+    connect(&m_statsReport, &QTimer::timeout, this, &AnlandWindowTask::noteFrameStats);
+    m_keepalive.setSingleShot(true);
+    m_keepalive.setInterval(s_keepaliveMs);
+    connect(&m_keepalive, &QTimer::timeout, this, [this]() {
+        render(true);
+    });
+    // Its surface of the daemon: the app's consumer for it says hello with this id after "popup".
+    if (connect_to_deamon_begin(&m_display, m_tasks->socketPath().toLocal8Bit().constData(), m_id) < 0) {
+        qCWarning(KWIN_ANLAND) << "popup surface" << m_id << ": no display daemon";
+        m_display = nullptr;
+        return;
+    }
+    set_fallback_callback(m_display, &AnlandWindowTask::fallbackTrampoline, this);
+    m_ctrlNotifier = new QSocketNotifier(get_ctrl_fd(m_display), QSocketNotifier::Read, this);
+    connect(m_ctrlNotifier, &QSocketNotifier::activated, this, &AnlandWindowTask::onCtrlReadable);
+}
+
+bool AnlandWindowTask::exportablePopup(const Window *window) const
+{
+    // A popup (menu, dropdown, combo box, tooltip: xdg_popup or the X11 types) or an X11 override-redirect window
+    // (0062's: Steam's menus, Wine's untyped ones) - never the window itself nor a dialog (those stay in the task).
+    return !m_isPopup && window && window != m_window && !window->isDeleted()
+        && (window->isPopupWindow() || window->isUnmanaged());
+}
+
+void AnlandWindowTask::setWebPopups(int mode)
+{
+    if (m_isPopup || mode == m_webPopups || mode < 0 || mode > 2) {
+        return;
+    }
+    qCInfo(KWIN_ANLAND) << "window task" << m_id << ": popups as their own surfaces" << mode << "(was" << m_webPopups << ")";
+    m_webPopups = mode;
+    if (mode == 0) {
+        dropAllPopups("the app turned them off");
+    } else if (m_state == State::Live) {
+        const auto watched = m_watched;
+        for (const Watched &w : watched) {
+            if (w.window && exportablePopup(w.window)) {
+                exportPopup(w.window);
+            }
+        }
+    }
+    markStale(); // mode 2 leaves them out of this task's frames, 0/1 draws them again
+    scheduleRender();
+}
+
+void AnlandWindowTask::exportPopup(Window *popup)
+{
+    if (m_webPopups == 0 || m_state != State::Live || m_popupSurfaces.contains(popup) || !exportablePopup(popup)) {
+        return;
+    }
+    const uint32_t id = m_tasks->takeId();
+    auto *surface = new AnlandWindowTask(m_tasks, popup, id, this);
+    m_popupSurfaces.insert(popup, surface);
+    qCInfo(KWIN_ANLAND) << "window task" << m_id << "exports popup" << id << describe(popup) << "at" << popup->frameGeometry();
+    // Where its client moves or sizes it (a submenu, a dropdown growing): said again.
+    connect(popup, &Window::frameGeometryChanged, surface, [this, surface]() {
+        tellPopup(surface);
+    });
+    tellPopup(surface);
+}
+
+void AnlandWindowTask::tellPopup(AnlandWindowTask *surface)
+{
+    Window *popup = surface->window();
+    if (!popup || popup->isDeleted()) {
+        return;
+    }
+    // In this task's buffer pixels: the popup's frame against the task's viewport (what the task's buffers show from
+    // their top left), so the app places it at its window's body + (x, y). Negative or past the task's size: the popup
+    // reaches out of the window (a Steam menu longer than it) - the reason it is a surface of its own.
+    const qreal s = scale();
+    const RectF frame = popup->frameGeometry();
+    const QPointF at = (frame.topLeft() - viewport().topLeft()) * s;
+    const qreal ps = popup->targetScale();
+    const QRect told(QPoint(qRound(at.x()), qRound(at.y())), QSize(qMax(1, qRound(frame.width() * ps)), qMax(1, qRound(frame.height() * ps))));
+    if (told == surface->m_popupTold) {
+        return;
+    }
+    surface->m_popupTold = told;
+    m_tasks->send({QStringLiteral("popup"), QString::number(m_id), QString::number(surface->id()), QString::number(told.x()),
+                   QString::number(told.y()), QString::number(told.width()), QString::number(told.height())});
+}
+
+void AnlandWindowTask::dropPopup(Window *popup, const char *why)
+{
+    AnlandWindowTask *surface = m_popupSurfaces.take(popup);
+    if (!surface) {
+        return;
+    }
+    qCInfo(KWIN_ANLAND) << "window task" << m_id << ": popup" << surface->id() << "gone:" << why;
+    m_tasks->send({QStringLiteral("popup-gone"), QString::number(m_id), QString::number(surface->id())});
+    surface->deleteLater(); // maybe inside its own callback (a failed handshake)
+}
+
+void AnlandWindowTask::dropAllPopups(const char *why)
+{
+    const auto popups = m_popupSurfaces.keys();
+    for (Window *popup : popups) {
+        dropPopup(popup, why);
+    }
+}
+
+void AnlandWindowTask::giveUp(const char *why)
+{
+    if (!m_isPopup) {
+        m_tasks->remove(this);
+    } else if (m_popupOf) {
+        m_popupOf->dropPopup(m_window, why);
+    } else {
+        deleteLater();
+    }
 }
 
