+void Workspace::setPopupAreaHandler(std::function<std::optional<RectF>(const Window *)> handler)
+{
+    m_popupAreaHandler = std::move(handler);
+}
+
+std::optional<RectF> Workspace::popupArea(const Window *parent) const
+{
+    if (!m_popupAreaHandler || !parent) {
+        return std::nullopt;
+    }
+    return m_popupAreaHandler(parent);
+}
