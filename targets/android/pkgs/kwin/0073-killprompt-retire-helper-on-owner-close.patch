@@ -39,6 +40,10 @@ public:
 
 private:
     Window *m_window = nullptr;
+    bool m_ownerClosed = false;
+    bool m_quitRequested = false;
+    QTimer m_retirementTimer;
+    // Destroy the connection context first, while callback state is still alive.
     QProcess m_process;
 };
 
