From: PowOS <noreply@powback.com>
Subject: [PATCH] input: PowOS phone: swipe up on a panel opens the launcher

The taskbar is the app drawer's handle. See PhoneLauncherSwipeFilter. (The desktop background opens it too, in
Plasma, which can tell it from a widget: plasma-desktop patch 0005.)
---
diff --git a/src/input.cpp b/src/input.cpp
--- a/src/input.cpp	2026-10-13 04:02:18
+++ b/src/input.cpp	2026-10-13 04:02:18
@@ -65,7 +65,11 @@
 #include <KScreenLocker/KsldApp>
 #endif
 // Qt
+#include <KConfigGroup>
 #include <QAction>
+#include <QDBusConnection>
+#include <QDBusMessage>
+#include <QDBusPendingCall>
 #include <QKeyEvent>
 #include <QThread>
 #include <qpa/qwindowsysteminterface.h>
@@ -1920,6 +1924,107 @@
 };
 
 /**
+ * PowOS phone: a swipe up on a panel (the taskbar is the drawer handle) opens the
+ * application launcher, like a phone's app drawer.
+ *
+ * Not a screen edge: on a phone the bottom edge belongs to the host OS's home gesture, and KWin's
+ * touch edges swallow every touch that starts inside them (ScreenEdgeGestureRecognizer::touchDown),
+ * so an edge as tall as the panel would make the panel untappable. This filter lets the touch through
+ * until it is clearly an upward swipe, then cancels it for the client (the desktop's rubber band, a
+ * panel applet) and toggles the launcher the way the ApplicationLauncher screen edge action does.
+ *
+ * On when POWOS_PLATFORM=phone (the PowOS phone session sets it); kwinrc [PowOS] SwipeUpLauncher=false
+ * turns it off.
+ */
+class PhoneLauncherSwipeFilter : public InputEventFilter
+{
+public:
+    PhoneLauncherSwipeFilter()
+        : InputEventFilter(InputFilterOrder::PhoneLauncherSwipe)
+    {
+    }
+
+    static bool enabled()
+    {
+        return qgetenv("POWOS_PLATFORM") == "phone"
+            && kwinApp()->config()->group(QStringLiteral("PowOS")).readEntry("SwipeUpLauncher", true);
+    }
+
+    bool touchDown(TouchDownEvent *event) override
+    {
+        if (m_taken) {
+            return true;
+        }
+        if (m_id) {
+            // a second finger: a pinch or a multi-finger gesture, not ours
+            m_id.reset();
+            return false;
+        }
+        const Window *window = input()->findToplevel(event->pos);
+        if (window && window->isDock()) { // the desktop background: Plasma's own (plasma-desktop 0005)
+            m_id = event->id;
+            m_start = event->pos;
+        }
+        return false;
+    }
+    bool touchMotion(TouchMotionEvent *event) override
+    {
+        if (m_taken) {
+            return true;
+        }
+        if (m_id != event->id) {
+            return false;
+        }
+        const QPointF delta = event->pos - m_start;
+        if (-delta.y() >= s_distance && std::abs(delta.x()) < -delta.y()) {
+            // A release, not notifyTouchCancel(): Plasma's desktop kept its press-and-hold timer through a cancel
+            // and went into edit mode (closing the launcher). Past the drag threshold, a release is no click.
+            waylandServer()->seat()->notifyTouchUp(*m_id);
+            waylandServer()->seat()->notifyTouchFrame();
+            QDBusConnection::sessionBus().asyncCall(
+                QDBusMessage::createMethodCall(QStringLiteral("org.kde.plasmashell"),
+                                               QStringLiteral("/PlasmaShell"),
+                                               QStringLiteral("org.kde.PlasmaShell"),
+                                               QStringLiteral("activateLauncherMenu")));
+            m_taken = true;
+            m_fingers = 1;
+            return true;
+        }
+        if (std::abs(delta.x()) >= s_distance || delta.y() >= s_distance) {
+            m_id.reset(); // sideways or downwards: an ordinary drag
+        }
+        return false;
+    }
+    bool touchUp(TouchUpEvent *event) override
+    {
+        if (m_id == event->id) {
+            m_id.reset();
+        }
+        if (m_taken) {
+            // the sequence was cancelled for the client: swallow it until its last finger lifts
+            if (--m_fingers <= 0) {
+                m_taken = false;
+            }
+            return true;
+        }
+        return false;
+    }
+    bool touchCancel() override
+    {
+        m_id.reset();
+        m_taken = false;
+        return false;
+    }
+
+private:
+    static constexpr qreal s_distance = 48; // logical px
+    std::optional<qint32> m_id;
+    QPointF m_start;
+    bool m_taken = false;
+    int m_fingers = 0;
+};
+
+/**
  * This filter implements window actions. If the event should not be passed to the
  * current window it will filter out the event
  */
@@ -3170,6 +3275,11 @@
     if (kwinApp()->supportsGlobalShortcuts()) {
         m_screenEdgeFilter = std::make_unique<ScreenEdgeInputFilter>();
         installInputEventFilter(m_screenEdgeFilter.get());
+    }
+
+    if (PhoneLauncherSwipeFilter::enabled()) {
+        m_phoneLauncherSwipeFilter = std::make_unique<PhoneLauncherSwipeFilter>();
+        installInputEventFilter(m_phoneLauncherSwipeFilter.get());
     }
 
     m_dragAndDropFilter = std::make_unique<DragAndDropInputFilter>();
