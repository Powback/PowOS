+void AnlandWindowTasks::followScreen(const QSize &screen)
+{
+    // A full-screen game's window covers Wine's monitor (the X root) only while both are the screen's size. The root
+    // follows the app's screen at once (0061), the window only when its task reports its new size ("size") - seconds
+    // later on a fold, or never when the task's surface is re-made (game-resize 11-11 03:19: Besiege on the cover,
+    // landscape -> portrait, no "full screen follows its task" at all). Meanwhile the 2484x1116 window sat in a 1116x2484
+    // root: Wine asked to leave full screen, Unity re-made its window at 473x2484 (and 1135x1365 / 390x2484 in other
+    // runs) and the task was left without a full-screen game. The app's own full-screen task covers the whole screen
+    // (immersive, _POWOS_SCREEN_SIZE), so its size is known now: taken here, the window and the root change in the
+    // same event, and Wine's leave from the moment between them is within 0072's grace (refused).
+    if (!screen.isValid()) {
+        return;
+    }
+    for (AnlandWindowTask *task : std::as_const(m_tasks)) {
+        Window *window = task->window();
+        if (!window || !AnlandTaskPolicy::followsScreenWithRoot(task->appFullScreen(), window->isFullScreen(),
+                                                                window->property("powosKeepFullScreenGeometry").toBool())) {
+            continue;
+        }
+        qCInfo(KWIN_ANLAND) << "window task" << task->id() << "full screen takes the new screen with the root:" << screen;
+        task->resizeTo(screen);
+    }
+}
