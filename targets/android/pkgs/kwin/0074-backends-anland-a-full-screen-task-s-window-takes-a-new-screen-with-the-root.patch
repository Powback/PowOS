+/**
+ * PowOS (kwin 0074): a task's window takes the app's new screen with the output and Xwayland's root (followScreen)
+ * only when the screen IS its task's size: the app's own full-screen task ([appFullScreen], immersive, the whole
+ * screen) shows a full-screen window ([windowFullScreen]) whose geometry the task keeps ([keptByTask],
+ * powosKeepFullScreenGeometry). A floating task, or a full-screen window in a floating task, waits for its task's size.
+ */
+inline bool followsScreenWithRoot(bool appFullScreen, bool windowFullScreen, bool keptByTask)
+{
+    return appFullScreen && windowFullScreen && keptByTask;
+}
