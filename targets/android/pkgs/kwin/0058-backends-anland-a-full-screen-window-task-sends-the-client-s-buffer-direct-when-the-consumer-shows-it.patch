+void AnlandWindowTask::resetDirect()
+{
+    m_directCaps = 0;
+    m_directLast = 0;
+    m_directShowing = false;
+    for (auto it = m_directIds.cbegin(); it != m_directIds.cend(); ++it) {
+        QObject::disconnect(it.key(), &QObject::destroyed, this, nullptr);
+    }
+    m_directIds.clear();
+    m_directFdSent.clear();
+    m_directForget.clear();
+    // HACK: a buffer the consumer's (hidden) child may still hold goes back to the client here - fine after a
+    // disconnect (its surface is gone), but after a mid-stream refusal (caps 0) SurfaceFlinger could still read it for
+    // a frame. Real fix: the consumer sends the releases for what it holds before caps 0.
+    m_directHolds.clear();
+    markStale(); // every consumer buffer holds an old composite at best: the next offer is drawn (or sent) fresh
+}
