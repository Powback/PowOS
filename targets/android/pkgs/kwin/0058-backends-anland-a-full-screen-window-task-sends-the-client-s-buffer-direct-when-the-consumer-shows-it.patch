+bool AnlandWindowTask::sendDirect()
+{
+    // PowOS (0058): directBlocker() said the client's buffer is the frame. The consumer shows XR24/AR24 (its
+    // DIRECT_CAP_XR24_LINEAR); anything else is composited, never sent (the consumer gives direct up for good on one).
+    SurfaceInterface *surface = m_window ? m_window->surface() : nullptr;
+    GraphicsBuffer *buffer = surface ? surface->buffer() : nullptr;
+    const DmaBufAttributes *attrs = buffer ? buffer->dmabufAttributes() : nullptr;
+    if (!attrs || !(m_directCaps & DIRECT_CAP_XR24_LINEAR) || (attrs->format != 0x34325258 && attrs->format != 0x34325241)) {
+        m_statBlockers[QStringLiteral("consumer-format")]++;
+        return false;
+    }
+    uint32_t id = m_directIds.value(buffer, 0);
+    if (!id) {
+        if (m_directIds.size() >= 8) { // the consumer keeps 8 (direct_scanout.c MAX_IDS); more = it refuses for good
+            m_statBlockers[QStringLiteral("too-many-buffers")]++;
+            return false;
+        }
+        id = m_directNextId++;
+        if (!m_directNextId) {
+            m_directNextId = 1;
+        }
+        m_directIds.insert(buffer, id);
+        // The client destroyed it: its id is forgotten on the consumer before more buffers go (render()). Never
+        // while held - a held buffer isn't destroyed (GraphicsBufferRef).
+        connect(buffer, &QObject::destroyed, this, [this, buffer]() {
+            const uint32_t gone = m_directIds.take(buffer);
+            if (gone && m_directFdSent.remove(gone)) {
+                m_directForget.append(gone);
+            }
+        });
+    }
+    const bool newFd = !m_directFdSent.contains(id);
+    struct direct_frame df = {};
+    df.id = id;
+    df.width = attrs->width;
+    df.height = attrs->height;
+    df.pitch = attrs->pitch[0];
+    df.fourcc = attrs->format;
+    df.offset = attrs->offset[0];
+    df.modifier = attrs->modifier;
+    // No acquire fence: KWin applies a commit only once the client's dma-buf is ready (implicit fence / its acquire
+    // point, the transaction), so the buffer is complete when it is surface->buffer().
+    df.flags = newFd ? DIRECT_FLAG_NEW_FD : 0;
+    if (send_direct_frame(m_display, &df, -1, newFd ? attrs->fd[0].get() : -1) != 0) {
+        return false;
+    }
+    if (newFd) {
+        m_directFdSent.insert(id);
+    }
+    if (id != m_directLast) {
+        // On screen in place of another: one DIRECT_RELEASE comes for it when something else replaces it.
+        DirectHold &hold = m_directHolds[id];
+        hold.ref = buffer;
+        hold.count++;
+    }
+    m_directLast = id;
+    m_directShowing = true;
+    return true;
+}
+
+bool AnlandWindowTask::sendDirectNoFrame(uint32_t id)
+{
+    struct direct_frame df = {};
+    df.id = id;
+    df.flags = DIRECT_FLAG_FORGET;
+    return send_direct_frame(m_display, &df, -1, -1) == 0;
+}
+
+void AnlandWindowTask::directReleased(uint32_t id)
+{
+    // SurfaceFlinger no longer reads it: the client may have it back (its wl_buffer.release once nothing else holds it).
+    auto it = m_directHolds.find(id);
+    if (it == m_directHolds.end()) {
+        return;
+    }
+    if (--it->count <= 0) {
+        m_directHolds.erase(it);
+    }
+}
