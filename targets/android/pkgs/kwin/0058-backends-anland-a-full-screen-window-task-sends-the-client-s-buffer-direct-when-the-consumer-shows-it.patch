+int send_direct_frame(display_ctx *ctx, const struct direct_frame *df, int fence_fd, int dmabuf_fd)
+{
+    if (ctx->fallback)
+        return -1;
+    char b = (char)(FRAME_TAG_DIRECT | FRAME_TAG_PRETRANSFORM | (ctx->buf_transform & 3));
+    struct iovec iov[2] = {
+        { .iov_base = &b, .iov_len = 1 },
+        { .iov_base = (void *)df, .iov_len = sizeof(*df) },
+    };
+    int fds[2], n = 0;
+    if (fence_fd >= 0)
+        fds[n++] = fence_fd;
+    if (dmabuf_fd >= 0)
+        fds[n++] = dmabuf_fd;
+    union {
+        char buf[CMSG_SPACE(2 * sizeof(int))];
+        struct cmsghdr align;
+    } cmsg;
+    struct msghdr msg = {
+        .msg_iov = iov,
+        .msg_iovlen = 2,
+    };
+    if (n > 0) {
+        msg.msg_control = cmsg.buf;
+        msg.msg_controllen = CMSG_SPACE(n * sizeof(int));
+        struct cmsghdr *c = CMSG_FIRSTHDR(&msg);
+        c->cmsg_level = SOL_SOCKET;
+        c->cmsg_type = SCM_RIGHTS;
+        c->cmsg_len = CMSG_LEN(n * sizeof(int));
+        memcpy(CMSG_DATA(c), fds, n * sizeof(int));
+    }
+    /* Non-blocking as trigger_refresh. In lockstep the channel is empty here; a short write (never seen) would split
+     * the struct, which the consumer reads with a 1 s poll, so it still arrives whole. */
+    ssize_t r = sendmsg(ctx->fence_fd, &msg, MSG_NOSIGNAL | MSG_DONTWAIT);
+    if (r <= 0)
+        return -1;
+    if ((size_t)r < 1 + sizeof(*df)) {
+        size_t off = (size_t)r - 1;
+        while (off < sizeof(*df)) {
+            ssize_t w = send(ctx->fence_fd, (const char *)df + off, sizeof(*df) - off, MSG_NOSIGNAL);
+            if (w <= 0)
+                break;
+            off += (size_t)w;
+        }
+    }
+    if (ctx->pending_render_fence >= 0) {
+        close(ctx->pending_render_fence);
+        ctx->pending_render_fence = -1;
+    }
+    return 0;
+}
