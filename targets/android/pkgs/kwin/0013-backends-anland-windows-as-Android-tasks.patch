+namespace KWin
+{
+
+// The consumer gives up on a buffer it handed over after 5 s (refresh_done): answer well before.
+static constexpr int s_keepaliveMs = 2000;
+// Touch ids of a task's fingers: never the desktop's own (Android's are small).
+static constexpr qint32 s_touchIdBase = 1 << 16;
+static const QString s_tasksDesktopName = QStringLiteral("Android tasks");
+
+static std::chrono::milliseconds now()
+{
+    return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch());
+}
+
+// ---------------------------------------------------------------------------
+// AnlandWindowTask
+// ---------------------------------------------------------------------------
+
+AnlandWindowTask::AnlandWindowTask(AnlandWindowTasks *tasks, Window *window, uint32_t id)
+    : QObject(tasks)
+    , m_tasks(tasks)
+    , m_window(window)
+    , m_id(id)
+{
+    m_retry.setSingleShot(true);
+    m_retry.setInterval(500);
+    connect(&m_retry, &QTimer::timeout, this, &AnlandWindowTask::requestConsumer);
+    m_keepalive.setSingleShot(true);
+    m_keepalive.setInterval(s_keepaliveMs);
+    connect(&m_keepalive, &QTimer::timeout, this, [this]() {
+        render(true);
+    });
+
+    connect(window, &Window::captionChanged, this, [this]() {
+        m_tasks->send({QStringLiteral("title"), QString::number(m_id), m_window->caption()});
+    });
+
+    // Its surface of the daemon: the task's consumer says hello with the same id once the activity is up.
+    if (connect_to_deamon_begin(&m_display, m_tasks->socketPath().toLocal8Bit().constData(), m_id) < 0) {
+        qCWarning(KWIN_ANLAND) << "window task" << m_id << ": no display daemon";
+        m_display = nullptr;
+        return;
+    }
+    set_fallback_callback(m_display, &AnlandWindowTask::fallbackTrampoline, this);
+    m_ctrlNotifier = new QSocketNotifier(get_ctrl_fd(m_display), QSocketNotifier::Read, this);
+    connect(m_ctrlNotifier, &QSocketNotifier::activated, this, &AnlandWindowTask::onCtrlReadable);
+}
+
+AnlandWindowTask::~AnlandWindowTask()
+{
+    cancelTouches();
+    releaseBuffers();
+    if (m_display) {
+        ::disconnect(m_display); // C producer API, not QObject::disconnect
+        m_display = nullptr;
+    }
+    unwatchAll();
+    if (m_window && m_exported && !m_window->isDeleted() && workspace()) {
+        // Back on the desktop as it was, and in front.
+        m_window->setDesktops(m_desktops);
+        m_window->moveResize(m_geometry);
+        if (m_maximizeMode != MaximizeRestore) {
+            m_window->maximize(m_maximizeMode);
+        }
+        workspace()->activateWindow(m_window);
+    }
+}
+
+void AnlandWindowTask::focus()
+{
+    if (m_window && m_exported) {
+        // The window is shown (on the tasks desktop, which isn't current), so it can take the focus without a desktop
+        // switch: requestFocus() neither raises nor switches (activateWindow() would switch to its desktop).
+        workspace()->requestFocus(m_window, true);
+    }
+}
+
+void AnlandWindowTask::onCtrlReadable()
+{
+    if (m_state == State::Handshake) {
+        m_ctrlNotifier->setEnabled(false);
+        if (connect_to_deamon_finish(m_display) < 0) {
+            qCWarning(KWIN_ANLAND) << "window task" << m_id << ": daemon handshake failed";
+            m_tasks->remove(this);
+            return;
+        }
+        m_state = State::Fallback;
+        requestConsumer();
+    } else if (m_state == State::Fallback) {
+        m_ctrlNotifier->setEnabled(false);
+        if (finish_exit_fallback(m_display) < 0) {
+            // A stale hand-over (that consumer already left): ask again.
+            m_retry.start();
+            return;
+        }
+        goLive();
+    }
+}
+
+void AnlandWindowTask::requestConsumer()
+{
+    if (!m_display || m_state != State::Fallback) {
+        return;
+    }
+    if (request_consumer_fds(m_display) < 0) {
+        qCWarning(KWIN_ANLAND) << "window task" << m_id << ": lost the display daemon";
+        m_tasks->remove(this);
+        return;
+    }
+    m_ctrlNotifier->setEnabled(true);
+}
+
+void AnlandWindowTask::goLive()
+{
+    if (!importBuffers()) {
+        // try_exit_fallback()'s contract: back to fallback, then ask again.
+        enterFallback();
+        return;
+    }
+    m_state = State::Live;
+    qCInfo(KWIN_ANLAND) << "window task" << m_id << "live," << m_bufferSize << "for" << (m_window ? m_window->caption() : QString());
+
+    m_inputNotifier = new QSocketNotifier(get_data_fd(m_display), QSocketNotifier::Read, this);
+    connect(m_inputNotifier, &QSocketNotifier::activated, this, &AnlandWindowTask::onInputReadable);
+    m_bufReadyNotifier = new QSocketNotifier(get_buffer_ready_fd(m_display), QSocketNotifier::Read, this);
+    connect(m_bufReadyNotifier, &QSocketNotifier::activated, this, &AnlandWindowTask::onBufferReady);
+
+    if (!m_window) {
+        return;
+    }
+    if (!m_exported) {
+        // Off the desktop: its own virtual desktop, which the desktop never shows - the window stays shown (focus,
+        // input) - and kept rendering while the task shows it (the screencast way: not suspended, frame callbacks).
+        m_desktops = m_window->desktops();
+        m_geometry = m_window->frameGeometry();
+        m_maximizeMode = m_window->maximizeMode();
+        if (m_maximizeMode != MaximizeRestore) {
+            m_window->maximize(MaximizeRestore);
+        }
+        if (VirtualDesktop *desktop = m_tasks->tasksDesktop()) {
+            m_window->setDesktops({desktop});
+        }
+        m_exported = true;
+        focus();
+    }
+    watchWindow(m_window);
+    for (Window *child : m_window->transients()) {
+        if (child->isPopupWindow()) {
+            watchWindow(child);
+        }
+    }
+    // Menus and other popups it opens from now on are drawn into the task too.
+    m_popupAdded = connect(workspace(), &Workspace::windowAdded, this, [this](Window *added) {
+        if (added->isPopupWindow() && added->transientFor() == m_window) {
+            watchWindow(added);
+        }
+    });
+    fitWindow();
+}
+
+void AnlandWindowTask::watchWindow(Window *window)
+{
+    for (const Watched &w : std::as_const(m_watched)) {
+        if (w.window == window) {
+            return;
+        }
+    }
+    window->refOffscreenRendering();
+    Watched watched;
+    watched.window = window;
+    watched.damaged = connect(window, &Window::damaged, this, [this]() {
+        std::fill(std::begin(m_stale), std::end(m_stale), true);
+        scheduleRender();
+    });
+    watched.closed = connect(window, &Window::closed, this, [this, window]() {
+        for (qsizetype i = 0; i < m_watched.size(); i++) {
+            if (m_watched[i].window == window) {
+                disconnect(m_watched[i].damaged);
+                disconnect(m_watched[i].closed);
+                window->unrefOffscreenRendering();
+                m_watched.removeAt(i);
+                break;
+            }
+        }
+        std::fill(std::begin(m_stale), std::end(m_stale), true);
+        scheduleRender();
+    });
+    m_watched.append(watched);
+    std::fill(std::begin(m_stale), std::end(m_stale), true);
+    scheduleRender();
+}
+
+void AnlandWindowTask::unwatchAll()
+{
+    disconnect(m_popupAdded);
+    for (const Watched &w : std::as_const(m_watched)) {
+        disconnect(w.damaged);
+        disconnect(w.closed);
+        if (w.window) {
+            w.window->unrefOffscreenRendering();
+        }
+    }
+    m_watched.clear();
+}
+
+void AnlandWindowTask::enterFallback()
+{
+    if (m_state == State::Fallback) {
+        return;
+    }
+    // The task went to the background (its surface is gone) or the consumer dropped: stop drawing, keep the window
+    // where it is (on the tasks desktop) until the task comes back or is closed.
+    qCInfo(KWIN_ANLAND) << "window task" << m_id << "in the background";
+    m_state = State::Fallback;
+    cancelTouches();
+    if (m_inputNotifier) {
+        m_inputNotifier->setEnabled(false);
+        m_inputNotifier->deleteLater();
+        m_inputNotifier = nullptr;
+    }
+    if (m_bufReadyNotifier) {
+        m_bufReadyNotifier->setEnabled(false);
+        m_bufReadyNotifier->deleteLater();
+        m_bufReadyNotifier = nullptr;
+    }
+    m_keepalive.stop();
+    m_offered = false;
+    releaseBuffers();
+    // Not rendering meanwhile: let the window be suspended like any unseen one.
+    unwatchAll();
+    // Called from inside the producer library (it closes the fds right after): ask again from the event loop.
+    QMetaObject::invokeMethod(this, &AnlandWindowTask::requestConsumer, Qt::QueuedConnection);
+}
+
+void AnlandWindowTask::fallbackTrampoline(void *data)
+{
+    static_cast<AnlandWindowTask *>(data)->enterFallback();
+}
+
+bool AnlandWindowTask::importBuffers()
+{
+    AnlandEglBackend *egl = m_tasks->backend()->eglBackend();
+    if (!egl || !egl->openglContext()->makeCurrent()) {
+        return false;
+    }
+    releaseBuffers();
+    const int count = get_buf_count(m_display);
+    if (count <= 0 || count > MAX_BUFS) {
+        return false;
+    }
+    for (int i = 0; i < count; i++) {
+        // Top-down for the consumer, as the desktop's buffers (AnlandEglLayer): a vertical flip, no rotation - the
+        // task's surface is already in its own orientation.
+        auto imported = egl->importConsumerBuffer(m_display, i, OutputTransform::FlipY);
+        if (!imported.texture) {
+            releaseBuffers();
+            return false;
+        }
+        m_bufferSize = imported.size;
+        m_textures[i] = std::move(imported.texture);
+        m_fbos[i] = std::move(imported.fbo);
+        m_stale[i] = true;
+    }
+    m_bufCount = count;
+    return true;
+}
+
+void AnlandWindowTask::releaseBuffers()
+{
+    if (m_bufCount == 0) {
+        return;
+    }
+    if (AnlandEglBackend *egl = m_tasks->backend()->eglBackend()) {
+        (void)egl->openglContext()->makeCurrent();
+    }
+    for (int i = 0; i < MAX_BUFS; i++) {
+        m_fbos[i].reset();
+        m_textures[i].reset();
+    }
+    m_bufCount = 0;
+}
+
+qreal AnlandWindowTask::scale() const
+{
+    return m_window ? m_window->targetScale() : 1.0;
+}
+
+RectF AnlandWindowTask::viewport() const
+{
+    // The client area, at the task's size: no title bar (the task has its own), the window's popups where they open.
+    const QPointF origin = m_window ? m_window->clientGeometry().topLeft() : QPointF();
+    return RectF(origin, QSizeF(m_bufferSize) / scale());
+}
+
+void AnlandWindowTask::fitWindow()
+{
+    if (!m_window || m_bufferSize.isEmpty()) {
+        return;
+    }
+    // The window takes the task's size (split screen, floating window, fold): its client area fills the buffers.
+    const QSizeF client = QSizeF(m_bufferSize) / scale();
+    if (m_window->clientGeometry().size() != client) {
+        m_window->moveResize(RectF(m_window->frameGeometry().topLeft(), m_window->clientSizeToFrameSize(client)));
+    }
+}
+
+QPointF AnlandWindowTask::mapToGlobal(const QPointF &taskPoint) const
+{
+    return viewport().topLeft() + taskPoint / scale();
+}
+
+QList<Window *> AnlandWindowTask::paintedWindows() const
+{
+    QList<Window *> windows;
+    for (const Watched &w : m_watched) {
+        if (w.window && !w.window->isDeleted() && (w.window == m_window || w.window->readyForPainting())) {
+            windows.append(w.window);
+        }
+    }
+    return windows;
+}
+
+void AnlandWindowTask::onBufferReady()
+{
+    eventfd_t val;
+    eventfd_read(get_buffer_ready_fd(m_display), &val);
+    m_offered = true;
+    const int idx = get_selected_idx(m_display);
+    if (idx >= 0 && idx < m_bufCount && m_stale[idx]) {
+        scheduleRender();
+    } else {
+        // Nothing new for it: hold it until the window changes (no frames while idle), answering in time.
+        m_keepalive.start();
+    }
+}
+
+void AnlandWindowTask::scheduleRender()
+{
+    if (!m_offered || m_renderScheduled) {
+        return;
+    }
+    m_renderScheduled = true;
+    QMetaObject::invokeMethod(this, [this]() {
+        m_renderScheduled = false;
+        render(false);
+    }, Qt::QueuedConnection);
+}
+
+void AnlandWindowTask::render(bool keepalive)
+{
+    Q_UNUSED(keepalive)
+    if (m_state != State::Live || !m_offered) {
+        return;
+    }
+    m_keepalive.stop();
+    const int idx = get_selected_idx(m_display);
+    AnlandEglBackend *egl = m_tasks->backend()->eglBackend();
+    if (idx >= 0 && idx < m_bufCount && m_stale[idx] && egl && egl->openglContext()->makeCurrent()) {
+        RenderTarget renderTarget(m_fbos[idx].get());
+        RenderViewport renderViewport(viewport(), scale(), renderTarget, QPoint());
+        WorkspaceScene *scene = kwinApp()->scene();
+        scene->renderer()->beginFrame(renderTarget, renderViewport);
+        glClearColor(0.0, 0.0, 0.0, 1.0);
+        glClear(GL_COLOR_BUFFER_BIT);
+        // The window, then its popups (as a window screencast draws them).
+        for (Window *w : paintedWindows()) {
+            scene->renderer()->renderItem(renderTarget, renderViewport, w->windowItem(), Scene::PAINT_WINDOW_TRANSFORMED,
+                                          Region::infinite(), WindowPaintData{}, {}, {});
+        }
+        scene->renderer()->endFrame();
+        glFlush();
+        // As the desktop: the consumer hands the render-done fence to queueBuffer, SurfaceFlinger waits GPU-side.
+        EGLNativeFence fence{egl->openglContext()->displayObject()};
+        set_render_fence(m_display, fence.takeFileDescriptor().take());
+        m_stale[idx] = false;
+    }
+    trigger_refresh(m_display);
+    m_offered = false;
+    // Frame callbacks: the client draws its next frame at the task's pace.
+    for (Window *w : paintedWindows()) {
+        w->windowItem()->framePainted(nullptr, w->output(), nullptr, now());
+    }
+}
+
+void AnlandWindowTask::onInputReadable()
+{
+    InputEvent ev;
+    while (m_state == State::Live && poll_input_event(m_display, &ev, 0) > 0) {
+        processInputEvent(ev);
+    }
+}
+
+void AnlandWindowTask::processInputEvent(const InputEvent &ev)
+{
+    SeatInterface *seat = waylandServer()->seat();
+    switch (ev.type) {
+    case INPUT_TYPE_KEY:
+        // Through KWin's keyboard (xkb, shortcuts, input method) to the focused window - this one, while its task
+        // has the focus.
+        m_tasks->backend()->inputDevice()->keyboardKey(ev.key.keycode, ev.key.action == INPUT_ACTION_DOWN);
+        break;
+    case INPUT_TYPE_TOUCH: {
+        if (!m_window) {
+            break;
+        }
+        const qint32 id = s_touchIdBase * qint32(m_id) + ev.touch.pointer_id;
+        const QPointF pos = mapToGlobal(QPointF(ev.touch.x, ev.touch.y));
+        seat->setTimestamp(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now().time_since_epoch()));
+        if (ev.touch.action == INPUT_ACTION_DOWN) {
+            if (m_touches.contains(id)) {
+                break;
+            }
+            // Straight to the window or popup under the finger (no hit test against the desktop, where this window
+            // isn't). A touch outside an open popup dismisses it, as KWin's popup filter does.
+            const QList<Window *> windows = paintedWindows();
+            Window *target = m_window;
+            for (auto it = windows.crbegin(); it != windows.crend(); ++it) {
+                if ((*it)->isPopupWindow() && (*it)->frameGeometry().contains(pos)) {
+                    target = *it;
+                    break;
+                }
+            }
+            if (target == m_window) {
+                for (Window *w : windows) {
+                    if (w->isPopupWindow()) {
+                        w->popupDone();
+                    }
+                }
+            }
+            focus();
+            if (seat->notifyTouchDown(target->surface(), target->bufferGeometry().topLeft(), id, pos)) {
+                m_touches.insert(id);
+            }
+        } else if (ev.touch.action == INPUT_ACTION_MOVE) {
+            if (m_touches.contains(id)) {
+                seat->notifyTouchMotion(id, pos);
+            }
+        } else if (ev.touch.action == INPUT_ACTION_UP) {
+            if (m_touches.remove(id)) {
+                seat->notifyTouchUp(id);
+            }
+        }
+        break;
+    }
+    case INPUT_TYPE_TOUCH_FRAME:
+        seat->notifyTouchFrame();
+        break;
+    default:
+        break;
+    }
+}
+
+void AnlandWindowTask::cancelTouches()
+{
+    if (m_touches.isEmpty()) {
+        return;
+    }
+    SeatInterface *seat = waylandServer()->seat();
+    for (qint32 id : std::as_const(m_touches)) {
+        seat->notifyTouchUp(id);
+    }
+    seat->notifyTouchFrame();
+    m_touches.clear();
+}
+
+// ---------------------------------------------------------------------------
+// AnlandWindowTasks
+// ---------------------------------------------------------------------------
+
+AnlandWindowTasks::AnlandWindowTasks(AnlandBackend *backend, const QString &socketPath)
+    : QObject(backend)
+    , m_backend(backend)
+    , m_socketPath(socketPath)
+{
+    m_controlRetry.setSingleShot(true);
+    m_controlRetry.setInterval(1000);
+    connect(&m_controlRetry, &QTimer::timeout, this, &AnlandWindowTasks::connectControl);
+    connectControl();
+    connect(kwinApp(), &Application::workspaceCreated, this, &AnlandWindowTasks::integrate);
+    QDBusConnection::sessionBus().registerObject(QStringLiteral("/org/powos/WindowTasks"), this,
+                                                 QDBusConnection::ExportScriptableSlots);
+}
+
+AnlandWindowTasks::~AnlandWindowTasks()
+{
+    closeAll();
+    if (m_controlFd >= 0) {
+        ::close(m_controlFd);
+    }
+}
+
+void AnlandWindowTasks::connectControl()
+{
+    m_controlFd = connect_unix(m_socketPath.toLocal8Bit().constData());
+    if (m_controlFd < 0) {
+        m_controlRetry.start();
+        return;
+    }
+    uint8_t hello[sizeof(ctrl_msg) + sizeof(uint32_t)];
+    const ctrl_msg hdr{.type = CTRL_MSG_CONTROL_HELLO, .size = sizeof(uint32_t)};
+    const uint32_t role = CONTROL_ROLE_COMPOSITOR;
+    memcpy(hello, &hdr, sizeof(hdr));
+    memcpy(hello + sizeof(hdr), &role, sizeof(role));
+    if (send_all(m_controlFd, hello, sizeof(hello)) < 0) {
+        ::close(m_controlFd);
+        m_controlFd = -1;
+        m_controlRetry.start();
+        return;
+    }
+    m_controlBuffer.clear();
+    m_controlNotifier = new QSocketNotifier(m_controlFd, QSocketNotifier::Read, this);
+    connect(m_controlNotifier, &QSocketNotifier::activated, this, &AnlandWindowTasks::onControlReadable);
+}
+
+void AnlandWindowTasks::onControlReadable()
+{
+    char buf[4096];
+    const ssize_t n = ::recv(m_controlFd, buf, sizeof(buf), MSG_DONTWAIT);
+    if (n == 0 || (n < 0 && errno != EAGAIN && errno != EINTR)) {
+        // The daemon went away (the app restarted): reconnect.
+        m_controlNotifier->setEnabled(false);
+        m_controlNotifier->deleteLater();
+        m_controlNotifier = nullptr;
+        ::close(m_controlFd);
+        m_controlFd = -1;
+        m_controlRetry.start();
+        return;
+    }
+    if (n < 0) {
+        return;
+    }
+    m_controlBuffer.append(buf, n);
+    while (m_controlBuffer.size() >= int(sizeof(ctrl_msg))) {
+        ctrl_msg hdr;
+        memcpy(&hdr, m_controlBuffer.constData(), sizeof(hdr));
+        if (hdr.size > CONTROL_MAX_PAYLOAD) {
+            m_controlBuffer.clear();
+            return;
+        }
+        if (m_controlBuffer.size() < int(sizeof(hdr) + hdr.size)) {
+            return;
+        }
+        const QByteArray payload = m_controlBuffer.mid(sizeof(hdr), hdr.size);
+        m_controlBuffer.remove(0, sizeof(hdr) + hdr.size);
+        if (hdr.type == CTRL_MSG_CONTROL) {
+            handleLine(QString::fromUtf8(payload));
+        }
+    }
+}
+
+void AnlandWindowTasks::handleLine(const QString &line)
+{
+    const QStringList f = line.split(QLatin1Char('\t'));
+    if (f.size() < 2) {
+        return;
+    }
+    AnlandWindowTask *task = m_tasks.value(f[1].toUInt());
+    if (!task) {
+        return;
+    }
+    if (f[0] == QLatin1String("closed")) {
+        // The task was closed for good: the window goes back on the desktop.
+        remove(task);
+    } else if (f[0] == QLatin1String("focus")) {
+        task->focus();
+    }
+}
+
+void AnlandWindowTasks::send(const QStringList &fields)
+{
+    if (m_controlFd < 0) {
+        return;
+    }
+    QStringList clean;
+    for (QString field : fields) {
+        clean.append(field.replace(QLatin1Char('\t'), QLatin1Char(' ')).replace(QLatin1Char('\n'), QLatin1Char(' ')));
+    }
+    const QByteArray line = clean.join(QLatin1Char('\t')).toUtf8().left(CONTROL_MAX_PAYLOAD);
+    QByteArray msg(sizeof(ctrl_msg), Qt::Uninitialized);
+    const ctrl_msg hdr{.type = CTRL_MSG_CONTROL, .size = uint32_t(line.size())};
+    memcpy(msg.data(), &hdr, sizeof(hdr));
+    msg.append(line);
+    send_all(m_controlFd, msg.constData(), msg.size());
+}
+
+void AnlandWindowTasks::integrate()
+{
+    // The title bar's maximize button (and double tap, the window menu, Meta+PgUp): on a phone, a window fills the
+    // screen as its own Android task - split screen and floating windows are Android's then. The same in its task
+    // gives it back to the desktop. A window already maximized on the desktop keeps KWin's restore; an application
+    // maximizing itself doesn't come this way.
+    workspace()->setWindowOperationHandler([this](Window *window, Options::WindowOperation op) {
+        if (op != Options::MaximizeOp) {
+            return false;
+        }
+        if (AnlandWindowTask *task = taskFor(window)) {
+            send({QStringLiteral("close"), QString::number(task->id())});
+            remove(task);
+            return true;
+        }
+        if (window->maximizeMode() == MaximizeFull || !exportable(window)) {
+            return false;
+        }
+        return show(window);
+    });
+    // Something activated an exported window the desktop way (the PowOS taskbar, a notification): KWin switches to
+    // its desktop, focuses it, then reports it activated. Bring its task to the front, and stay on the desktop. A
+    // switch to that desktop on its own (a pager, a shortcut) just goes back.
+    connect(VirtualDesktopManager::self(), &VirtualDesktopManager::currentChanged, this,
+            [this](VirtualDesktop *previous, VirtualDesktop *current, LogicalOutput *output) {
+        if (!m_desktop || current != m_desktop || !previous) {
+            return;
+        }
+        m_returnDesktop = previous;
+        QMetaObject::invokeMethod(this, [this, output]() {
+            if (m_desktop && m_returnDesktop && VirtualDesktopManager::self()->currentDesktop(output) == m_desktop) {
+                VirtualDesktopManager::self()->setCurrent(m_returnDesktop, output);
+            }
+        }, Qt::QueuedConnection);
+    });
+    connect(workspace(), &Workspace::windowActivated, this, [this](Window *window) {
+        AnlandWindowTask *task = taskFor(window);
+        if (!task || !m_desktop || VirtualDesktopManager::self()->currentDesktop(window->output()) != m_desktop) {
+            return; // the task's own focus (requestFocus, no desktop switch), or not exported
+        }
+        send({QStringLiteral("open"), QString::number(task->id()), window->desktopFileName(), window->caption()});
+    });
+}
+
+bool AnlandWindowTasks::exportable(Window *window) const
+{
+    return m_controlFd >= 0 && window && window->isClient() && !window->isDeleted() && window->surface()
+        && window->isNormalWindow() && !window->isPopupWindow();
+}
+
+AnlandWindowTask *AnlandWindowTasks::taskFor(Window *window) const
+{
+    for (AnlandWindowTask *task : m_tasks) {
+        if (window && task->window() == window) {
+            return task;
+        }
+    }
+    return nullptr;
+}
+
+bool AnlandWindowTasks::show(const QString &windowId)
+{
+    return show(workspace()->findWindow(QUuid::fromString(windowId)));
+}
+
+bool AnlandWindowTasks::show(Window *window)
+{
+    if (m_controlFd < 0) {
+        qCWarning(KWIN_ANLAND) << "no window tasks: the PowOS app isn't connected";
+        return false;
+    }
+    if (!exportable(window)) {
+        return false;
+    }
+    if (AnlandWindowTask *task = taskFor(window)) {
+        // Already a task: to the front.
+        send({QStringLiteral("open"), QString::number(task->id()), window->desktopFileName(), window->caption()});
+        return true;
+    }
+    const uint32_t id = m_nextId++;
+    auto *task = new AnlandWindowTask(this, window, id);
+    m_tasks.insert(id, task);
+    connect(window, &Window::closed, task, [this, task]() {
+        send({QStringLiteral("close"), QString::number(task->id())});
+        remove(task);
+    });
+    send({QStringLiteral("open"), QString::number(id), window->desktopFileName(), window->caption()});
+    return true;
+}
+
+void AnlandWindowTasks::closeAll()
+{
+    const auto tasks = m_tasks;
+    m_tasks.clear();
+    for (AnlandWindowTask *task : tasks) {
+        send({QStringLiteral("close"), QString::number(task->id())});
+        delete task;
+    }
+}
+
+void AnlandWindowTasks::remove(AnlandWindowTask *task)
+{
+    if (!m_tasks.remove(task->id())) {
+        return;
+    }
+    task->deleteLater();
+    // After the window went back (the task's destructor).
+    QMetaObject::invokeMethod(this, &AnlandWindowTasks::dropTasksDesktopIfUnused, Qt::QueuedConnection);
+}
+
+VirtualDesktop *AnlandWindowTasks::tasksDesktop()
+{
+    if (m_desktop) {
+        return m_desktop;
+    }
+    VirtualDesktopManager *vdm = VirtualDesktopManager::self();
+    for (VirtualDesktop *desktop : vdm->desktops()) {
+        if (desktop->name() == s_tasksDesktopName) {
+            m_desktop = desktop;
+            return desktop;
+        }
+    }
+    m_desktop = vdm->createVirtualDesktop(vdm->count(), s_tasksDesktopName);
+    return m_desktop;
+}
+
+void AnlandWindowTasks::dropTasksDesktopIfUnused()
+{
+    if (!m_tasks.isEmpty() || !m_desktop) {
+        return;
+    }
+    for (Window *window : workspace()->windows()) {
+        if (!window->isDeleted() && !window->isOnAllDesktops() && window->desktops().contains(m_desktop)) {
+            return;
+        }
+    }
+    // The user's desktops as they were.
+    VirtualDesktopManager::self()->removeVirtualDesktop(m_desktop);
+    m_desktop = nullptr;
+}
+
