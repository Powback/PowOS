+
+AnlandEglBackend::ImportedBuffer AnlandEglBackend::importConsumerBuffer(display_ctx *display, int index, OutputTransform contentTransform)
+{
+    const int fd = get_dmabuf_fd_at(display, index);
+    buf_info info;
+    if (fd < 0 || get_dmabuf_info_at(display, index, &info) < 0) {
+        qCWarning(KWIN_ANLAND) << "failed to get dmabuf info for buffer" << index;
+        return {};
+    }
+    const QSize size(info.width, info.height);
+
+    DmaBufAttributes attrs;
+    attrs.planeCount = 1;
+    attrs.width = size.width();
+    attrs.height = size.height();
+    attrs.format = protocol_format_to_drm(info.format);
+    attrs.modifier = info.modifier;
+    // The producer owns the dmabuf fd; DmaBufAttributes (and the EGLImage we
+    // hand the fd to) must not close it, so dup() into the owning slot.
+    attrs.fd[0] = FileDescriptor(dup(fd));
+    attrs.offset[0] = static_cast<int>(info.offset);
+    attrs.pitch[0] = static_cast<int>(info.stride);
+
+    // EglBackend::importDmaBufAsTexture() builds the EGLImage and wraps it in
+    // a GLTexture in one step (the 5.27-era manual EGLImageKHR +
+    // EGLImageTexture(...) dance is gone in 6.x).
+    std::shared_ptr<GLTexture> texture = importDmaBufAsTexture(attrs);
+    if (!texture) {
+        qCWarning(KWIN_ANLAND) << "failed to import dmabuf" << index << "as texture";
+        return {};
+    }
+    texture->setContentTransform(contentTransform);
+    auto fbo = std::make_unique<GLFramebuffer>(texture.get());
+    if (!fbo->valid()) {
+        qCWarning(KWIN_ANLAND) << "framebuffer for dmabuf" << index << "is not complete";
+        return {};
+    }
+    qCDebug(KWIN_ANLAND) << "imported buffer" << index << "fd" << fd << size
+                         << "fmt" << Qt::hex << attrs.format << "mod" << attrs.modifier;
+    return ImportedBuffer{.texture = std::move(texture), .fbo = std::move(fbo), .size = size};
 }
 
