+    if (own) {
+        line.append(QStringLiteral("own"));
+    }
+    m_tasks->send(line);
 }
 
 void AnlandWindowTask::handOverMaximize()
@@ -257,15 +269,33 @@ void AnlandWindowTask::handOverMoveResize()
         return;
     }
     const bool move = m_window->isInteractiveMove();
-    qCInfo(KWIN_ANLAND) << "window task" << m_id << "asked to be" << (move ? "moved: the task moves" : "resized: the task's grip resizes");
+    // Which edges a resize drags (its gravity), as the app's frame names them: n s e w ne nw se sw.
+    QString edges = QStringLiteral("move");
+    if (!move) {
+        switch (m_window->interactiveMoveResizeGravity()) {
+        case Gravity::Top: edges = QStringLiteral("n"); break;
+        case Gravity::Bottom: edges = QStringLiteral("s"); break;
+        case Gravity::Left: edges = QStringLiteral("w"); break;
+        case Gravity::Right: edges = QStringLiteral("e"); break;
+        case Gravity::TopLeft: edges = QStringLiteral("nw"); break;
+        case Gravity::TopRight: edges = QStringLiteral("ne"); break;
+        case Gravity::BottomLeft: edges = QStringLiteral("sw"); break;
+        case Gravity::BottomRight: edges = QStringLiteral("se"); break;
+        default: edges = QStringLiteral("se"); break;
+        }
+    }
+    qCInfo(KWIN_ANLAND) << "window task" << m_id << "asked to be" << (move ? "moved: the task moves" : "resized: the task resizes") << edges;
     QMetaObject::invokeMethod(this, [w = m_window]() {
         if (w && (w->isInteractiveMove() || w->isInteractiveResize())) {
             w->cancelInteractiveMoveResize();
         }
     }, Qt::QueuedConnection);
     if (move) {
-        m_tasks->send({QStringLiteral("move"), QString::number(m_id)});
+        m_tasks->send({QStringLiteral("move"), QString::number(m_id)}); // an older app's (a task's frame drag)
     }
+    // The app's own window drag/resize with the rest of that touch ("moveresize <id> move|<edges>": a web window's
+    // frame follows the finger as its own bar's and edges' drags do).
+    m_tasks->send({QStringLiteral("moveresize"), QString::number(m_id), edges});
 }
 
