@@ -169,8 +173,16 @@ void AnlandWindowTask::tellDecoration(bool again)
         return;
     }
     m_decorTold = decorated;
-    qCInfo(KWIN_ANLAND) << "window task" << m_id << (decorated ? "has KWin's title bar" : "draws its own title bar (or none)");
-    m_tasks->send({QStringLiteral("decor"), QString::number(m_id), QString::number(decorated)});
+    // Undecorated: a normal window or dialog that draws its own complete frame (Brave, Chrome, Steam, a GTK header
+    // bar) says so ("own"): the app shows no second bar over it. Anything else undecorated (a splash) has no bar at all.
+    const bool own = !decorated && drawsOwnFrame();
+    qCInfo(KWIN_ANLAND) << "window task" << m_id
+                        << (decorated ? "has KWin's title bar" : own ? "draws its own frame (client-side decorations)" : "has no title bar");
