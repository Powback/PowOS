# PowOS Android: Turnip (Mesa's Vulkan driver for Adreno) on KGSL - /usr/lib/libvulkan_freedreno.so and its ICD, the
# library every Vulkan program on the phone runs (DXVK games through FEX's thunk, Zink).
#
# The same Mesa Andromarchy's build-inside.sh builds into the rootfs (lfdevs/mesa-for-android-container @ eb3e7fd4,
# rootfs-in-container.sh's MESA_SRC_URL) with its options, only the Vulkan driver, plus ours:
#   0001  A7XX: RB_CCU_CNTL and the RB_* magic regs are written on the BR pipe only. tu_init_hw emits the static
#         regs under CP_SET_THREAD_BOTH, so BV executed the RB non-context write too and the Adreno 740's CP faulted
#         on every command buffer start: dmesg "kgsl kgsl-3d0: CP: AHB bus error, CP_RL_ERROR_DETAILS_0:0x10008e07"
#         (0x8e07 = RB_CCU_CNTL), ~300/s while Broforce ran (= its KGSL submit rate; 11-03 22:4x).
#   0002  KGSL: IOCOHERENT is trusted only when the device tree marks the gfx3d_user context bank dma-coherent
#         (no readable DT: distrusted on Adreno 740). The phone's kgsl-smmu is dma-coherent, gfx3d_user isn't, yet
#         KGSL accepts IOCOHERENT; FEX sets tu_override_uncached_as_cache_coherent in every Proton-ARM64 game, so
#         DXVK's uncached memory became cached+IOCOHERENT (suspected 16 px black columns, docs/research/
#         broforce-black-columns.md "Coherency override"). Now the same as TU_KGSL_FORCE_NONCOHERENT=1: no
#         cached-coherent type, the override is a no-op; one "turnip: KGSL accepts IOCOHERENT but ..." warning.
#         TU_KGSL_TRUST_IOCOHERENT=1 restores the kernel's answer.
#   0003  upstream Mesa 2fae1d0d (main 2026-10-27, after the pin's last upstream merge; drop on the next pin move if
#         the fork has it): a7xx gen1/gen2 (Adreno 740 is gen2) pad VPC_PS_CNTL::NUMNONPOSVAR by one vec4 when the
#         FS varyings take an odd number of slots, as Qualcomm's driver does - else garbage in loaded varyings
#         ("Fixes rendering corruption in Devil May Cry 5").
# Build option -Dfreedreno-kmds=kgsl,msm (not kgsl alone): with ONLY kgsl and only Turnip, Mesa's meson drops
#   system_has_kms_drm, so with_dri_platform isn't 'drm', HAVE_X11_DRM is never defined and the X11 WSI is built
#   software-only: every vkQueuePresentKHR to an X window became one xcb_put_image of the whole image on the
#   "WSI swapchain queue" thread (Broforce on Proton ARM64, 1116x2484: 11 MB/frame, that thread 61-76 % CPU, 19 fps vs
#   38-39 fps under FEX, whose x86 Turnip from the FEX RootFS presents through DRI3; 2026-11-05, docs/research/
#   game-launch-time.md "Why ARM64 Proton halves"). Adding msm keeps DRM in the build (DRI3/Present, dma-buf images,
#   libdrm linked - already a dependency); /dev/kgsl-3d0 is still enumerated first (tu_enumerate_devices), msm is
#   only tried when there is no KGSL device.
# A package so a Turnip fix reaches phones without a new rootfs: rooted.sh deploy installs it (powos-deploy.sh),
# replacing Arch's vulkan-freedreno (whose files the rootfs build had already overwritten with this same source).
# Gallium freedreno (KWin, Xwayland's glamor) stays the rootfs's build: it writes RB_CCU_CNTL on BR only already
# (fd6_emit_restore sets CP_SET_THREAD_BR first).
#
# Version = what the source is: Mesa's own VERSION (27.0.0-devel) + the pinned commit's date + its sha, e.g.
# 27.0.0_devel.20261029.geb3e7fd4 (pacman forbids '-' in pkgver). Not a Mesa release: lfdevs's dev/adreno-main is Mesa
# main + the fork's KGSL/termux-va work, merged from upstream main roughly weekly.
# Moving the pin (do it on purpose, with a reason - the source never moves on its own):
#   1. pick the commit: the fork's DEVELOPMENT branch is dev/adreno-main (Mesa source). NOT adreno-main: that one is
#      docs/CI only on a 26.1.0-devel (2026-04) tree - "45 commits ahead" there are README/workflow edits.
#      gh api repos/lfdevs/mesa-for-android-container/commits/dev/adreno-main --jq '.sha, .commit.committer.date'
#   2. _commit=<full sha>, pkgver=<its VERSION with _>.<committer date YYYYMMDD>.g<sha:8>, pkgrel=1; sha256sums[0] =
#      shasum -a 256 of https://github.com/lfdevs/mesa-for-android-container/archive/<sha>.tar.gz
#   3. rebase 0001-0003: extract the archive, `patch -Np1 --dry-run` each; regenerate with diff -u when offsets moved;
#      drop a patch the source already has (grep the fix's symbol: RB_CCU_CNTL guard in tu_cmd_buffer.cc's
#      tu_init_hw path, IOCOHERENT in tu_knl_kgsl.cc).
#   4. the SAME sha in targets/android/rootfs-in-container.sh MESA_SRC_URL (Gallium freedreno must match Turnip).
#   5. record why + what changed in docs/research/broforce-black-columns.md ("Turnip pin").
# Pin history: ef25369b (2026-10-04, termux-va topic branch test/add-va-bridge, pinned 10-13 in 56007a05) ->
#   eb3e7fd4 (2026-10-29, dev/adreno-main, 11-04).

pkgname=vulkan-freedreno-kgsl
pkgver=27.0.0_devel.20261029.geb3e7fd4
pkgrel=3
pkgdesc='Turnip Vulkan driver on KGSL (lfdevs Mesa) with PowOS fixes (PowOS Android)'
arch=(aarch64)
url='https://github.com/lfdevs/mesa-for-android-container'
license=(MIT)
depends=(libdrm libx11 libxcb libxshmfence wayland zstd expat libelf vulkan-icd-loader libdisplay-info systemd-libs)
makedepends=(meson ninja python-mako python-yaml python-packaging python-ply glslang byacc bison flex
             wayland-protocols libxrandr)
provides=(vulkan-freedreno vulkan-driver)
conflicts=(vulkan-freedreno)
replaces=(vulkan-freedreno)
# -3: freedreno-kmds=kgsl,msm (X11 WSI presents through DRI3, see above).
# -2: andromarchy-protect put the rootfs's 10-13 Turnip back after every install of -1 (see the .install).
install=vulkan-freedreno-kgsl.install
_commit=eb3e7fd4f009cab04b1482aad4843c0bde28a786
_patches=(0001-turnip-a7xx-rb-ccu-cntl-br-only.patch
          0002-turnip-kgsl-iocoherent-needs-coherent-user-cb.patch
          0003-turnip-a7xx-gen1-gen2-numnonposvar-alignment.patch)
source=("mesa-$_commit.tar.gz::https://github.com/lfdevs/mesa-for-android-container/archive/$_commit.tar.gz"
        "${_patches[@]}")
sha256sums=(123af0b3b2f7c83273a51f28367a64054201d524cbfa52f99ba76696e619927a
            SKIP
            SKIP
            SKIP)

prepare() {
  cd mesa-for-android-container-$_commit
  for p in "${_patches[@]}"; do
    echo "Applying $p"
    patch -Np1 -i "$srcdir/$p"
  done
}

build() {
  # build-inside.sh's options that apply to the Vulkan driver (no Gallium drivers: they stay the rootfs's).
  meson setup build mesa-for-android-container-$_commit --prefix=/usr --buildtype=release -Dplatforms=x11,wayland \
    -Dgallium-drivers= -Dvulkan-drivers=freedreno -Dfreedreno-kmds=kgsl,msm -Dvideo-codecs=all \
    -Degl=disabled -Dglx=disabled -Dgbm=disabled -Dopengl=false -Dgles1=disabled -Dgles2=disabled \
    -Dllvm=disabled -Dintel-rt=disabled -Dmicrosoft-clc=disabled -Dvalgrind=disabled -Dlibunwind=disabled
  ninja -C build src/freedreno/vulkan/libvulkan_freedreno.so src/freedreno/vulkan/freedreno_icd.aarch64.json
}

package() {
  install -Dm755 build/src/freedreno/vulkan/libvulkan_freedreno.so "$pkgdir"/usr/lib/libvulkan_freedreno.so
  install -Dm644 build/src/freedreno/vulkan/freedreno_icd.aarch64.json \
    "$pkgdir"/usr/share/vulkan/icd.d/freedreno_icd.aarch64.json
  install -Dm644 mesa-for-android-container-$_commit/docs/license.rst "$pkgdir"/usr/share/licenses/$pkgname/license.rst
}
