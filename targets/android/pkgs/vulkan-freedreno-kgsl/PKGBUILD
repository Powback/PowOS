# PowOS Android: Turnip (Mesa's Vulkan driver for Adreno) on KGSL - /usr/lib/libvulkan_freedreno.so and its ICD, the
# library every Vulkan program on the phone runs (DXVK games through FEX's thunk, Zink).
#
# Source = UPSTREAM Mesa main (a pinned commit, gitlab archive) + the lfdevs fork's Turnip changes as one patch + ours
# (since 11-07, board task gaming-fixes-version-independent-stack-on-latest). Before, the source was the fork's own
# tree, which merges upstream only every week or two: its dev/adreno-main tip b2d3bc3e (11-06) had no source change
# since our pin eb3e7fd4 (= Mesa main of 10-25 + fork work), only CI, so upstream Turnip fixes reached us late (0003
# was a hand cherry-pick of upstream 2fae1d0d). Patches, in order:
#   0000  lfdevs/mesa-for-android-container's Turnip-relevant delta (fork _fork vs its merge base with Mesa main,
#         18879c94): KGSL kernel interface (tu_knl_kgsl.cc, msm_kgsl.h), devices table, tu_device/tu_wsi/
#         tu_clear_blit/tu_cmd_buffer, the X11 WSI/dri3/loader/os_file bits and its meson options - only the paths a
#         Vulkan-only build compiles. Regenerate (see "Moving the pin") when the fork changes those files.
#   0001  A7XX: RB_CCU_CNTL and the RB_* magic regs are written on the BR pipe only. tu_init_hw emits the static
#         regs under CP_SET_THREAD_BOTH, so BV executed the RB non-context write too and the Adreno 740's CP faulted
#         on every command buffer start: dmesg "kgsl kgsl-3d0: CP: AHB bus error, CP_RL_ERROR_DETAILS_0:0x10008e07"
#         (0x8e07 = RB_CCU_CNTL), ~300/s while Broforce ran (= its KGSL submit rate; 11-03 22:4x).
#   0002  KGSL: IOCOHERENT is trusted only when the device tree marks the gfx3d_user context bank dma-coherent
#         (no readable DT: distrusted on Adreno 740). The phone's kgsl-smmu is dma-coherent, gfx3d_user isn't, yet
#         KGSL accepts IOCOHERENT; FEX sets tu_override_uncached_as_cache_coherent in every Proton-ARM64 game, so
#         DXVK's uncached memory became cached+IOCOHERENT (suspected 16 px black columns, docs/research/
#         broforce-black-columns.md "Coherency override"). Now the same as TU_KGSL_FORCE_NONCOHERENT=1: no
#         cached-coherent type, the override is a no-op; one "turnip: KGSL accepts IOCOHERENT but ..." warning.
#         TU_KGSL_TRUST_IOCOHERENT=1 restores the kernel's answer.
#   (0003-turnip-a7xx-gen1-gen2-numnonposvar-alignment.patch dropped 11-07: upstream 2fae1d0d is in Mesa main.)
# The build refuses a patch that no longer fits or that the source already has (patch -N: "previously applied"),
# naming it: a fix upstream took is dropped on purpose with a note here, never silently.
# Build option -Dfreedreno-kmds=kgsl,msm (not kgsl alone): with ONLY kgsl and only Turnip, Mesa's meson drops
#   system_has_kms_drm, so with_dri_platform isn't 'drm', HAVE_X11_DRM is never defined and the X11 WSI is built
#   software-only: every vkQueuePresentKHR to an X window became one xcb_put_image of the whole image on the
#   "WSI swapchain queue" thread (Broforce on Proton ARM64, 1116x2484: 11 MB/frame, that thread 61-76 % CPU, 19 fps vs
#   38-39 fps under FEX, whose x86 Turnip from the FEX RootFS presents through DRI3; 2026-11-05, docs/research/
#   game-launch-time.md "Why ARM64 Proton halves"). Adding msm keeps DRM in the build (DRI3/Present, dma-buf images,
#   libdrm linked - already a dependency); /dev/kgsl-3d0 is still enumerated first (tu_enumerate_devices), msm is
#   only tried when there is no KGSL device.
# A package so a Turnip fix reaches phones without a new rootfs: rooted.sh deploy installs it (powos-deploy.sh),
# replacing Arch's vulkan-freedreno (whose files the rootfs build had already overwritten with this same source).
# Gallium freedreno (KWin, Xwayland's glamor) stays the rootfs's build: it writes RB_CCU_CNTL on BR only already
# (fd6_emit_restore sets CP_SET_THREAD_BR first).
#
# Version = what the source is: Mesa's own VERSION (27.0.0-devel) + the pinned commit's date + its sha, e.g.
# 27.0.0_devel.20261107.g3a2cd129 (pacman forbids '-' in pkgver). Not a Mesa release.
# Moving the pin (do it on purpose, with a reason - the source never moves on its own):
#   1. _commit = Mesa main (git ls-remote https://gitlab.freedesktop.org/mesa/mesa.git refs/heads/main), pkgver =
#      <its VERSION with _>.<committer date YYYYMMDD>.g<sha:8>, pkgrel=1, sha256sums[0] = shasum -a 256 of
#      https://gitlab.freedesktop.org/mesa/mesa/-/archive/<sha>/mesa-<sha>.tar.gz
#   2. 0000, only when the fork's dev/adreno-main changed Turnip paths since _fork (gh api repos/lfdevs/mesa-for-android-
#      container/compare/<_fork>...dev/adreno-main --jq '.files[].filename'): in a git dir with both remotes,
#      M=$(git merge-tree --write-tree <mesa sha> <fork sha> | head -1); git diff <mesa sha> $M -- meson.build
#      meson.options src/freedreno/common src/freedreno/vulkan src/vulkan src/x11 src/util src/loader > 0000-...patch;
#      _fork=<fork sha>.
#   3. rebase 0001-0002: `patch -Np1 --dry-run` each on the extracted source + 0000; regenerate with diff -u when
#      offsets moved; drop a patch the source already has, with a note above.
#   4. targets/android/rootfs-in-container.sh MESA_SRC_COMMIT is the rootfs's whole Mesa from the fork (Gallium
#      freedreno for KWin and Xwayland's glamor, GL, EGL): it needs the fork's Gallium KGSL work and stays a fork sha.
#      Turnip is a separate library (libvulkan_freedreno.so links libdrm/xcb/wayland/expat/zstd only, no Gallium).
#   5. record why + what changed in docs/research/broforce-black-columns.md ("Turnip pin").
# Pin history: ef25369b (fork, 2026-10-04, termux-va topic branch test/add-va-bridge, pinned 10-13 in 56007a05) ->
#   eb3e7fd4 (fork dev/adreno-main, 2026-10-29, 11-04) -> Mesa main 3a2cd129 (2026-11-07) + fork eb3e7fd4's delta.

pkgname=vulkan-freedreno-kgsl
pkgver=27.0.0_devel.20261107.g3a2cd129
pkgrel=1
pkgdesc='Turnip Vulkan driver on KGSL (Mesa main + lfdevs KGSL work) with PowOS fixes (PowOS Android)'
arch=(aarch64)
url='https://gitlab.freedesktop.org/mesa/mesa'
license=(MIT)
depends=(libdrm libx11 libxcb libxshmfence wayland zstd expat libelf vulkan-icd-loader libdisplay-info systemd-libs)
makedepends=(meson ninja python-mako python-yaml python-packaging python-ply glslang byacc bison flex
             wayland-protocols libxrandr)
provides=(vulkan-freedreno vulkan-driver)
conflicts=(vulkan-freedreno)
replaces=(vulkan-freedreno)
# 27.0.0_devel.20261107-1: Mesa main + the fork's Turnip delta (was the fork's own tree, 20261029.geb3e7fd4-3).
# -3: freedreno-kmds=kgsl,msm (X11 WSI presents through DRI3, see above).
# -2: andromarchy-protect put the rootfs's 10-13 Turnip back after every install of -1 (see the .install).
install=vulkan-freedreno-kgsl.install
_commit=3a2cd129ca41d87267b3cd4262fc4280f3f63176   # Mesa main, 2026-11-07
_fork=eb3e7fd4f009cab04b1482aad4843c0bde28a786     # lfdevs dev/adreno-main whose Turnip delta 0000 carries
_patches=(0000-lfdevs-android-container-turnip.patch
          0001-turnip-a7xx-rb-ccu-cntl-br-only.patch
          0002-turnip-kgsl-iocoherent-needs-coherent-user-cb.patch)
source=("mesa-$_commit.tar.gz::https://gitlab.freedesktop.org/mesa/mesa/-/archive/$_commit/mesa-$_commit.tar.gz"
        "${_patches[@]}")
sha256sums=(2ba9a6f48e3c5706584772888a3b7d2f94b18a041b19577b5acb7b2f5f6c1ad8
            SKIP
            SKIP
            SKIP)

prepare() {
  cd mesa-$_commit
  local p out
  for p in "${_patches[@]}"; do
    echo "Applying $p"
    # A dry run first (-N: a patch the source already has fails instead of reversing): one that no longer fits, or
    # that upstream took, stops the build with its name before anything is half applied.
    out=$(patch -Np1 --dry-run -i "$srcdir/$p" 2>&1) || {
      printf '%s\n' "$out"
      echo "patch $p does not apply to Mesa $_commit: rebase it, or drop it if upstream has it (see the header)"
      exit 1
    }
    patch -Np1 -s -i "$srcdir/$p"
  done
}

build() {
  # build-inside.sh's options that apply to the Vulkan driver (no Gallium drivers: they stay the rootfs's).
  meson setup build mesa-$_commit --prefix=/usr --buildtype=release -Dplatforms=x11,wayland \
    -Dgallium-drivers= -Dvulkan-drivers=freedreno -Dfreedreno-kmds=kgsl,msm -Dvideo-codecs=all \
    -Degl=disabled -Dglx=disabled -Dgbm=disabled -Dopengl=false -Dgles1=disabled -Dgles2=disabled \
    -Dllvm=disabled -Dintel-rt=disabled -Dmicrosoft-clc=disabled -Dvalgrind=disabled -Dlibunwind=disabled
  ninja -C build src/freedreno/vulkan/libvulkan_freedreno.so src/freedreno/vulkan/freedreno_icd.aarch64.json
}

package() {
  install -Dm755 build/src/freedreno/vulkan/libvulkan_freedreno.so "$pkgdir"/usr/lib/libvulkan_freedreno.so
  install -Dm644 build/src/freedreno/vulkan/freedreno_icd.aarch64.json \
    "$pkgdir"/usr/share/vulkan/icd.d/freedreno_icd.aarch64.json
  install -Dm644 mesa-$_commit/docs/license.rst "$pkgdir"/usr/share/licenses/$pkgname/license.rst
}
