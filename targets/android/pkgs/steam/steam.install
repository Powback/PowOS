# The System V IPC shim into every FEX x86 RootFS (x86 programs see that tree, not PowOS's /usr/lib). A RootFS
# fetched later (install-powos-android.sh) gets it there too.
_sysvipc_into_rootfs() {
  for r in /usr/share/fex-emu/RootFS/*/; do
    [ -d "$r/usr/lib" ] || continue
    mkdir -p "$r/usr/lib/powos-sysvipc"
    cp -r /usr/lib/powos-sysvipc/i386 /usr/lib/powos-sysvipc/x86_64 "$r/usr/lib/powos-sysvipc/"
  done
}

# Valve's FEX compat tool (what the native ARM64 client runs games with) expects the OS's x86 system at
# /usr/share/guestos/fex-mesa (SteamOS ARM ships one with x86 Mesa): FEX's RootFS.
_guestos_rootfs() {
  for r in /usr/share/fex-emu/RootFS/*/; do
    mkdir -p /usr/share/guestos
    ln -sfn "${r%/}" /usr/share/guestos/fex-mesa
    return
  done
}

post_install() { _sysvipc_into_rootfs; _guestos_rootfs; }
post_upgrade() { _sysvipc_into_rootfs; _guestos_rootfs; }
