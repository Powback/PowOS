#!/bin/sh
# /usr/bin/steam on PowOS (ARM): Valve's native ARM64 Linux client (the "linuxarm64" build behind the Steam Frame -
# unlisted, but on Valve's update servers since 2026). Steam itself and its web UI run natively; only games' x86
# code goes through FEX. On first run the client is fetched from Valve's linuxarm64 manifest (it updates itself
# from then on). STEAM_X86=1 runs the old way: Valve's x86 client entirely under FEX (minutes to start).
#
# System V IPC: Android's kernel has none (semget -> ENOSYS) and the client needs its semaphores ("Thread
# synchronization object is unuseable"); the sysvipc-emu shim (targets/android/steam/sysvipc: aarch64 for the
# native client, i386 + x86-64 for x86 programs - each process skips the ones of other architectures) provides them
# from /dev/shm. Preloaded from the home directory: the same path outside FEX, under FEX and inside the Steam Runtime
# container (pressure-vessel binds the home in; from /usr/lib the container's programs couldn't find it).
L=${XDG_DATA_HOME:-$HOME/.local/share}/powos-sysvipc
for b in aarch64 i386 x86_64; do
  cmp -s /usr/lib/powos-sysvipc/$b/libsysvipc-emu.so "$L/$b/libsysvipc-emu.so" \
    || install -Dm755 /usr/lib/powos-sysvipc/$b/libsysvipc-emu.so "$L/$b/libsysvipc-emu.so"
done
export LD_PRELOAD="$L/aarch64/libsysvipc-emu.so $L/i386/libsysvipc-emu.so $L/x86_64/libsysvipc-emu.so${LD_PRELOAD:+ $LD_PRELOAD}"

# IPC left behind by a Steam that didn't shut down (killed, crashed, the session restarted): the shim's semaphores are
# files that a kernel would have released with their processes, so the next Steam waited on ones a dead process held
# and hung at start. Valve's IPC object and shared memory went with them, and FEX's per-process stats - all in
# /dev/shm, which is RAM (600 MB of it after a day of games). Only while no Steam of this user runs: its games and
# helpers are all started by it. Running = the pid Steam keeps in ~/.steam/steam.pid is alive and is Steam's client (by
# name, pgrep found this script: its process, and the subshells it forks, are called steam too).
steam_pid=$(cat "$HOME/.steam/steam.pid" 2>/dev/null)

# Proton prefixes' registries after a reboot or crash (checked while no Steam runs, so no wineserver writes them):
# wineserver saves system/user/userdef.reg (temp file + rename) without fsync, and on the phone's f2fs (/data) a reboot
# within a minute or so of a save can keep the files' size and lose their data - all NUL bytes. Wine then can't load
# its registry and the game's whole launch chain dies ~10-16 s in, no window, every time (Broforce, 2026-10-22: saved
# 23:57:58, rebooted 23:59). Each Steam start keeps an fsynced copy of every prefix's last good set (compatdata/<id>/
# powos-reg) and puts it back over a broken one; with no copy, Proton rebuilds the registry itself (its creation path:
# no creation_sync_guard -> the default prefix's files are copied in, drive_c and the game's data stay). Every Wine
# key the game changed since the copy is lost, nothing else.
reg_ok() { [ "$(head -c 23 "$1" 2>/dev/null | tr -d '\0')" = "WINE REGISTRY Version 2" ] && ! LC_ALL=C grep -qaP '\x00' "$1"; }
reg_guard() {
  local p c r ok bad
  for p in "${XDG_DATA_HOME:-$HOME/.local/share}"/Steam/steamapps/compatdata/*/pfx; do
    [ -f "$p/system.reg" ] || continue
    c=${p%/pfx}
    # The last rebuild's tracked_files (Proton's copy_pfx rewrote it with only what it copied): merged back.
    [ -f "$c/tracked_files.powos-keep" ] && [ -e "$p/creation_sync_guard" ] \
      && sort -u "$c/tracked_files.powos-keep" "$c/tracked_files" -o "$c/tracked_files" && rm -f "$c/tracked_files.powos-keep"
    ok=1 bad=
    for r in system user userdef; do reg_ok "$p/$r.reg" || { ok=; [ -e "$p/$r.reg" ] && bad="$bad $r"; }; done
    if [ -n "$ok" ]; then
      for r in system user userdef; do
        cmp -s "$p/$r.reg" "$c/powos-reg/$r.reg" && continue
        mkdir -p "$c/powos-reg" && cp -p "$p/$r.reg" "$c/powos-reg/$r.reg.tmp" && sync "$c/powos-reg/$r.reg.tmp" \
          && mv -f "$c/powos-reg/$r.reg.tmp" "$c/powos-reg/$r.reg"
      done
      sync "$c/powos-reg" 2>/dev/null
      continue
    fi
    [ -n "$bad" ] || continue
    mkdir -p "$c/powos-reg-broken" && for r in $bad; do mv -f "$p/$r.reg" "$c/powos-reg-broken/$r.reg"; done
    # The install script evaluator's record (user_settings.py): its registry marks may be gone with the old registry.
    rm -f "$c/powos-iscript.done"
    if reg_ok "$c/powos-reg/system.reg" && reg_ok "$c/powos-reg/user.reg" && reg_ok "$c/powos-reg/userdef.reg"; then
      for r in system user userdef; do cp -p "$c/powos-reg/$r.reg" "$p/$r.reg"; done
      echo "steam: ${c##*/}'s Wine registry was broken (${bad# }): restored the copy of $(date -r "$c/powos-reg/system.reg" '+%F %T')" | tee -a "$c/powos-reg-broken/log" >&2
    else
      for r in system user userdef; do [ -e "$p/$r.reg" ] && mv -f "$p/$r.reg" "$c/powos-reg-broken/$r.reg"; done
      cp -p "$c/tracked_files" "$c/tracked_files.powos-keep" 2>/dev/null; rm -f "$p/creation_sync_guard"
      echo "steam: ${c##*/}'s Wine registry was broken (${bad# }), no good copy: Proton rebuilds it at the next launch" | tee -a "$c/powos-reg-broken/log" >&2
    fi
    sync "$p" "$c/powos-reg-broken"
  done
}
# Instant start: a game launch (steam://rungameid/<appid>) for a game this Steam already runs - kept alive, frozen
# with Steam while out of sight (units/phone/steam.json "games": "pause") - thaws it and raises the game's window
# (powos-sleep-gui's Resume) instead of handing Steam a launch it has nothing to do for. Not running, or no watcher
# (no PowOS session sleep): the launch goes on to Steam as always.
case " $* " in
  *" steam://rungameid/"*)
    appid=${*##*steam://rungameid/}; appid=${appid%% *}
    case $appid in *[!0-9]* | '') appid= ;; esac
    if [ -n "$appid" ] && [ -d "/proc/${steam_pid:-0}" ] && pgrep -f "SteamLaunch AppId=$appid( --|\$)" >/dev/null 2>&1; then  # the game's, not its install script's (Install=1)
      case $(dbus-send --session --print-reply=literal --reply-timeout=3000 --dest=dev.powos.Sleep /Gui \
               dev.powos.Sleep.Gui.Resume string:"$appid" 2>/dev/null) in
        *'"running": true'*) exit 0 ;;
      esac
    fi ;;
esac
# Instant resume: unified sleep freezes a Steam that's out of sight (units/phone/steam.json, docs/UNIFIED-SLEEP.md).
# Thaw it first, so what this launch hands to it (a game, the window) reaches a running Steam instead of waiting on a
# frozen one. dbus-send, not powos-sleep-gui wake: a C program, no Python start-up on the way to the window.
case $(cat "/proc/${steam_pid:-0}/cgroup" 2>/dev/null) in
  *powos/sleep/*)
    dbus-send --session --print-reply=literal --reply-timeout=3000 --dest=dev.powos.Sleep /Gui \
      dev.powos.Sleep.Gui.Wake string:steam >/dev/null 2>&1 || powos sleep wake "$steam_pid" >/dev/null 2>&1 ;;
esac
# A client left stopped by a signal (state T: a debugger's attach that never finished left a SIGSTOP pending, 2026-10-23)
# reads nothing either: SIGCONT to its tree (harmless to running processes; a cgroup-frozen one keeps sleeping).
if [ -d "/proc/${steam_pid:-0}" ]; then
  for t in $steam_pid $(pgrep -P "$steam_pid" 2>/dev/null); do
    [ "$(awk '{print $3}' "/proc/$t/stat" 2>/dev/null)" = T ] && kill -CONT "$t" 2>/dev/null
  done
fi
case $(readlink "/proc/${steam_pid:-0}/exe" 2>/dev/null) in
  */steamrtarm64/steam | */FEX*) ;;  # the ARM64 client, or the x86 one (STEAM_X86) under FEX
  *)
    rm -f /dev/shm/y700-sysv/sem-* "/dev/shm/u$(id -u)-ValveIPCSharedObj-Steam" "/dev/shm/u$(id -u)-Shm_"*
    for f in /dev/shm/fex-*-stats; do
      pid=${f#/dev/shm/fex-}; pid=${pid%-stats}
      [ -e "$f" ] && [ ! -d "/proc/$pid" ] && rm -f "$f"
    done
    reg_guard
    # PowOS's launch gate in front of ARM64 Proton (/usr/lib/powos-steam/compat/powos-proton-arm64, see its
    # powos-entry): into Steam's compatibilitytools.d before the policy below maps "arm64" games to it.
    g=/usr/lib/powos-steam/compat/powos-proton-arm64 gd="${XDG_DATA_HOME:-$HOME/.local/share}"/Steam/compatibilitytools.d/powos-proton-arm64
    if [ -d "$g" ]; then
      mkdir -p "$gd" && for f in "$g"/*; do cmp -s "$f" "$gd/${f##*/}" || install -m"$([ -x "$f" ] && echo 755 || echo 644)" "$f" "$gd/${f##*/}"; done
    fi
    # Which way each game runs - its native Linux build, ARM64 Proton or x86 Proton, the fastest that worked
    # (powos-steam-compat: per-game policy, measured launches): written into config.vdf now, while no Steam runs.
    command -v powos-steam-compat >/dev/null && timeout 20 powos-steam-compat apply 2>&1 | sed 's/^/steam: /' >&2
    # PowOS's Proton user_settings.py (/usr/lib/powos-steam/user_settings.py: skips the install script evaluator when it
    # has nothing to do, ~/.config/powos/proton-settings.json) in every Proton, unless that Proton has the user's own.
    for d in "${XDG_DATA_HOME:-$HOME/.local/share}"/Steam/steamapps/common/Proton* \
             "${XDG_DATA_HOME:-$HOME/.local/share}"/Steam/compatibilitytools.d/*; do
      [ -f "$d/proton" ] && [ -f /usr/lib/powos-steam/user_settings.py ] || continue
      if [ ! -e "$d/user_settings.py" ] || head -1 "$d/user_settings.py" | grep -q '^# PowOS user_settings'; then
        cmp -s /usr/lib/powos-steam/user_settings.py "$d/user_settings.py" \
          || install -m644 /usr/lib/powos-steam/user_settings.py "$d/user_settings.py"
      fi
    done
    # HACK: FEX's Vulkan thunk inside pressure-vessel. Valve's FEX compat tool (FEX-2607) builds its thunk overlay paths
    # from @PREFIX_LIB@ with a multiarch test on its RootFS - empty inside the container, so it takes the Fedora
    # layout (.../overrides/lib64) while pressure-vessel puts the x86_64 loader at
    # /usr/lib/pressure-vessel/overrides/lib/x86_64-linux-gnu/libvulkan.so.1: the thunk never matched and x86 games
    # ran FEX RootFS's x86_64 Turnip emulated (bf-driver.sh, 2026-11-04). FEX also reads a ThunksDB.json from its
    # user config dir (FEX_APP_CONFIG_LOCATION = compatdata/<id>/fex-emu/, the compat tool leaves it alone): ours
    # names the container's paths explicitly. Real fix: FEX-2610's FEX_STEAM_SUPPORT prefixes (Valve's next FEX),
    # then this goes. Off until x86 Proton launches on it: on 2026-11-04 16:11 the thunk worked (explorer.exe mapped
    # libvulkan-guest/-host + our Turnip inode, natively) but Broforce never started (3 explorer.exe, no game exe, no
    # window in 4 min). POWOS_FEX_VULKAN_THUNK=1 in ~/.config/powos/steam-env (or a check's env:) turns it on; off,
    # the copies are removed again so a game never keeps a stale one.
    if [ "${POWOS_FEX_VULKAN_THUNK:-0}" = 1 ] && [ -f /usr/lib/powos-steam/fex-ThunksDB.json ]; then
      for d in "${XDG_DATA_HOME:-$HOME/.local/share}"/Steam/steamapps/compatdata/[0-9]*/; do
        [ -d "$d" ] || continue; mkdir -p "$d/fex-emu"
        cmp -s /usr/lib/powos-steam/fex-ThunksDB.json "$d/fex-emu/ThunksDB.json" \
          || install -m644 /usr/lib/powos-steam/fex-ThunksDB.json "$d/fex-emu/ThunksDB.json"
      done
    else
      for f in "${XDG_DATA_HOME:-$HOME/.local/share}"/Steam/steamapps/compatdata/*/fex-emu/ThunksDB.json; do
        [ -f "$f" ] && cmp -s /usr/lib/powos-steam/fex-ThunksDB.json "$f" && rm -f "$f"
      done
    fi ;;
esac

# Environment for Steam and every game it starts (/usr/lib/powos-steam/steam-env, then the user's
# ~/.config/powos/steam-env; KEY=VALUE lines, # comments, an empty value unsets). Exported, not sourced: no code runs.
for f in /usr/lib/powos-steam/steam-env "${XDG_CONFIG_HOME:-$HOME/.config}/powos/steam-env"; do
  [ -f "$f" ] || continue
  while IFS= read -r l || [ -n "$l" ]; do
    case $l in '#'* | '') continue ;; [A-Za-z_]*=*) ;; *) continue ;; esac
    k=${l%%=*}; case $k in *[!A-Za-z0-9_]*) continue ;; esac
    if [ -n "${l#*=}" ]; then export "$k=${l#*=}"; else unset "$k"; fi
  done < "$f"
done

# HACK: the session's locales, compiled once and kept, for every game's Steam Runtime container. pressure-vessel's
# pv-locale-gen otherwise compiles the session's locale (LANG=en_CH.UTF-8) and en_US.UTF-8 from source on EVERY game
# launch, because the container doesn't have them; under FEX (x86 Proton) its localedef took 3.6 s a launch
# (bf-coldstart steam, 2026-11-05: pressure-vessel -> Proton 4.5 s with it, 0.9 s with PRESSURE_VESSEL_GENERATE_LOCALES=0).
# pv-locale-gen first checks each LANG/LC_* locale and en_US.UTF-8 with setlocale(), which honours LOCPATH: with these
# already there it generates nothing and the game keeps the user's locale (turning generation off would leave the game
# on "C"). Compiled here by the host's own localedef (native, ~0.2 s each, only when one is missing), per host glibc
# version; glibc adds its default locale path after LOCPATH, so Steam itself and the container's own locales (C.UTF-8)
# still work. A container whose glibc can't read them simply generates as before (pv-locale-gen's own fallback).
# Off: POWOS_STEAM_LOCALES=0 in ~/.config/powos/steam-env; a LOCPATH already set is left alone.
# Real fix: pressure-vessel keeping the locales it generated (a cache dir instead of a temp dir per launch), then this goes.
steam_locales() {
  local d g loc
  g=$(getconf GNU_LIBC_VERSION 2>/dev/null | tr -cd 'A-Za-z0-9._-'); [ -n "$g" ] || return 0
  d=${XDG_CACHE_HOME:-$HOME/.cache}/powos/steam-locales/$g
  for loc in en_US.UTF-8 "${LANG:-}" "${LC_ALL:-}" "${LC_CTYPE:-}" "${LC_MESSAGES:-}" "${LC_NUMERIC:-}" "${LC_TIME:-}" \
             "${LC_COLLATE:-}" "${LC_MONETARY:-}" "${LC_PAPER:-}" "${LC_NAME:-}" "${LC_ADDRESS:-}" "${LC_TELEPHONE:-}" \
             "${LC_MEASUREMENT:-}" "${LC_IDENTIFICATION:-}"; do
    steam_locale "$d" "$loc"
  done
  [ -d "$d/en_US.UTF-8" ] && export LOCPATH=$d
}
# steam_locale <dir> <locale>: <dir>/<locale> compiled (UTF-8 locales only). One glibc has no definition for (the
# session's en_CH.UTF-8: glibc has de_CH/fr_CH/it_CH, no en_CH - pv-locale-gen failed on it every launch, so the game
# fell back to "C") points at its language's own locale (en -> en_US, de -> de_DE, else the language's first).
steam_locale() {
  local d=$1 loc=$2 src tmp l m i=${POWOS_I18N_LOCALES:-/usr/share/i18n/locales}
  case $loc in '' | C | C.* | POSIX | *..* | */*) return 0 ;; *.UTF-8 | *.utf8) ;; *) return 0 ;; esac
  [ -d "$d/$loc" ] && return 0
  src=${loc%%.*}; m=${loc#*@}; [ "$m" = "$loc" ] && m= || m=@$m
  if [ ! -f "$i/$src$m" ]; then
    l=${src%%_*}; m=
    for src in "${l}_$(printf %s "$l" | tr a-z A-Z)" $( [ "$l" = en ] && echo en_US ) \
               "$(cd "$i" 2>/dev/null && ls -d "${l}"_?? 2>/dev/null | head -1)"; do
      [ -n "$src" ] && [ -f "$i/$src" ] && break; src=
    done
    [ -n "$src" ] || return 0
    steam_locale "$d" "$src.UTF-8"
    [ -d "$d/$src.UTF-8" ] && ln -sfn "$src.UTF-8" "$d/$loc"
    return 0
  fi
  mkdir -p "$d" && tmp=$(mktemp -d "$d/.new-XXXXXX") || return 0
  # Exit 1 = generated with warnings (as pv-locale-gen counts it); a locale is kept once its LC_CTYPE is there.
  localedef --no-archive -c -f UTF-8 -i "$src$m" "$tmp/$loc" >/dev/null 2>&1
  [ -f "$tmp/$loc/LC_CTYPE" ] && mv -T "$tmp/$loc" "$d/$loc" 2>/dev/null
  rm -rf "$tmp"
}
if [ "${POWOS_STEAM_LOCALES:-1}" != 0 ] && [ -z "${LOCPATH:-}" ] && command -v localedef >/dev/null 2>&1; then
  steam_locales
fi

if [ -n "${STEAM_X86:-}" ]; then
  # -cef-disable-gpu: the x86 web UI (CEF) software-renders; its x86 Mesa can't reach the Adreno GPU.
  exec FEXBash -c 'exec /usr/lib/steam/bin_steam.sh -cef-disable-gpu "$@"' steam "$@"
fi

S=${XDG_DATA_HOME:-$HOME/.local/share}/Steam
if [ ! -x "$S/steamrtarm64/steam" ]; then
  U=https://client-update.steamstatic.com
  f=$(curl -fsSL "$U/steam_client_linuxarm64" | awk '/"bins_linuxarm64_linuxarm64"/ {n = 1} n && /"file"/ {gsub(/"/, "", $2); print $2; exit}')
  [ -n "$f" ] || { echo "steam: Valve's linuxarm64 manifest has no client (offline?)" >&2; exit 1; }
  mkdir -p "$S" && t=$(mktemp) && curl -fL "$U/$f" -o "$t" && unzip -oq "$t" -d "$S" && rm -f "$t" \
    && chmod -R u+rwx "$S/steamrtarm64" || { echo "steam: downloading the ARM64 client failed" >&2; exit 1; }
fi
# Games: Valve's FEX compat tool (steamapps/common/FEX-Emu) with GL + Vulkan thunks - the game's x86 graphics calls go
# to PowOS's native Mesa (Turnip/freedreno on the Adreno; x86 Mesa can't reach Android's KGSL GPU driver). Its x86
# system (RootFS) is /usr/share/guestos/fex-mesa, which steam.install points at FEX's RootFS.
# The client overwrites STEAM_COMPAT_FEX_CONFIG per game (its own FEX setting, empty), so this export only reaches what
# Steam starts outside a game; the games' Vulkan thunk comes from steam-env's FEX_THUNKCONFIG.
export STEAM_COMPAT_FEX_CONFIG=${STEAM_COMPAT_FEX_CONFIG:-TSOEnabled:1,Multiblock:1,ThunksDB_GL:1,ThunksDB_Vulkan:1}

# The ~/.steam links Valve's launcher script makes, for the native client: games start through
# ~/.steam/sdkarm64/steam-launch-wrapper ("Game process removed" at once without it).
mkdir -p "$HOME/.steam"
ln -sfn "$S" "$HOME/.steam/root"
ln -sfn "$S" "$HOME/.steam/steam"
ln -sfn "$S/linuxarm64" "$HOME/.steam/sdkarm64"
# No -cef-disable-gpu here: the ARM64 client's web UI then loses its GPU process ("GPU process isn't usable. Goodbye",
# exit_code=4, in a restart loop) and never shows a window.
# Steam's web UI draws on the Adreno (the client sets MESA_LOADER_DRIVER_OVERRIDE=kgsl for steamwebhelper itself).
# HACK: -cef-disable-gpu-sandbox - Chromium's GPU sandbox only lets the GPU process open DRM devices (/dev/dri/*); the
# Adreno here is KGSL (/dev/kgsl-3d0), so in the sandbox Mesa found no GPU: the GPU process died at start
# (GPU_DEAD_ON_ARRIVAL, "GPU process isn't usable. Goodbye", no UI) or, on newer clients, the web UI fell back to
# software rendering. Only the GPU process goes unsandboxed; pages and the rest stay sandboxed (was -no-cef-sandbox:
# none at all; checked 2026-10-17: GPU process up and steady, renderers sandboxed). Real fix: the KGSL device in
# Chromium's GPU sandbox broker allowlist (CEF/Valve side).
# POWOS_STEAM_ARGS (steam-env / ~/.config/powos/steam-env, or a check's env): extra client options, word-split, e.g.
# -noshaders (no shader pre-caching: Steam's "Processing Vulkan shaders" held RimWorld's launch 28 s, 2026-10-23 05:46,
# fossilize under FEX). Set only once measured (bf-coldstart env:POWOS_STEAM_ARGS=-noshaders).
POWOS_STEAM_ARGS=${POWOS_STEAM_ARGS:-}
cd "$S/steamrtarm64" || exit 1
# A steam:// URL (or any command line) for a client that already runs: Steam's own single-instance forwarding - this
# binary writes the command line into ~/.steam/steam.pipe and exits; the client reads it, stashes it in registry.vdf
# (TempAppCmdLine), sets its named event (a System V semaphore) and runs it on its next frame (ExecCommandLine in
# console_log). That event was why every launch to a running client was lost until pkgrel 28: the sysvipc-emu shim
# left a semaphore's sempid at 0 after SETVAL, so the next Steam process to open the event took it for abandoned
# (Valve's check: GETPID 0 or dead, nobody waiting) and IPC_RMID'd it under the running client - whose semop on it
# then failed (EIDRM) for good. The shim sets sempid on SETVAL/SETALL now, as Linux does.
# A tap on Steam itself (its launcher entry: `steam %U` with no URL = no arguments at all) must SHOW Steam's main
# window, every time. A Steam that already runs may have none: the session's resident Steam (powos-steam-resident)
# starts -silent, and a closed main window leaves the client in its tray. A bare `./steam` to a running client is a
# forward with nothing in it (no window, 2026-10-23 14:42 "Steam won't boot"), so the tap asks for the window by URL.
# Not running: a client started with steam://open/main opens on its main window (never -silent). Only with no
# arguments: -shutdown, -silent and every other caller's options are left as they are.
[ $# -eq 0 ] && set -- steam://open/main
# A game launch forwarded into a running client waits until that client is logged on to Steam over a live link.
# A client frozen out of sight (unified sleep) for a while loses its connection: Steam's server drops it, and the
# client only notices at the thaw - which is this launch ("Disconnected By Remote Host", then a 9-19 s reconnect
# backoff, connection_log). A launch that reached it meanwhile ran its cloud sync logged off, which failed, and
# Steam then waited for the user to answer "syncfailed" inside its own window, out of sight; every later launch of
# that game joined the same waiting action, so nothing ever started (Broforce 2026-10-24 05:09:56 and 05:15:43,
# console_log "LaunchApp waiting for user response to SynchronizingCloud "syncfailed"", cloud_log "[login=false]").
# The link's state is read from the kernel (no guess from timing): the local port of the client's newest
# connection (connection_log ConnectionCompleted) must be an ESTABLISHED socket and its newest state Logged On. A
# client that isn't trying to log on (user logoff, offline mode, no log) is not waited for; at most 30 s otherwise.
cm_link() {  # 0 logged on over a live link, 1 not yet (reconnecting, or its link died while frozen), 2 not trying
  t=$(tail -c 262144 "$1" 2>/dev/null)
  case $(printf '%s\n' "$t" | grep -a -o -E '\] \[(Logged On|Logged Off|Connecting|Connected|Logging On), [0-9]+' | tail -1) in
    '' | *'Logged Off, 0') return 2 ;;
    *'Logged On,'*) ;;
    *) return 1 ;;
  esac
  lp=$(printf '%s\n' "$t" | grep -a -o -E 'ConnectionCompleted\(\) \([^)]*\) local address \([^)]*:[0-9]+\)' | tail -1 \
       | sed -E 's/.*:([0-9]+)\)$/\1/')
  [ -n "$lp" ] || return 0
  awk -v p=":$(printf '%04X' "$lp")" 'FNR > 1 && substr($2, length($2) - 4) == p && $4 == "01" { f = 1 } END { exit !f }' \
    /proc/net/tcp /proc/net/tcp6 2>/dev/null || return 1
}
case " $* " in
  *" steam://rungameid/"*)
    case $(readlink "/proc/${steam_pid:-0}/exe" 2>/dev/null) in */steamrtarm64/steam)
      t0=$(date +%s); r=0
      while cm_link "$S/logs/connection_log.txt"; r=$?; [ $r -eq 1 ] && [ $(($(date +%s) - t0)) -lt 30 ]; do sleep 0.25; done
      [ $(($(date +%s) - t0)) -gt 0 ] && echo "steam: waited $(($(date +%s) - t0)) s for Steam to log on again before the launch$([ $r -eq 1 ] && echo ' (still not logged on: forwarded anyway)')" >&2 ;;
    esac ;;
esac
