#!/bin/sh
# /usr/bin/steam on PowOS (ARM): Valve's native ARM64 Linux client (the "linuxarm64" build behind the Steam Frame -
# unlisted, but on Valve's update servers since 2026). Steam itself and its web UI run natively; only games' x86
# code goes through FEX. On first run the client is fetched from Valve's linuxarm64 manifest (it updates itself
# from then on). STEAM_X86=1 runs the old way: Valve's x86 client entirely under FEX (minutes to start).
#
# System V IPC: Android's kernel has none (semget -> ENOSYS) and the client needs its semaphores ("Thread
# synchronization object is unuseable"); the sysvipc-emu shim (targets/android/steam/sysvipc: aarch64 for the
# native client, i386 + x86-64 for x86 programs - each process skips the ones of other architectures) provides them
# from /dev/shm. Preloaded from the home directory: the same path outside FEX, under FEX and inside the Steam Runtime
# container (pressure-vessel binds the home in; from /usr/lib the container's programs couldn't find it).
L=${XDG_DATA_HOME:-$HOME/.local/share}/powos-sysvipc
for b in aarch64 i386 x86_64; do
  cmp -s /usr/lib/powos-sysvipc/$b/libsysvipc-emu.so "$L/$b/libsysvipc-emu.so" \
    || install -Dm755 /usr/lib/powos-sysvipc/$b/libsysvipc-emu.so "$L/$b/libsysvipc-emu.so"
done
export LD_PRELOAD="$L/aarch64/libsysvipc-emu.so $L/i386/libsysvipc-emu.so $L/x86_64/libsysvipc-emu.so${LD_PRELOAD:+ $LD_PRELOAD}"

# IPC left behind by a Steam that didn't shut down (killed, crashed, the session restarted): the shim's semaphores are
# files that a kernel would have released with their processes, so the next Steam waited on ones a dead process held
# and hung at start. Valve's IPC object and shared memory went with them, and FEX's per-process stats - all in
# /dev/shm, which is RAM (600 MB of it after a day of games). Only while no Steam of this user runs: its games and
# helpers are all started by it. Running = the pid Steam keeps in ~/.steam/steam.pid is alive and is Steam's client (by
# name, pgrep found this script: its process, and the subshells it forks, are called steam too).
steam_pid=$(cat "$HOME/.steam/steam.pid" 2>/dev/null)
# Instant start: a game launch (steam://rungameid/<appid>) for a game this Steam already runs - kept alive, frozen
# with Steam while out of sight (units/phone/steam.json "games": "pause") - thaws it and raises the game's window
# (powos-sleep-gui's Resume) instead of handing Steam a launch it has nothing to do for. Not running, or no watcher
# (no PowOS session sleep): the launch goes on to Steam as always.
case " $* " in
  *" steam://rungameid/"*)
    appid=${*##*steam://rungameid/}; appid=${appid%% *}
    case $appid in *[!0-9]* | '') appid= ;; esac
    if [ -n "$appid" ] && [ -d "/proc/${steam_pid:-0}" ] && pgrep -f "SteamLaunch AppId=$appid( |\$)" >/dev/null 2>&1; then
      case $(dbus-send --session --print-reply=literal --reply-timeout=3000 --dest=dev.powos.Sleep /Gui \
               dev.powos.Sleep.Gui.Resume string:"$appid" 2>/dev/null) in
        *'"running": true'*) exit 0 ;;
      esac
    fi ;;
esac
# Instant resume: unified sleep freezes a Steam that's out of sight (units/phone/steam.json, docs/UNIFIED-SLEEP.md).
# Thaw it first, so what this launch hands to it (a game, the window) reaches a running Steam instead of waiting on a
# frozen one. dbus-send, not powos-sleep-gui wake: a C program, no Python start-up on the way to the window.
case $(cat "/proc/${steam_pid:-0}/cgroup" 2>/dev/null) in
  *powos/sleep/*)
    dbus-send --session --print-reply=literal --reply-timeout=3000 --dest=dev.powos.Sleep /Gui \
      dev.powos.Sleep.Gui.Wake string:steam >/dev/null 2>&1 || powos sleep wake "$steam_pid" >/dev/null 2>&1 ;;
esac
case $(readlink "/proc/${steam_pid:-0}/exe" 2>/dev/null) in
  */steamrtarm64/steam | */FEX*) ;;  # the ARM64 client, or the x86 one (STEAM_X86) under FEX
  *)
    rm -f /dev/shm/y700-sysv/sem-* "/dev/shm/u$(id -u)-ValveIPCSharedObj-Steam" "/dev/shm/u$(id -u)-Shm_"*
    for f in /dev/shm/fex-*-stats; do
      pid=${f#/dev/shm/fex-}; pid=${pid%-stats}
      [ -e "$f" ] && [ ! -d "/proc/$pid" ] && rm -f "$f"
    done ;;
esac

if [ -n "${STEAM_X86:-}" ]; then
  # -cef-disable-gpu: the x86 web UI (CEF) software-renders; its x86 Mesa can't reach the Adreno GPU.
  exec FEXBash -c 'exec /usr/lib/steam/bin_steam.sh -cef-disable-gpu "$@"' steam "$@"
fi

S=${XDG_DATA_HOME:-$HOME/.local/share}/Steam
if [ ! -x "$S/steamrtarm64/steam" ]; then
  U=https://client-update.steamstatic.com
  f=$(curl -fsSL "$U/steam_client_linuxarm64" | awk '/"bins_linuxarm64_linuxarm64"/ {n = 1} n && /"file"/ {gsub(/"/, "", $2); print $2; exit}')
  [ -n "$f" ] || { echo "steam: Valve's linuxarm64 manifest has no client (offline?)" >&2; exit 1; }
  mkdir -p "$S" && t=$(mktemp) && curl -fL "$U/$f" -o "$t" && unzip -oq "$t" -d "$S" && rm -f "$t" \
    && chmod -R u+rwx "$S/steamrtarm64" || { echo "steam: downloading the ARM64 client failed" >&2; exit 1; }
fi
# Games: Valve's FEX compat tool (steamapps/common/FEX-Emu) with GL + Vulkan thunks - the game's x86 graphics calls go
# to PowOS's native Mesa (Turnip/freedreno on the Adreno; x86 Mesa can't reach Android's KGSL GPU driver). Its x86
# system (RootFS) is /usr/share/guestos/fex-mesa, which steam.install points at FEX's RootFS.
export STEAM_COMPAT_FEX_CONFIG=${STEAM_COMPAT_FEX_CONFIG:-TSOEnabled:1,Multiblock:1,ThunksDB_GL:1,ThunksDB_Vulkan:1}

# The ~/.steam links Valve's launcher script makes, for the native client: games start through
# ~/.steam/sdkarm64/steam-launch-wrapper ("Game process removed" at once without it).
mkdir -p "$HOME/.steam"
ln -sfn "$S" "$HOME/.steam/root"
ln -sfn "$S" "$HOME/.steam/steam"
ln -sfn "$S/linuxarm64" "$HOME/.steam/sdkarm64"
# No -cef-disable-gpu here: the ARM64 client's web UI then loses its GPU process ("GPU process isn't usable. Goodbye",
# exit_code=4, in a restart loop) and never shows a window.
# Steam's web UI draws on the Adreno (the client sets MESA_LOADER_DRIVER_OVERRIDE=kgsl for steamwebhelper itself).
# HACK: -cef-disable-gpu-sandbox - Chromium's GPU sandbox only lets the GPU process open DRM devices (/dev/dri/*); the
# Adreno here is KGSL (/dev/kgsl-3d0), so in the sandbox Mesa found no GPU: the GPU process died at start
# (GPU_DEAD_ON_ARRIVAL, "GPU process isn't usable. Goodbye", no UI) or, on newer clients, the web UI fell back to
# software rendering. Only the GPU process goes unsandboxed; pages and the rest stay sandboxed (was -no-cef-sandbox:
# none at all; checked 2026-10-17: GPU process up and steady, renderers sandboxed). Real fix: the KGSL device in
# Chromium's GPU sandbox broker allowlist (CEF/Valve side).
cd "$S/steamrtarm64" && exec ./steam -cef-disable-gpu-sandbox "$@"
