# Steam for PowOS on ARM phones. /usr/bin/steam runs Valve's native ARM64 Linux client (fetched on first run, see
# the file); games' x86 code goes through FEX. Valve's x86 launcher (shell script + 32-bit bootstrap, packaged like
# Arch's steam PKGBUILD) stays as the STEAM_X86=1 fallback, through FEX.
pkgname=steam
pkgver=1.0.0.87
pkgrel=26
pkgdesc="Steam: Valve's native ARM64 client (games through FEX) - PowOS phone build"
arch=(any)
url=https://steampowered.com/
license=(custom)
depends=(bash python fex-emu curl unzip desktop-file-utils hicolor-icon-theme lsof xdg-utils xz zenity bubblewrap
         gtk2 ibus libnm openal)
install=steam.install
# sysvipc-emu.tar.gz: System V IPC for the native client and x86 programs (targets/android/steam/sysvipc/build.sh puts it here).
source=("https://repo.steampowered.com/steam/archive/stable/steam_$pkgver.tar.gz" steam sysvipc-emu.tar.gz
        user_settings.py powos-steam-resident powos-steam-resident.desktop powos-steam-compat steam-env)
noextract=(sysvipc-emu.tar.gz)
sha256sums=('649375d2f9377f8009aaf3e2ff09978041eb9114897d9c5a3886f1d82e27ba1f' SKIP
            '205ee32a07213a8cad3c9bf67caa70361c5b4f9cdec2e71c216c967e651ae4af' SKIP SKIP SKIP SKIP SKIP)

package() {
  mkdir -p "$pkgdir/usr/lib/powos-sysvipc"
  tar -xzf sysvipc-emu.tar.gz -C "$pkgdir/usr/lib/powos-sysvipc" ./aarch64/libsysvipc-emu.so ./i386/libsysvipc-emu.so \
    ./x86_64/libsysvipc-emu.so
  cd steam-launcher
  make DESTDIR="$pkgdir" PREFIX=/usr install
  # steamdeps installs Ubuntu packages through apt; nothing to do on PowOS (as Arch's package).
  ln -sf /usr/bin/true "$pkgdir/usr/bin/steamdeps"
  # The launcher in FEX's x86 world, with System V IPC (see the file).
  install -m755 "$srcdir/steam" "$pkgdir/usr/bin/steam"
  # Proton's user_settings.py, put into each Proton by /usr/bin/steam (see the file).
  install -Dm644 "$srcdir/user_settings.py" "$pkgdir/usr/lib/powos-steam/user_settings.py"
  # Which way each game runs (native Linux build / ARM64 Proton / x86 Proton), per game, measured (see the file);
  # /usr/bin/steam applies it before each Steam start.
  install -Dm755 "$srcdir/powos-steam-compat" "$pkgdir/usr/bin/powos-steam-compat"
  # Environment for Steam and every game it starts (FEX, pressure-vessel switches; see the file).
  install -Dm644 "$srcdir/steam-env" "$pkgdir/usr/lib/powos-steam/steam-env"
  # Steam started once per session, out of sight (then frozen by unified sleep): a game's tap skips Steam's start.
  install -Dm755 "$srcdir/powos-steam-resident" "$pkgdir/usr/lib/powos-steam/powos-steam-resident"
  install -Dm644 "$srcdir/powos-steam-resident.desktop" "$pkgdir/etc/xdg/autostart/powos-steam-resident.desktop"
  rm -rf "$pkgdir/etc/apt"
  install -Dm644 steam_subscriber_agreement.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
