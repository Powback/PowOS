+/// Calls into WASM running right now, on any database. Wasmtime's epoch only serves to log calls running for over
+/// a second (the epoch deadline callback logs and continues), so it needs to advance only while one runs: an idle
+/// server then has no 10ms ticker waking a tokio worker 100 times a second.
+static RUNNING: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+static STARTED: std::sync::LazyLock<tokio::sync::Notify> = std::sync::LazyLock::new(tokio::sync::Notify::new);
+
+/// Held for the duration of a call into WASM.
+pub(super) struct Running(());
+
+impl Running {
+    pub(super) fn start() -> Self {
+        if RUNNING.fetch_add(1, std::sync::atomic::Ordering::SeqCst) == 0 {
+            STARTED.notify_one();
+        }
+        Running(())
+    }
+}
+
+impl Drop for Running {
+    fn drop(&mut self) {
+        RUNNING.fetch_sub(1, std::sync::atomic::Ordering::SeqCst);
+    }
+}
+
+/// [`epoch_ticker`], but ticking only while a call into WASM is [`Running`].
+fn epoch_ticker_while_running(mut on_tick: impl 'static + Send + FnMut() -> Option<()>) {
+    tokio::spawn(async move {
+        let mut interval = tokio::time::interval(EPOCH_TICK_LENGTH);
+        interval.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Delay);
+        loop {
+            if RUNNING.load(std::sync::atomic::Ordering::SeqCst) == 0 {
+                STARTED.notified().await;
+                interval.reset();
+            }
+            interval.tick().await;
+            let Some(()) = on_tick() else {
+                return;
+            };
+        }
+    });
+}
