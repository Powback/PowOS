# PowOS packages Arch Linux ARM doesn't build: the upstream recipe, built unchanged for aarch64 by
# build-pkgs.sh (makepkg --ignorearch). phone-rules.conf maps the PowOS RPM names to these.
#   <arch package>     <official|aur>    <PowOS RPM(s) it stands for>
mangohud              official          terra-mangohud
vkbasalt              aur               vkBasalt
umu-launcher          official          umu-launcher umu-wrapper
input-remapper        aur               input-remapper
scopebuddy            aur               ScopeBuddy
nvtop                 official          nvtop
rom-properties        aur               rom-properties-kf6 rom-properties-utils
obs-vkcapture         aur               obs-studio-plugin-vkcapture-hook-libs
xwaylandvideobridge   official          xwaylandvideobridge
cardwire              aur               cardwire-gui
hfsprogs              aur               hfsplus-tools
hfsutils              aur               hfsutils
krunner-bazaar        aur               krunner-bazaar
makemkv               aur               makemkv
ntfs-3g-system-compression aur          ntfs-3g-system-compression
pinfo                 aur               pinfo
vulkan-low-latency-layer aur            vulkan-low-latency-layer
box64                 aur               (x86 translator: PowOS's Steam + x86 games, see patches/andromarchy/0002)
gtk2                  aur               (none: the native ARM64 Steam client's steamui.so/vgui2_s.so link libgtk-x11-2.0, which Arch dropped; see play/powos-steam)
# Bazzite's own (bazzite-portal, cicpoffs, gamemode-news-hook, gmodpatchtool, krunner-yafti,
# steam-notif-daemon) have no Arch recipe: pkgs/<name>/PKGBUILD, packaged from their Bazzite/terra spec.
