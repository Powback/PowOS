#!/bin/sh
# unity-screen: a Unity or Unreal game's Steam launch option (powos-steam-compat apply sets it for every installed Unity
# / Unreal game at each Steam start - the generic default, board task games-resize-live-to-their-container-portrait-la;
# Besiege launched at its saved 2268x1600 in a 2268x2440 container, letterboxed) - `<home>/.local/share/powos/unity-screen %command%` - that starts
# the game fullscreen at the CURRENT screen size. Unity keeps the size it saved last time (Broforce: 1116x2440 from the
# folded cover screen, stored in the Proton prefix's user.reg) and doesn't follow KWin's output when the phone is
# unfolded/rotated (the output anland-1 follows the Android surface: one mode, resized). So each launch passes
# `-screen-fullscreen 0 -popupwindow -screen-width W -screen-height H` (Unity player arguments) with W x H = the
# container's size now (see "size" below).
#
# Live after a rotate/fold (G2, 2026-11-02): a borderless WINDOWED Unity player, not a full-screen one. Unity's
# full-screen modes keep the render resolution they started with (Screen.width/height) and stretch it to the window:
# KWin 0032/0037 resize the game's window to its task on every rotate/fold/resize, Wine turns that ConfigureNotify into
# WM_SIZE, and a full-screen Broforce kept drawing its launch size, scaled. In windowed mode the render resolution IS the
# client area (Unity's Screen docs: "the render resolution changes when ... the user drags the window to resize it"),
# so the same resize re-renders at the new size, inside the engine, no restart. -popupwindow = no frame; the window
# covers Wine's monitor (the X root, never larger than the task), so winex11 still sets _NET_WM_STATE_FULLSCREEN and
# KWin keeps the task immersive. Fixed size hints (no WS_THICKFRAME) are covered by 0037 (fixed-size steam_app_ window
# -> full screen in its task). A windowed game also doesn't minimise itself on focus loss the way a full-screen Wine
# window does (skill: "Minimised game").
# -popupwindow stays in windowed mode (game-window-chrome, 11-08): the window's chrome is PowOS's, not the game's - a
# game's undecorated window keeps the web window's bar (close / full screen / resize; WebWindows.pageOwnFrame), so a
# Wine caption isn't needed for it, and one would add a non-client area (render size != the task) and drop the
# monitor-covering _NET_WM_STATE_FULLSCREEN the immersive task relies on.
# POWOS_UNITY_SCREEN=fullscreen: the old `-screen-fullscreen 1` launch (render size fixed at launch, scaled after).
#
# Runs where Steam puts launch-option prefixes: inside the Steam Linux Runtime container, under FEX (x86). That runtime
# has no xrandr and only `python3.13`, so the size comes from libX11 through ctypes; outside it the host's python3 does
# the same. No display or no python: the game starts unchanged.
#
#   unity-screen --install <appid>...   (in the session, Steam NOT running) copy this file to
#                                       ~/.local/share/powos/unity-screen and set it as the LaunchOptions of each appid
#                                       in every Steam user's localconfig.vdf (backup: localconfig.vdf.powos-bak).
#   unity-screen --remove <appid>...    drop those LaunchOptions again.
# Steam rewrites localconfig.vdf from memory when it exits: an edit while it runs is lost (hence the check).
if [ "${1:-}" = --install ] || [ "${1:-}" = --remove ]; then
  mode=$1; shift
  S=${XDG_DATA_HOME:-$HOME/.local/share}/Steam
  case $(readlink "/proc/$(cat "$HOME/.steam/steam.pid" 2>/dev/null || echo 0)/exe" 2>/dev/null) in
    */steam | */FEX*) echo "unity-screen: Steam is running - close it first (it rewrites localconfig.vdf on exit)" >&2; exit 1 ;;
  esac
  dst=${XDG_DATA_HOME:-$HOME/.local/share}/powos/unity-screen
  [ "$mode" = --install ] && install -Dm755 "$0" "$dst"
  for c in "$S"/userdata/*/config/localconfig.vdf; do
    [ -f "$c" ] || continue
    cp -p "$c" "$c.powos-bak"
    python3 - "$c" "$mode" "$dst" "$@" <<'PY' || exit 1
import re, sys
path, mode, dst, appids = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4:]
t = open(path, encoding="utf-8", errors="surrogateescape").read()
# Tokens with positions: quoted strings, braces. Track the key path; edit only the app's own block in place, so the
# rest of the file stays byte for byte.
tok = [(m.start(), m.end(), m.group()) for m in re.finditer(r'"(?:[^"\\]|\\.)*"|[{}]', t)]
want = ["userlocalconfigstore", "software", "valve", "steam", "apps"]
edits, stack, key, i = [], [], None, 0
while i < len(tok):
    s, e, v = tok[i]
    if v == "{":
        stack.append((key or "").strip('"').lower()); key = None
        if [k for k in stack[:-1]] == want and stack[-1] in appids:
            depth, j, lo = 0, i, None
            while j < len(tok):  # the block's end and a direct-child LaunchOptions
                if tok[j][2] == "{": depth += 1
                elif tok[j][2] == "}":
                    depth -= 1
                    if depth == 0: break
                elif depth == 1 and tok[j][2].lower() == '"launchoptions"': lo = j
                j += 1
            ind = "\t" * len(stack)
            val = '"%s %%command%%"' % dst
            if lo is not None:
                ls = t.rfind("\n", 0, tok[lo][0]) + 1
                le = t.find("\n", tok[lo + 1][1]); le = len(t) if le < 0 else le + 1
                edits.append((ls, le, "" if mode == "--remove" else '%s"LaunchOptions"\t\t%s\n' % (ind, val)))
            elif mode == "--install":
                cs = t.rfind("\n", 0, tok[j][0]) + 1
                edits.append((cs, cs, '%s"LaunchOptions"\t\t%s\n' % (ind, val)))
            print("%s: %s %s" % (path, stack[-1], "removed" if mode == "--remove" else "-> " + val))
    elif v == "}":
        stack.pop(); key = None
    else:
        key = v if key is None else None  # a key, or the value that ends a key/value pair
    i += 1
for s, e, r in sorted(edits, reverse=True):
    t = t[:s] + r + t[e:]
open(path, "w", encoding="utf-8", errors="surrogateescape").write(t)
PY
  done
  exit 0
fi

# The Steam overlay off for this game (per game: only the games with this launch option; Steam's own settings, the
# FPS corner included, stay as the user set them; POWOS_STEAM_OVERLAY=1 keeps it). Steam injects it into the game with
# LD_PRELOAD (gameoverlayrenderer.so, plus its Vulkan layer for DXVK); on the phone it draws nothing in the game (an
# x11grab in a level, 11-06 13:37, had no FPS corner), yet Steam's webhelper rendered its popup at ~35-40 % of a core
# next to the game - heat, which is what moves OxygenOS' thermal gear (docs/research/broforce-fps.md "Heat").
if [ "${POWOS_STEAM_OVERLAY:-0}" != 1 ]; then
  case ${LD_PRELOAD:-} in
    *gameoverlayrenderer*)
      keep=; oifs=$IFS; IFS=': '
      for l in $LD_PRELOAD; do case $l in *gameoverlayrenderer*) ;; *) keep=${keep:+$keep:}$l ;; esac; done
      IFS=$oifs
      if [ -n "$keep" ]; then export LD_PRELOAD="$keep"; else unset LD_PRELOAD; fi
      unset ENABLE_VK_LAYER_VALVE_steam_overlay_1
      echo "unity-screen: Steam overlay off for this game (gameoverlayrenderer dropped from LD_PRELOAD)" >&2 ;;
    *) echo "unity-screen: no Steam overlay in LD_PRELOAD" >&2 ;;
  esac
fi
py=$(command -v python3 || command -v python3.13)
# The size: Xwayland root's _POWOS_SCREEN_SIZE (kwin 0051: the Android screen the game's full-screen task gets, in its
# orientation now) - the root itself is KWin's output, which follows the desktop consumer (home below the status bar
# 2268x2314, a floating task 1360x1708, the cover 1116x2358): a game launched at that drew a smaller frame that Proton
# scaled up to its window ("not the right resolution", 2026-10-30). No property (an older KWin): the root, as before.
size=$([ -n "$py" ] && [ -n "${DISPLAY:-}" ] && "$py" -c "$(cat <<'PY'
import ctypes
x = ctypes.CDLL("libX11.so.6")
P, L, I, U = ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int, ctypes.POINTER
x.XOpenDisplay.restype = P; x.XOpenDisplay.argtypes = [ctypes.c_char_p]
for f in (x.XDisplayWidth, x.XDisplayHeight): f.argtypes = [P, I]
x.XDefaultScreen.argtypes = [P]
x.XRootWindow.restype = L; x.XRootWindow.argtypes = [P, I]
x.XInternAtom.restype = L; x.XInternAtom.argtypes = [P, ctypes.c_char_p, I]
x.XGetWindowProperty.argtypes = [P, L, L, ctypes.c_long, ctypes.c_long, I, L,
                                 U(L), U(I), U(L), U(L), U(P)]
x.XFree.argtypes = [P]
d = x.XOpenDisplay(None)
if d:
    n = x.XDefaultScreen(d)
    size = (x.XDisplayWidth(d, n), x.XDisplayHeight(d, n))
    atom = x.XInternAtom(d, b"_POWOS_SCREEN_SIZE", 1)  # only_if_exists: 0 = no KWin ever set it
    if atom:
        t, fmt, nitems, after, data = L(), I(), L(), L(), P()
        if x.XGetWindowProperty(d, x.XRootWindow(d, n), atom, 0, 2, 0, 6, ctypes.byref(t), ctypes.byref(fmt),
                                ctypes.byref(nitems), ctypes.byref(after), ctypes.byref(data)) == 0 and data.value:
            # format 32 comes back as C longs (Xlib), AnyPropertyType 0 / XA_CARDINAL 6
            v = ctypes.cast(data, U(ctypes.c_long))
            if fmt.value == 32 and nitems.value == 2 and v[0] > 0 and v[1] > 0:
                size = (v[0], v[1])
            x.XFree(data)
    print(size[0], size[1])
PY
)" 2>/dev/null)
# The engine, from the game's own executable in the command (Proton: `... proton waitforexitandrun <dir>/<game>.exe`;
# native: `<dir>/<game>.x86_64`): Unreal (an Engine/ folder at the install root, or the exe under <Project>/Binaries/)
# takes `-ResX=W -ResY=H -windowed` (ABZU, UE4: its GameUserSettings.ini says 1280x720 Fullscreen and
# bUseDesktopResolutionForFullscreen=False, so it rendered 1280x720 and Proton's fullscreen hack scaled + pillarboxed
# it; a windowed UE viewport re-renders at its window's size like windowed Unity). Anything else gets the Unity player
# arguments (this wrapper's first job; powos-steam-compat apply only sets it for Unity and Unreal games).
engine=unity
for a in "$@"; do
  case $a in *.exe|*.x86_64|*.x86) ;; *) continue ;; esac
  [ -f "$a" ] || continue
  d=$(dirname "$a")
  case $a in */Binaries/Win64/*|*/Binaries/Linux/*) engine=unreal ;; esac
  [ -d "$d/Engine/Binaries" ] && engine=unreal
  break
done
# The render scale (board abz-has-low-fps, 2026-11-07): the window stays the container's size, the game draws fewer
# pixels and its frame is scaled up to it. ABZU (UE4, GPU-bound on the a740) at the native 2268x2439 that -ResX/-ResY
# gives it: 19.6 fps; at its own SCALE_50: 27.3 (docs/research/abzu-fps.md). Per game: `powos game <x> scale
# auto|100|85|70|50` or the games widget's settings screen (powos-steam-compat scale; steam-compat.json "scale").
#   Unreal: the engine's own screen percentage in the game's GameUserSettings.ini (its Proton prefix, or ~/.config/Epic
#     for a native build): the game's own ResolutionScale=SCALE_<n> enum when the file has that key (ABZU's
#     EGraphicsRenderScale, SCALE_25..200), else UE's standard [ScalabilityGroups] sg.ResolutionQuality. UE upsamples
#     to its full-size window in its own pipeline, so the UI stays sharp. The value there before is kept in the record
#     and put back at 100; at 100 a value we never wrote (the user's in-game choice) is left alone.
#   Unity: a full-screen player at the scaled size (its render size is fixed at launch); Wine's fullscreen hack
#     (Proton) or Xwayland's emulated mode (native) stretches it to the screen. A rotate/fold then rescales the frame
#     instead of re-rendering (100 % keeps the live borderless window).
# auto: from the game's recorded fps (powos-steam-compat watch-fps after each launch: KWin's window task frames) - the
# highest scale that held 55 fps (one step up again at >= 80), a step down while none did (100 85 70 50), back to the
# highest when lowering didn't buy >= 10 % (not GPU-bound); nothing recorded: 70 for an Unreal game on > 3 MP, else 100.
# Fail loudly, run as is: a scale that can't be applied says why on stderr and the game starts at full size.
# ~/.local/share/powos/render-scale/<appid>.json: what the last launch applied and why (the widget and watch-fps read it).
# POWOS_RENDER_SCALE=off: nothing read, nothing written.
RS_PY=$(cat <<'PY'
import glob, json, os, re, sys, time
appid, engine, w, h = sys.argv[1], sys.argv[2], int(sys.argv[3]), int(sys.argv[4])
STEPS = [100, 85, 70, 50]
home = os.path.expanduser("~")
data = os.environ.get("XDG_DATA_HOME") or os.path.join(home, ".local/share")
try:
    with open(os.environ.get("POWOS_STEAM_COMPAT_STATE") or os.path.join(data, "powos/steam-compat.json")) as f:
        app = json.load(f).get("apps", {}).get(appid, {})
except (OSError, ValueError, AttributeError):
    app = {}
want = str(app.get("scale", "auto"))


def auto():
    m = {}
    for r in app.get("fps", []):  # oldest first: the latest fps per scale wins
        try:
            m[int(r["scale"])] = float(r["fps"])
        except (KeyError, TypeError, ValueError):
            pass
    if not m:
        if engine == "unreal" and w * h > 3000000:
            return 70, "auto: Unreal at %.1f MP, nothing measured yet" % (w * h / 1e6)
        return 100, "auto: nothing measured yet"
    hi, lo = max(m), min(m)
    if len(m) > 1 and m[lo] < m[hi] * 1.1:
        return hi, "auto: %d%% %.0f fps, %d%% %.0f - not GPU-bound" % (hi, m[hi], lo, m[lo])
    held = [s for s in m if m[s] >= 55]
    if held:
        s = max(held)
        up = [t for t in STEPS if t > s and t not in m]
        if m[s] >= 80 and up:
            return min(up), "auto: %.0f fps at %d%%, trying %d%%" % (m[s], s, min(up))
        return s, "auto: %.0f fps at %d%%" % (m[s], s)
    down = [t for t in STEPS if t < lo]
    if down:
        return down[0], "auto: %.0f fps at %d%%, under 55" % (m[lo], lo)
    return lo, "auto: %.0f fps at %d%%, the lowest step" % (m[lo], lo)


if want == "auto":
    scale, why = auto()
else:
    try:
        scale, why = max(25, min(100, int(want))), "set"
    except ValueError:
        scale, why = 100, "unknown setting %r" % want
msgs = []
rec_path = os.path.join(data, "powos/render-scale", appid + ".json")
try:
    with open(rec_path) as f:
        prev = json.load(f)
except (OSError, ValueError):
    prev = {}
rec = {"scale": scale, "why": why, "engine": engine, "size": [w, h], "t": time.strftime("%F %T"), "applied": True}
if engine == "unreal":
    pfx = os.environ.get("STEAM_COMPAT_DATA_PATH", "")
    pats = [os.path.join(glob.escape(pfx), "pfx/drive_c/users/*/AppData/Local/*/Saved/Config/Windows*/GameUserSettings.ini")] if pfx else []
    pats.append(os.path.join(glob.escape(home), ".config/Epic/*/Saved/Config/Linux*/GameUserSettings.ini"))
    inis = sorted({p for pat in pats for p in glob.glob(pat) if "/UnrealEngine/" not in p}, key=os.path.getmtime, reverse=True)
    if not inis:
        rec["applied"] = scale == 100
        if scale != 100:
            msgs.append("%d%% not applied: no GameUserSettings.ini yet (the game writes it when it first exits) - from the next launch on" % scale)
    else:
        ini = inis[0]
        t = open(ini, encoding="utf-8", errors="surrogateescape").read()
        orig = dict(prev.get("orig", {})) if prev.get("ini") == ini else {}
        own = re.search(r"(?m)^ResolutionScale=(SCALE_\d+)[ \t\r]*$", t)
        key = "ResolutionScale" if own else "sg.ResolutionQuality"
        g = own or re.search(r"(?m)^sg\.ResolutionQuality=(\S+)[ \t\r]*$", t)
        cur = g.group(1) if g else None
        if scale == 100:
            val = orig.get(key, cur)  # ours put back; never ours = the game's (or the user's in-game) value stays
        elif own:
            val = "SCALE_%d" % max(25, int(round(scale / 25.0)) * 25)
        else:
            val = str(scale)
        if val is not None and val != cur:
            if scale != 100 and key not in orig:
                orig[key] = cur if cur is not None else ("SCALE_100" if own else "100")
            if g:
                t = t[:g.start(1)] + val + t[g.end(1):]
            elif re.search(r"(?m)^\[ScalabilityGroups\][ \t\r]*$", t):
                t = re.sub(r"(?m)^\[ScalabilityGroups\][ \t\r]*$", lambda x: x.group(0) + "\n%s=%s" % (key, val), t, count=1)
            else:
                t = t.rstrip("\n") + "\n\n[ScalabilityGroups]\n%s=%s\n" % (key, val)
            try:
                with open(ini + ".powos-tmp", "w", encoding="utf-8", errors="surrogateescape") as f:
                    f.write(t)
                os.replace(ini + ".powos-tmp", ini)
                msgs.append("%s=%s (was %s) in %s" % (key, val, cur, ini))
            except OSError as e:
                rec["applied"] = False
                msgs.append("%d%% not applied: %s" % (scale, e))
        if scale == 100:
            orig.pop(key, None)
        rec.update(ini=ini, key=key, value=val, orig=orig)
try:
    os.makedirs(os.path.dirname(rec_path), exist_ok=True)
    with open(rec_path + ".tmp", "w") as f:
        json.dump(rec, f)
    os.replace(rec_path + ".tmp", rec_path)
except OSError as e:
    msgs.append("record not written: %s" % e)
print(scale if rec["applied"] else 100, why)
for m in msgs:
    print(m)
PY
)
scale=100
if [ -n "$py" ] && [ "${POWOS_RENDER_SCALE:-}" != off ]; then
  case $size in [1-9]*' '[1-9]*)
    rs=$("$py" -c "$RS_PY" "${SteamAppId:-${SteamGameId:-0}}" "$engine" "${size% *}" "${size#* }" 2>&1)
    case $rs in [1-9]*) scale=${rs%% *} ;; esac
    case $scale in *[!0-9]*|'') scale=100 ;; esac
    printf '%s\n' "$rs" | sed 's/^/unity-screen: render scale /' >&2 ;;
  esac
fi
case $size in
  [1-9]*' '[1-9]*)
    if [ "$engine" = unreal ]; then
      echo "unity-screen: Unreal window ${size% *}x${size#* } (-ResX/-ResY -windowed)" >&2
      exec "$@" -windowed "-ResX=${size% *}" "-ResY=${size#* }"
    fi
    if [ "$scale" -lt 100 ]; then
      sw=$(( ${size% *} * scale / 100 / 2 * 2 )); shh=$(( ${size#* } * scale / 100 / 2 * 2 ))
      echo "unity-screen: fullscreen ${sw}x${shh} at render scale ${scale}% (stretched to ${size% *}x${size#* })" >&2
      exec "$@" -screen-fullscreen 1 -screen-width "$sw" -screen-height "$shh"
    fi
    if [ "${POWOS_UNITY_SCREEN:-window}" = fullscreen ]; then
      echo "unity-screen: fullscreen ${size% *}x${size#* }" >&2
      exec "$@" -screen-fullscreen 1 -screen-width "${size% *}" -screen-height "${size#* }"
    fi
    echo "unity-screen: borderless window ${size% *}x${size#* } (follows its task live)" >&2
    exec "$@" -screen-fullscreen 0 -popupwindow -screen-width "${size% *}" -screen-height "${size#* }" ;;
esac
echo "unity-screen: no screen size (DISPLAY=${DISPLAY:-unset}, python=${py:-none}) - starting unchanged" >&2
exec "$@"
