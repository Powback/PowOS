#!/bin/sh
# powos-android-app <package> [title]            an Android app as a PowOS window (started on its own display)
# powos-android-app --task <task id> <package> [title]   an app that is already running on the phone's screen,
#                                                 moved into a PowOS window (powos-android-tasks, on a taskbar click)
#
# With adb to the phone itself (rooted mode: rooted/powos-deploy.sh authorizes PowOS's adb key and adbd listens on
# 127.0.0.1:5555): scrcpy gives the app its own Android virtual display and shows it in a normal Wayland window -
# KWin decorations, the taskbar (app_id android-<package> = its .desktop entry, so the right icon and grouping),
# alt-tab, resize. Touch, keyboard and mouse go back to the app. Sound stays on Android (--no-audio: the app plays
# through the phone's own audio, no second copy). Closing the window moves the app back to the phone's screen
# (--no-vd-destroy-content): it keeps running, as with any window closed on Android's desktop mode.
# Without adb (the no-root app): the app opens as a floating Android window over the desktop (android-request).
task=
[ "$1" = --task ] && { task=$2; shift 2; }
pkg=$1
title=${2:-$1}
[ -n "$pkg" ] || { echo "usage: powos-android-app [--task <id>] <package> [title]" >&2; exit 2; }
dev=127.0.0.1:5555

# One window per app: if it has one, bring that to the front instead of opening a second display (by the window's
# process: the taskbar stand-in of powos-android-tasks has the same app_id).
W=${XDG_RUNTIME_DIR:-/tmp}/android-windows
mkdir -p "$W"
if pid=$(cat "$W/$pkg.pid" 2>/dev/null) && kill -0 "$pid" 2>/dev/null; then
  js=$W/activate-$$.js
  printf 'for (const w of workspace.windowList()) if (w.pid == %s) { w.minimized = false; workspace.activeWindow = w; }\n' \
    "$pid" > "$js"
  qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.loadScript "$js" "powos-activate-$$" >/dev/null &&
    qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.start >/dev/null
  qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript "powos-activate-$$" >/dev/null
  rm -f "$js"
  exit 0
fi

if command -v scrcpy >/dev/null && command -v adb >/dev/null; then
  [ "$(adb -s $dev get-state 2>/dev/null)" = device ] || adb connect $dev >/dev/null 2>&1
  if [ "$(adb -s $dev get-state 2>/dev/null)" = device ]; then
    export SDL_VIDEODRIVER=wayland SDL_VIDEO_WAYLAND_WMCLASS="android-$pkg" SDL_APP_ID="android-$pkg"
    # Hardware decoding (VA-API through the PowOS app's termux-va -> MediaCodec), set here so it doesn't depend on
    # how this was started. Without DISPLAY, FFmpeg takes VA-API's DRM path (served by the bridge) instead of X11
    # (not served: "Failed to initialise VAAPI connection").
    if [ -S "${XDG_RUNTIME_DIR:-/run/powos-app}/termux-va.sock" ] && [ -e /usr/lib/dri/termuxva_drv_video.so ]; then
      export LIBVA_DRIVER_NAME=termuxva TERMUX_VA_BRIDGE=1 TERMUX_VA_GPU_BACKEND=kgsl \
        TERMUX_VA_SOCKET="${XDG_RUNTIME_DIR:-/run/powos-app}/termux-va.sock"
      unset DISPLAY
    fi
    # Density = the desktop's scale x 160 (Android's 1 dp = density/160 px), so an Android app is the same size as
    # PowOS's own apps.
    # HACK: a fixed-size display; resizing the window scales the picture instead of the app. scrcpy's
    # --flex-display (the display follows the window) showed an over-zoomed, half-black Chrome on the OnePlus Open
    # (scrcpy 5.0.1, 2026-10-16). Real fix: find why (scrcpy issue or our Wayland scaling), then use it.
    # Window: 3:4, 80% of the screen's height (desktop units), and the app's display exactly that many pixels at the
    # desktop's scale - sharp, and never taller than the screen (a 1440 px display opened a 1440-unit window, cut off).
    set -- $(kscreen-doctor -j 2>/dev/null | jq -r '.outputs[0] as $o | ($o.modes[] | select(.id == $o.currentModeId)
      | .size.height) as $h | "\($o.scale) \($h)"' 2>/dev/null)
    geo=$(awk -v s="${1:-1.5}" -v h="${2:-2440}" 'BEGIN {
      wh = int(h / s * 0.8); ww = int(wh * 3 / 4)
      printf "%d %d %dx%d %d", ww, wh, int(ww * s / 2) * 2, int(wh * s / 2) * 2, s * 160 }')
    set -- $geo
    set -- -s $dev --new-display="$3/$4" --window-width="$1" --window-height="$2" --no-vd-system-decorations \
      --no-vd-destroy-content --no-audio --window-title="$title"
    # A new app: started on its display. A running task: an empty display first, then Android moves the task (with
    # everything in it - a split pair too) onto it once scrcpy reports the display's id.
    [ -n "$task" ] || set -- "$@" --start-app="$pkg"
    # scrcpy's output, minus the VA-API bridge's line per decoded frame (tva-va: ...; it has no quiet switch), in a
    # small per-app log. Its pid (the window's process) for the one-window check above.
    log=$W/$pkg.log
    rm -f "$W/$pkg.pid"
    (sh -c 'echo $$ > "$0"; exec scrcpy "$@"' "$W/$pkg.pid" "$@" 2>&1 | grep --line-buffered -v '^tva-va:' > "$log") &
    for _ in $(seq 100); do
      [ -n "$task" ] && id=$(sed -n 's/.*New display: .* (id=\([0-9]*\)).*/\1/p' "$log")
      [ -n "${id:-}" ] && break
      [ -z "$task" ] && [ -s "$W/$pkg.pid" ] && break
      sleep 0.1
    done
    [ -n "${id:-}" ] && adb -s $dev shell am display move-stack "$task" "$id"
    wait
    exit
  fi
fi
[ -z "$task" ] || exit 1   # a running app can't be moved without adb
exec android-request float "$pkg"
