#!/usr/bin/env python3
"""powos-android-tasks: the phone's running Android apps in PowOS's taskbar.

Started with the desktop (/etc/xdg/autostart/powos-android-tasks.desktop). Every 2 s it reads Android's task list
(adb to the phone itself, 127.0.0.1:5555 - rooted mode; without adb it exits). Each app running on the phone's own
screen gets a taskbar entry: a small minimized stand-in window whose app_id is the app's .desktop entry
(android-<package>, written by the PowOS app), so it shows the app's icon and name. Clicking it moves the running
app - the same instance, a split-screen pair as one - into a real PowOS window (powos-android-app --task). Closing
that window puts the app back on the phone's screen, and the stand-in returns.

HACK: one small process per stand-in: Qt sets the Wayland app_id (= taskbar icon and grouping) per process, not
per window. Real fix: a native helper setting app_id per toplevel.

    powos-android-tasks                         the watcher
    powos-android-tasks --stub <task> <pkg> <title>   one stand-in (started by the watcher)
"""
import os
import re
import signal
import subprocess
import sys
import time

DEV = "127.0.0.1:5555"
SHARE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/run/powos-app"), "share")
# Not apps the user ran: PowOS itself, OnePlus's split-screen/canvas container.
IGNORE = {"com.powos.app", "com.oplus.pscanvas"}


def adb(*args, timeout=10):
    return subprocess.run(["adb", "-s", DEV, *args], capture_output=True, text=True, timeout=timeout).stdout


def all_tasks():
    """Every root task: {id: {display, type, mode, pkgs}}."""
    found, cur = {}, None
    for line in adb("shell", "am", "stack", "list").splitlines():
        m = re.match(r"RootTask id=(\d+) .*displayId=(\d+)", line)
        if m:
            cur = {"id": int(m[1]), "display": int(m[2]), "type": None, "mode": None, "pkgs": []}
            found[cur["id"]] = cur
            continue
        if cur is None:
            continue
        t = re.search(r"mActivityType=(\w+)", line)
        if t and cur["type"] is None:
            cur["type"] = t[1]
        w = re.search(r"mWindowingMode=(\w+)", line)
        if w and cur["mode"] is None:
            cur["mode"] = w[1]
        p = re.match(r"\s+taskId=\d+: ([\w.]+)/", line)
        if p and p[1] not in cur["pkgs"]:
            cur["pkgs"].append(p[1])
    return found


def phone_screen(found):
    """{root task id: [packages]} of the apps on the phone's own screen (display 0) - the taskbar entries."""
    return {
        tid: t["pkgs"]
        for tid, t in found.items()
        if t["display"] == 0 and t["type"] == "standard" and t["pkgs"] and not set(t["pkgs"]) & IGNORE
    }


WINDOWS = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "android-windows")  # powos-android-app's


def windows():
    """{display id: scrcpy pid} of the open Android-app windows (powos-android-app: <pkg>.pid, <pkg>.log)."""
    out = {}
    try:
        names = os.listdir(WINDOWS)
    except OSError:
        return out
    for name in names:
        if not name.endswith(".pid"):
            continue
        base = os.path.join(WINDOWS, name[:-4])
        try:
            with open(base + ".pid") as f:
                pid = int(f.read().strip())
            os.kill(pid, 0)
            with open(base + ".log", errors="replace") as f:
                m = re.search(r"New display: .* \(id=(\d+)\)", f.read())
        except (OSError, ValueError):
            continue
        if m:
            out[int(m[1])] = pid
    return out


def label(pkg):
    try:
        with open(os.path.join(SHARE, "applications", f"android-{pkg}.desktop")) as f:
            for line in f:
                if line.startswith("Name="):
                    return line[5:].strip()
    except OSError:
        pass
    return pkg


RUN = os.environ.get("XDG_RUNTIME_DIR", "/run/powos-app")
# The Android app in the focused PowOS window, for the PowOS app's FoldWatcher: folding the phone moves that task onto
# the cover screen (and unfolding back into its window). "<root task id> <display id>", empty when the focused window
# isn't an Android app (the cover then shows the launcher).
ACTIVE = os.path.join(RUN, "android-active")
# "1" while a PowOS (Linux) app is what's in use, else "0": folding the phone then takes the desktop onto the cover
# screen; otherwise the cover shows the launcher and the desktop keeps its size (MainActivity.onCoverScreen).
DESKTOP_ACTIVE = os.path.join(RUN, "desktop-active")
# The desktop itself and panels count as nothing in use ("").
KWIN_SCRIPT = """
function report(w) {
    var app = w && !w.desktopWindow && !w.dock && !w.specialWindow;
    callDBus("org.powos.AndroidTasks", "/", "org.powos.AndroidTasks", "Activated", app ? String(w.resourceClass) : "");
}
workspace.windowActivated.connect(report);
report(workspace.activeWindow);
"""


def watch():
    if not adb("get-state").strip() == "device":
        subprocess.run(["adb", "connect", DEV], capture_output=True)
        if not adb("get-state").strip() == "device":
            sys.exit("no adb to the phone (rooted mode only)")
    from PySide6.QtCore import ClassInfo, QCoreApplication, QObject, QTimer, Slot
    from PySide6.QtDBus import QDBusConnection

    app = QCoreApplication(sys.argv[:1])
    stubs = {}  # task id -> Popen
    moving = {}  # task id -> time its stand-in was clicked: no new stand-in while Android moves it to its window
    found = {}  # the last task list
    occupied = set()  # window displays that have held an app
    active = [""]  # resourceClass of the focused window

    def write_active():
        cls, entry = active[0], ""
        if cls.startswith("android-"):
            pkg = cls[len("android-"):]
            for tid, t in found.items():
                if t["display"] != 0 and pkg in t["pkgs"]:
                    entry = f"{tid} {t['display']}"
                    break
        with open(ACTIVE + ".tmp", "w") as f:
            f.write(entry)
        os.replace(ACTIVE + ".tmp", ACTIVE)
        with open(DESKTOP_ACTIVE + ".tmp", "w") as f:
            f.write("1" if cls and not cls.startswith("android-") else "0")
        os.replace(DESKTOP_ACTIVE + ".tmp", DESKTOP_ACTIVE)

    # A non-Android window (the desktop, a Linux app) only replaces the Android app as "what's in use" once it kept
    # the focus for a while: a touch on the desktop while folding the phone shut must not swap what the cover shows.
    settle = QTimer()
    settle.setSingleShot(True)
    pending = [""]

    def settled():
        active[0] = pending[0]
        write_active()

    settle.timeout.connect(settled)

    @ClassInfo({"D-Bus Interface": "org.powos.AndroidTasks"})
    class Service(QObject):
        @Slot(str)
        def Activated(self, cls):  # noqa: N802 - D-Bus method name
            if cls.startswith("android-"):
                settle.stop()
                active[0] = cls
                write_active()
            else:
                pending[0] = cls
                settle.start(10_000)

    def refresh():
        nonlocal found
        try:
            found = all_tasks()
        except Exception as e:  # adb hiccup: keep the stand-ins, try again
            print("tasks:", e, file=sys.stderr)
            return
        # A window whose app left its display (opened from the phone's side - its taskbar, recents, a link - or closed
        # there) would stay an empty frame: it closes, and the app's taskbar entry comes back below. Only a display
        # that has held an app: a new window's display is empty until its app is started or moved onto it.
        used = {t["display"] for t in found.values() if t["pkgs"]}
        for disp, pid in windows().items():
            if disp in used:
                occupied.add(disp)
            elif disp in occupied:
                occupied.discard(disp)
                print(f"window on display {disp}: its app left, closing", file=sys.stderr, flush=True)
                try:
                    os.kill(pid, signal.SIGTERM)
                except OSError:
                    pass
        now = phone_screen(found)
        for tid in list(stubs):
            if stubs[tid].poll() is not None:  # exits only when clicked
                moving[tid] = time.monotonic()
                del stubs[tid]
            elif tid not in now:
                stubs[tid].terminate()
                del stubs[tid]
        for tid in [t for t, at in moving.items() if time.monotonic() - at > 15]:
            del moving[tid]
        for tid, pkgs in now.items():
            if tid not in stubs and tid not in moving:
                title = " | ".join(label(p) for p in pkgs)
                stubs[tid] = subprocess.Popen([sys.argv[0], "--stub", str(tid), pkgs[0], title])
        write_active()  # the focused app's task may have moved (opened, closed, adopted)

    bus = QDBusConnection.sessionBus()
    service = Service()
    if not bus.registerService("org.powos.AndroidTasks"):
        sys.exit("already running")
    bus.registerObject("/", service, QDBusConnection.ExportAllSlots)
    # KWin reports every focus change to us (a KWin script can't write files; it can call D-Bus).
    script = os.path.join(RUN, "powos-android-active.js")
    with open(script, "w") as f:
        f.write(KWIN_SCRIPT)
    kwin = ["qdbus6", "org.kde.KWin", "/Scripting"]
    subprocess.run(kwin + ["org.kde.kwin.Scripting.unloadScript", "powos-android-active"], capture_output=True)
    subprocess.run(kwin + ["org.kde.kwin.Scripting.loadScript", script, "powos-android-active"], capture_output=True)
    subprocess.run(kwin + ["org.kde.kwin.Scripting.start"], capture_output=True)

    timer = QTimer()
    timer.timeout.connect(refresh)
    timer.start(2000)
    refresh()
    signal.signal(signal.SIGTERM, lambda *_: app.quit())
    signal.signal(signal.SIGINT, lambda *_: app.quit())
    try:
        app.exec()
    finally:
        for p in stubs.values():
            p.terminate()


def stub(task, pkg, title):
    from PySide6.QtCore import QRect, Qt
    from PySide6.QtGui import QColor, QGuiApplication, QIcon, QPainter, QRasterWindow

    class Stub(QRasterWindow):
        def paintEvent(self, _):
            QPainter(self).fillRect(QRect(0, 0, self.width(), self.height()), QColor(0x20, 0x20, 0x20))

    app = QGuiApplication(sys.argv[:1])
    app.setDesktopFileName(f"android-{pkg}")  # the Wayland app_id: the taskbar's icon and grouping
    icon = os.path.join(SHARE, "icons/hicolor/192x192/apps", f"android-{pkg}.png")
    if os.path.exists(icon):
        app.setWindowIcon(QIcon(icon))
    w = Stub()
    w.setTitle(title)
    w.resize(320, 200)
    done = []

    def clicked(*why):
        # Clicked in the taskbar (KWin restores and activates the minimized stand-in): the running app into a
        # PowOS window; this stand-in's job is done.
        print(f"stub {pkg}: {why} active={w.isActive()} state={w.windowStates()}", file=sys.stderr, flush=True)
        if done or Qt.WindowMinimized in w.windowStates() or not (w.isActive() or w.isExposed()):
            return
        done.append(1)
        subprocess.Popen(["powos-android-app", "--task", task, pkg, title], start_new_session=True)
        w.hide()
        app.quit()

    w.activeChanged.connect(lambda: clicked("active"))
    w.windowStateChanged.connect(lambda s: clicked("state", s))
    w.showMinimized()
    app.exec()


if __name__ == "__main__":
    if len(sys.argv) >= 5 and sys.argv[1] == "--stub":
        stub(*sys.argv[2:5])
    else:
        watch()
