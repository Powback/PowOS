#!/usr/bin/env python3
# PowOS's copy of Andromarchy's native/android-nm.py (installed over it: install-powos-android.sh, rooted/powos-deploy.sh),
# with the D-Bus ObjectManager libnm needs (below). Unit android-bridge (units/phone/android-bridge.json).
# /usr/local/bin/android-nm: org.freedesktop.NetworkManager on the session's system bus, fed by Android. Apps cannot
# see the network interfaces, so the app (SessionService) writes the active network to $XDG_RUNTIME_DIR/network:
#   "wifi <strength 0-100> <ssid...>" | "wired" | "none"
# and this serves the minimum Quickshell's Networking (Omarchy's bar and network panel) reads: one Wi-Fi device with
# its access point, saved connection and active connection, and one wired device (mobile data, USB, Ethernet: Quickshell
# knows no other kind). Read-only: connecting to another network is done in Android.
# libnm (NMClient, every GLib client: Steam's network controller, nmcli) reads NetworkManager ONLY through the D-Bus
# ObjectManager at /org/freedesktop (GetManagedObjects + InterfacesAdded/Removed) and the Devices properties: without
# them it saw "NetworkManager not running", no device, state unknown - and Steam's login waited 10-20 s for a network
# at every start ("Timed out waiting for network", steamui_login.txt, 213 of 222 logins until 2026-10-23).
# Steam's network device manager (steamclient.so, CNetworkDeviceManagerLinux) then opens every NM device with libudev
# from its Udi as a SYSFS path and drops the device when that fails ("Init: failed to open udev_device for wlan0
# (sysfs path: /org/freedesktop/NetworkManager/Devices/1)", console_log.txt), and takes the device's address from its
# IP4Config: with D-Bus paths as Udi and no IP4Config it saw no device up, so the login still waited 10 s. So each
# device is the REAL interface (its sysfs path as Udi, its MAC) with a real IP4Config (address, gateway, DNS), as
# NetworkManager serves it; where the interfaces can't be read (the app's unprivileged session), the old values stay.
import os
import re
import socket
import struct
import subprocess
import uuid
import warnings

import gi

warnings.simplefilter("ignore", DeprecationWarning)  # Gio.DBusConnection.register_object: still the simplest form
gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

FILE = os.path.join(os.environ["XDG_RUNTIME_DIR"], "network")
NM = "/org/freedesktop/NetworkManager"
WIFI, WIRED = NM + "/Devices/1", NM + "/Devices/2"
P = "org.freedesktop.NetworkManager"
OM = "/org/freedesktop"  # libnm's ObjectManager root

XML = f"""<node>
 <interface name="{P}">
  <method name="GetDevices"><arg type="ao" direction="out"/></method>
  <method name="GetAllDevices"><arg type="ao" direction="out"/></method>
  <method name="CheckConnectivity"><arg type="u" direction="out"/></method>
  <signal name="DeviceAdded"><arg type="o"/></signal>
  <signal name="DeviceRemoved"><arg type="o"/></signal>
  <signal name="StateChanged"><arg type="u"/></signal>
  <property name="WirelessEnabled" type="b" access="readwrite"/>
  <property name="WirelessHardwareEnabled" type="b" access="read"/>
  <property name="Connectivity" type="u" access="read"/>
  <property name="ConnectivityCheckAvailable" type="b" access="read"/>
  <property name="ConnectivityCheckEnabled" type="b" access="readwrite"/>
  <property name="State" type="u" access="read"/>
  <property name="PrimaryConnection" type="o" access="read"/>
  <property name="ActiveConnections" type="ao" access="read"/>
  <property name="NetworkingEnabled" type="b" access="read"/>
  <property name="Version" type="s" access="read"/>
  <property name="Devices" type="ao" access="read"/>
  <property name="AllDevices" type="ao" access="read"/>
  <property name="Checkpoints" type="ao" access="read"/>
  <property name="Capabilities" type="au" access="read"/>
