#!/bin/bash
# powos-app-quit <pid>: ends the app process <pid> belongs to - the second half of closing an app from the switcher.
# KWin runs it (kwin 0042, "quit"): the user swiped a Linux window's card away (or the frame's close), KWin closed the
# window (WM_DELETE_WINDOW / xdg close) and the process was still there 3 s later. KWin already checked it has no other
# window of its own and isn't asking anything (a modal dialog).
#
# What goes:
#   - a Steam game (the pid is under Steam's reaper `SteamLaunch AppId=<id>`, or its environment says SteamAppId /
#     SteamGameId / STEAM_COMPAT_APP_ID): the game's whole launch chain for that AppId - reaper, pressure-vessel,
#     wine/wineserver and children, the FEX-run processes - through `powos game <id> stop` (lib/game.sh: TERM, KILL
#     after 2 s, a sweep for what a launcher started meanwhile); whatever that leaves (it failed, no powos), this
#     script ends itself: the tree of the launch's outermost `SteamLaunch AppId=<id>` process. Steam's client stays.
#   - anything else (Dolphin, a Wine app): the process and its descendants - TERM, KILL whatever is left after 2 s.
# Never: Steam's client (and its web helpers / launcher), FEXServer (every FEX process shares it), the PowOS session,
# KWin, Xwayland, Plasma, the buses, audio - nor another user's process, nor this script's own ancestors. A protected
# pid KWin hands over is refused as a whole (Steam's own window closed: Steam stays in its tray).
# Logs one line per step to stderr (KWin's log) and $XDG_RUNTIME_DIR/powos-app-quit.log.
#   POWOS_APP_QUIT_DRY=1 powos-app-quit <pid>   prints what it would end, ends nothing.
set -u
pid=${1:-}
LOG=${XDG_RUNTIME_DIR:-/tmp}/powos-app-quit.log
DRY=${POWOS_APP_QUIT_DRY:-0}
log() { local l; l="$(date '+%F %T') powos-app-quit $pid: $*"; echo "$l" >&2; echo "$l" >> "$LOG" 2>/dev/null; }

# Process names (comm, or a program's basename in argv - FEX-run ones show as FEXInterpreter <program>) never ended.
PROTECT=" steam steam.sh steamwebhelper steam-runtime-steam-remote steam-runtime-launcher-interface-0 FEXServer
 kwin_wayland kwin_wayland_wrapper kwin_wayland_wr kwin_x11 Xwayland plasmashell ksmserver kded6 startplasma-wayland
 startplasma-way plasma_session dbus-daemon dbus-broker dbus-broker-launch dbus-broker-lau pipewire pipewire-pulse
 wireplumber xdg-desktop-portal xdg-desktop-por xdg-desktop-portal-kde kglobalacceld polkit-kde-authentication-agent-1
 powos-rooted-session powos-rooted-se powos-shell powos-supervisor powos-supervis powos-sleepd powos-sleep-gui
 powos-padd powos-focus-watch powos-focus-wat powos-android-tasks powos-android-t powos-steam-resident
 powos-steam-res powos-app-quit systemd init sshd tmux su sudo magiskd "

comm_of() { cat "/proc/$1/comm" 2>/dev/null; }
argv() { tr '\0' '\n' < "/proc/$1/cmdline" 2>/dev/null; }
# The names a process goes by: comm, argv[0]'s basename and - for a FEX-run program - argv[1]'s.
names() {
  local a0 a1
  comm_of "$1"
  { read -r a0; read -r a1; } < <(argv "$1")
  echo "${a0##*/}"
  case "${a0##*/}" in FEXInterpreter|FEXLoader|FEXInterpreter.*) echo "${a1##*/}" ;; esac
}
protected() {
  local n s
  s=$(cat "$HOME/.steam/steam.pid" 2>/dev/null)
  [[ "$1" == "$s" ]] && return 0
  [[ "$(stat -c %u "/proc/$1" 2>/dev/null)" == "$(id -u)" ]] || return 0
  [[ " $self " == *" $1 "* ]] && return 0
  while read -r n; do [[ -n "$n" && "$PROTECT" == *" $n "* ]] && return 0; done < <(names "$1")
  return 1
}
ppid_of() { awk '{print $4}' "/proc/$1/stat" 2>/dev/null | head -1; }
# This script and its ancestors (KWin) - never ours to end.
self=" "; a=$$; while [[ -n "$a" && "$a" -gt 1 ]]; do self+="$a "; a=$(ppid_of "$a"); done

[[ "$pid" =~ ^[0-9]+$ && "$pid" -gt 1 ]] || { log "usage: powos-app-quit <pid>"; exit 2; }
[[ -d /proc/$pid ]] || { log "gone already"; exit 0; }
if protected "$pid"; then
  log "$(comm_of "$pid") is protected (Steam, the session, KWin, Xwayland, another user's, or our own): nothing ended"
  exit 0
fi

# A Steam game? Its reaper above it (not the install-script evaluator, `SteamLaunch AppId=<id> Install=1`), else its
# environment.
# root: the outermost process of that launch (Steam's pw-audio-namespace / reaper carry the same `SteamLaunch AppId=`
# argv) - a Proton game's window pid (AbzuGame-Win64-Shipping.exe) is a sibling of its wineserver, winedevice.exe and
# launcher exe under pressure-vessel, not their parent: its own tree alone leaves the game running.
app= root=$pid
a=$pid
while [[ -n "$a" && "$a" -gt 1 ]]; do
  c=$(argv "$a" | tr '\n' ' ')
  if [[ "$c" =~ SteamLaunch\ AppId=([0-9]+)\ -- ]] && [[ -z "$app" || "$app" == "${BASH_REMATCH[1]}" ]] \
      && ! protected "$a"; then
    app=${BASH_REMATCH[1]} root=$a
  fi
  a=$(ppid_of "$a")
done
if [[ -z "$app" ]]; then
  app=$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null \
    | sed -n 's/^\(SteamAppId\|SteamGameId\|STEAM_COMPAT_APP_ID\)=\([1-9][0-9]*\)$/\2/p' | head -1)
fi

if [[ -n "$app" ]]; then
  log "$(comm_of "$pid") is Steam game $app's: ending its launch chain (powos game $app stop; Steam stays)"
  [[ "$DRY" == 1 ]] && { log "dry run: nothing ended"; exit 0; }
  if command -v powos >/dev/null; then
    timeout 20 powos game "$app" stop 2>&1 | while read -r l; do log "powos game: $l"; done
    log "game $app: done (exit ${PIPESTATUS[0]})"
  else
    log "no powos command"
  fi
  # Whatever `powos game stop` left (it failed, timed out, resolved no installed game, or there is no powos): the
  # launch chain from its root, here - a swipe ends the game, always.
  [[ -d /proc/$root || -d /proc/$pid ]] || exit 0
  log "game $app still runs: ending its launch chain from $root:$(comm_of "$root")"
fi

# The process (a Steam game: its launch chain's root) and its descendants (one ps call), minus anything protected (a
# terminal's Steam). A root gone meanwhile: the window's own process.
[[ -d /proc/$root ]] || root=$pid
tree=$(ps -e -o pid=,ppid= 2>/dev/null | awk -v r="$root" '{c[$2] = c[$2] " " $1}
  END {n = 1; q[1] = r; for (i = 1; i <= n; i++) {p = q[i]; if (s[p]++) continue; print p
       m = split(c[p], k, " "); for (j = 1; j <= m; j++) q[++n] = k[j]}}')
go=() kept=()
for p in $tree; do if protected "$p"; then kept+=("$p:$(comm_of "$p")"); else go+=("$p"); fi; done
log "ending $(for p in "${go[@]}"; do printf '%s:%s ' "$p" "$(comm_of "$p")"; done)${kept[*]:+(kept: ${kept[*]})}"
[[ ${#go[@]} == 0 ]] && { log "nothing of its own to end"; exit 0; }
[[ "$DRY" == 1 ]] && { log "dry run: nothing ended"; exit 0; }
# A frozen app (unified sleep) answers no TERM: thawed first (SIGKILL ends frozen tasks anyway).
timeout 2 dbus-send --session --print-reply=literal --reply-timeout=1500 --dest=dev.powos.Sleep /Gui \
  dev.powos.Sleep.Gui.Wake "string:$pid" >/dev/null 2>&1 || true
kill -TERM "${go[@]}" 2>/dev/null
for _ in $(seq 20); do
  left=(); for p in "${go[@]}"; do [[ -d /proc/$p ]] && left+=("$p"); done
  [[ ${#left[@]} == 0 ]] && { log "ended on TERM"; exit 0; }
  sleep 0.1
done
log "KILL after 2 s: ${left[*]}"
kill -KILL "${left[@]}" 2>/dev/null
sleep 0.3
left=(); for p in "${go[@]}"; do [[ -d /proc/$p ]] && left+=("$p"); done
[[ ${#left[@]} == 0 ]] && log "ended" || log "still there: ${left[*]}"
