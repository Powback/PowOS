#!/bin/bash
# powos-app-quit <pid>: ends the app process <pid> belongs to - the second half of closing an app from the switcher.
# KWin runs it (kwin 0042, "quit"): the user swiped a Linux window's card away (or the frame's close), KWin closed the
# window (WM_DELETE_WINDOW / xdg close) and the process was still there 3 s later. KWin already checked it has no other
# window of its own and isn't asking anything (a modal dialog).
#
# What goes:
#   - a Steam game (the pid is under Steam's reaper `SteamLaunch AppId=<id>`, or its environment says SteamAppId /
#     SteamGameId / STEAM_COMPAT_APP_ID): the game's whole launch chain for that AppId - reaper, pressure-vessel,
#     wine/wineserver and children, the FEX-run processes - through `powos game <id> stop` (lib/game.sh: TERM, KILL
#     after 2 s, a sweep for what a launcher started meanwhile); whatever that leaves (it failed, no powos), this
#     script ends itself: the tree of the launch's outermost `SteamLaunch AppId=<id>` process. Steam's client stays.
#   - anything else (Dolphin, a Wine app): the process and its descendants - TERM, KILL whatever is left after 2 s.
#   - Steam itself (the pid is Steam's client or one of its helpers - Steam's windows are steamwebhelper's - or
#     `powos-app-quit --steam`, the app menu's close): Steam quits, as an app swiped away on stock Android does (the
#     user, 11-26: "steam is always running even when i try to stop it from the switcher" - its window's close only
#     put it in its tray). In order: the user-closed mark (~/.local/state/powos/user-closed/steam: /usr/bin/steam and
#     powos-steam-resident start no background Steam while it is there; the user's next start of Steam or a game clears
#     it), each running game's launch chain (`powos game <id> stop`: games close with Steam), Steam thawed and asked
#     `steam -shutdown` (its wrapper), up to POWOS_STEAM_QUIT_WAIT (15) s for it to exit, then TERM - KILL after 2 s -
#     of what is left of its process group and its tree.
# Never: FEXServer (every FEX process shares it), the PowOS session, KWin, Xwayland, Plasma, the buses, audio - nor
# another user's process, nor this script's own ancestors; Steam's client only through the Steam quit above. Any
# other protected pid KWin hands over is refused as a whole.
# Logs one line per step to stderr (KWin's log) and $XDG_RUNTIME_DIR/powos-app-quit.log.
#   POWOS_APP_QUIT_DRY=1 powos-app-quit <pid>   prints what it would end, ends nothing.
set -u
pid=${1:-}
LOG=${XDG_RUNTIME_DIR:-/tmp}/powos-app-quit.log
DRY=${POWOS_APP_QUIT_DRY:-0}
log() { local l; l="$(date '+%F %T') powos-app-quit $pid: $*"; echo "$l" >&2; echo "$l" >> "$LOG" 2>/dev/null; }

# Process names (comm, or a program's basename in argv - FEX-run ones show as FEXInterpreter <program>) never ended.
PROTECT=" steam steam.sh steamwebhelper steam-runtime-steam-remote steam-runtime-launcher-interface-0 FEXServer
 kwin_wayland kwin_wayland_wrapper kwin_wayland_wr kwin_x11 Xwayland plasmashell ksmserver kded6 startplasma-wayland
 startplasma-way plasma_session dbus-daemon dbus-broker dbus-broker-launch dbus-broker-lau pipewire pipewire-pulse
 wireplumber xdg-desktop-portal xdg-desktop-por xdg-desktop-portal-kde kglobalacceld polkit-kde-authentication-agent-1
 powos-rooted-session powos-rooted-se powos-shell powos-supervisor powos-supervis powos-sleepd powos-sleep-gui
 powos-padd powos-focus-watch powos-focus-wat powos-android-tasks powos-android-t powos-steam-resident
 powos-steam-res powos-app-quit systemd init sshd tmux su sudo magiskd "

comm_of() { cat "/proc/$1/comm" 2>/dev/null; }
argv() { tr '\0' '\n' < "/proc/$1/cmdline" 2>/dev/null; }
# The names a process goes by: comm, argv[0]'s basename and - for a FEX-run program - argv[1]'s.
names() {
  local a0 a1
  comm_of "$1"
  { read -r a0; read -r a1; } < <(argv "$1")
  echo "${a0##*/}"
  case "${a0##*/}" in FEXInterpreter|FEXLoader|FEXInterpreter.*) echo "${a1##*/}" ;; esac
}
protected() {
  local n s
  s=$(cat "$HOME/.steam/steam.pid" 2>/dev/null)
  [[ "$1" == "$s" ]] && return 0
  [[ "$(stat -c %u "/proc/$1" 2>/dev/null)" == "$(id -u)" ]] || return 0
  [[ " $self " == *" $1 "* ]] && return 0
  while read -r n; do [[ -n "$n" && "$PROTECT" == *" $n "* ]] && return 0; done < <(names "$1")
  return 1
}
ppid_of() { awk '{print $4}' "/proc/$1/stat" 2>/dev/null | head -1; }
# This script and its ancestors (KWin) - never ours to end.
self=" "; a=$$; while [[ -n "$a" && "$a" -gt 1 ]]; do self+="$a "; a=$(ppid_of "$a"); done

# Steam's own processes: its client, its wrapper/launcher scripts, its web UI (whose windows Steam's are).
STEAM_NAMES=" steam steam.sh bin_steam.sh steamwebhelper steam-runtime-steam-remote steam-runtime-launcher-interface-0 "
steam_client() { local s; s=$(cat "$HOME/.steam/steam.pid" 2>/dev/null)
  [[ "$s" =~ ^[0-9]+$ && -d /proc/$s ]] && [[ "$(stat -c %u "/proc/$s" 2>/dev/null)" == "$(id -u)" ]] && echo "$s"; }
is_steam() {
  local n
  [[ "$1" == "$(steam_client)" ]] && return 0
  [[ "$(stat -c %u "/proc/$1" 2>/dev/null)" == "$(id -u)" ]] || return 1
  while read -r n; do [[ -n "$n" && "$STEAM_NAMES" == *" $n "* ]] && return 0; done < <(names "$1")
  return 1
}
# hard_protected <pid>: never ended, not even by a Steam quit - protected for anything but being Steam's.
hard_protected() {
  local n
  [[ "$(stat -c %u "/proc/$1" 2>/dev/null)" == "$(id -u)" ]] || return 0
  [[ " $self " == *" $1 "* ]] && return 0
  while read -r n; do
    [[ -n "$n" && "$PROTECT" == *" $n "* && "$STEAM_NAMES" != *" $n "* ]] && return 0
  done < <(names "$1")
  return 1
}
# tree_of <pid>: it and its descendants (one ps call).
tree_of() { ps -e -o pid=,ppid= 2>/dev/null | awk -v r="$1" '{c[$2] = c[$2] " " $1}
  END {n = 1; q[1] = r; for (i = 1; i <= n; i++) {p = q[i]; if (s[p]++) continue; print p
       m = split(c[p], k, " "); for (j = 1; j <= m; j++) q[++n] = k[j]}}'; }
alive() { [[ -d /proc/$1 ]] && ! grep -q '^State:.*Z' "/proc/$1/status" 2>/dev/null; }

# steam_quit: Steam quits and stays quit until the user opens it again (the header).
steam_quit() {
  local s mark ids id rc i go=() kept=() left=() p pg
  mark=${XDG_STATE_HOME:-$HOME/.local/state}/powos/user-closed/steam
  s=$(steam_client)
  [[ -n "$s" ]] || s=$pid
  log "Steam closed by the user: quitting Steam (client ${s:-none}), its games too; marked closed until the user opens it"
  [[ "$DRY" == 1 ]] && { log "dry run: nothing ended, no mark"; exit 0; }
  mkdir -p "${mark%/*}" && date '+%F %T' > "$mark"
  # Its games first, each through the games tooling's own close (wineserver too, Steam's cloud sync awaited).
  ids=$(ps -u "$(id -u)" -o args= 2>/dev/null | sed -n 's/.*SteamLaunch AppId=\([0-9][0-9]*\) --.*/\1/p' | sort -u)
  for id in $ids; do
    if command -v powos >/dev/null; then
      timeout 35 powos game "$id" stop 2>&1 | while read -r l; do log "powos game $id: $l"; done
      rc=${PIPESTATUS[0]}; log "game $id: closed (exit $rc)"
    fi
  done
  [[ -n "$s" && -d /proc/$s ]] || { log "Steam isn't running"; exit 0; }
  # Thawed (a frozen client answers nothing), then asked through its wrapper (bounded: the forwarder can hang on a
  # dying client).
  timeout 2 dbus-send --session --print-reply=literal --reply-timeout=1500 --dest=dev.powos.Sleep /Gui \
    dev.powos.Sleep.Gui.Wake string:steam >/dev/null 2>&1 || true
  pg=$(ps -o pgid= -p "$s" 2>/dev/null | tr -d ' ')
  timeout -k 1 10 steam -shutdown </dev/null >/dev/null 2>&1 || log "steam -shutdown: exit $?"
  for (( i = 0; i < ${POWOS_STEAM_QUIT_WAIT:-15} * 10; i++ )); do
    alive "$s" || break
    sleep 0.1
  done
  alive "$s" && log "Steam still runs ${POWOS_STEAM_QUIT_WAIT:-15} s after -shutdown: ending it" || log "Steam shut down"
  # What is left: its tree, and its process group's Steam processes (a helper re-parented out of the tree; a group it
  # may share with a launcher shell gives only those - never another app started from the same shell).
  local cand
  cand=$(tree_of "$s")
  if [[ -n "$pg" && "$pg" -gt 1 ]]; then
    for p in $(ps -e -o pid=,pgid= 2>/dev/null | awk -v g="$pg" '$2 == g {print $1}'); do
      is_steam "$p" && cand="$cand $p"
    done
  fi
  for p in $(echo $cand | tr ' ' '\n' | sort -un); do
    alive "$p" || continue
    if hard_protected "$p"; then kept+=("$p:$(comm_of "$p")"); else go+=("$p"); fi
  done
  [[ ${#go[@]} == 0 ]] && { log "nothing of Steam's left${kept[*]:+ (kept: ${kept[*]})}"; exit 0; }
  log "TERM $(for p in "${go[@]}"; do printf '%s:%s ' "$p" "$(comm_of "$p")"; done)${kept[*]:+(kept: ${kept[*]})}"
  kill -TERM "${go[@]}" 2>/dev/null
  for _ in $(seq 20); do
    left=(); for p in "${go[@]}"; do alive "$p" && left+=("$p"); done
    [[ ${#left[@]} == 0 ]] && { log "Steam ended on TERM"; exit 0; }
    sleep 0.1
  done
  log "KILL after 2 s: ${left[*]}"
  kill -KILL "${left[@]}" 2>/dev/null
  exit 0
}

[[ "$pid" == --steam ]] && { pid=$(steam_client); pid=${pid:-0}; steam_quit; }
[[ "$pid" =~ ^[0-9]+$ && "$pid" -gt 1 ]] || { log "usage: powos-app-quit <pid> | --steam"; exit 2; }
[[ -d /proc/$pid ]] || { log "gone already"; exit 0; }
is_steam "$pid" && steam_quit
if protected "$pid"; then
  log "$(comm_of "$pid") is protected (the session, KWin, Xwayland, FEXServer, another user's, or our own): nothing ended"
  exit 0
fi

# A Steam game? Its reaper above it (not the install-script evaluator, `SteamLaunch AppId=<id> Install=1`), else its
# environment.
# root: the outermost process of that launch (Steam's pw-audio-namespace / reaper carry the same `SteamLaunch AppId=`
# argv) - a Proton game's window pid (AbzuGame-Win64-Shipping.exe) is a sibling of its wineserver, winedevice.exe and
# launcher exe under pressure-vessel, not their parent: its own tree alone leaves the game running.
app= root=$pid
a=$pid
while [[ -n "$a" && "$a" -gt 1 ]]; do
  c=$(argv "$a" | tr '\n' ' ')
  if [[ "$c" =~ SteamLaunch\ AppId=([0-9]+)\ -- ]] && [[ -z "$app" || "$app" == "${BASH_REMATCH[1]}" ]] \
      && ! protected "$a"; then
    app=${BASH_REMATCH[1]} root=$a
  fi
  a=$(ppid_of "$a")
done
if [[ -z "$app" ]]; then
  app=$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null \
    | sed -n 's/^\(SteamAppId\|SteamGameId\|STEAM_COMPAT_APP_ID\)=\([1-9][0-9]*\)$/\2/p' | head -1)
fi

if [[ -n "$app" ]]; then
  log "$(comm_of "$pid") is Steam game $app's: ending its launch chain (powos game $app stop; Steam stays)"
  [[ "$DRY" == 1 ]] && { log "dry run: nothing ended"; exit 0; }
  if command -v powos >/dev/null; then
    timeout 35 powos game "$app" stop 2>&1 | while read -r l; do log "powos game: $l"; done
    rc=${PIPESTATUS[0]}; log "game $app: done (exit $rc)"
    # 4: Steam's cloud sync of the game still runs (lib/game.sh _game_steam_close) - left for Steam to finish; killing
    # it mid-sync leaves a sync-conflict question that holds every later launch of the game.
    [[ $rc == 4 ]] && exit 0
  else
    log "no powos command"
  fi
  # Whatever `powos game stop` left (it failed, timed out, resolved no installed game, or there is no powos): the
  # launch chain from its root, here - a swipe ends the game, always.
  [[ -d /proc/$root || -d /proc/$pid ]] || exit 0
  log "game $app still runs: ending its launch chain from $root:$(comm_of "$root")"
fi

# The process (a Steam game: its launch chain's root) and its descendants (one ps call), minus anything protected (a
# terminal's Steam). A root gone meanwhile: the window's own process.
[[ -d /proc/$root ]] || root=$pid
tree=$(ps -e -o pid=,ppid= 2>/dev/null | awk -v r="$root" '{c[$2] = c[$2] " " $1}
  END {n = 1; q[1] = r; for (i = 1; i <= n; i++) {p = q[i]; if (s[p]++) continue; print p
       m = split(c[p], k, " "); for (j = 1; j <= m; j++) q[++n] = k[j]}}')
go=() kept=()
for p in $tree; do if protected "$p"; then kept+=("$p:$(comm_of "$p")"); else go+=("$p"); fi; done
log "ending $(for p in "${go[@]}"; do printf '%s:%s ' "$p" "$(comm_of "$p")"; done)${kept[*]:+(kept: ${kept[*]})}"
[[ ${#go[@]} == 0 ]] && { log "nothing of its own to end"; exit 0; }
[[ "$DRY" == 1 ]] && { log "dry run: nothing ended"; exit 0; }
# A frozen app (unified sleep) answers no TERM: thawed first (SIGKILL ends frozen tasks anyway).
timeout 2 dbus-send --session --print-reply=literal --reply-timeout=1500 --dest=dev.powos.Sleep /Gui \
  dev.powos.Sleep.Gui.Wake "string:$pid" >/dev/null 2>&1 || true
# alive <pid>: still a process - a zombie has ended (only its parent's wait is missing), it isn't "still there".
alive() { [[ -d /proc/$1 ]] && ! grep -q '^State:.*Z' "/proc/$1/status" 2>/dev/null; }
# why <pid>: what a process that outlived its signals is doing, for the log - every "ending" since 10-31 (90 of them:
# foot, kate, dolphin, konsole) ended "still there" after the KILL, and kill's errors went to /dev/null. Its state,
# parent, ids, capabilities, wait channel, signals and cgroup, and whether this script may read it at all (KWin's
# child got "environ: Permission denied" on the same pids).
why() { local s; s=$(grep -E '^(State|PPid|Uid|Gid|CapPrm|SigPnd|ShdPnd|SigBlk|SigIgn)' "/proc/$1/status" 2>&1 | tr -s '\t\n' '  ')
  echo "$1 [$s wchan=$(cat "/proc/$1/wchan" 2>&1) cgroup=$(sed -n 's/^0:://p' "/proc/$1/cgroup" 2>&1) environ=$(head -c1 "/proc/$1/environ" >/dev/null 2>&1 && echo readable || echo denied)]"; }
e=$(kill -TERM "${go[@]}" 2>&1) || log "TERM: kill said: $e (we are $(id))"
for _ in $(seq 20); do
  left=(); for p in "${go[@]}"; do alive "$p" && left+=("$p"); done
  [[ ${#left[@]} == 0 ]] && { log "ended on TERM"; exit 0; }
  sleep 0.1
done
log "KILL after 2 s: ${left[*]}"
e=$(kill -KILL "${left[@]}" 2>&1) || log "KILL: kill said: $e (we are $(id))"
for _ in $(seq 10); do
  sleep 0.2
  left2=(); for p in "${left[@]}"; do alive "$p" && left2+=("$p"); done
  [[ ${#left2[@]} == 0 ]] && { log "ended"; exit 0; }
done
log "still there 2 s after the KILL (we are $(id)): $(for p in "${left2[@]}"; do why "$p"; done)"
