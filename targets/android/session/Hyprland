#!/bin/bash
# /usr/bin/Hyprland in the PowOS Android rootfs: starts KDE Plasma (KWin on the Anland backend).
#
# HACK: this file is named Hyprland only because Andromarchy's app hardcodes the session command
# (SessionService.java: `exec /usr/bin/Hyprland`). There is no Hyprland in this rootfs. Real fix:
# the app reads the session command from the rootfs (planned upstream PR to Andromarchy, or our own
# PowOS-branded app), then this becomes /usr/bin/powos-android-session.
#
# Environment from the app (SessionService.archEnv): XDG_RUNTIME_DIR, DBUS_SESSION_BUS_ADDRESS,
# DBUS_SYSTEM_BUS_ADDRESS, ANDROMARCHY_SOCKET (display daemon), ANDROMARCHY_PHYSICAL_MM, LANG, TZ.
# The GPU variables (KGSL Mesa) are set for every process by the engine's arch-native.sh.
set -u

# KWin picks its Anland backend whenever ANLAND_SOCKET is set (patched main_wayland.cpp). Same daemon,
# same wire protocol as Andromarchy's (protocol.h structs identical; checked 2026-10-13).
export ANLAND_SOCKET="$ANDROMARCHY_SOCKET"
# No /dev/dri on Android: KWin must not try to open a DRM render node (patch 0002).
export ANLAND_NO_DRM_DEVICE=1
export EGL_PLATFORM=surfaceless
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=KDE XDG_SESSION_DESKTOP=KDE
export KDE_FULL_SESSION=true
# PowOS knows it is the phone build (the powos CLI gates boot/bootc/systemd commands on this).
export POWOS_PLATFORM=phone

# No Adreno (the Android emulator, or a non-Snapdragon device): the engine's arch-native.sh points
# every process at the KGSL Mesa driver, which can't load without /dev/kgsl-3d0. Fall back to Mesa's
# llvmpipe (CPU rendering) for KWin and everything the session starts. Slow, but it draws.
if [ ! -e /dev/kgsl-3d0 ]; then
  unset MESA_LOADER_DRIVER_OVERRIDE TURNIP_KMD FD_FORCE_KGSL XWAYLAND_FORCE_KGSL_SURFACELESS
  export GALLIUM_DRIVER=llvmpipe LIBGL_ALWAYS_SOFTWARE=1 POWOS_GPU=software
  echo "powos-session: no /dev/kgsl-3d0, using llvmpipe (software rendering)" >&2
fi
# HACK: freedreno's UBWC (compressed textures) on KGSL left Plasma's SVG textures (panel, widgets, theme previews)
# as noise blocks (OnePlus Open, Adreno 740, Mesa 26.3). Real fix: find and report the UBWC bug in Mesa's KGSL path.
export FD_MESA_DEBUG=${FD_MESA_DEBUG:-noubwc}

# HACK: the app ends its splash screen only when it sees Omarchy's shell process (`quickshell`/`qs`);
# otherwise it waits out a 2-minute timeout. Tell it directly once plasmashell is up. Real fix: the
# app waits for $XDG_RUNTIME_DIR/desktop-ready alone (same planned app change as above).
(
  for _ in $(seq 600); do pgrep -x plasmashell >/dev/null && break; sleep 0.2; done
  sleep 1
  touch "$XDG_RUNTIME_DIR/desktop-ready"
) &

# Initial output scale from the display's density, FIRST START ONLY: Anland reports pixels only, so
# KWin starts at 1x and a 500+ dpi phone gets a tiny desktop and a huge cursor. The app passes the
# physical size (ANDROMARCHY_PHYSICAL_MM, "<long>x<short>" mm); scale = dpi / 270 in quarter steps,
# clamped 1..4 (2x on a 6.9" 1440p phone, 1x on an 8-10" 1280p tablet; dpi/180 = 2.75x was too big).
# After that the user's choice in System Settings > Display & Monitor (kscreen; KWin saves it in
# kwinoutputconfig.json) is never overridden. POWOS_SCALE forces a scale on every start instead.
(
  for _ in $(seq 600); do pgrep -x plasmashell >/dev/null && break; sleep 0.2; done
  done_mark=$HOME/.local/state/powos/output-scale.done
  [ -z "${POWOS_SCALE:-}" ] && [ -e "$done_mark" ] && exit 0
  scale=${POWOS_SCALE:-}
  if [ -z "$scale" ] && [ -n "${ANDROMARCHY_PHYSICAL_MM:-}" ]; then
    mm=${ANDROMARCHY_PHYSICAL_MM%%x*}
    px=$(kscreen-doctor -j 2>/dev/null | jq -r '.outputs[0] as $o | ($o.modes[] | select(.id == $o.currentModeId) | [.size.width, .size.height] | max)' 2>/dev/null)
    if [ -n "$px" ] && [ "$px" != null ] && [ "${mm:-0}" -gt 0 ]; then
      scale=$(awk -v px="$px" -v mm="$mm" 'BEGIN { s = int(px / (mm / 25.4) / 270 * 4 + 0.5) / 4; if (s < 1) s = 1; if (s > 4) s = 4; print s }')
    fi
  fi
  if [ -n "$scale" ] && kscreen-doctor "output.1.scale.$scale" >/dev/null 2>&1; then
    echo "powos-session: output scale $scale (${ANDROMARCHY_PHYSICAL_MM:-?} mm)" >&2
    mkdir -p "${done_mark%/*}" && touch "$done_mark"
  fi
) &

# The phone's files in PowOS: the app passes /storage through (SessionService ARCH_EXCLUDE_EXTRA) once the
# storage permission is granted. ~/Phone is the whole shared storage; the standard folders (Dolphin's Places,
# file pickers, browsers' downloads) are the phone's own. Every start: the permission may come later.
phone=/storage/emulated/0
if [ -r "$phone" ]; then
  ln -sfn "$phone" "$HOME/Phone"
  for d in DOWNLOAD:Download PICTURES:DCIM DOCUMENTS:Documents MUSIC:Music VIDEOS:Movies; do
    xdg-user-dirs-update --set "${d%%:*}" "$phone/${d#*:}" 2>/dev/null
  done
fi

# PowOS's services: the image's enabled units, from their own unit files, under Andromarchy's systemctl
# (docker-systemctl-replacement: reads the real .service files, Restart=, enabled targets). Andromarchy started
# user units from Omarchy's Hyprland autostart, which PowOS doesn't have; here it is the session's job.
# System units (multi-user.target) and user units (default.target); units whose Condition*= fail on a phone
# skip themselves, as on any machine. Guarded: one manager per scope.
# System units run as root, as on PowOS: Andromarchy's (fake) root, what sudo gives here. "default" starts the
# enabled ones once and returns; "init" (a PID 1 stand-in) loops reaping over /proc, which an Android app can
# only partly read (it spun on "Permission denied" on the S25). Daemons it starts keep running.
sudo env SYSTEMD_DEFAULT_TARGET=multi-user.target systemctl default >"$XDG_RUNTIME_DIR/powos-system-units.log" 2>&1 &
pgrep -f 'pytho[n].*systemctl --user init' >/dev/null ||
  systemctl --user init >"$XDG_RUNTIME_DIR/powos-user-units.log" 2>&1 &

# First session of this rootfs (Flatpak remote, theme defaults); idempotent, marks itself done.
/opt/powos/first-session.sh >"$XDG_RUNTIME_DIR/powos-first-session.log" 2>&1 &

# startplasma-wayland runs kwin_wayland_wrapper (which inherits ANLAND_SOCKET -> Anland backend)
# and then plasmashell. systemd boot is off in /etc/xdg/startkderc: there is no systemd on Android.
exec startplasma-wayland
