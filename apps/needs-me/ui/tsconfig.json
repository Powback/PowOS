{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    // @powos/shared: apps/build.sh's esbuild alias for shell/ui/shared (friction f179).
    "baseUrl": ".",
    "paths": { "@powos/shared/*": ["../../../shell/ui/shared/*"] }
  }
}
